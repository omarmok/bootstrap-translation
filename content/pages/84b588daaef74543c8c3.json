ip: 1060,\n  toast: 1070,\n);","language":""},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Position utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"z-index\": (\n  property: z-index,\n  class: z,\n  values: $zindex-levels,\n),","language":""}],"demos":[{"key":"a3e92a40959b5d4ec8a5","html":"<div class=\"z-3 position-absolute p-9 rounded-3\"><span>z-3</span></div>\n<div class=\"z-2 position-absolute p-9 rounded-3\"><span>z-2</span></div>\n<div class=\"z-1 position-absolute p-9 rounded-3\"><span>z-1</span></div>\n<div class=\"z-0 position-absolute p-9 rounded-3\"><span>z-0</span></div>\n<div class=\"z-n1 position-absolute p-9 rounded-3\"><span>z-n1</span></div>","attrs":{"class":"bd-example bd-example-zindex-levels position-relative"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0/getting-started/css-variables"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/6.0/getting-started/javascript"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/6.0/getting-started/accessibility"},{"en":"Quickstart","href":"https://getbootstrap.com/docs/6.0/guides/quickstart"},{"en":"npm","href":"https://getbootstrap.com/docs/6.0/guides/npm"},{"en":"Webpack","href":"https://getbootstrap.com/docs/6.0/guides/webpack"},{"en":"Parcel","href":"https://getbootstrap.com/docs/6.0/guides/parcel"},
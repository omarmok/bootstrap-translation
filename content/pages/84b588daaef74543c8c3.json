{"route":"/docs/6.0/utilities/z-index/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Z-index","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use our low-level <code>z-index</code> utilities to quickly change the stack level of an element or component."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".z-n1"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"z-index: -1;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".z-0"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"z-index: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".z-1"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"z-index: 1;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".z-2"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"z-index: 2;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".z-3"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"z-index: 3;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".z-menu"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"z-index: 1000;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":".z-sticky"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"z-index: 1010;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":".z-fixed"}]},{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"z-index: 1020;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":".z-drawer"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"z-index: 1030;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":".z-dialog"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"z-index: 1040;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-24","type":"paragraph","en":".z-popover"}]},{"type":"td","body":[{"id":"content--paragraph-25","type":"paragraph","en":"z-index: 1050;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-26","type":"paragraph","en":".z-tooltip"}]},{"type":"td","body":[{"id":"content--paragraph-27","type":"paragraph","en":"z-index: 1060;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-28","type":"paragraph","en":".z-toast"}]},{"type":"td","body":[{"id":"content--paragraph-29","type":"paragraph","en":"z-index: 1070;"}]}]}]},{"id":"example","type":"heading","en":"Example","level":2},{"id":"example--paragraph-1","type":"paragraph","en":"Use <code>z-index</code> utilities to stack elements on top of one another. Requires a <code>position</code> value other than <code>static</code>, which can be set with custom styles or using our <a href=\"https://getbootstrap.com/docs/6.0/utilities/position/\">position utilities</a>."},{"id":"low-level-stack","type":"heading","en":"Low-level stack","level":3},{"id":"low-level-stack--paragraph-1","type":"paragraph","en":"We call these “low-level” <code>z-index</code> utilities because of their default values of <code>-1</code> through <code>3</code>, which we use for the layout of overlapping components. High-level <code>z-index</code> values are used for overlay components like modals and tooltips."},{"id":"low-level-stack--example-1","type":"demo","key":"a3e92a40959b5d4ec8a5","height":300},{"id":"low-level-stack--code-1","type":"code","value":"<div class=\"z-3 position-absolute p-9 rounded-3\"><span>z-3</span></div>\n<div class=\"z-2 position-absolute p-9 rounded-3\"><span>z-2</span></div>\n<div class=\"z-1 position-absolute p-9 rounded-3\"><span>z-1</span></div>\n<div class=\"z-0 position-absolute p-9 rounded-3\"><span>z-0</span></div>\n<div class=\"z-n1 position-absolute p-9 rounded-3\"><span>z-n1</span></div>","language":""},{"id":"component-stack","type":"heading","en":"Component stack","level":3},{"id":"component-stack--paragraph-1","type":"paragraph","en":"The component <code>z-index</code> utilities are used for overlay components like dialogs, popovers, and more. Classes are available for all of them, and their CSS variables are used in their respective components out of the box."},{"id":"component-stack--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"component-stack--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","body":[{"id":"component-stack--paragraph-3","type":"paragraph","en":"Value"}]},{"type":"th","body":[{"id":"component-stack--paragraph-4","type":"paragraph","en":"CSS variable"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-5","type":"paragraph","en":"<code>z-menu</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-6","type":"paragraph","en":"<code>1000</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-7","type":"paragraph","en":"<code>var(--z-menu)</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-8","type":"paragraph","en":"<code>z-sticky</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-9","type":"paragraph","en":"<code>1010</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-10","type":"paragraph","en":"<code>var(--z-sticky)</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-11","type":"paragraph","en":"<code>z-fixed</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-12","type":"paragraph","en":"<code>1020</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-13","type":"paragraph","en":"<code>var(--z-fixed)</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-14","type":"paragraph","en":"<code>z-drawer</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-15","type":"paragraph","en":"<code>1030</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-16","type":"paragraph","en":"<code>var(--z-drawer)</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-17","type":"paragraph","en":"<code>z-dialog</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-18","type":"paragraph","en":"<code>1040</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-19","type":"paragraph","en":"<code>var(--z-dialog)</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-20","type":"paragraph","en":"<code>z-popover</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-21","type":"paragraph","en":"<code>1050</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-22","type":"paragraph","en":"<code>var(--z-popover)</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-23","type":"paragraph","en":"<code>z-tooltip</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-24","type":"paragraph","en":"<code>1060</code>"}]},{"type":"td","body":[{"id":"component-stack--paragraph-25","type":"paragraph","en":"<code>var(--z-tooltip)</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"component-stack--paragraph-26","type":
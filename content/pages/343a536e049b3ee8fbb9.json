{"route":"/docs/5.2/utilities/vertical-align/","version":"5.2","renderedVersion":"5.2","title":{"id":"content","type":"heading","en":"Vertical alignment","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Easily change the vertical alignment of inline, inline-block, inline-table, and table cell elements."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"Change the alignment of elements with the <a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/vertical-align\"><code>vertical-alignment</code></a> utilities. Please note that vertical-align only affects inline, inline-block, inline-table, and table cell elements."},{"id":"content--paragraph-3","type":"paragraph","en":"Choose from <code>.align-baseline</code>, <code>.align-top</code>, <code>.align-middle</code>, <code>.align-bottom</code>, <code>.align-text-bottom</code>, and <code>.align-text-top</code> as needed."},{"id":"content--paragraph-4","type":"paragraph","en":"To vertically center non-inline content (like <code>&lt;div&gt;</code>s and more), use our <a href=\"https://getbootstrap.com/docs/5.2/utilities/flex/#align-items\">flex box utilities</a>."},{"id":"content--paragraph-5","type":"paragraph","en":"With inline elements:"},{"id":"content--example-1","type":"demo","key":"329f360d9a23f207d694","height":300},{"id":"content--code-1","type":"code","value":"<span class=\"align-baseline\">baseline</span>\n<span class=\"align-top\">top</span>\n<span class=\"align-middle\">middle</span>\n<span class=\"align-bottom\">bottom</span>\n<span class=\"align-text-top\">text-top</span>\n<span class=\"align-text-bottom\">text-bottom</span>","language":"html"},{"id":"content--paragraph-6","type":"paragraph","en":"With table cells:"},{"id":"content--example-2","type":"demo","key":"9a5132ebf01bc912c83f","height":147},{"id":"content--code-2","type":"code","value":"<table style=\"height: 100px;\">\n  <tbody>\n    <tr>\n      <td class=\"align-baseline\">baseline</td>\n      <td class=\"align-top\">top</td>\n      <td class=\"align-middle\">middle</td>\n      <td class=\"align-bottom\">bottom</td>\n      <td class=\"align-text-top\">text-top</td>\n      <td class=\"align-text-bottom\">text-bottom</td>\n    </tr>\n  </tbody>\n</table>","language":"html"},{"id":"sass","type":"heading","en":"Sass","level":2},{"id":"utilities-api","type":"heading","en":"Utilities API","level":3},{"id":"utilities-api--paragraph-1","type":"paragraph","en":"Vertical align utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/5.2/utilities/api/#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"utilities-api--code-1","type":"code","value":"    \"align\": (\n      property: vertical-align,\n      class: align,\n      values: baseline top middle bottom text-bottom text-top\n    ),","language":"scss"}],"demos":[{"key":"329f360d9a23f207d694","html":"\n<span class=\"align-baseline\">baseline</span>\n<span class=\"align-top\">top</span>\n<span class=\"align-middle\">middle</span>\n<span class=\"align-bottom\">bottom</span>\n<span class=\"align-text-top\">text-top</span>\n<span class=\"align-text-bottom\">text-bottom</span>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"9a5132ebf01bc912c83f","html":"\n<table style=\"height: 100px;\">\n  <tbody>\n    <tr>\n      <td class=\"align-baseline\">baseline</td>\n      <td class=\"align-top\">top</td>\n      <td class=\"align-middle\">middle</td>\n      <td class=\"align-bottom\">bottom</td>\n      <td class=\"align-text-top\">text-top</td>\n      <td class=\"align-text-bottom\">text-bottom</td>\n    </tr>\n  </tbody>\n</table>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.2/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/5.2/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.2/getting-started/contents/"},{"en"
":[{"id":"content--paragraph-32","type":"paragraph","en":".text-xl"}]},{"type":"td","body":[{"id":"content--paragraph-33","type":"paragraph","en":"font-size: clamp(1.5rem, 1.1rem + 0.75vw, 1.75rem);<br>line-height: 1.4285714286;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-34","type":"paragraph","en":".text-2xl"}]},{"type":"td","body":[{"id":"content--paragraph-35","type":"paragraph","en":"font-size: clamp(1.75rem, 1.3rem + 1vw, 2rem);<br>line-height: 1.3333333333;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-36","type":"paragraph","en":".text-3xl"}]},{"type":"td","body":[{"id":"content--paragraph-37","type":"paragraph","en":"font-size: clamp(2rem, 1.5rem + 1.875vw, 2.5rem);<br>line-height: 1.2;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-38","type":"paragraph","en":".text-4xl"}]},{"type":"td","body":[{"id":"content--paragraph-39","type":"paragraph","en":"font-size: clamp(2.25rem, 1.75rem + 2.5vw, 3rem);<br>line-height: 1.1;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-40","type":"paragraph","en":".text-5xl"}]},{"type":"td","body":[{"id":"content--paragraph-41","type":"paragraph","en":"font-size: clamp(3rem, 2rem + 5vw, 4rem);<br>line-height: 1.1;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-42","type":"paragraph","en":".text-6xl"}]},{"type":"td","body":[{"id":"content--paragraph-43","type":"paragraph","en":"font-size: clamp(3.75rem, 2.5rem + 6.25vw, 5rem);<br>line-height: 1;"}]}]}]},{"id":"content--note-1","type":"note","tone":"info","body":[{"id":"content--note-text-1","type":"note-text","en":"Looking for heading classes? Head to our <a href=\"https://getbootstrap.com/docs/6.0/content/typography#headings\">headings documentation</a>."}]},{"id":"font-size","type":"heading","en":"Font size","level":2},{"id":"font-size--paragraph-1","type":"paragraph","en":"Alternatively, you can change the <code>font-size</code> of text with <code>.fs-&lt;size&gt;</code> utilities. These classes only set <code>font-size</code> and offer a larger range of sizes than the heading classes."},{"id":"font-size--example-1","type":"demo","key":"260c860f9f076302f8dc","height":300},{"id":"font-size--code-1","type":"code","value":"<div class=\"fs-xs\">.fs-xs text</div>\n<div class=\"fs-sm\">.fs-sm text</div>\n<div class=\"fs-md\">.fs-md text</div>\n<div class=\"fs-lg\">.fs-lg text</div>\n<div class=\"fs-xl\">.fs-xl text</div>\n<div class=\"fs-2xl\">.fs-2xl text</div>\n<div class=\"fs-3xl\">.fs-3xl text</div>\n<div class=\"fs-4xl\">.fs-4xl text</div>\n<div class=\"fs-5xl\">.fs-5xl text</div>\n<div class=\"fs-6xl\">.fs-6xl text</div>","language":""},{"id":"with-line-height","type":"heading","en":"With <code>line-height</code>","level":2},{"id":"with-line-height--paragraph-1","type":"paragraph","en":"Swap the <code>.fs-*</code> utilities with the <code>.text-*</code> utilities to apply a <code>font-size</code> and <code>line-height</code> at the same time. These are configured from a single Sass map, <code>$font-sizes</code>."},{"id":"with-line-height--example-1","type":"demo","key":"a84949dada11d926ce24","height":300},{"id":"with-line-height--code-1","type":"code","value":"<div class=\"text-xs\">.text-xs text</div>\n<div class=\"text-sm\">.text-sm text</div>\n<div class=\"text-md\">.text-md text</div>\n<div class=\"text-lg\">.text-lg text</div>\n<div class=\"text-xl\">.text-xl text</div>\n<div class=\"text-2xl\">.text-2xl text</div>\n<div class=\"text-3xl\">.text-3xl text</div>\n<div class=\"text-4xl\">.text-4xl text</div>\n<div class=\"text-5xl\">.text-5xl text</div>\n<div class=\"text-6xl\">.text-6xl text</div>","language":""},{"id":"responsive-font-size","type":"heading","en":"Responsive <code>font-size</code>","level":2},{"id":"responsive-font-size--paragraph-1","type":"paragraph","en":"Font sizes use CSS‘s <code>clamp()</code> to provide fluid, responsive sizing that scales between a minimum and maximum value based on the viewport width. <strong>The <code>clamp()</code> function takes three parameters:</strong>"},{"id":"responsive-font-size--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"responsive-font-size--item-1","type":"item","en":"a minimum value"}]},{"tag":"li","body":[{"id":"responsive-font-size--item-2","type":"item","en":"a preferred value (calculated using viewport units)"}]},{"tag":"li","body":[{"id":"responsive-font-size--item-3","type":"item","en":"and, a maximum value"}]}]},{"id":"responsive-font-size--paragraph-2","type":"paragraph","en":"As the viewport changes, the font size smoothly transitions between the minimum and maximum values. Here’s how each size scales at different viewport widths."},{"id":"responsive-font-size--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"responsive-font-size--paragraph-3","type":"paragraph","en":"Size"}]},{"type":"th","body":[{"id":"responsive-font-size--paragraph-4","type":"paragraph","en":"Definition"}]},{"type":"th","body":[{"id":"responsive-font-size--paragraph-5","type":"paragraph","en":"Min"}]},{"type":"th","body":[{"id":"responsive-font-size--paragraph-6","type":"paragraph","en":"Max"}]},{"type":"th","body":[{"id":"responsive-font-size--paragraph-7","type":"paragraph","en":"@ 500px"}]},{"type":"th","body":[{"id":"responsive-font-size--paragraph-8","type":"paragraph","en":"@ 1400px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"responsive-font-size--paragraph-9","type":"paragraph","en":"<code>xs</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-10","type":"paragraph","en":"<code>clamp(.75rem, .7rem + .25vw, .875rem)</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-11","type":"paragraph","en":"12px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-12","type":"paragraph","en":"14px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-13","type":"paragraph","en":"12.45px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-14","type":"paragraph","en":"14px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"responsive-font-size--paragraph-15","type":"paragraph","en":"<code>sm</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-16","type":"paragraph","en":"<code>clamp(.875rem, .8rem + .375vw, 1rem)</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-17","type":"paragraph","en":"14px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-18","type":"paragraph","en":"16px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-19","type":"paragraph","en":"14.675px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-20","type":"paragraph","en":"16px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"responsive-font-size--paragraph-21","type":"paragraph","en":"<code>md</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-22","type":"paragraph","en":"<code>clamp(1rem, .9rem + .5vw, 1.125rem)</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-23","type":"paragraph","en":"16px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-24","type":"paragraph","en":"18px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-25","type":"paragraph","en":"16.9px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-26","type":"paragraph","en":"18px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"responsive-font-size--paragraph-27","type":"paragraph","en":"<code>lg</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-28","type":"paragraph","en":"<code>clamp(1.25rem, 1rem + .625vw, 1.5rem)</code>"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-29","type":"paragraph","en":"20px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-30","type":"paragraph","en":"24px"}]},{"type":"td","body":[{"id":"responsive-font-size--paragraph-31","type":"
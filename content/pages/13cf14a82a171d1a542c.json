{"route":"/docs/5.0/components/close-button/","version":"5.0","renderedVersion":"5.0","title":{"id":"content","type":"heading","en":"Close button","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"A generic close button for dismissing content like modals and alerts."},"blocks":[{"id":"example","type":"heading","en":"Example","level":2},{"id":"example--paragraph-1","type":"paragraph","en":"Provide an option to dismiss or close a component with <code>.btn-close</code>. Default styling is limited, but highly customizable. Modify the Sass variables to replace the default <code>background-image</code>. <strong>Be sure to include text for screen readers</strong>, as we’ve done with <code>aria-label</code>."},{"id":"example--example-1","type":"demo","key":"bca3a964f241cd3b383a","height":147},{"id":"example--code-1","type":"code","value":"<button type=\"button\" class=\"btn-close\" aria-label=\"Close\"></button>","language":"html"},{"id":"disabled-state","type":"heading","en":"Disabled state","level":2},{"id":"disabled-state--paragraph-1","type":"paragraph","en":"Disabled close buttons change their <code>opacity</code>. We’ve also applied <code>pointer-events: none</code> and <code>user-select: none</code> to preventing hover and active states from triggering."},{"id":"disabled-state--example-1","type":"demo","key":"946069652d11518dfca0","height":147},{"id":"disabled-state--code-1","type":"code","value":"<button type=\"button\" class=\"btn-close\" disabled aria-label=\"Close\"></button>","language":"html"},{"id":"white-variant","type":"heading","en":"White variant","level":2},{"id":"white-variant--paragraph-1","type":"paragraph","en":"Change the default <code>.btn-close</code> to be white with the <code>.btn-close-white</code> class. This class uses the <code>filter</code> property to invert the <code>background-image</code>."},{"id":"white-variant--example-1","type":"demo","key":"7e4215eaacd213f7f9ab","height":174},{"id":"white-variant--code-1","type":"code","value":"<button type=\"button\" class=\"btn-close btn-close-white\" aria-label=\"Close\"></button>\n<button type=\"button\" class=\"btn-close btn-close-white\" disabled aria-label=\"Close\"></button>","language":"html"},{"id":"sass","type":"heading","en":"Sass","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--code-1","type":"code","value":"$btn-close-width:            1em;\n$btn-close-height:           $btn-close-width;\n$btn-close-padding-x:        .25em;\n$btn-close-padding-y:        $btn-close-padding-x;\n$btn-close-color:            $black;\n$btn-close-bg:               url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='#{$btn-close-color}'><path d='M.293.293a1 1 0 011.414 0L8 6.586 14.293.293a1 1 0 111.414 1.414L9.414 8l6.293 6.293a1 1 0 01-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 01-1.414-1.414L6.586 8 .293 1.707a1 1 0 010-1.414z'/></svg>\");\n$btn-close-focus-shadow:     $input-btn-focus-box-shadow;\n$btn-close-opacity:          .5;\n$btn-close-hover-opacity:    .75;\n$btn-close-focus-opacity:    1;\n$btn-close-disabled-opacity: .25;\n$btn-close-white-filter:     invert(1) grayscale(100%) brightness(200%);","language":"scss"}],"demos":[{"key":"bca3a964f241cd3b383a","html":"\n<button type=\"button\" class=\"btn-close\" aria-label=\"Close\"></button>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"946069652d11518dfca0","html":"\n<button type=\"button\" class=\"btn-close\" disabled=\"\" aria-label=\"Close\"></button>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"7e4215eaacd213f7f9ab","html":"\n<button type=\"button\" class=\"btn-close btn-close-white\" aria-label=\"Close\"></button>\n<button type=\"button\" class=\"btn-close btn-close-white\" disabled=\"\" aria-label=\"Close\"></button>\n","attrs":{"class":"bd-example bg-dark"},"sprite":""}],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.0/getting-started/introduction/"},{"en":"Download"
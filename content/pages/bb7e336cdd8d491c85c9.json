pill-content</code>"}]},{"type":"td","body":[{"id":"dropped--paragraph-46","type":"paragraph","en":"<code>.tab-content</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dropped--paragraph-47","type":"paragraph","en":"Pill-based tabbable area pane"}]},{"type":"td","body":[{"id":"dropped--paragraph-48","type":"paragraph","en":"<code>.pill-pane</code>"}]},{"type":"td","body":[{"id":"dropped--paragraph-49","type":"paragraph","en":"<code>.tab-pane</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dropped--paragraph-50","type":"paragraph","en":"Nav lists"}]},{"type":"td","body":[{"id":"dropped--paragraph-51","type":"paragraph","en":"<code>.nav-list</code> <code>.nav-header</code>"}]},{"type":"td","body":[{"id":"dropped--paragraph-52","type":"paragraph","en":"No direct equivalent, but <a href=\"https://getbootstrap.com/docs/3.4/components/#list-group\">list groups</a> and <a href=\"https://getbootstrap.com/docs/3.4/javascript/#collapse\"><code>.panel-group</code>s</a> are similar."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dropped--paragraph-53","type":"paragraph","en":"Inline help for form controls"}]},{"type":"td","body":[{"id":"dropped--paragraph-54","type":"paragraph","en":"<code>.help-inline</code>"}]},{"type":"td","body":[{"id":"dropped--paragraph-55","type":"paragraph","en":"No exact equivalent, but <code>.help-block</code> is similar."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dropped--paragraph-56","type":"paragraph","en":"Non-bar-level progress colors"}]},{"type":"td","body":[{"id":"dropped--paragraph-57","type":"paragraph","en":"<code>.progress-info</code> <code>.progress-success</code> <code>.progress-warning</code> <code>.progress-danger</code>"}]},{"type":"td","body":[{"id":"dropped--paragraph-58","type":"paragraph","en":"Use <code>.progress-bar-*</code> on the <code>.progress-bar</code> instead."}]}]}]},{"id":"notes","type":"heading","en":"Additional notes","level":2},{"id":"notes--paragraph-1","type":"paragraph","en":"Other changes in v3.0 are not immediately apparent. Base classes, key styles, and behaviors have been adjusted for flexibility and our <em>mobile first</em> approach. Here&#39;s a partial list:"},{"id":"notes--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notes--item-1","type":"item","en":"By default, text-based form controls now receive only minimal styling.  For focus colors and rounded corners, apply the <code>.form-control</code> class on the element to style."}]},{"tag":"li","body":[{"id":"notes--item-2","type":"item","en":"Text-based form controls with the <code>.form-control</code> class applied are now 100% wide by default. Wrap inputs inside <code>&lt;div class=&quot;col-*&quot;&gt;&lt;/div&gt;</code> to control input widths."}]},{"tag":"li","body":[{"id":"notes--item-3","type":"item","en":"<code>.badge</code> no longer has contextual (-success,-primary,etc..) classes."}]},{"tag":"li","body":[{"id":"notes--item-4","type":"item","en":"<code>.btn</code> must also use <code>.btn-default</code> to get the &quot;default&quot; button."}]},{"tag":"li","body":[{"id":"notes--item-5","type":"item","en":"<code>.row</code> is now fluid."}]},{"tag":"li","body":[{"id":"notes--item-6","type":"item","en":"Images are no longer responsive by default. Use <code>.img-responsive</code> for fluid <code>&lt;img&gt;</code> size."}]},{"tag":"li","body":[{"id":"notes--item-7","type":"item","en":"The icons, now <code>.glyphicon</code>, are now font based. Icons also require a base and icon class (e.g. <code>.glyphicon .glyphicon-asterisk</code>)."}]},{"tag":"li","body":[{"id":"notes--item-8","type":"item","en":"Typeahead has been dropped, in favor of using <a href=\"http://twitter.github.io/typeahead.js/\">Twitter Typeahead</a>."}]},{"tag":"li","body":[{"id":"notes--item-9","type":"item","en":"Modal markup has changed significantly. The <code>.modal-header</code>, <code>.modal-body</code>, and <code>.modal-footer</code> sections are now wrapped in <code>.modal-content</code> and <code>.modal-dialog</code> for better mobile styling and behavior. Also, you should no longer apply <code>.hide</code> to <code>.modal</code> in your markup."}]},{"tag":"li","body":[{"id":"notes--item-10","type":"item","en":"As of v3.1.0, the HTML loaded by the <code>remote</code> modal option is now injected into the <code>.modal-content</code> (from v3.0.0 to v3.0.3, into the <code>.modal</code>) instead of into the <code>.modal-body</code>. This allows you to also easily vary the header and footer of the modal, not just the modal body."}]},{"tag":"li","body":[{"id":"notes--item-11","type":"item","en":"The checkbox and radio features of the button.js plugin now both use <code>data-toggle=&quot;buttons&quot;</code> instead of <code>data-toggle=&quot;buttons-checkbox&quot;</code> or <code>data-toggle=&quot;buttons-radio&quot;</code> in their markup."}]},{"tag":"li","body":[{"id":"notes--item-12","type":"item","en":"JavaScript events are namespaced. For example, to handle the modal &quot;show&quot; event, use <code>&#39;show.bs.modal&#39;</code>. For tabs &quot;shown&quot; use <code>&#39;shown.bs.tab&#39;</code>, etc."}]}]},{"id":"notes--paragraph-2","type":"paragraph","en":"For more information on upgrading to v3.0, and code snippets from the community, see <a href=\"https://www.bootply.com/\">Bootply</a>."}],"demos":[],"nav":[{"en":"Major class changes","href":"#classes"},{"en":"What's new","href":"#new"},{"en":"What's removed","href":"#dropped"},{"en":"Additional notes","href":"#notes"}],"standalone":false,"publishedAssets":[{"url":"https://code.jquery.com/jquery-1.12.4.min.js","integrity":"sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://cdn.carbonads.com/carbon.js?zoneid=1673&serve=C6AILKT&placement=getbootstrapcom","https://code.jquery.com/jquery-1.12.4.min.js","https://getbootstrap.com/docs/3.4/dist/js/bootstrap.min.js","https://cdn.jsdelivr.net/docsearch.js/2/docsearch.min.js","https://getbootstrap.com/docs/3.4/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/3.4/dist/css/bootstrap.min.css","https://cdn.jsdelivr.net/docsearch.js/2/docsearch.min.css","https://getbootstrap.com/docs/3.4/assets/css/docs.min.css"]}

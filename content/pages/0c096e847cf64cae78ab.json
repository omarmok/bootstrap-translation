strap.com/docs/5.2/utilities/interactions/"},{"en":"Opacity","href":"https://getbootstrap.com/docs/5.2/utilities/opacity/"},{"en":"Overflow","href":"https://getbootstrap.com/docs/5.2/utilities/overflow/"},{"en":"Position","href":"https://getbootstrap.com/docs/5.2/utilities/position/"},{"en":"Shadows","href":"https://getbootstrap.com/docs/5.2/utilities/shadows/"},{"en":"Sizing","href":"https://getbootstrap.com/docs/5.2/utilities/sizing/"},{"en":"Spacing","href":"https://getbootstrap.com/docs/5.2/utilities/spacing/"},{"en":"Text","href":"https://getbootstrap.com/docs/5.2/utilities/text/"},{"en":"Vertical align","href":"https://getbootstrap.com/docs/5.2/utilities/vertical-align/"},{"en":"Visibility","href":"https://getbootstrap.com/docs/5.2/utilities/visibility/"},{"en":"Approach","href":"https://getbootstrap.com/docs/5.2/extend/approach/"},{"en":"Icons","href":"https://getbootstrap.com/docs/5.2/extend/icons/"},{"en":"Overview","href":"https://getbootstrap.com/docs/5.2/about/overview/"},{"en":"Team","href":"https://getbootstrap.com/docs/5.2/about/team/"},{"en":"Brand","href":"https://getbootstrap.com/docs/5.2/about/brand/"},{"en":"License","href":"https://getbootstrap.com/docs/5.2/about/license/"},{"en":"Translations","href":"https://getbootstrap.com/docs/5.2/about/translations/"},{"en":"Migration","href":"https://getbootstrap.com/docs/5.2/migration/"}],"standalone":false,"publishedAssets":[{"url":"/docs/5.2/dist/css/bootstrap.min.css","integrity":"sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65"},{"url":"/docs/5.2/dist/js/bootstrap.bundle.min.js","integrity":"sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-analytics.com/analytics.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://getbootstrap.com/docs/5.2/dist/js/bootstrap.bundle.min.js","https://cdn.jsdelivr.net/npm/@docsearch/js@3","h
{"route":"/docs/4.5/utilities/screen-readers/","version":"4.5","renderedVersion":"4.5","title":{"id":"content","type":"heading","en":"Screen readers","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.5.3/site/docs/4.5/utilities/screen-readers.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Use screen reader utilities to hide elements on all devices except screen readers."},{"id":"content--paragraph-2","type":"paragraph","en":"Hide an element to all devices <strong>except screen readers</strong> with <code>.sr-only</code>. Combine <code>.sr-only</code> with <code>.sr-only-focusable</code> to show the element again when it’s focused (e.g. by a keyboard-only user). Can also be used as mixins."},{"id":"content--example-1","type":"demo","key":"2ffc3d93101c2285f5ba","height":147},{"id":"content--code-1","type":"code","value":"<a class=\"sr-only sr-only-focusable\" href=\"#content\">Skip to main content</a>","language":"html"},{"id":"content--code-2","type":"code","value":"// Usage as a mixin\n.skip-navigation {\n  @include sr-only;\n  @include sr-only-focusable;\n}","language":"scss"}],"demos":[{"key":"2ffc3d93101c2285f5ba","html":"\n<a class=\"sr-only sr-only-focusable\" href=\"#content\">Skip to main content</a>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.5/getting-started/introduction/"},{"en":"Introduction","href":"https://getbootstrap.com/docs/4.5/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/4.5/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/4.5/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/4.5/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/4.5/getting-started/javascript/"},{"en":"Theming","href":"https://getbootst
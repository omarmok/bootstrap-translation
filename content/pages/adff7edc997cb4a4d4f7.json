{"route":"/docs/6.0/components/button-group/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Button group","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Group a series of buttons together on a single line or stack them in a vertical column."},"blocks":[{"id":"examples","type":"heading","en":"Examples","level":2},{"id":"examples--paragraph-1","type":"paragraph","en":"Wrap a series of buttons in <code>.btn-group</code>."},{"id":"examples--example-1","type":"demo","key":"a26ea06558b05098a08d","height":147},{"id":"examples--code-1","type":"code","value":"<div class=\"btn-group\" role=\"group\" aria-label=\"Basic example\">\n  <button type=\"button\" class=\"btn-solid theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Right</button>\n</div>","language":""},{"id":"examples--note-1","type":"note","tone":"info","body":[{"id":"examples--note-text-1","type":"note-text","en":"Button groups require an appropriate <code>role</code> attribute and explicit label to ensure assistive technologies like screen readers identify buttons as grouped and announce them. Use <code>role=&quot;group&quot;</code> for button groups or <code>role=&quot;toolbar&quot;</code> for button toolbars. Then use <code>aria-label</code> or <code>aria-labelledby</code> to label them."}]},{"id":"with-links","type":"heading","en":"With links","level":3},{"id":"with-links--paragraph-1","type":"paragraph","en":"These classes can also be added to groups of links, as an alternative to the <a href=\"https://getbootstrap.com/docs/6.0/components/nav\"><code>.nav</code> navigation components</a>."},{"id":"with-links--example-1","type":"demo","key":"f6fca344a9615e96be9e","height":147},{"id":"with-links--code-1","type":"code","value":"<div class=\"btn-group\">\n  <a href=\"#\" class=\"btn-solid theme-primary active\" aria-current=\"page\">Active link</a>\n  <a href=\"#\" class=\"btn-solid theme-primary\">Link</a>\n  <a href=\"#\" class=\"btn-solid theme-primary\">Link</a>\n</div>","language":""},{"id":"dividers","type":"heading","en":"Dividers","level":3},{"id":"dividers--paragraph-1","type":"paragraph","en":"Add a divider between buttons by adding the <code>.btn-group-divider</code> class to the <code>.btn-group</code>. Most useful when used with buttons that have the same theme color and a solid fill."},{"id":"dividers--example-1","type":"demo","key":"598856c8d622336afb01","height":174},{"id":"dividers--code-1","type":"code","value":"<div class=\"btn-group btn-group-divider\" role=\"group\" aria-label=\"Basic example\">\n  <button type=\"button\" class=\"btn-solid theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-primary active\">Active</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Right</button>\n</div>\n\n<div class=\"btn-group btn-group-divider\" role=\"group\" aria-label=\"Basic example\">\n  <button type=\"button\" class=\"btn-solid theme-secondary\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-secondary\">Right</button>\n</div>","language":""},{"id":"dividers--paragraph-2","type":"paragraph","en":"Works with vertical button groups, too."},{"id":"dividers--example-2","type":"demo","key":"5dfc65c1fe60a58ab849","height":174},{"id":"dividers--code-2","type":"code","value":"<div class=\"btn-group-vertical btn-group-divider\" role=\"group\" aria-label=\"Basic example\">\n  <button type=\"button\" class=\"btn-solid theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-primary active\">Active</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Right</button>\n</div>\n\n<div class=\"btn-group-vertical btn-group-divider\" role=\"group\" aria-label=\"Basic example\">\n  <button type=\"button\" class=\"btn-solid theme-secondary\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-secondary\">Right</button>\n</div>","language":""},{"id":"theme-variants","type":"heading","en":"Theme variants","level":2},{"id":"theme-variants--paragraph-1","type":"paragraph","en":"Ue the <code>.theme-{color}</code> classes to apply a theme color to a set of buttons."},{"id":"theme-variants--example-1","type":"demo","key":"b4429b974db213e10949","height":147},{"id":"theme-variants--code-1","type":"code","value":"<div class=\"btn-group\" role=\"group\" aria-label=\"Accent theme example\">\n  <button type=\"button\" class=\"btn-solid theme-accent\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-accent\">Middle</button>\n  <button type=\"button\" class=\"btn-solid theme-accent\">Right</button>\n</div>","language":""},{"id":"theme-variants--paragraph-2","type":"paragraph","en":"You can mix and match button variants in a button group."},{"id":"theme-variants--example-2","type":"demo","key":"e3638496c57cbcd2e9c7","height":147},{"id":"theme-variants--code-2","type":"code","value":"<div class=\"btn-group\" role=\"group\" aria-label=\"Basic mixed styles example\">\n  <button type=\"button\" class=\"btn-solid theme-danger\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-warning\">Middle</button>\n  <button type=\"button\" class=\"btn-solid theme-success\">Right</button>\n</div>","language":""},{"id":"style-variants","type":"heading","en":"Style variants","level":2},{"id":"style-variants--paragraph-1","type":"paragraph","en":"All button styles are supported in button groups. Mix and match with the <code>.btn-group-divider</code> class to add dividers between some styles or just use the button borders in others."},{"id":"style-variants--example-1","type":"demo","key":"f1c9b3df3b9ba434e486","height":147},{"id":"style-variants--code-1","type":"code","value":"<div class=\"btn-group btn-group-divider\" role=\"group\" aria-label=\"Solid example\">\n  <button type=\"button\" class=\"btn-solid theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Right</button>\n</div>","language":""},{"id":"style-variants--example-2","type":"demo","key":"d3228e7930a80de23970","height":147},{"id":"style-variants--code-2","type":"code","value":"<div class=\"btn-group\" role=\"group\" aria-label=\"Outlined example\">\n  <button type=\"button\" class=\"btn-outline theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Right</button>\n</div>","language":""},{"id":"style-variants--example-3","type":"demo","key":"e435c178ba0e6ca8ca88","height":147},{"id":"style-variants--code-3","type":"code","value":"<div class=\"btn-group btn-group-divider\" role=\"group\" aria-label=\"Subtle example\">\n  <button type=\"button\" class=\"btn-subtle theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-subtle theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-subtle theme-primary\">Right</button>\n</div>","language":""},{"id":"toggle-buttons","type":"heading","en":"Toggle buttons","level":2},{"id":"checkbox","type":"heading","en":"Checkbox","level":3},{"id":"checkbox--paragraph-1","type":"paragraph","en":"Checkbox toggle buttons can be grouped together. Any or all of the buttons can be checked."},{"id":"checkbox--example-1","type":"demo","key":"7eddf11625ae33022872","height":147},{"id":"checkbox--code-1","type":"code","value":"<div class=\"btn-group\" role=\"group\" aria-label=\"Basic checkbox toggle button group\">\n  <label class=\"btn-check btn-outline theme-primary\">\n    <input type=\"checkbox\" autocomplete=\"off\">\n    Check 1\n  </label>\n  <label class=\"btn-check btn-outline theme-primary\">\n    <input type=\"checkbox\" autocomplete=\"off\">\n    Check 2\n  </label>\n  <label class=\"btn-check btn-outline theme-primary\">\n    <input type=\"checkbox\" autocomplete=\"off\">\n    Check 3\n  </label>\n</div>","language":""},{"id":"radio","type":"heading","en":"Radio","level":3},{"id":"radio--paragraph-1","type":"paragraph","en":"By design, radio toggle button groups can only have one button checked at a time."},{"id":"radio--example-1","type":"demo","key":"63036fd3e2fc38ce6ee2","height":147},{"id":"radio--code-1","type":"code","value":"<div class=\"btn-group\" role=\"group\" aria-label=\"Basic radio toggle button group\">\n  <label class=\"btn-check btn-outline theme-primary\">\n    <input type=\"radio\" name=\"btnradio\" autocomplete=\"off\" checked>\n    Radio 1\n  </label>\n  <label class=\"btn-check btn-outline theme-primary\">\n    <input type=\"radio\" name=\"btnradio\" autocomplete=\"off\">\n    Radio 2\n  </label>\n  <label class=\"btn-check btn-outline theme-primary\">\n    <input type=\"radio\" name=\"btnradio\" autocomplete=\"off\">\n    Radio 3\n  </label>\n</div>","language":""},{"id":"button-toolbar","type":"heading","en":"Button toolbar","level":2},{"id":"button-toolbar--paragraph-1","type":"paragraph","en":"Combine sets of button groups into button toolbars for more complex components. Use utility classes as needed to space out groups, buttons, and more."},{"id":"button-toolbar--example-1","type":"demo","key":"458b89f75cd4845e1b63","height":147},{"id":"button-toolbar--code-1","type":"code","value":"<div class=\"btn-toolbar\" role=\"toolbar\" aria-label=\"Toolbar with button groups\">\n  <div class=\"btn-group\" role=\"group\" aria-label=\"First group\">\n    <button type=\"button\" class=\"btn-solid theme-primary\">1</button>\n    <button type=\"button\" class=\"btn-solid theme-primary\">2</button>\n    <button type=\"button\" class=\"btn-solid theme-primary\">3</button>\n    <button type=\"button\" class=\"btn-solid theme-primary\">4</button>\n  </div>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Second group\">\n    <button type=\"button\" class=\"btn-solid theme-secondary\">5</button>\n    <button type=\"button\" class=\"btn-solid theme-secondary\">6</button>\n    <button type=\"button\" class=\"btn-solid theme-secondary\">7</button>\n  </div>\n  <div class=\"btn-group\" role=\"group\" aria-label=\"Third group\">\n    <button type=\"button\" class=\"btn-solid theme-info\">8</button>\n  </div>\n</div>","language":""},{"id":"button-toolbar--paragraph-2","type":"paragraph","en":"Feel free to mix input groups with button groups in your toolbars. Similar to the example above, you’ll likely need some utilities though to space things properly."},{"id":"button-toolbar--example-2","type":"demo","key":"b8dd1e6d4f6f61c9332f","height":174,"anchors":["btnGroupAddon","btnGroupAddon2"]},{"id":"button-toolbar--code-2","type":"code","value":"<div class=\"btn-toolbar\" role=\"toolbar\" aria-label=\"Toolbar with button groups\">\n  <div class=\"btn-group\" role=\"group\" aria-label=\"First group\">\n    <button type=\"button\" class=\"btn-outline theme-secondary\">1</button>\n    <button type=\"button\" class=\"btn-outline theme-secondary\">2</button>\n    <button type=\"button\" class=\"btn-outline theme-secondary\">3</button>\n    <button type=\"button\" class=\"btn-outline theme-secondary\">4</button>\n  </div>\n  <div class=\"input-group\">\n    <div class=\"input-group-text\" id=\"btnGroupAddon\">@</div>\n    <input type=\"text\" class=\"form-control\" placeholder=\"Input group example\" aria-label=\"Input group example\" aria-describedby=\"btnGroupAddon\">\n  </div>\n</div>\n\n<div class=\"btn-toolbar justify-content-between\" role=\"toolbar\" aria-label=\"Toolbar with button groups\">\n  <div class=\"btn-group\" role=\"group\" aria-label=\"First group\">\n    <button type=\"button\" class=\"btn-outline theme-secondary\">1</button>\n    <button type=\"button\" class=\"btn-outline theme-secondary\">2</button>\n    <button type=\"button\" class=\"btn-outline theme-secondary\">3</button>\n    <button type=\"button\" class=\"btn-outline theme-secondary\">4</button>\n  </div>\n  <div class=\"input-group\">\n    <div class=\"input-group-text\" id=\"btnGroupAddon2\">@</div>\n    <input type=\"text\" class=\"form-control\" placeholder=\"Input group example\" aria-label=\"Input group example\" aria-describedby=\"btnGroupAddon2\">\n  </div>\n</div>","language":""},{"id":"sizing","type":"heading","en":"Sizing","level":2},{"id":"sizing--paragraph-1","type":"paragraph","en":"Instead of applying button sizing classes to every button in a group, just add <code>.btn-group-*</code> to each <code>.btn-group</code>, including each one when nesting multiple groups."},{"id":"sizing--example-1","type":"demo","key":"b4ae83978ff68f819913","height":228},{"id":"sizing--code-1","type":"code","value":"<div class=\"btn-group btn-group-lg\" role=\"group\" aria-label=\"Large button group\">\n  <button type=\"button\" class=\"btn-outline theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Right</button>\n</div>\n<div class=\"btn-group\" role=\"group\" aria-label=\"Default button group\">\n  <button type=\"button\" class=\"btn-outline theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Right</button>\n</div>\n<div class=\"btn-group btn-group-sm\" role=\"group\" aria-label=\"Small button group\">\n  <button type=\"button\" class=\"btn-outline theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Right</button>\n</div>\n<div class=\"btn-group btn-group-xs\" role=\"group\" aria-label=\"Extra small button group\">\n  <button type=\"button\" class=\"btn-outline theme-primary\">Left</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Middle</button>\n  <button type=\"button\" class=\"btn-outline theme-primary\">Right</button>\n</div>","language":""},{"id":"nesting","type":"heading","en":"Nesting","level":2},{"id":"nesting--paragraph-1","type":"paragraph","en":"Place a <code>.btn-group</code> within another <code>.btn-group</code> when you want menus mixed with a series of buttons."},{"id":"nesting--example-1","type":"demo","key":"ce634b749ee9460a4ef7","height":147},{"id":"nesting--code-1","type":"code","value":"<div class=\"btn-group\" role=\"group\" aria-label=\"Button group with nested menu\">\n  <button type=\"button\" class=\"btn-solid theme-primary\">1</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">2</button>\n\n  <div class=\"btn-group\" role=\"group\">\n    <button type=\"button\" class=\"btn-solid theme-primary\" data-bs-toggle=\"menu\" aria-expanded=\"false\">\n      Menu\n    </button>\n    <div class=\"menu\">\n      <a class=\"menu-item\" href=\"#\">Menu link</a>\n      <a class=\"menu-item\" href=\"#\">Menu link</a>\n    </div>\n  </div>\n</div>","language":""},{"id":"vertical-variation","type":"heading","en":"Vertical variation","level":2},{"id":"vertical-variation--paragraph-1","type":"paragraph","en":"Make a set of buttons appear vertically stacked rather than horizontally. <strong>Split button menus are not supported here.</strong>"},{"id":"vertical-variation--example-1","type":"demo","key":"39b54fbe8f4dd71b2157","height":147},{"id":"vertical-variation--code-1","type":"code","value":"<div class=\"btn-group-vertical\" role=\"group\" aria-label=\"Vertical button group\">\n  <button type=\"button\" class=\"btn-solid theme-primary\">Button</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Button</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Button</button>\n  <button type=\"button\" class=\"btn-solid theme-primary\">Button</button>\n</div>","language":""},{"id":"vertical-variation--example-2","type":"demo","key":"9f6be22fbbb584591cc9","height":147},{"id":"vertical-variation--code-2",
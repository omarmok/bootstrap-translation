{"route":"/docs/4.6/utilities/float/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"Float","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/utilities/float.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Toggle floats on any element, across any breakpoint, using our responsive float utilities."},{"id":"overview","type":"heading","en":"Overview","level":2},{"id":"overview--paragraph-1","type":"paragraph","en":"These utility classes float an element to the left or right, or disable floating, based on the current viewport size using the <a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/float\">CSS <code>float</code> property</a>. <code>!important</code> is included to avoid specificity issues. These use the same viewport breakpoints as our grid system. Please be aware float utilities have no effect on flex items."},{"id":"classes","type":"heading","en":"Classes","level":2},{"id":"classes--paragraph-1","type":"paragraph","en":"Toggle a float with a class:"},{"id":"classes--example-1","type":"demo","key":"4f5feb4d521123990bfd","height":300},{"id":"classes--code-1","type":"code","value":"<div class=\"float-left\">Float left on all viewport sizes</div><br>\n<div class=\"float-right\">Float right on all viewport sizes</div><br>\n<div class=\"float-none\">Don't float on all viewport sizes</div>","language":"html"},{"id":"mixins","type":"heading","en":"Mixins","level":2},{"id":"mixins--paragraph-1","type":"paragraph","en":"Or by Sass mixin:"},{"id":"mixins--code-1","type":"code","value":".element {\n  @include float-left;\n}\n.another-element {\n  @include float-right;\n}\n.one-more {\n  @include float-none;\n}","language":"scss"},{"id":"responsive","type":"heading","en":"Responsive","level":2},{"id":"responsive--paragraph-1","type":"paragraph","en":"Responsive variations also exist for each <code>float</code> value."},{"id":"responsive--example-1","type":"demo","key":"ab06f60f134334e14bbb","height":300},{"id":"responsive--code-1","type":"code","value":"<div class=\"float-sm-left\">Float left on viewports sized SM (small) or wider</div><br>\n<div class=\"float-md-left\">Float left on viewports sized MD (medium) or wider</div><br>\n<div class=\"float-lg-left\">Float left on viewports sized LG (large) or wider</div><br>\n<div class=\"float-xl-left\">Float left on viewports sized XL (extra-large) or wider</div><br>","language":"html"},{"id":"responsive--paragraph-2","type":"paragraph","en":"Here are all the support classes;"},{"id":"responsive--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"responsive--item-1","type":"item","en":"<code>.float-left</code>"}]},{"tag":"li","body":[{"id":"responsive--item-2","type":"item","en":"<code>.float-right</code>"}]},{"tag":"li","body":[{"id":"responsive--item-3","type":"item","en":"<code>.float-none</code>"}]},{"tag":"li","body":[{"id":"responsive--item-4","type":"item","en":"<code>.float-sm-left</code>"}]},{"tag":"li","body":[{"id":"responsive--item-5","type":"item","en":"<code>.float-sm-right</code>"}]},{"tag":"li","body":[{"id":"responsive--item-6","type":"item","en":"<code>.float-sm-none</code>"}]},{"tag":"li","body":[{"id":"responsive--item-7","type":"item","en":"<code>.float-md-left</code>"}]},{"tag":"li","body":[{"id":"responsive--item-8","type":"item","en":"<code>.float-md-right</code>"}]},{"tag":"li","body":[{"id":"responsive--item-9","type":"item","en":"<code>.float-md-none</code>"}]},{"tag":"li","body":[{"id":"responsive--item-10","type":"item","en":"<code>.float-lg-left</code>"}]},{"tag":"li","body":[{"id":"responsive--item-11","type":"item","en":"<code>.float-lg-right</code>"}]},{"tag":"li","body":[{"id":"responsive--item-12","type":"item","en":"<code>.float-lg-none</code>"}]},{"tag":"li","body":[{"id":"responsive--item-13","type":"item","en":"<code>.float-xl-left</code>"}]},{"tag":"li","body":[{"id":"responsive--item-14","type":"item","en":"<code>.float-xl-right</code>"}]},{"tag":"li","body":[{"id":"responsive--item-15","type":"item","en":"<code>.float-xl-none</code>"}]}]}],"demos":[{"key":"4f5feb4d521123990bfd","html":"\n<div class=\"float-left\">Float left on all viewport sizes</div><br>\n<div class=\"float-right\">Float right on all viewport sizes</div><br>\n<div class=\"float-none\">Don't float on all viewport sizes</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"ab06f60f134334e14bbb","html":"\n<div class=\"float-sm-left\">Float left on viewports sized SM (small) or wider</div><br>\n<div class=\"float-md-left\">Float left on viewports sized MD (medium) or wider</div><br>\n<div class=\"float-lg-left\">Float left on viewports sized LG (large) or wider</div><br>\n<div class=\"float-xl-left\">Float left on viewports sized XL (extra-large) or wider</div><br>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.6/getting-started/introduction/"},{"en":"Layout","href":"https://getbootstrap.com/docs/4.6/layout/overview/"},{"en":"Content","href":"https://getbootstrap.com/docs/4.6/content/reboot/"},{"en":"Components","href":"https://getbootstrap.com/docs/4.6/components/alerts/"},{"en":"Utilities","href":"https://getbootstrap.com/docs/4.6/utilities/borders/"},{"en":"Borders","href":"https://getbootstrap.com/docs/4.6/utilities/borders/"},{"en":"Clearfix","href":"https://getbootstrap.com/docs/4.6/utilities/clearfix/"},{"en":"Close icon","href":"https://getbootstrap.com/docs/4.6/utilities/close-icon/"},{"en":"Colors","href":"https://getbootstrap.com/docs/4.6/utilities/colors/"},{"en":"Display","href":"https://getbootstrap.com/docs/4.6/utilities/display/"},{"en":"Embed","href":"https://getbootstrap.com/docs/4.6/utilities/embed/"},{"en":"Flex","href":"https://getbootstrap.com/docs/4.6/utilities/flex/"},{"en":"Float","href":"https://getbootstrap.com/docs/4.6/utilities/float/"},
{"route":"/docs/5.0/forms/floating-labels/","version":"5.0","renderedVersion":"5.0","title":{"id":"content","type":"heading","en":"Floating labels","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Create beautifully simple form labels that float over your input fields."},"blocks":[{"id":"example","type":"heading","en":"Example","level":2},{"id":"example--paragraph-1","type":"paragraph","en":"Wrap a pair of <code>&lt;input class=&quot;form-control&quot;&gt;</code> and <code>&lt;label&gt;</code> elements in <code>.form-floating</code> to enable floating labels with Bootstrap’s textual form fields. A <code>placeholder</code> is required on each <code>&lt;input&gt;</code> as our method of CSS-only floating labels uses the <code>:placeholder-shown</code> pseudo-element. Also note that the <code>&lt;input&gt;</code> must come first so we can utilize a sibling selector (e.g., <code>~</code>)."},{"id":"example--example-1","type":"demo","key":"65b47001850e8131d6ba","height":174,"anchors":["floatingInput","floatingPassword"]},{"id":"example--code-1","type":"code","value":"<div class=\"form-floating mb-3\">\n  <input type=\"email\" class=\"form-control\" id=\"floatingInput\" placeholder=\"name@example.com\">\n  <label for=\"floatingInput\">Email address</label>\n</div>\n<div class=\"form-floating\">\n  <input type=\"password\" class=\"form-control\" id=\"floatingPassword\" placeholder=\"Password\">\n  <label for=\"floatingPassword\">Password</label>\n</div>","language":"html"},{"id":"example--paragraph-2","type":"paragraph","en":"When there’s a <code>value</code> already defined, <code>&lt;label&gt;</code>s will automatically adjust to their floated position."},{"id":"example--example-2","type":"demo","key":"83e3472af1628b6406d0","height":300,"anchors":["floatingInputValue"]},{"id":"example--code-2","type":"code","value":"<form class=\"form-floating\">\n  <input type=\"email\" class=\"form-control\" id=\"floatingInputValue\" placeholder=\"name@example.com\" value=\"test@example.com\">\n  <label for=\"floatingInputValue\">Input with value</label>\n</form>","language":"html"},{"id":"example--paragraph-3","type":"paragraph","en":"Form validation styles also work as expected."},{"id":"example--example-3","type":"demo","key":"4a85be5d13eac478b1b5","height":300,"anchors":["floatingInputInvalid"]},{"id":"example--code-3","type":"code","value":"<form class=\"form-floating\">\n  <input type=\"email\" class=\"form-control is-invalid\" id=\"floatingInputInvalid\" placeholder=\"name@example.com\" value=\"test@example.com\">\n  <label for=\"floatingInputInvalid\">Invalid input</label>\n</form>","language":"html"},{"id":"textareas","type":"heading","en":"Textareas","level":2},{"id":"textareas--paragraph-1","type":"paragraph","en":"By default, <code>&lt;textarea&gt;</code>s with <code>.form-control</code> will be the same height as <code>&lt;input&gt;</code>s."},{"id":"textareas--example-1","type":"demo","key":"808aaea5080f879da4ea","height":147,"anchors":["floatingTextarea"]},{"id":"textareas--code-1","type":"code","value":"<div class=\"form-floating\">\n  <textarea class=\"form-control\" placeholder=\"Leave a comment here\" id=\"floatingTextarea\"></textarea>\n  <label for=\"floatingTextarea\">Comments</label>\n</div>","language":"html"},{"id":"textareas--paragraph-2","type":"paragraph","en":"To set a custom height on your <code>&lt;textarea&gt;</code>, do not use the <code>rows</code> attribute. Instead, set an explicit <code>height</code> (either inline or via custom CSS)."},{"id":"textareas--example-2","type":"demo","key":"c0304582c00ced126ce6","height":147,"anchors":["floatingTextarea2"]},{"id":"textareas--code-2","type":"code","value":"<div class=\"form-floating\">\n  <textarea class=\"form-control\" placeholder=\"Leave a comment here\" id=\"floatingTextarea2\" style=\"height: 100px\"></textarea>\n  <label for=\"floatingTextarea2\">Comments</label>\n</div>","language":"html"},{"id":"selects","type":"heading","en":"Selects","level":2},{"id":"selects--paragraph-1","type":"paragraph","en":"Other than <code>.form-control</code>, floating labels are only available on <code>.form-select</code>s. They work in the same way, but unlike <code>&lt;input&gt;</code>s, they’ll always show the <code>&lt;label&gt;</code> in its floated state. <strong>Selects with <code>size</code> and <code>multiple</code> are not supported.</strong>"},{"id":"selects--example-1","type":"demo","key":"e9cf9ae01e18b46aacd5","height":147,"anchors":["floatingSelect"]},{"id":"selects--code-1","type":"code","value":"<div class=\"form-floating\">\n  <select class=\"form-select\" id=\"floatingSelect\" aria-label=\"Floating label select example\">\n    <option selected>Open this select menu</option>\n    <option value=\"1\">One</option>\n    <option value=\"2\">Two</option>\n    <option value=\"3\">Three</option>\n  </select>\n  <label for=\"floatingSelect\">Works with selects</label>\n</div>","language":"html"},{"id":"layout","type":"heading","en":"Layout","level":2},{"id":"layout--paragraph-1","type":"paragraph","en":"When working with the Bootstrap grid system, be sure to place form elements within column classes."},{"id":"layout--example-1","type":"demo","key":"b9cbc8f82a0d4b5c5655","height":147,"anchors":["floatingInputGrid","floatingSelectGrid"]},{"id":"layout--code-1","type":"code","value":"<div class=\"row g-2\">\n  <div class=\"col-md\">\n    <div class=\"form-floating\">\n      <input type=\"email\" class=\"form-control\" id=\"floatingInputGrid\" placeholder=\"name@example.com\" value=\"mdo@example.com\">\n      <label for=\"floatingInputGrid\">Email address</label>\n    </div>\n  </div>\n  <div class=\"col-md\">\n    <div class=\"form-floating\">\n      <select class=\"form-select\" id=\"floatingSelectGrid\" aria-label=\"Floating label select example\">\n        <option selected>Open this select menu</option>\n        <option value=\"1\">One</option>\n        <option value=\"2\">Two</option>\n        <option value=\"3\">Three</option>\n      </select>\n      <label for=\"floatingSelectGrid\">Works with selects</label>\n    </div>\n  </div>\n</div>","language":"html"},{"id":"sass","type":"heading","en":"Sass","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--code-1","type":"code","value":"$form-floating-height:            add(3.5rem, $input-height-border);\n$form-floating-line-height:       1.25;\n$form-floating-padding-x:         $input-padding-x;\n$form-floating-padding-y:         1rem;\n$form-floating-input-padding-t:   1.625rem;\n$form-floating-input-padding-b:   .625rem;\n$form-floating-label-opacity:     .65;\n$form-floating-label-transform:   scale(.85) translateY(-.5rem) translateX(.15rem);\n$form-floating-transition:        opacity .1s ease-in-out, transform .1s ease-in-out;","language":"scss"}],"demos":[{"key":"65b47001850e8131d6ba","html":"\n<div class=\"form-floating mb-3\">\n  <input type=\"email\" class=\"form-control\" id=\"floatingInput\" placeholder=\"name@example.com\">\n  <label for=\"floatingInput\">Email address</label>\n</div>\n<div class=\"form-floating\">\n  <input type=\"password\" class=\"form-control\" id=\"floatingPassword\" placeholder=\"Password\">\n  <label for=\"floatingPassword\">Password</label>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"83e3472af1628b6406d0","html":"\n<form class=\"form-floating\">\n  <input type=\"email\" class=\"form-control\" id=\"floatingInputValue\" placeholder=\"name@example.com\" value=\"test@example.com\">\n  <label for=\"floatingInputValue\">Input with value</label>\n</form>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"4a85be5d13eac478b1b5","html":"\n<form class=\"form-floating\">\n  <input type=\"email\" class=\"form-control is-invalid\" id=\"floatingInputInvalid\" placeholder=\"name@example.com\" value=\"test@example.com\">\n  <label for=\"floatingInputInvalid\">Invalid input</label>\n</form>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"808aaea5080f879da4ea","html":"\n<div class=\"form-floating\">\n  <textarea class=\"form-control\" placeholder=\"Leave a comment here\" id=\"floatingTextarea\"></textarea>\n  <label for=\"floatingTextarea\">Comments</label>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"c0304582c00ced126ce6","html":"\n<div class=\"form-floating\">\n  <textarea class=\"form-control\" placeholder=\"Leave a comment here\" id=\"floatingTextarea2\" style=\"height: 100px\"></textarea>\n  <label for=\"floatingTextarea2\">Comments</label>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"e9cf9ae01e18b46aacd5","html":"\n<div class=\"form-floating\">\n  <select class=\"form-select\" id=\"floatingSelect\" aria-label=\"Floating label select example\">\n    <option selected=\"\">Open this select menu</option>\n    <option value=\"1\">One</option>\n    <option value=\"2\">Two</option>\n    <option value=\"3\">Three</option>\n  </select>\n  <label for=\"floatingSelect\">Works with selects</label>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"b9cbc8f82a0d4b5c5655","html":"\n<div class=\"row g-2\">\n  <div class=\"col-md\">\n    <div class=\"form-floating\">\n      <input type=\"email\" class=\"form-control\" id=\"floatingInputGrid\" placeholder=\"name@example.com\" value=\"mdo@example.com\">\n      <label for=\"floatingInputGrid\">Email address</label>\n    </div>\n  </div>\n  <div class=\"col-md\">\n    <div class=\"form-floating\">\n      <select class=\"form-select\" id=\"floatingSelectGrid\" aria-label=\"Floating label select example\">\n        <option selected=\"\">Open this select menu</option>\n        <option value=\"1\">One</option>\n        <option value=\"2\">Two</option>\n        <option value=\"3\">Three</option>\n      </select>\n      <label for=\"floatingSelectGrid\">Works with selects</label>\n    </div>\n  </div>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs
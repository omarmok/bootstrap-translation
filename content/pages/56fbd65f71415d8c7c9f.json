{"route":"/docs/4.1/about/license/","version":"4.1","renderedVersion":"4.1","title":{"id":"content","type":"heading","en":"License FAQs","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Commonly asked questions about Bootstrap’s open source license."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"Bootstrap is released under the MIT license and is copyright 2018 Twitter. Boiled down to smaller chunks, it can be described with the following conditions."},{"id":"it-requires-you-to","type":"heading","en":"It requires you to:","level":4},{"id":"it-requires-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-requires-you-to--item-1","type":"item","en":"Keep the license and copyright notice included in Bootstrap’s CSS and JavaScript files when you use them in your works"}]}]},{"id":"it-permits-you-to","type":"heading","en":"It permits you to:","level":4},{"id":"it-permits-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-permits-you-to--item-1","type":"item","en":"Freely download and use Bootstrap, in whole or in part, for personal, private, company internal, or commercial purposes"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-2","type":"item","en":"Use Bootstrap in packages or distributions that you create"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-3","type":"item","en":"Modify the source code"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-4","type":"item","en":"Grant a sublicense to modify and distribute Bootstrap to third parties not included in the license"}]}]},{"id":"it-forbids-you-to","type":"heading","en":"It forbids you to:","level":4},{"id":"it-forbids-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-forbids-you-to--item-1","type":"item","en":"Hold the authors and license owners liable for damages as Bootstrap is provided without warranty"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-2","type":"ite
{"route":"/docs/6.0/utilities/width/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Width","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use width utilities to control the width of elements with responsive width classes."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".w-1"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"width: 1rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".w-2"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"width: 2rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".w-3"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"width: 3rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".w-4"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"width: 4rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".w-5"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"width: 5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".w-6"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"width: 6rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":".w-7"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"width: 7rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":".w-8"}]},{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"width: 8rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":".w-9"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"width: 9rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":".w-10"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"width: 10rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-24","type":"paragraph","en":".w-11"}]},{"type":"td","body":[{"id":"content--paragraph-25","type":"paragraph","en":"width: 11rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-26","type":"paragraph","en":".w-12"}]},{"type":"td","body":[{"id":"content--paragraph-27","type":"paragraph","en":"width: 12rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-28","type":"paragraph","en":".w-25"}]},{"type":"td","body":[{"id":"content--paragraph-29","type":"paragraph","en":"width: 25%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-30","type":"paragraph","en":".w-50"}]},{"type":"td","body":[{"id":"content--paragraph-31","type":"paragraph","en":"width: 50%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-32","type":"paragraph","en":".w-75"}]},{"type":"td","body":[{"id":"content--paragraph-33","type":"paragraph","en":"width: 75%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-34","type":"paragraph","en":".w-100"}]},{"type":"td","body":[{"id":"content--paragraph-35","type":"paragraph","en":"width: 100%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-36","type":"paragraph","en":".w-auto"}]},{"type":"td","body":[{"id":"content--paragraph-37","type":"paragraph","en":"width: auto;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-38","type":"paragraph","en":".w-min"}]},{"type":"td","body":[{"id":"content--paragraph-39","type":"paragraph","en":"width: min-content;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-40","type":"paragraph","en":".w-max"}]},{"type":"td","body":[{"id":"content--paragraph-41","type":"paragraph","en":"width: max-content;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-42","type":"paragraph","en":".w-fit"}]},{"type":"td","body":[{"id":"content--paragraph-43","type":"paragraph","en":"width: fit-content;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-44","type":"paragraph","en":".max-w-100"}]},{"type":"td","body":[{"id":"content--paragraph-45","type":"paragraph","en":"max-width: 100%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-46","type":"paragraph","en":".min-w-0"}]},{"type":"td","body":[{"id":"content--paragraph-47","type":"paragraph","en":"min-width: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-48","type":"paragraph","en":".min-w-100"}]},{"type":"td","body":[{"id":"content--paragraph-49","type":"paragraph","en":"min-width: 100%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-50","type":"paragraph","en":".vw-100"}]},{"type":"td","body":[{"id":"content--paragraph-51","type":"paragraph","en":"width: 100vw;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-52","type":"paragraph","en":".min-vw-100"}]},{"type":"td","body":[{"id":"content--paragraph-53","type":"paragraph","en":"min-width: 100vw;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-54","type":"paragraph","en":".dvw-100"}]},{"type":"td","body":[{"id":"content--paragraph-55","type":"paragraph","en":"width: 100dvw;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-56","type":"paragraph","en":".min-dvw-100"}]},{"type":"td","body":[{"id":"content--paragraph-57","type":"paragraph","en":"min-width: 100dvw;"}]}]}]},{"id":"content--paragraph-58","type":"paragraph","en":"Use width utilities to set the width of elements. Width utilities are generated from the utility API and include support for a preset scale, percentage values, intrinsic sizing keywords, and viewport units."},{"id":"width","type":"heading","en":"Width","level":2},{"id":"width--paragraph-1","type":"paragraph","en":"Set width using <code>.w-{size}</code> utilities for any size from <code>1</code> to <code>12</code>. These classes are generated from the utility API based on the <code>$sizes</code> map in <code>_config.scss</code>. Each number is a multiple of the <code>$spacer</code> variable, which defaults to <code>1rem</code>."},{"id":"width--example-1","type":"demo","key":"6fec45c8b27668999612","height":147},{"id":"width--code-1","type":"code","value":"<div class=\"d-flex flex-column gap-3\">\n  <div class=\"w-1\">…</div>\n  <div class=\"w-2\">…</div>\n  <div class=\"w-3\">…</div>\n  <div class=\"w-4\">…</div>\n  <div class=\"w-5\">…</div>\n  <div class=\"w-6\">…</div>\n  <div class=\"w-7\">…</div>\n  <div class=\"w-8\">…</div>\n  <div class=\"w-9\">…</div>\n  <div class=\"w-10\">…</div>\n  <div class=\"w-11\">…</div>\n  <div class=\"w-12\">…</div>\n</div>","language":""},{"id":"relative-width","type":"heading","en":"Relative width","level":2},{"id":"relative-width--paragraph-1","type":"paragraph","en":"Set width relative to the parent element using percentage-based utilities. Includes support for <code>25%</code>, <code>50%</code>, <code>75%</code>, <code>100%</code>, and <code>auto</code> by default."},{"id":"relative-width--example-1","type":"demo","key":"501e151b269508ffc8de","height":300},{"id":"relative-width--code-1","type":"code","value":"<div class=\"w-25 p-3\">Width 25%</div>\n<div class=\"w-50 p-3\">Width 50%</div>\n<div class=\"w-75 p-3\">Width 75%</div>\n<div class=\"w-100 p-3\">Width 100%</div>\n<div class=\"w-auto p-3\">Width auto</div>","language":""},{"id":"intrinsic-sizing","type":"heading","en":"Intrinsic sizing","level":2},{"id":"intrinsic-sizing--paragraph-1","type":"paragraph","en":"Use intrinsic sizing keywords to set width based on content."},{"id":"intrinsic-sizing--example-1","type":"demo","key":"2df0cc30e8ea9fc56d64","height":201},{"id":"intrinsic-sizing--code-1","type":"code","value":"<div class=\"w-min p-3\">Width min-content</div>\n<div class=\"w-max p-3\">Width max-content</div>\n<div class=\"w-fit p-3\">Width fit-content</div>","language":""},{"id":"max-width","type":"heading","en":"Max width","level":2},{"id":"max-width--paragraph-1","type":"paragraph","en":"Set maximum width using <code>max-width</code> utilities."},{"id":"max-width--example-1","type":"demo","key":"08827701f478790f5bf3","height":147},{"id":"max-width--code-1","type":"code","value":"<div style=\"width: 50%;\">\n  <div class=\"max-w-100\" style=\"width: 200%;\">Max-width 100%</div>\n</div>","language":""},{"id":"min-width","type":"heading","en":"Min width","level":2},{"id":"min-width--paragraph-1","type":"paragraph","en":"Set minimum width using <code>min-width</code> utilities."},{"id":"min-width--example-1","type":"demo","key":"c61785e6dc0f3f2b89b0","height":174},{"id":"min-width--code-1","type":"code","value":"<div class=\"min-w-0 p-3\" style=\"overflow: hidden;\">\n  <div style=\"width: 200px;\">This content is wider than the min-width: 0 container</div>\n</div>\n<div class=\"min-w-100 p-3\">Min-width 100%</div>","language":""},{"id":"viewport-width","type":"heading","en":"Viewport width","level":2},{"id":"viewport-width--paragraph-1","type":"paragraph","en":"Set width relative to the viewport using viewport units."},{"id":"viewport-width--code-1","type":"code","value":"<div class=\"vw-100\">Width 100vw</div>\n<div class=\"min-vw-100\">Min-width 100vw</div>","language":""},{"id":"viewport-width--note-1","type":"note","tone":"warning","body":[{"id":"viewport-width--note-text-1","type":"note-text","en":"<strong>Beware of the viewport width!</strong> CSS sizes <code>vw</code> as if the scrollbar does not exist. On a desktop browser that shows a classic scrollbar, <code>vw-100</code> is wider than the content area. The page then scrolls sideways. Use <code>w-100</code> to fill the parent element instead. See <a href=\"#dynamic-viewport-width\">dynamic viewport width</a>."}]},{"id":"dynamic-viewport-width","type":"heading","en":"Dynamic viewport width","level":2},{"id":"dynamic-viewport-width--paragraph-1","type":"paragraph","en":"The <code>vw</code> unit measures the large viewport width. The browser calculates that width as if every retractable browser interface is retracted. The value stays the same while the user scrolls."},{"id":"dynamic-viewport-width--paragraph-2","type":"paragraph","en":"The <code>dvw</code> unit measures the viewport width that the user sees now. The browser updates the value when it expands or retracts a browser interface. Use <code>dvw-100</code> and <code>min-dvw-100</code> when a browser interface changes the viewport width."},{"id":"dynamic-viewport-width--code-1","type":"code","value":"<div class=\"dvw-100\">Width 100dvw</div>\n<div class=\"min-dvw-100\">Min-width 100dvw</div>","language":""},{"id":"dynamic-viewport-width--paragraph-3","type":"paragraph","en":"Most browsers put the retractable interface at the top and the bottom of the screen. That interface changes the viewport height, not the viewport width. On these browsers, <code>dvw</code> and <code>vw</code> give you the same value. The <code>dvw</code> unit is therefore less useful than <a href=\"https://getbootstrap.com/docs/6.0/utilities/height#dynamic-viewport-height\"><code>dvh</code></a>. We ship it so that the width utilities match the height utilities."},{"id":"dynamic-viewport-width--note-1","type":"note","tone":"warning","body":[{"id":"dynamic-viewport-width--note-text-1","type":"note-text","en":"<strong><code>dvw</code> does not fix the scrollbar problem.</strong> CSS sizes every viewport width unit as if the scrollbar does not exist. The <code>dvw</code> unit gets the same treatment as the <code>vw</code> unit. To make the units respect the scrollbar, set <code>overflow: scroll</code> or <code>scrollbar-gutter: stable</code> on the root element."}]},{"id":"dynamic-viewport-width--note-2","type":"note","tone":"info","body":[{"id":"dynamic-viewport-width--note-text-2","type":"note-text","en":"<strong>Which unit do I use?</strong> Use <code>w-100</code> for a full-width layout. It fills the parent element, so the page does not scroll sideways. Use <code>dvw</code> when a browser interface changes the viewport width. Use <code>vw</code> when you need a width that does not change while the user scrolls."}]},{"id":"small-and-large-viewport-units","type":"heading","en":"Small and large viewport units","level":3},{"id":"small-and-large-viewport-units--paragraph-1","type":"paragraph","en":"CSS gives you two more viewport width units:"},{"id":"small-and-large-viewport-units--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"small-and-large-viewport-units--item-1","type":"item","en":"<code>svw</code> is the small viewport width. The browser calculates it as if every retractable browser interface is expanded."}]},{"tag":"li","body":[{"id":"small-and-large-viewport-units--item-2","type":"item","en":"<code>lvw</code> is the large viewport width. The browser calculates it as if every retractable browser interface is retracted. Current browsers give <code>vw</code> the same value."}]}]},{"id":"small-and-large-viewport-units--paragraph-2","type":"paragraph","en":"We do not ship utilities for <code>svw</code> and <code>lvw</code>, because most layouts need <code>w-100</code> or <code>dvw</code>. Add them with the <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#add-utilities\">utilities API</a>:"},{"id":"small-and-large-viewport-units--code-1","type":"code","value":"// my-bootstrap.scss\n@use \"bootstrap/scss/bootstrap\" with (\n  $utilities: (\n    \"small-viewport-width\": (\n      property: width,\n      class: svw,\n      values: (100: 100svw)\n    ),\n    \"min-small-viewport-width\": (\n      property: min-width,\n      class: min-svw,\n      values: (100: 100svw)\n    ),\n    \"large-viewport-width\": (\n      property: width,\n      class: lvw,\n      values: (100: 100lvw)\n    ),\n    \"min-large-viewport-width\": (\n      property: min-width,\n      class: min-lvw,\n      values: (100: 100lvw)\n    )\n  )\n);","language":""},{"id":"small-and-large-viewport-units--paragraph-3","type":"paragraph","en":"This adds <code>.svw-100</code>, <code>.min-svw-100</code>, <code>.lvw-100</code>, and <code>.min-lvw-100</code>."},{"id":"small-and-large-viewport-units--note-1","type":"note","tone":"info","body":[{"id":"small-and-large-viewport-units--note-text-1","type":"note-text","en":"Every browser that Bootstrap 6 supports has <code>dvw</code>, <code>svw</code>, and <code>lvw</code>. Read <a href=\"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices\">Browsers &amp; devices</a> for the full support policy."}]},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Width utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"width\": (\n  property: width,\n  class: w,\n  values: map.merge(\n    $sizes,\n    (\n      25: 25%,\n      50: 50%,\n      75: 75%,\n      100: 100%,\n      auto: auto,\n      min: min-content,\n      max: max-content,\n      fit: fit-content,\n    )\n  )\n),\n\"max-width\": (\n  property: max-width,\n  class: max-w,\n  values: (100: 100%)\n),\n\"min-width\": (\n  property: min-width,\n  class: min-w,\n  values: (\n    0: 0,\n    100: 100%\n  )\n),\n\"viewport-width\": (\n  property: width,\n  class: vw,\n  values: (100: 100vw)\n),\n\"min-viewport-width\": (\n  property: min-width,\n  class: min-vw,\n  values: (100: 100vw)\n),\n\"dynamic-viewport-width\": (\n  property: width,\n  class: dvw,\n  values: (100: 100dvw)\n),\n\"min-dynamic-viewport-width\": (\n  property: min-width,\n  class: min-dvw,\n  values: (100: 100dvw)\n),","language":""}],"demos":[{"key":"6fec45c8b27668999612","html":"<div class=\"w-12 p-3\">Width 12</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""},{"key":"501e151b269508ffc8de","html":"<div class=\"w-25 p-3\">Width 25%</div>\n<div class=\"w-50 p-3\">Width 50%</div>\n<div class=\"w-75 p-3\">Width 75%</div>\n<div class=\"w-100 p-3\">Width 100%</div>\n<div class=\"w-auto p-3\">Width auto</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""},{"key":"2df0cc30e8ea9fc56d64","html":"<div class=\"w-min p-3\">Width min-content</div>\n<div class=\"w-max p-3\">Width max-content</div>\n<div class=\"w-fit p-3\">Width fit-content</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""},{"key":"08827701f478790f5bf3","html":"<div style=\"width: 50%;\">\n  <div class=\"max-w-100\" style=\"width: 200%;\">Max-width 100%</div>\n</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""},{"key":"c61785e6dc0f3f2b89b0","html":"<div class=\"min-w-0 p-3\" style=\"overflow: hidden;\">\n  <div style=\"width: 200px;\">This content is wider than the min-width: 0 container</div>\n</div>\n<div class=\"min-w-100 p-3\">Min-width 100%</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"
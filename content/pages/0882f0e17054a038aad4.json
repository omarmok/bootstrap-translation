s/5.3/helpers/clearfix"},{"en":"Color & background","href":"https://getbootstrap.com/docs/5.3/helpers/color-background"},{"en":"Colored links","href":"https://getbootstrap.com/docs/5.3/helpers/colored-links"},{"en":"Focus ring","href":"https://getbootstrap.com/docs/5.3/helpers/focus-ring"},{"en":"Icon link","href":"https://getbootstrap.com/docs/5.3/helpers/icon-link"},{"en":"Position","href":"https://getbootstrap.com/docs/5.3/helpers/position"},{"en":"Ratio","href":"https://getbootstrap.com/docs/5.3/helpers/ratio"},{"en":"Stacks","href":"https://getbootstrap.com/docs/5.3/helpers/stacks"},{"en":"Stretched link","href":"https://getbootstrap.com/docs/5.3/helpers/stretched-link"},{"en":"Text truncation","href":"https://getbootstrap.com/docs/5.3/helpers/text-truncation"},{"en":"Vertical rule","href":"https://getbootstrap.com/docs/5.3/helpers/vertical-rule"},{"en":"Visually hidden","href":"https://getbootstrap.com/docs/5.3/helpers/visually-hidden"},{"en":"API","href":"https://getbootstrap.com/docs/5.3/utilities/api"},{"en":"Background","href":"https://getbootstrap.com/docs/5.3/utilities/background"},{"en":"Borders","href":"https://getbootstrap.com/docs/5.3/utilities/borders"},{"en":"Colors","href":"https://getbootstrap.com/docs/5.3/utilities/colors"},{"en":"Display","href":"https://getbootstrap.com/docs/5.3/utilities/display"},{"en":"Flex","href":"https://getbootstrap.com/docs/5.3/utilities/flex"},{"en":"Float","href":"https://getbootstrap.com/docs/5.3/utilities/float"},{"en":"Interactions","href":"https://getbootstrap.com/docs/5.3/utilities/interactions"},{"en":"Link","href":"https://getbootstrap.com/docs/5.3/utilities/link"},{"en":"Object fit","href":"https://getbootstrap.com/docs/5.3/utilities/object-fit"},{"en":"Opacity","href":"https://getbootstrap.com/docs/5.3/utilities/opacity"},{"en":"Overflow","href":"https://getbootstrap.com/docs/5.3/utilities/overflow"},{"en":"Position","href":"https://getbootstrap.com/docs/5.3/utilities/position"},{"en":"Shadows","href":"https://getbootstrap.com/docs/5.3/utilities/shadows"},{"en":"Sizing","href":"https://getbootstrap.com/docs/5.3/utilities/sizing"},{"en":"Spacing","href":"https://getbootstrap.com/docs/5.3/utilities/spacing"},{"en":"Text","href":"https://getbootstrap.com/docs/5.3/utilities/text"},{"en":"Vertical align","href":"https://getbootstrap.com/docs/5.3/utilities/vertical-align"},{"en":"Visibility","href":"https://getbootstrap.com/docs/5.3/utilities/visibility"},{"en":"Z-index","href":"https://getbootstrap.com/docs/5.3/utilities/z-index"},{"en":"Approach","href":"https://getbootstrap.com/docs/5.3/extend/approach"},{"en":"Icons","href":"https://getbootstrap.com/docs/5.3/extend/icons"},{"en":"Overview","href":"https://getbootstrap.com/docs/5.3/about/overview"},{"en":"Team","href":"https://getbootstrap.com/docs/5.3/about/team"},{"en":"Brand","href":"https://getbootstrap.com/docs/5.3/about/brand"},{"en":"License","href":"https://getbootstrap.com/docs/5.3/about/license"},{"en":"Translations","href":"https://getbootstrap.com/docs/5.3/about/translations"},{"en":"Migration","href":"https://getbootstrap.com/docs/5.3/migration/"}],"standalone":false,"publishedAssets":[{"url":"/docs/5.3/dist/css/bootstrap.min.css","integrity":"sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX"},{"url":"/docs/5.3/dist/js/bootstrap.bundle.min.js","integrity":"sha384-WyOxWvTyr1QaMPfiPJSv76iReVthorl5uWlFtZPyK0IEB0hGzo9y5Bp9mYanr8Bu"}],"sourceScripts":["https://getbootstrap.com/docs/5.3/assets/js/color-modes.js","https://cdn.usefathom.com/script.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom","https://getbootstrap.com/docs/5.3/assets/Code.astro_astro_type_script_index_0_lang.jwvOqc1M.js","https://getbootstrap.com/docs/5.3/dist/js/bootstrap.bundle.min.js","https://getbootstrap.com/docs/5.3/assets/Scripts.astro_astro_type_script_index_0_lang.D9qkKYrx.js","https://getbootstrap.com/docs/5.3/assets/DocsScripts.astro_astro_type_script_index_0_lang.DSSVDTqU.js"],"sourceStyles":["https://getbootstrap.com/docs/5.3/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/5.3/assets/_slug_.ZhhCqGDD.css"]}

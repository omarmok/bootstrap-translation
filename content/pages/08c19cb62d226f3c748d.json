m/docs/6.0/utilities/font-weight"},{"en":"Line height","href":"https://getbootstrap.com/docs/6.0/utilities/line-height"},{"en":"Link","href":"https://getbootstrap.com/docs/6.0/utilities/link"},{"en":"Text alignment","href":"https://getbootstrap.com/docs/6.0/utilities/text-alignment"},{"en":"Text decoration","href":"https://getbootstrap.com/docs/6.0/utilities/text-decoration"},{"en":"Text transform","href":"https://getbootstrap.com/docs/6.0/utilities/text-transform"},{"en":"Text wrapping","href":"https://getbootstrap.com/docs/6.0/utilities/text-wrapping"},{"en":"Vertical align","href":"https://getbootstrap.com/docs/6.0/utilities/vertical-align"},{"en":"Border","href":"https://getbootstrap.com/docs/6.0/utilities/border"},{"en":"Border color","href":"https://getbootstrap.com/docs/6.0/utilities/border-color"},{"en":"Border radius","href":"https://getbootstrap.com/docs/6.0/utilities/border-radius"},{"en":"Divide","href":"https://getbootstrap.com/docs/6.0/utilities/divide"},{"en":"Pointer events","href":"https://getbootstrap.com/docs/6.0/utilities/pointer-events"},{"en":"User select","href":"https://getbootstrap.com/docs/6.0/utilities/user-select"},{"en":"MotionNew (Added in v6.0.0)","href":"https://getbootstrap.com/docs/6.0/utilities/motion"},{"en":"Opacity","href":"https://getbootstrap.com/docs/6.0/utilities/opacity"},{"en":"Shadows","href":"https://getbootstrap.com/docs/6.0/utilities/shadows"}],"standalone":false,"publishedAssets":[],"sourceScripts":["https://getbootstrap.com/docs/6.0/assets/Navigation.astro_astro_type_script_index_0_lang.DDEt4Qt4.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://getbootstrap.com/docs/6.0/assets/Code.astro_astro_type_script_index_0_lang.C_kuDqMK.js","https://getbootstrap.com/docs/6.0/assets/Scripts.astro_astro_type_script_index_0_lang.G87Cecqi.js","https://getbootstrap.com/docs/6.0/assets/DocsScripts.astro_astro_type_script_index_0_lang.C1IgVFhS.js"],"sourceStyles":["https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap","https://getbootstrap.com/docs/6.0/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/6.0/assets/ScssProd.2L6G2bjf.css"]}

{"route":"/docs/6.0/utilities/colors/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Colors","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Convey meaning through <code>color</code> with a handful of color utility classes, including built-in color mode adaptivity and support for translucency."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".fg-primary"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"--bs-fg: var(--bs-primary-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".fg-accent"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"--bs-fg: var(--bs-accent-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".fg-success"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"--bs-fg: var(--bs-success-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".fg-danger"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"--bs-fg: var(--bs-danger-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".fg-warning"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"--bs-fg: var(--bs-warning-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".fg-info"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"--bs-fg: var(--bs-info-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":".fg-inverse"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"--bs-fg: var(--bs-inverse-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":".fg-secondary"}]},{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"--bs-fg: var(--bs-secondary-fg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":".fg-body"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"--bs-fg: var(--bs-fg-body);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":".fg-1"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"--bs-fg: var(--bs-fg-1);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-24","type":"paragraph","en":".fg-2"}]},{"type":"td","body":[{"id":"content--paragraph-25","type":"paragraph","en":"--bs-fg: var(--bs-fg-2);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-26","type":"paragraph","en":".fg-3"}]},{"type":"td","body":[{"id":"content--paragraph-27","type":"paragraph","en":"--bs-fg: var(--bs-fg-3);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-28","type":"paragraph","en":".fg-4"}]},{"type":"td","body":[{"id":"content--paragraph-29","type":"paragraph","en":"--bs-fg: var(--bs-fg-4);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-30","type":"paragraph","en":".fg-bg"}]},{"type":"td","body":[{"id":"content--paragraph-31","type":"paragraph","en":"--bs-fg: var(--bs-fg-bg);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-32","type":"paragraph","en":".fg-white"}]},{"type":"td","body":[{"id":"content--paragraph-33","type":"paragraph","en":"--bs-fg: var(--bs-fg-white);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-34","type":"paragraph","en":".fg-black"}]},{"type":"td","body":[{"id":"content--paragraph-35","type":"paragraph","en":"--bs-fg: var(--bs-fg-black);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-36","type":"paragraph","en":".fg-reset"}]},{"type":"td","body":[{"id":"content--paragraph-37","type":"paragraph","en":"--bs-fg: inherit;<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-38","type":"paragraph","en":".fg-emphasis-primary"}]},{"type":"td","body":[{"id":"content--paragraph-39","type":"paragraph","en":"--bs-fg: var(--bs-primary-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-40","type":"paragraph","en":".fg-emphasis-accent"}]},{"type":"td","body":[{"id":"content--paragraph-41","type":"paragraph","en":"--bs-fg: var(--bs-accent-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-42","type":"paragraph","en":".fg-emphasis-success"}]},{"type":"td","body":[{"id":"content--paragraph-43","type":"paragraph","en":"--bs-fg: var(--bs-success-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-44","type":"paragraph","en":".fg-emphasis-danger"}]},{"type":"td","body":[{"id":"content--paragraph-45","type":"paragraph","en":"--bs-fg: var(--bs-danger-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-46","type":"paragraph","en":".fg-emphasis-warning"}]},{"type":"td","body":[{"id":"content--paragraph-47","type":"paragraph","en":"--bs-fg: var(--bs-warning-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-48","type":"paragraph","en":".fg-emphasis-info"}]},{"type":"td","body":[{"id":"content--paragraph-49","type":"paragraph","en":"--bs-fg: var(--bs-info-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-50","type":"paragraph","en":".fg-emphasis-inverse"}]},{"type":"td","body":[{"id":"content--paragraph-51","type":"paragraph","en":"--bs-fg: var(--bs-inverse-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-52","type":"paragraph","en":".fg-emphasis-secondary"}]},{"type":"td","body":[{"id":"content--paragraph-53","type":"paragraph","en":"--bs-fg: var(--bs-secondary-fg-emphasis);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-54","type":"paragraph","en":".fg-10"}]},{"type":"td","body":[{"id":"content--paragraph-55","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 10%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-56","type":"paragraph","en":".fg-20"}]},{"type":"td","body":[{"id":"content--paragraph-57","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 20%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-58","type":"paragraph","en":".fg-30"}]},{"type":"td","body":[{"id":"content--paragraph-59","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 30%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-60","type":"paragraph","en":".fg-40"}]},{"type":"td","body":[{"id":"content--paragraph-61","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 40%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-62","type":"paragraph","en":".fg-50"}]},{"type":"td","body":[{"id":"content--paragraph-63","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 50%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-64","type":"paragraph","en":".fg-60"}]},{"type":"td","body":[{"id":"content--paragraph-65","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 60%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-66","type":"paragraph","en":".fg-70"}]},{"type":"td","body":[{"id":"content--paragraph-67","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 70%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-68","type":"paragraph","en":".fg-80"}]},{"type":"td","body":[{"id":"content--paragraph-69","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 80%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-70","type":"paragraph","en":".fg-90"}]},{"type":"td","body":[{"id":"content--paragraph-71","type":"paragraph","en":"color: color-mix(in oklch, var(--bs-fg) 90%, transparent);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-72","type":"paragraph","en":".fg-100"}]},{"type":"td","body":[{"id":"content--paragraph-73","type":"paragraph","en":"color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-74","type":"paragraph","en":".fg-contrast-primary"}]},{"type":"td","body":[{"id":"content--paragraph-75","type":"paragraph","en":"--bs-fg: var(--bs-primary-contrast);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-76","type":"paragraph","en":".fg-contrast-accent"}]},{"type":"td","body":[{"id":"content--paragraph-77","type":"paragraph","en":"--bs-fg: var(--bs-accent-contrast);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-78","type":"paragraph","en":".fg-contrast-success"}]},{"type":"td","body":[{"id":"content--paragraph-79","type":"paragraph","en":"--bs-fg: var(--bs-success-contrast);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-80","type":"paragraph","en":".fg-contrast-danger"}]},{"type":"td","body":[{"id":"content--paragraph-81","type":"paragraph","en":"--bs-fg: var(--bs-danger-contrast);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-82","type":"paragraph","en":".fg-contrast-warning"}]},{"type":"td","body":[{"id":"content--paragraph-83","type":"paragraph","en":"--bs-fg: var(--bs-warning-contrast);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-84","type":"paragraph","en":".fg-contrast-info"}]},{"type":"td","body":[{"id":"content--paragraph-85","type":"paragraph","en":"--bs-fg: var(--bs-info-contrast);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-86","type":"paragraph","en":".fg-contrast-inverse"}]},{"type":"td","body":[{"id":"content--paragraph-87","type":"paragraph","en":"--bs-fg: var(--bs-inverse-contrast);<br>color: var(--bs-fg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-88","type":"paragraph","en":".fg-contrast-secondary"}]},{"type":"td","body":[{"id":"content--paragraph-89","type":"paragraph","en":"--bs-fg: var(--bs-secondary-contrast);<br>color: var(--bs-fg);"}]}]}]},{"id":"content--caption-1","type":"caption","en":"Accessibility Tip: Using color to convey meaning"},{"id":"content--paragraph-90","type":"paragraph","en":"Using color to add meaning only provides a visual indication, which will not be conveyed to users of assistive technologies like screen readers. Please ensure the meaning is obvious from the content itself (e.g., the visible text with a <a href=\"https://getbootstrap.com/docs/6.0/getting-started/accessibility/#color-contrast\"><em>sufficient</em> color contrast</a>) or is included through alternative means, such as additional text hidden with the <code>.visually-hidden</code> class."},{"id":"colors","type":"heading","en":"Colors","level":2},{"id":"colors--paragraph-1","type":"paragraph","en":"Change the <code>color</code> using utilities built on our theme colors using <code>.fg-{color}</code> and <code>.fg-emphasis-{color}</code>. All these color utilities set the <code>color</code> property to a local CSS variable, <code>--bs-fg</code>, which has the value of the theme color. The root color tokens color values also use <code>light-dark()</code> to ensure sufficient contrast in both light and dark color modes."},{"id":"colors--paragraph-2","type":"paragraph","en":"For example, <code>.fg-primary</code> sets the <code>--bs-fg</code> variable to <code>var(--bs-primary-fg)</code>:"},{"id":"colors--code-1","type":"code","value":".fg-primary {\n  --bs-fg: var(--bs-primary-fg);\n  color: var(--bs-fg);\n}","language":""},{"id":"colors--paragraph-3","type":"paragraph","en":"This approach allows us to also easily support translucency with our <code>.fg-{opacity}</code> utilities as we can use <code>color-mix()</code> with the CSS variable to generate the appropriate color. See the <a href=\"#opacity\">opacity section</a> for more details."},{"id":"colors--paragraph-4","type":"paragraph","en":"If you want to colorize links, you can use the <a href=\"https://getbootstrap.com/docs/6.0/utilities/link\"><code>.link-{color}</code> utilities</a> which have <code>:hover</code> and <code>:focus</code> states."},{"id":"colors--example-1","type":"demo","key":"5b3255297dc4e6f6faca","height":300},{"id":"colors--code-2","type":"code","value":"<p class=\"fg-primary\">.fg-primary</p>\n<p class=\"fg-emphasis-primary\">.fg-emphasis-primary</p>\n<p class=\"fg-accent\">.fg-accent</p>\n<p class=\"fg-emphasis-accent\">.fg-emphasis-accent</p>\n<p class=\"fg-success\">.fg-success</p>\n<p class=\"fg-emphasis-success\">.fg-emphasis-success</p>\n<p class=\"fg-danger\">.fg-danger</p>\n<p class=\"fg-emphasis-danger\">.fg-emphasis-danger</p>\n<p class=\"fg-warning\">.fg-warning</p>\n<p class=\"fg-emphasis-warning\">.fg-emphasis-warning</p>\n<p class=\"fg-info\">.fg-info</p>\n<p class=\"fg-emphasis-info\">.fg-emphasis-info</p>\n<p class=\"fg-inverse\">.fg-inverse</p>\n<p class=\"fg-emphasis-inverse\">.fg-emphasis-inverse</p>\n<p class=\"fg-secondary\">.fg-secondary</p>\n<p class=\"fg-emphasis-secondary\">.fg-emphasis-secondary</p>\n\n<p class=\"fg-body\">.fg-body</p>\n<p class=\"fg-1\">.fg-1</p>\n<p class=\"fg-2\">.fg-2</p>\n<p class=\"fg-3\">.fg-3</p>\n<p class=\"fg-4\">.fg-4</p>\n\n<p class=\"fg-black bg-white\">.fg-black</p>\n<p class=\"fg-white bg-black\">.fg-white</p>","language":""},{"id":"opacity","type":"heading","en":"Opacity","level":2},{"id":"opacity--paragraph-1","type":"paragraph","en":"Change the opacity of a text color by using any of the <code>.fg-&lt;percentage&gt;</code> utilities which use <code>color-mix()</code> to mix the text color with <code>transparent</code> thanks to the CSS variable approach mentioned above."},{"id":"opacity--example-1","type":"demo","key":"2d489bd35685c6f0ce2c","height":300},{"id":"opacity--code-1","type":"code","value":"<div class=\"fg-primary\">This is default primary text</div>\n<div class=\"fg-primary fg-90\">This is 90% opacity primary text</div>\n<div class=\"fg-primary fg-80\">This is 80% opacity primary text</div>\n<div class=\"fg-primary fg-70\">This is 70% opacity primary text</div>\n<div class=\"fg-primary fg-60\">This is 60% opacity primary text</div>\n<div class=\"fg-primary fg-50\">This is 50% opacity primary text</div>\n<div class=\"fg-primary fg-40\">This is 40% opacity primary text</div>\n<div class=\"fg-primary fg-30\">This is 30% opacity primary text</div>\n<div class=\"fg-primary fg-20\">This is 20% opacity primary text</div>\n<div class=\"fg-primary fg-10\">This is 10% opacity primary text</div>","language":""},{"id":"contrast-colors","type":"heading","en":"Contrast colors","level":2},{"id":"contrast-colors--paragraph-1","type":"paragraph","en":"Change the contrast color of a text or link with <code>.fg-contrast-{color}</code>. This will set the <code>--bs-fg</code> variable to the theme’s <code>contrast</code> key color."},{"id":"contrast-colors--code-1","type":"code","value":".fg-contrast-primary {\n  --bs-fg: var(--bs-white);\n  color: var(--bs-fg);\n}","language":""},{"id":"contrast-colors--example-1","type":"demo","key":"43c0b2da3b98f22488f7","height":300},{"id":"contrast-colors--code-2","type":"code","value":"<p class=\"bg-primary fg-contrast-primary\">.fg-contrast-primary</p>\n<p class=\"bg-accent fg-contrast-accent\">.fg-contrast-accent</p>\n<p class=\"bg-success fg-contrast-success\">.fg-contrast-success</p>\n<p class=\"bg-danger fg-contrast-danger\">.fg-contrast-danger</p>\n<p class=\"bg-warning fg-contrast-warning\">.fg-contrast-warning</p>\n<p class=\"bg-info fg-contrast-info\">.fg-contrast-info</p>\n<p class=\"bg-inverse fg-contrast-inverse\">.fg-contrast-inverse</p>\n<p class=\"bg-secondary fg-contrast-secondary\">.fg-contrast-secondary</p>","language":""},{"id":"contrast-colors--paragraph-2","type":"paragraph","en":"These even mix with the opacity utilities."},{"id":"contrast-colors--example-2","type":"demo","key":"51245cbd3df1bf9898c0","height":300},{"id":"contrast-colors--code-3","type":"code","value":"<p class=\"bg-primary fg-contrast-primary fg-100\">.fg-contrast-primary fg-100</p>\n<p class=\"bg-primary fg-contrast-primary fg-90\">.fg-contrast-primary fg-90</p>\n<p class=\"bg-primary fg-contrast-primary fg-80\">.fg-contrast-primary fg-80</p>\n<p class=\"bg-primary fg-contrast-primary fg-70\">.fg-contrast-primary fg-70</p>\n<p class=\"bg-primary fg-contrast-primary fg-60\">.fg-contrast-primary fg-60</p>\n<p class=\"bg-primary fg-contrast-primary fg-50\">.fg-contrast-primary fg-50</p>\n<p class=\"bg-primary fg-contrast-primary fg-40\">.fg-contrast-primary fg-40</p>\n<p class=\"bg-primary fg-contrast-primary fg-30\">.fg-contrast-primary fg-30</p>\n<p class=\"bg-primary fg-contrast-primary fg-20\">.fg-contrast-primary fg-20</p>\n<p class=\"bg-primary fg-contrast-primary fg-10\">.fg-contrast-primary fg-10</p>","language":""},{"id":"reset-color","type":"heading","en":"Reset color","level":2},{"id":"reset-color--paragraph-1","type":"paragraph","en":"Reset a text or link’s color with <code>.fg-reset</code>, so that it inherits the color from its parent."},{"id":"reset-color--example-1","type":"demo","key":"c8a9231d17e1e1900fa6","height":147},{"id":"reset-color--code-1","type":"code","value":"<p class=\"fg-danger\">\n  Danger text with a <a href=\"#\">normal link</a> and a <a href=\"#\" class=\"fg-reset\">reset link</a>.\n</p>","language":""},{"id":"specificity","type":"heading","en":"Specificity","level":2},{"id":"specificity--paragraph-1","type":"paragraph","en":"Sometimes contextual classes cannot be applied due to the specificity of another selector. In some cases, a sufficient workaround is to wrap your element’s content in a <code>&lt;div&gt;</code> or more semantic element with the desired class."},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"css--paragraph-1","type":"paragraph","en":"In addition to the following Sass functionality, consider reading about our included <a href=\"https://getbootstrap.com/docs/6.0/getting-started/css-variables\">CSS custom properties</a> (aka CSS variables) for colors and more."},{"id":"sass-variables","type":"heading","en":"Sass variables","level":3},{"id":"sass-variables--paragraph-1","type":"paragraph","en":"Most <code>color</code> utilities are generated by our theme colors, reassigned from our generic color palette variables. Grayscale colors are also available, but only a subset are used to generate any utilities. See the <a href=\"https://getbootstrap.com/docs/6.0/customize/color\">Color</a> documentation for our base color variables and map."},{"id":"sass-maps","type":"heading","en":"Sass maps","level":3},{"id":"sass-maps--paragraph-1","type":"paragraph","en":"Theme colors are then put into a Sass map so we can loop over them to generate our utilities, component modifiers, and more. See the <a href=\"https://getbootstrap.com/docs/6.0/customize/theme\">Theme</a> documentation for the full <code>$theme-colors</code> Sass map."},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Color utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"fg\": (\n  property: (\n    \"--fg\": null,\n    \"color\": var(--fg)\n  ),\n  class: fg,\n  values: map.merge(\n    map.merge(theme-color-refs(\"fg\"), theme-token-refs($theme-fgs, \"fg\")),\n    (reset: inherit)\n  ),\n),\n\"fg-emphasis\": (\n  property: (\n    \"--fg\": null,\n    \"color\": var(--fg)\n  ),\n  class: fg-emphasis,\n  values: theme-color-refs(\"fg-emphasis\"),\n),\n\"fg-contrast\": (\n  property: (\n    \"--fg\": null,\n    \"color\": var(--fg)\n  ),\n  class: fg-contrast,\n  values: theme-color-refs(\"contrast\"),\n),\n\"fg-opacity\": (\n  class: fg,\n  property: color,\n  values: theme-opacity-values(--fg)\n),\n// scss-docs-end utils-color\n// scss-docs-start utils-links\n\"link-opacity\": (\n  property: color,\n  // css-var: true,\n  class: link,\n  state: hover,\n  values: theme-opacity-values(--link-color)\n),\n// scss-docs-end utils-links\n// scss-docs-start utils-underline\n\"underline-offset\": (\n  property: text-underline-offset,\n  class: underline-offset,\n  state: hover,\n  values: (\n    1: .125em,\n    2: .25em,\n    3: .375em,\n  )\n),\n\"underline-color\": (\n  property: (\n    \"--underline-color\": null,\n    \"text-decoration-color\": var(--underline-color)\n  ),\n  class: underline,\n  values: theme-color-values(\"fg\"),\n),\n\"underline-opacity\": (\n  property: text-decoration-color,\n  class: underline,\n  state: hover,\n  values: theme-opacity-values(--underline-color, currentcolor)\n),\n\"underline-thickness\": (\n  property: text-decoration-thickness,\n  class: underline-thickness,\n  state: hover,\n  values: (\n    1: 1px,\n    2: 2px,\n    3: 3px,\n    4: 4px,\n    5: 5px,\n  )\n),\n// scss-docs-end utils-underline\n// scss-docs-start utils-bg-color\n\"bg-color\": (\n  property: (\n    \"--bg\": null,\n    \"background-color\": var(--bg)\n  ),\n  class: bg,\n  values: map.merge(theme-color-refs(\"bg\"), theme-token-refs($theme-bgs, \"bg\")),\n),\n\"bg-color-subtle\": (\n  property: (\n    \"--bg\": null,\n    \"background-color\": var(--bg)\n  ),\n  class: bg-subtle,\n  values: theme-color-refs(\"bg-subtle\"),\n),\n\"bg-color-muted\": (\n  property: (\n    \"--bg\": null,\n    \"background-color\": var(--bg)\n  ),\n  class: bg-muted,\n  values: theme-color-refs(\"bg-muted\"),\n),\n\"bg-opacity\": (\n  class: bg,\n  property: background-color,\n  values: theme-opacity-values(--bg)\n),\n// scss-docs-end utils-bg-color\n// scss-docs-start utils-theme\n// Theme style utilities - pair with .theme-{color} to apply coordinated bg + text colors\n\"theme-contrast\": (\n  property: (\n    \"background-color\": var(--theme-bg),\n    \"color\": var(--theme-contrast)\n  ),\n  class: theme-contrast,\n  values: (null: null)\n),\n\"theme-subtle\": (\n  property: (\n    \"background-color\": var(--theme-bg-subtle),\n    \"color\": var(--theme-fg)\n  ),\n  class: theme-subtle,\n  values: (null: null)\n),\n\"theme-muted\": (\n  property: (\n    \"background-color\": var(--theme-bg-muted),\n    \"color\": var(--theme-fg-emphasis)\n  ),\n  class: theme-muted,\n  values: (null: null)\n),\n\"theme-border\": (\n  property: border,\n  class: theme-border,\n  values: (null: var(--border-width) solid var(--theme-border))\n),\n// scss-docs-end utils-theme\n\"gradient\": (\n  property: background-image,\n  class: bg,\n  values: (gradient: var(--gradient))\n),\n// scss-docs-start utils-color-scheme\n\"color-scheme\": (\n  property: color-scheme,\n  class: color-scheme,\n  values: (\n    light: light,\n    dark: dark,\n    auto: light dark,\n  )\n),","language":""}],"demos":[{"key":"5b3255297dc4e6f6faca","html":"<p class=\"fg-primary\">.fg-primary</p>\n<p class=\"fg-emphasis-primary\">.fg-emphasis-primary</p>\n<p class=\"fg-accent\">.fg-accent</p>\n<p class=\"fg-emphasis-accent\">.fg-emphasis-accent</p>\n<p class=\"fg-success\">.fg-success</p>\n<p class=\"fg-emphasis-success\">.fg-emphasis-success</p>\n<p class=\"fg-danger\">.fg-danger</p>\n<p class=\"fg-emphasis-danger\">.fg-emphasis-danger</p>\n<p class=\"fg-warning\">.fg-warning</p>\n<p class=\"fg-emphasis-warning\">.fg-emphasis-warning</p>\n<p class=\"fg-info\">.fg-info</p>\n<p class=\"fg-emphasis-info\">.fg-emphasis-info</p>\n<p class=\"fg-inverse\">.fg-inverse</p>\n<p class=\"fg-emphasis-inverse\">.fg-emphasis-inverse</p>\n<p class=\"fg-secondary\">.fg-secondary</p>\n<p class=\"fg-emphasis-secondary\">.fg-emphasis-secondary</p>\n\n<p class=\"fg-body\">.fg-body</p>\n<p class=\"fg-1\">.fg-1</p>\n<p class=\"fg-2\">.fg-2</p>\n<p class=\"fg-3\">.fg-3</p>\n<p class=\"fg-4\">.fg-4</p>\n\n<p class=\"fg-black bg-white\">.fg-black</p>\n<p class=\"fg-white bg-black\">.fg-white</p>","attrs":{"class":"bd-example"},"sprite":""},{"key":"2d489bd35685c6f0ce2c","html":"<div class=\"fg-primary\">This is default primary text</div>\n<div class=\"fg-primary fg-90\">This is 90% opacity primary text</div>\n<div class=\"fg-primary fg-80\">This is 80% opacity primary text</div>\n<div class=\"fg-primary fg-70\">This is 70% opacity primary text</div>\n<div class=\"fg-primary fg-60\">This is 60% opacity primary text</div>\n<div class=\"fg-primary fg-50\">This is 50% opacity primary text</div>\n<div class=\"f
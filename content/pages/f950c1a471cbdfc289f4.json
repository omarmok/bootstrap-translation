{"route":"/docs/4.4/components/input-group/","version":"4.4","renderedVersion":"4.4","title":{"id":"content","type":"heading","en":"Input group","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Easily extend form controls by adding text, buttons, or button groups on either side of textual inputs, custom selects, and custom file inputs."},"blocks":[{"id":"basic-example","type":"heading","en":"Basic example","level":2},{"id":"basic-example--paragraph-1","type":"paragraph","en":"Place one add-on or button on either side of an input. You may also place one on both sides of an input. Remember to place <code>&lt;label&gt;</code>s outside the input group."},{"id":"basic-example--example-1","type":"demo","key":"c314544d288035feaa88","height":300,"anchors":["basic-addon1","basic-addon2","basic-addon3","basic-url"]},{"id":"basic-example--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\" id=\"basic-addon1\">@</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" placeholder=\"Username\" aria-label=\"Username\" aria-describedby=\"basic-addon1\">\n</div>\n\n<div class=\"input-group mb-3\">\n  <input type=\"text\" class=\"form-control\" placeholder=\"Recipient's username\" aria-label=\"Recipient's username\" aria-describedby=\"basic-addon2\">\n  <div class=\"input-group-append\">\n    <span class=\"input-group-text\" id=\"basic-addon2\">@example.com</span>\n  </div>\n</div>\n\n<label for=\"basic-url\">Your vanity URL</label>\n<div class=\"input-group mb-3\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\" id=\"basic-addon3\">https://example.com/users/</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" id=\"basic-url\" aria-describedby=\"basic-addon3\">\n</div>\n\n<div class=\"input-group mb-3\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\">$</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Amount (to the nearest dollar)\">\n  <div class=\"input-group-append\">\n    <span class=\"input-group-text\">.00</span>\n  </div>\n</div>\n\n<div class=\"input-group\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\">With textarea</span>\n  </div>\n  <textarea class=\"form-control\" aria-label=\"With textarea\"></textarea>\n</div>","language":"html"},{"id":"wrapping","type":"heading","en":"Wrapping","level":2},{"id":"wrapping--paragraph-1","type":"paragraph","en":"Input groups wrap by default via <code>flex-wrap: wrap</code> in order to accommodate custom form field validation within an input group. You may disable this with <code>.flex-nowrap</code>."},{"id":"wrapping--example-1","type":"demo","key":"5b01308c3f6695ad93d8","height":147,"anchors":["addon-wrapping"]},{"id":"wrapping--code-1","type":"code","value":"<div class=\"input-group flex-nowrap\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\" id=\"addon-wrapping\">@</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" placeholder=\"Username\" aria-label=\"Username\" aria-describedby=\"addon-wrapping\">\n</div>","language":"html"},{"id":"sizing","type":"heading","en":"Sizing","level":2},{"id":"sizing--paragraph-1","type":"paragraph","en":"Add the relative form sizing classes to the <code>.input-group</code> itself and contents within will automatically resize—no need for repeating the form control size classes on each element."},{"id":"sizing--paragraph-2","type":"paragraph","en":"<strong>Sizing on the individual input group elements isn’t supported.</strong>"},{"id":"sizing--example-1","type":"demo","key":"a20789bbf492d68f68d9","height":201,"anchors":["inputGroup-sizing-sm","inputGroup-sizing-default","inputGroup-sizing-lg"]},{"id":"sizing--code-1","type":"code","value":"<div class=\"input-group input-group-sm mb-3\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\" id=\"inputGroup-sizing-sm\">Small</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Sizing example input\" aria-describedby=\"inputGroup-sizing-sm\">\n</div>\n\n<div class=\"input-group mb-3\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\" id=\"inputGroup-sizing-default\">Default</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Sizing example input\" aria-describedby=\"inputGroup-sizing-default\">\n</div>\n\n<div class=\"input-group input-group-lg\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\" id=\"inputGroup-sizing-lg\">Large</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Sizing example input\" aria-describedby=\"inputGroup-sizing-lg\">\n</div>","language":"html"},{"id":"checkboxes-and-radios","type":"heading","en":"Checkboxes and radios","level":2},{"id":"checkboxes-and-radios--paragraph-1","type":"paragraph","en":"Place any checkbox or radio option within an input group’s addon instead of text."},{"id":"checkboxes-and-radios--example-1","type":"demo","key":"6d4be062af5f5ef93656","height":174},{"id":"checkboxes-and-radios--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <div class=\"input-group-prepend\">\n    <div class=\"input-group-text\">\n      <input type=\"checkbox\" aria-label=\"Checkbox for following text input\">\n    </div>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with checkbox\">\n</div>\n\n<div class=\"input-group\">\n  <div class=\"input-group-prepend\">\n    <div class=\"input-group-text\">\n      <input type=\"radio\" aria-label=\"Radio button for following text input\">\n    </div>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with radio button\">\n</div>","language":"html"},{"id":"multiple-inputs","type":"heading","en":"Multiple inputs","level":2},{"id":"multiple-inputs--paragraph-1","type":"paragraph","en":"While multiple <code>&lt;input&gt;</code>s are supported visually, validation styles are only available for input groups with a single <code>&lt;input&gt;</code>."},{"id":"multiple-inputs--example-1","type":"demo","key":"45f716f4618e06aa662d","height":147},{"id":"multiple-inputs--code-1","type":"code","value":"<div class=\"input-group\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\">First and last name</span>\n  </div>\n  <input type=\"text\" aria-label=\"First name\" class=\"form-control\">\n  <input type=\"text\" aria-label=\"Last name\" class=\"form-control\">\n</div>","language":"html"},{"id":"multiple-addons","type":"heading","en":"Multiple addons","level":2},{"id":"multiple-addons--paragraph-1","type":"paragraph","en":"Multiple add-ons are supported and can be mixed with checkbox and radio input versions."},{"id":"multiple-addons--example-1","type":"demo","key":"99cab80e5ecfdf712c33","height":174},{"id":"multiple-addons--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <div class=\"input-group-prepend\">\n    <span class=\"input-group-text\">$</span>\n    <span class=\"input-group-text\">0.00</span>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Dollar amount (with dot and two decimal places)\">\n</div>\n\n<div class=\"input-group\">\n  <input type=\"text\" class=\"form-control\" aria-label=\"Dollar amount (with dot and two decimal places)\">\n  <div class=\"input-group-append\">\n    <span class=\"input-group-text\">$</span>\n    <span class=\"input-group-text\">0.00</span>\n  </div>\n</div>","language":"html"},{"id":"button-addons","type":"heading","en":"Button addons","level":2},{"id":"button-addons--example-1","type":"demo","key":"2c1ba3e175f509107549","height":228,"anchors":["button-addon1","button-addon2","button-addon3","button-addon4"]},{"id":"button-addons--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <div class=\"input-group-prepend\">\n    <button class=\"btn btn-outline
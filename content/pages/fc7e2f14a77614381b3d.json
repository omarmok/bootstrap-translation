{"route":"/docs/5.0/customize/options/","version":"5.0","renderedVersion":"5.0","title":{"id":"content","type":"heading","en":"Options","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Quickly customize Bootstrap with built-in variables to easily toggle global CSS preferences for controlling style and behavior."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"Customize Bootstrap with our built-in custom variables file and easily toggle global CSS preferences with new <code>$enable-*</code> Sass variables. Override a variable’s value and recompile with <code>npm run test</code> as needed."},{"id":"content--paragraph-3","type":"paragraph","en":"You can find and customize these variables for key global options in Bootstrap’s <code>scss/_variables.scss</code> file."},{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"content--paragraph-4","type":"paragraph","en":"Variable"}]},{"type":"th","body":[{"id":"content--paragraph-5","type":"paragraph","en":"Values"}]},{"type":"th","body":[{"id":"content--paragraph-6","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"<code>$spacer</code>"}]},{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":"<code>1rem</code> (default), or any value &gt; 0"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"Specifies the default spacer value to programmatically generate our <a href=\"https://getbootstrap.com/docs/5.0/utilities/spacing/\">spacer utilities</a>."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":"<code>$enable-rounded</code>"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":"Enables predefined <code>border-radius</code> styles on various components."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"<code>$enable-shadows</code>"}]},{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":"<code>true</code> or <code>false</code> (default)"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"Enables predefined decorative <code>box-shadow</code> styles on various components. Does not affect <code>box-shadow</code>s used for focus states."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":"<code>$enable-gradients</code>"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"<code>true</code> or <code>false</code> (default)"}]},{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":"Enables predefined gradients via <code>background-image</code> styles on various components."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"<code>$enable-transitions</code>"}]},{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"Enables predefined <code>transition</code>s on various components."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":"<code>$enable-reduced-motion</code>"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-24","type":"paragraph","en":"Enables the <a href=\"https://getbootstrap.com/docs/5.0/getting-started/accessibility/#reduced-motion\"><code>prefers-reduced-motion</code> media query</a>, which suppresses certain animations/transitions based on the users&#39; browser/operating system preferences."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-25","type":"paragraph","en":"<code>$enable-grid-classes</code>"}]},{"type":"td","body":[{"id":"content--paragraph-26","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-27","type":"paragraph","en":"Enables the generation of CSS classes for the grid system (e.g. <code>.row</code>, <code>.col-md-1</code>, etc.)."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-28","type":"paragraph","en":"<code>$enable-caret</code>"}]},{"type":"td","body":[{"id":"content--paragraph-29","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-30","type":"paragraph","en":"Enables pseudo element caret on <code>.dropdown-toggle</code>."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-31","type":"paragraph","en":"<code>$enable-button-pointers</code>"}]},{"type":"td","body":[{"id":"content--paragraph-32","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-33","type":"paragraph","en":"Add “hand” cursor to non-disabled button elements."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-34","type":"paragraph","en":"<code>$enable-rfs</code>"}]},{"type":"td","body":[{"id":"content--paragraph-35","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-36","type":"paragraph","en":"Globally enables <a href=\"https://getbootstrap.com/docs/5.0/getting-started/rfs/\">RFS</a>."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-37","type":"paragraph","en":"<code>$enable-validation-icons</code>"}]},{"type":"td","body":[{"id":"content--paragraph-38","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-39","type":"paragraph","en":"Enables <code>background-image</code> icons within textual inputs and some custom forms for validation states."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-40","type":"paragraph","en":"<code>$enable-negative-margins</code>"}]},{"type":"td","body":[{"id":"content--paragraph-41","type":"paragraph","en":"<code>true</code> or <code>false</code> (default)"}]},{"type":"td","body":[{"id":"content--paragraph-42","type":"paragraph","en":"Enables the generation of <a href=\"https://getbootstrap.com/docs/5.0/utilities/spacing/#negative-margin\">negative margin utilities</a>."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-43","type":"paragraph","en":"<code>$enable-deprecation-messages</code>"}]},{"type":"td","body":[{"id":"content--paragraph-44","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-45","type":"paragraph","en":"Set to <code>false</code> to hide warnings when using any of the deprecated mixins and functions that are planned to be removed in <code>v6</code>."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-46","type":"paragraph","en":"<code>$enable-important-utilities</code>"}]},{"type":"td","body":[{"id":"content--paragraph-47","type":"paragraph","en":"<code>true</code> (default) or <code>false</code>"}]},{"type":"td","body":[{"id":"content--paragraph-48","type":"paragraph","en":"Enables the <code>!important</code> suffix in utility classes."}]}]}]}],"demos":[],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.0/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/5.0/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.0/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/5.0/getting-started/browser
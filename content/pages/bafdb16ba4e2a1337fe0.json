{"route":"/2.0.2/scaffolding.html","version":"2.0.2","renderedVersion":"2.0.2","title":{"id":"scaffolding","type":"heading","en":"Scaffolding","level":1,"anchors":["overview"]},"lead":{"id":"scaffolding--paragraph-1","type":"paragraph","en":"Bootstrap is built on a responsive 12-column grid. We&#39;ve also included fixed- and fluid-width layouts based on that system."},"blocks":[{"id":"scaffolding--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"scaffolding--item-1","type":"item","en":"<a href=\"#global\">Global styles</a>"}]},{"tag":"li","body":[{"id":"scaffolding--item-2","type":"item","en":"<a href=\"#gridSystem\">Grid system</a>"}]},{"tag":"li","body":[{"id":"scaffolding--item-3","type":"item","en":"<a href=\"#fluidGridSystem\">Fluid grid system</a>"}]},{"tag":"li","body":[{"id":"scaffolding--item-4","type":"item","en":"<a href=\"#gridCustomization\">Customizing</a>"}]},{"tag":"li","body":[{"id":"scaffolding--item-5","type":"item","en":"<a href=\"#layouts\">Layouts</a>"}]},{"tag":"li","body":[{"id":"scaffolding--item-6","type":"item","en":"<a href=\"#responsive\">Responsive design</a>"}]}]},{"id":"global-styles-for-css-reset-typography-and-links","type":"heading","en":"Global styles <small>for CSS reset, typography, and links</small>","level":1,"anchors":["global"]},{"id":"requires-html5-doctype","type":"heading","en":"Requires HTML5 doctype","level":2},{"id":"requires-html5-doctype--paragraph-1","type":"paragraph","en":"Bootstrap makes use of HTML elements and CSS properties that require the use of the HTML5 doctype. Be sure to include it at the beginning of every Bootstrapped page in your project."},{"id":"requires-html5-doctype--code-1","type":"code","value":"<!DOCTYPE html>\n<html lang=\"en\">\n  ...\n</html>","language":""},{"id":"typography-and-links","type":"heading","en":"Typography and links","level":2},{"id":"typography-and-links--paragraph-1","type":"paragraph","en":"Within the <strong>scaffolding.less</strong> file, we set basic global display, typography, and link styles. Specifically, we:"},{"id":"typography-and-links--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"typography-and-links--item-1","type":"item","en":"Remove margin on the body"}]},{"tag":"li","body":[{"id":"typography-and-links--item-2","type":"item","en":"Set <code>background-color: white;</code> on the <code>body</code>"}]},{"tag":"li","body":[{"id":"typography-and-links--item-3","type":"item","en":"Use the <code>@baseFontFamily</code>, <code>@baseFontSize</code>, and <code>@baseLineHeight</code> attributes as our typographyic base"}]},{"tag":"li","body":[{"id":"typography-and-links--item-4","type":"item","en":"Set the global link color via <code>@linkColor</code> and apply link underlines only on <code>:hover</code>"}]}]},{"id":"reset-via-normalize","type":"heading","en":"Reset via Normalize","level":2},{"id":"reset-via-normalize--paragraph-1","type":"paragraph","en":"As of Bootstrap 2, the traditional CSS reset has evolved to make use of elements from <a href=\"https://necolas.github.io/normalize.css/\">Normalize.css</a>, a project by <a href=\"https://twitter.com/necolas\">Nicolas Gallagher</a> that also powers the <a href=\"https://html5boilerplate.com/\">HTML5 Boilerplate</a>."},{"id":"reset-via-normalize--paragraph-2","type":"paragraph","en":"The new reset can still be found in <strong>reset.less</strong>, but with many elements removed for brevity and accuracy."},{"id":"default-grid-system-12-columns-with-a-responsive-twist","type":"heading","en":"Default grid system <small>12 columns with a responsive twist</small>","level":1,"anchors":["gridSystem"]},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-1","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-2","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-3","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-4","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-5","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-6","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-7","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-8","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-9","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-10","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-11","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-12","type":"paragraph","en":"1"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-13","type":"paragraph","en":"4"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-14","type":"paragraph","en":"4"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-15","type":"paragraph","en":"4"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-16","type":"paragraph","en":"4"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-17","type":"paragraph","en":"8"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-18","type":"paragraph","en":"6"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-19","type":"paragraph","en":"6"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-20","type":"paragraph","en":"12"},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-21","type":"paragraph","en":"The default grid system provided as part of Bootstrap is a <strong>940px-wide, 12-column grid</strong>."},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-22","type":"paragraph","en":"It also has four responsive variations for various devices and resolutions: phone, tablet portrait, table landscape and small desktops, and large widescreen desktops."},{"id":"default-grid-system-12-columns-with-a-responsive-twist--code-1","type":"code","value":"<div class=\"row\">\n  <div class=\"span4\">...</div>\n  <div class=\"span8\">...</div>\n</div>","language":""},{"id":"default-grid-system-12-columns-with-a-responsive-twist--paragraph-23","type":"paragraph","en":"As shown here, a basic layout can be created with two &quot;columns,&quot; each spanning a number of the 12 foundational columns we defined as part of our grid system."},{"id":"offsetting-columns","type":"heading","en":"Offsetting columns","level":2},{"id":"offsetting-columns--paragraph-1","type":"paragraph","en":"4"},{"id":"offsetting-columns--paragraph-2","type":"paragraph","en":"4 offset 4"},{"id":"offsetting-columns--paragraph-3","type":"paragraph","en":"3 offset 3"},{"id":"offsetting-columns--paragraph-4","type":"paragraph","en":"3 offset 3"},{"id":"offsetting-columns--paragraph-5","type":"paragraph","en":"8 offset 4"},{"id":"offsetting-columns--code-1","type":"code","value":"<div class=\"row\">\n  <div class=\"span4\">...</div>\n  <div class=\"span4 offset4\">...</div>\n</div>","language":""},{"id":"nesting-columns","type":"heading","en":"Nesting columns","level":2},{"id":"nesting-columns--paragraph-1","type":"paragraph","en":"With the static (non-fluid) grid system in Bootstrap, nesting is easy. To nest your content, just add a new <code>.row</code> and set of <code>.span*</code> columns within an existing <code>.span*</code> column."},{"id":"example","type":"heading","en":"Example","level":3},{"id":"example--paragraph-1","type":"paragraph","en":"Nested rows should include a set of columns that add up to the number of columns of it&#39;s parent. For example, two nested <code>.span3</code> columns should be placed within a <code>.span6</code>."},{"id":"example--paragraph-2","type":"paragraph","en":"Level 1 of column"},{"id":"example--paragraph-3","type":"paragraph","en":"Level 2"},{"id":"example--paragraph-4","type":"paragraph","en":"Level 2"},{"id":"example--code-1","type":"code","value":"<div class=\"row\">\n  <div class=\"span12\">\n    Level 1 of column\n    <div class=\"row\">\n      <div class=\"span6\">Level 2</div>\n      <div class=\"span6\">Level 2</div>\n    </div>\n  </div>\n</div>","language":""},{"id":"fluid-grid-system-12-responsive-percent-based-columns","type":"heading","en":"Fluid grid system <small>12 responsive, percent-based columns</small>","level":1,"anchors":["fluidGridSystem"]},{"id":"fluid-columns","type":"heading","en":"Fluid columns","level":2},{"id":"fluid-columns--paragraph-1","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-2","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-3","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-4","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-5","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-6","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-7","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-8","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-9","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-10","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-11","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-12","type":"paragraph","en":"1"},{"id":"fluid-columns--paragraph-13","type":"paragraph","en":"4"},{"id":"fluid-columns--paragraph-14","type":"paragraph","en":"4"},{"id":"fluid-columns--paragraph-15","type":"paragraph","en":"4"},{"id":"fluid-columns--paragraph-16","type":"paragraph","en":"4"},{"id":"fluid-columns--paragraph-17","type":"paragraph","en":"8"},{"id":"fluid-columns--paragraph-18","type":"paragraph","en":"6"},{"id":"fluid-columns--paragraph-19","type":"paragraph","en":"6"},{"id":"fluid-columns--paragraph-20","type":"paragraph","en":"12"},{"id":"percents-not-pixels","type":"heading","en":"Percents, not pixels","level":3},{"id":"percents-not-pixels--paragraph-1","type":"paragraph","en":"The fluid grid system uses percents for column widths instead of fixed pixels. It also has the same responsive variations as our fixed grid system, ensuring proper proportions for key screen resolutions and devices."},{"id":"fluid-rows","type":"heading","en":"Fluid rows","level":3},{"id":"fluid-rows--paragraph-1","type":"paragraph","en":"Make any row fluid simply by changing <code>.row</code> to <code>.row-fluid</code>. The columns stay the exact same, making it super straightforward to flip between fixed and fluid layouts."},{"id":"markup","type":"heading","en":"Markup","level":3},{"id":"markup--code-1","type":"code","value":"<div class=\"row-fluid\">\n  <div class=\"span4\">...</div>\n  <div class=\"span8\">...</div>\n</div>","language":""},{"id":"fluid-nesting","type":"heading","en":"Fluid nesting","level":2},{"id":"fluid-nesting--paragraph-1","type":"paragraph","en":"Nesting with fluid grids is a bit different: the number of nested columns doesn&#39;t need to match the parent. Instead, your columns are reset at each level because each row takes up 100% of the parent column."},{"id":"fluid-nesting--paragraph-2","type":"paragraph","en":"Fluid 12"},{"id":"fluid-nesting--paragraph-3","type":"paragraph","en":"Fluid 6"},{"id":"fluid-nesting--paragraph-4","type":"paragraph","en":"Fluid 6"},{"id":"fluid-nesting--code-1","type":"code","value":"<div class=\"row-fluid\">\n  <div class=\"span12\">\n    Level 1 of column\n    <div class=\"row-fluid\">\n      <div class=\"span6\">Level 2</div>\n      <div class=\"span6\">Level 2</div>\n    </div>\n  </div>\n</div>","language":""},{"id":"grid-customization","type":"heading","en":"Grid customization","level":1,"anchors":["gridCustomization"]},{"id":"grid-customization--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"grid-customization--paragraph-1","type":"paragraph","en":"Variable"}]},{"type":"th","body":[{"id":"grid-customization--paragraph-2","type":"paragraph","en":"Default value"}]},{"type":"th","body":[{"id":"grid-customization--paragraph-3","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"grid-customization--paragraph-4","type":"paragraph","en":"<code>@gridColumns</code>"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-5","type":"paragraph","en":"12"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-6","type":"paragraph","en":"Number of columns"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"grid-customization--paragraph-7","type":"paragraph","en":"<code>@gridColumnWidth</code>"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-8","type":"paragraph","en":"60px"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-9","type":"paragraph","en":"Width of each column"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"grid-customization--paragraph-10","type":"paragraph","en":"<code>@gridGutterWidth</code>"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-11","type":"paragraph","en":"20px"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-12","type":"paragraph","en":"Negative space between columns"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"grid-customization--paragraph-13","type":"paragraph","en":"<code>@siteWidth</code>"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-14","type":"paragraph","en":"<em>Computed sum of all columns and gutters</em>"}]},{"type":"td","body":[{"id":"grid-customization--paragraph-15","type":"paragraph","en":"Counts number of columns and gutters to set width of the <code>.container-fixed()</code> mixin"}]}]}]},{"id":"variables-in-less","type":"heading","en":"Variables in LESS","level":3},{"id":"variables-in-less--paragraph-1","type":"paragraph","en":"Built into Bootstrap are a handful of variables for customizing the default 940px grid system, documented above. All variables for the grid are stored in variables.less."},{"id":"how-to-customize","type":"heading","en":"How to customize","level":3},{"id":"how-to-customize--paragraph-1","type":"paragraph","en":"Modifying the grid means changing the three <code>@grid*</code> variables and recompiling Bootstrap. Change the grid variables in variables.less and use one of the <a href=\"https://getbootstrap.com/2.0.2/less.html#compiling\">four ways documented to recompile</a>. If you&#39;re adding more columns, be sure to add the CSS for those in grid.less."},{"id":"staying-responsive","type":"heading","en":"Staying responsive","level":3},{"id":"staying-responsive--paragraph-1","type":"paragraph","en":"Customization of the grid only works at the default level, the 940px grid. To maintain the responsive aspects of Bootstrap, you&#39;ll also have to customize the grids in responsive.less."},{"id":"layouts-basic-templates-to-create-webpages","type":"heading","en":"Layouts <small>Basic templates to create webpages</small>","level":1,"anchors":["layouts"]},{"id":"fixed-layout","type":"heading","en":"Fixed layout","level":2},{"id":"fixed-layout--paragraph-1","type":"paragraph","en":"The default and simple 940px-wide, centered layout for just about any website or page provided by a single <code>&lt;div class=&quot;container&quot;&gt;</code>."},{"id":"fixed-layout--code-1","type":"code","value":"<body>\n  <div class=\"container\">\n    ...\n  </div>\n</body>","language":""},{"id":"fluid-layout","type":"heading","en":"Fluid layout","level":2},{"id":"fluid-layout--paragraph-1","type":"paragraph","en":"<code>&lt;div class=&quot;container-fluid&quot;&gt;</code> gives flexible page structure, min- and max-widths, and a left-hand sidebar. It&#39;s great for apps and docs."},{"id":"fluid-layout--code-1","type":"code","value":"<div class=\"container-fluid\">\n  <div class=\"row-fluid\">\n    <div class=\"span2\">\n      <!--Sidebar content-->\n    </div>\n    <div class=\"span10\">\n      <!--Body content-->\n    </div>\n  </div>\n</div>","language":""},{"id":"responsive-design-media-queries-for-various-devices-and-resolutions","type":"heading","en":"Responsive design <small>Media queries for various devices and resolutions</small>","level":1,"anchors":["responsive"]},{"id":"responsive-design-media-queries-for-various-devices-and-resolutions--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.2/assets/img/responsive-illustrations.png\" alt=\"Responsive devices\" loading=\"lazy\">"},{"id":"what-they-do","type":"heading","en":"What they do","level":3},{"id":"what-they-do--paragraph-1","type":"paragraph","en":"Media queries allow for custom CSS based on a number of conditions—ratios, widths, display type, etc—but usually focuses around <code>min-width</code> and <code>max-width</code>."},{"id":"what-they-do--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"what-they-do--item-1","type":"item","en":"Modify the width of column in our grid"}]},{"tag":"li","body":[{"id":"what-they-do--item-2","type":"item","en":"Stack elements instead of float wherever necessary"}]},{"tag":"li","body":[{"id":"what-they-do--item-3","type":"item","en":"Resize headings and text to be more appropriate for devices"}]}]},{"id":"what-they-do--paragraph-2","type":"paragraph","en":"Use media queries responsibly and only as a start to your mobile audiences. For larger projects, do consider dedicated code bases and not layers of media queries."},{"id":"supported-devices","type":"heading","en":"Supported devices","level":2},{"id":"supported-devices--paragraph-1","type":"paragraph","en":"Bootstrap supports a handful of media queries in a single file to help make your projects more appropriate on different devices and screen resolutions. Here&#39;s what&#39;s included:"},{"id":"supported-devices--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"supported-devices--paragraph-2","type":"paragraph","en":"Label"}]},{"type":"th","body":[{"id":"supported-devices--paragraph-3","type":"paragraph","en":"Layout width"}]},{"type":"th","body":[{"id":"supported-devices--paragraph-4","type":"paragraph","en":"Column width"}]},{"type":"th","body":[{"id":"supported-devices--paragraph-5","type":"paragraph","en":"Gutter width"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"supported-devices--paragraph-6","type":"paragraph","en":"Smartphones"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-7","type":"paragraph","en":"480px and below"}]},{"type":"td","span":"2","body":[{"id":"supported-devices--paragraph-8","type":"paragraph","en":"Fluid columns, no fixed widths"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"supported-devices--paragraph-9","type":"paragraph","en":"Smartphones to tablets"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-10","type":"paragraph","en":"767px and below"}]},{"type":"td","span":"2","body":[{"id":"supported-devices--paragraph-11","type":"paragraph","en":"Fluid columns, no fixed widths"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"supported-devices--paragraph-12","type":"paragraph","en":"Portrait tablets"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-13","type":"paragraph","en":"768px and above"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-14","type":"paragraph","en":"42px"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-15","type":"paragraph","en":"20px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"supported-devices--paragraph-16","type":"paragraph","en":"Default"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-17","type":"paragraph","en":"980px and up"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-18","type":"paragraph","en":"60px"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-19","type":"paragraph","en":"20px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"supported-devices--paragraph-20","type":"paragraph","en":"Large display"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-21","type":"paragraph","en":"1200px and up"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-22","type":"paragraph","en":"70px"}]},{"type":"td","body":[{"id":"supported-devices--paragraph-23","type":"paragraph","en":"30px"}]}]}]},{"id":"requires-meta-tag","type":"heading","en":"Requires meta tag","level":3},{"id":"requires-meta-tag--paragraph-1","type":"paragraph","en":"To ensure devices display responsive pages properly, include the viewport meta tag."},{"id":"requires-meta-tag--code-1","type":"code","value":"<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">","language":""},{"id":"using-the-media-queries","type":"heading","en":"Using the media queries","level":2},{"id":"using-the-media-queries--paragraph-1","type":"paragraph","en":"Bootstrap doesn&#39;t automatically include these media queries, but understanding and adding them is very easy and requires minimal setup. You have a few options for including the responsive features of Bootstrap:"},{"id":"using-the-media-queries--list-1","type":"list","tag":"ol","items":[{"tag":"li","body":[{"id":"using-the-media-queries--item-1","type":"item","en":"Use the compiled responsive version, bootstrap-responsive.css"}]},{"tag":"li","body":[{"id":"using-the-media-queries--item-2","type":"item","en":"Add @import &quot;responsive.less&quot; and recompile Bootstrap"}]},{"tag":"li","body":[{"id":"using-the-media-queries--item-3","type":"item","en":"Modify and recompile responsive.less as a separate file"}]}]},{"id":"using-the-media-queries--paragraph-2","type":"paragraph","en":"<strong>Why not just include it?</strong> Truth be told, not everything needs to be responsive. Instead of encouraging developers to remove this feature, we figure it best to enable it."},{"id":"using-the-media-queries--code-1","type":"code","value":"  // Landscape phones and down\n  @media (max-width: 480px) { ... }\n\n  // Landscape phone to portrait tablet\n  @media (max-width: 768px) { ... }\n\n  // Portrait tablet to landscape and desktop\n  @media (min-width: 768px) and (max-width: 980px) { ... }\n\n  // Large desktop\n  @media (min-width: 1200px) { .. }","language":""},{"id":"responsive-utility-classes","type":"heading","en":"Responsive utility classes","level":2},{"id":"what-are-they","type":"heading","en":"What are they","level":3},{"id":"what-are-they--paragraph-1","type":"paragraph","en":"For faster mobile-friendly development, use these basic utility classes for showing and hidding content by device."},{"id":"when-to-use","type":"heading","en":"When to use","level":3},{"id":"when-to-use--paragraph-1","type":"paragraph","en":"Use on a limited basis and avoid creating entirely different versions of the same site. Instead, use them to complement each device&#39;s presentation."},{"id":"when-to-use--paragraph-2","type":"paragraph","en":"For example, you might show a <code>&lt;select&gt;</code> element for nav on mobile layouts, but not on tablets or desktops."},{"id":"support-classes","type":"heading","en":"Support classes","level":3},{"id":"support-classes--paragraph-1","type":"paragraph","en":"Shown here is a table of the classes we support and their effect on a given media query layout (labeled by device). They can be found in <code>responsive.less</code>."},{"id":"support-classes--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"support-classes--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","body":[{"id":"support-classes--paragraph-3","type":"paragraph","en":"Phones <small>480px and below</small>"}]},{"type":"th","body":[{"id":"support-classes--paragraph-4","type":"paragraph","en":"Tablets <small>767px and below</small>"}]},{"type":"th","body":[{"id":"support-classes--paragraph-5","type":"paragraph","en":"Desktops <small>768px and above</small>"}]}]},{"head":false,"cells":[{"type":"th","body":[{"id":"support-classes--paragraph-6","type":"paragraph","en":"<code>.visible-phone</code>"}]},{"type":"td","body":[{"id":"support-classes--paragraph-7","type":"paragraph","en":"Visible"}]},{"type":"td","body":[{"id":"support-classes--paragraph-8","type":"paragraph","en":"Hidden"}]},{"type":"td","body":[{"id":"support-classes--paragraph-9","type":"paragraph","en":"Hidden"}]}]},{"head":false,"cells":[{"type":"th","body":[{"id":"support-classes--paragraph-10","type":"paragraph","en":"<code>.visible-tablet</code>"}]},{"type":"td","body":[{"id":"support-classes--paragraph-11","type":"paragraph","en":"Hidden"}]},{"type":"td","body":[{"id":"support-classes--paragraph-12","type":"paragraph","en":"Visible"}]},{"type":"td","body":[{"id":"support-classes--paragraph-13","type":"paragraph","en":"Hidden"}]}]},{"head":false,"cells":[{"type":"th","body":[{"id":"support-classes--paragraph-14","type":"paragraph","en":"<code>.visible-desktop</code>"}]},{"type":"td","body":[{"id":"support-classes--paragraph-15","type":"paragraph","en":"Hidden"}]},{"type":"td","body":[{"id":"support-classes--paragraph-16","type":"paragraph","en":"Hidden"}]},{"type":"td","body":[{"id":"support-classes--paragraph-17","type":"paragraph","en":"Visible"}]}]},{"head":false,"cells":[{"type":"th","body":[{"id":"support-classes--paragraph-18","type":"paragraph","en":"<code>.hidden-phone</code>"}]},{"type":"td","body":[{"id":"support-classes--paragraph-19","type":"paragraph","en":"Hidden"}]},{"type":"td","body":[{"id":"support-classes--paragraph-20","type":"paragraph","en":"Visible"}]},{"type":"td","body":[{"id":"support-classes--paragraph-21","type":"paragraph","en":"Visible"}]}]},{"head":false,"cells":[{"type":"th","body":[{"id":"support-classes--paragraph-22","type":"paragraph","en":"<code>.hidden-tablet</code>"}]},{"type":"td","body":[{"id":"support-classes--paragraph-23","type":"paragraph","en":"Visible"}]},{"type":"td","body":[{"id":"support-classes--pa
aragraph-55","type":"paragraph","en":"row-gap: 3rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-56","type":"paragraph","en":".column-gap-0"}]},{"type":"td","body":[{"id":"content--paragraph-57","type":"paragraph","en":"column-gap: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-58","type":"paragraph","en":".column-gap-1"}]},{"type":"td","body":[{"id":"content--paragraph-59","type":"paragraph","en":"column-gap: 0.25rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-60","type":"paragraph","en":".column-gap-2"}]},{"type":"td","body":[{"id":"content--paragraph-61","type":"paragraph","en":"column-gap: 0.375rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-62","type":"paragraph","en":".column-gap-3"}]},{"type":"td","body":[{"id":"content--paragraph-63","type":"paragraph","en":"column-gap: 0.5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-64","type":"paragraph","en":".column-gap-4"}]},{"type":"td","body":[{"id":"content--paragraph-65","type":"paragraph","en":"column-gap: 0.75rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-66","type":"paragraph","en":".column-gap-5"}]},{"type":"td","body":[{"id":"content--paragraph-67","type":"paragraph","en":"column-gap: 1rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-68","type":"paragraph","en":".column-gap-6"}]},{"type":"td","body":[{"id":"content--paragraph-69","type":"paragraph","en":"column-gap: 1.25rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-70","type":"paragraph","en":".column-gap-7"}]},{"type":"td","body":[{"id":"content--paragraph-71","type":"paragraph","en":"column-gap: 1.5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-72","type":"paragraph","en":".column-gap-8"}]},{"type":"td","body":[{"id":"content--paragraph-73","type":"paragraph","en":"column-gap: 1.75rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-74","type":"paragraph","en":".column-gap-9"}]},{"type":"td","body":[{"id":"content--paragraph-75","type":"paragraph","en":"column-gap: 2rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-76","type":"paragraph","en":".column-gap-10"}]},{"type":"td","body":[{"id":"content--paragraph-77","type":"paragraph","en":"column-gap: 2.25rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-78","type":"paragraph","en":".column-gap-11"}]},{"type":"td","body":[{"id":"content--paragraph-79","type":"paragraph","en":"column-gap: 2.5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-80","type":"paragraph","en":".column-gap-12"}]},{"type":"td","body":[{"id":"content--paragraph-81","type":"paragraph","en":"column-gap: 3rem;"}]}]}]},{"id":"overview","type":"heading","en":"Overview","level":2},{"id":"overview--paragraph-1","type":"paragraph","en":"Use gap utilities to control the space between children in flexbox and grid layouts. Gap utilities are built from a default Sass map ranging from <code>0</code> to <code>3rem</code> (<code>.gap-0</code> through <code>.gap-12</code>). Use utilities like <code>.gap-3</code> and <code>.gap-5</code> to control the gap between all children:"},{"id":"overview--example-1","type":"demo","key":"8af977f46b277ebe6c7f","height":174},{"id":"overview--code-1","type":"code","value":"<div class=\"d-flex gap-3\">...</div>\n<div class=\"d-flex gap-5\">...</div>","language":""},{"id":"overview--note-1","type":"note","tone":"info","body":[{"id":"overview--note-text-1","type":"note-text","en":"<strong>Support note:</strong> Gap utilities work with CSS Grid and Flexbox layouts. They are a modern alternative to margin utilities for spacing children within a container."}]},{"id":"notation","type":"heading","en":"Notation","level":2},{"id":"notation--paragraph-1","type":"paragraph","en":"Gap utilities that apply to all breakpoints, from <code>xs</code> to <code>2xl</code>, have no breakpoint prefix in them. This is because those classes are applied from <code>min-width: 0</code> and up, and thus are not bound by a media query. The remaining breakpoints, however, do include a breakpoint prefix."},{"id":"notation--paragraph-2","type":"paragraph","en":"The classes are named using the format <code>{property}-{size}</code> for <code>xs</code> and <code>{breakpoint}:{property}-{size}</code> for <code>sm</code>, <code>md</code>, <code>lg</code>, <code>xl</code>, and <code>2xl</code>."},{"id":"notation--paragraph-3","type":"paragraph","en":"Where <em>property</em> is one of:"},{"id":"notation--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-1","type":"item","en":"<code>gap</code> - for classes that set <code>gap</code>"}]},{"tag":"li","body":[{"id":"notation--item-2","type":"item","en":"<code>row-gap</code> - for classes that set <code>row-gap</code>"}]},{"tag":"li","body":[{"id":"notation--item-3","type":"item","en":"<code>column-gap</code> - for classes that set <code>column-gap</code>"}]}]},{"id":"notation--paragraph-4","type":"paragraph","en":"Where <em>size</em> is one of:"},{"id":"notation--list-2","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-4","type":"item","en":"<code>0</code> - for classes that eliminate the <code>gap</code> by setting it to <code>0</code>"}]},{"tag":"li","body":[{"id":"notation--item-5","type":"item","en":"<code>1</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * .25</code>"}]},{"tag":"li","body":[{"id":"notation--item-6","type":"item","en":"<code>2</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * .375</code>"}]},{"tag":"li","body":[{"id":"notation--item-7","type":"item","en":"<code>3</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * .5</code>"}]},{"tag":"li","body":[{"id":"notation--item-8","type":"item","en":"<code>4</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * .75</code>"}]},{"tag":"li","body":[{"id":"notation--item-9","type":"item","en":"<code>5</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 1</code>"}]},{"tag":"li","body":[{"id":"notation--item-10","type":"item","en":"<code>6</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 1.25</code>"}]},{"tag":"li","body":[{"id":"notation--item-11","type":"item","en":"<code>7</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 1.5</code>"}]},{"tag":"li","body":[{"id":"notation--item-12","type":"item","en":"<code>8</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 1.75</code>"}]},{"tag":"li","body":[{"id":"notation--item-13","type":"item","en":"<code>9</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 2</code>"}]},{"tag":"li","body":[{"id":"notation--item-14","type":"item","en":"<code>10</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 2.25</code>"}]},{"tag":"li","body":[{"id":"notation--item-15","type":"item","en":"<code>11</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 2.5</code>"}]},{"tag":"li","body":[{"id":"notation--item-16","type":"item","en":"<code>12</code> - (by default) for classes that set the <code>gap</code> to <code>$spacer * 3</code>"}]}]},{"id":"notation--paragraph-5","type":"paragraph","en":"(You can add more sizes by adding entries to the <code>$spacers</code> Sass map variable.)"},{"id":"examples","type":"heading","en":"Examples","level":2},{"id":"flexbox-gap","type":"heading","en":"Flexbox gap","level":3},{"id":"flexbox-gap--paragraph-1","type":"paragraph","en":"Use <code>gap</code> utilities to control the space between children in a flexbox container:"},{"id":"flexbox-gap--example-1","type":"demo","key":"486e8de094281a45b965","height":147},{"id":"flexbox-gap--code-1","type":"code","value":"<div class=\"d-flex gap-4\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n</div>","language":""},{"id":"grid-gap","type":"heading","en":"Grid gap","level":3},{"id":"grid-gap--paragraph-1","type":"paragraph","en":"Gap utilities also work with CSS Grid layouts:"},{"id":"grid-gap--example-1","type":"demo","key":"eac56cfbddf20f4cb2ed","height":147},{"id":"grid-gap--code-1","type":"code","value":"<div class=\"d-grid gap-3\" style=\"grid-template-columns: 1fr 1fr;\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n  <div>Item 4</div>\n</div>","language":""},{"id":"row-and-column-gaps","type":"heading","en":"Row and column gaps","level":3},{"id":"row-and-column-gaps--paragraph-1","type":"paragraph","en":"Use <code>row-gap</code> and <code>column-gap</code> utilities to control the space between rows and columns independently:"},{"id":"row-and-column-gaps--example-1","type":"demo","key":"b915ed4d4501b20a117c","height":147},{"id":"row-and-column-gaps--code-1","type":"code","value":"<div class=\"d-grid row-gap-4 column-gap-2\" style=\"grid-template-columns: 1fr 1fr 1fr;\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n  <div>Item 4</div>\n  <div>Item 5</div>\n  <div>Item 6</div>\n</div>","language":""},{"id":"flexbox-with-wrapping","type":"heading","en":"Flexbox with wrapping","level":3},{"id":"flexbox-with-wrapping--paragraph-1","type":"paragraph","en":"You can also use <code>row-gap</code> and <code>column-gap</code> utilities with flexbox layouts that wrap:"},{"id":"flexbox-with-wrapping--example-1","type":"demo","key":"d711ec0bac1e263b4537","height":147},{"id":"flexbox-with-wrapping--code-1","type":"code","value":"<div class=\"d-flex flex-wrap row-gap-3 column-gap-2\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n  <div>Item 4</div>\n  <div>Item 5</div>\n</div>","language":""},{"id":"responsive","type":"heading","en":"Responsive","level":2},{"id":"responsive--paragraph-1","type":"paragraph","en":"All gap utilities are responsive and include all breakpoints."},{"id":"responsive--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"responsive--item-1","type":"item","en":"<code>.gap-0</code> through <code>.gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-2","type":"item","en":"<code>.sm:gap-0</code> through <code>.sm:gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-3","type":"item","en":"<code>.md:gap-0</code> through <code>.md:gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-4","type":"item","en":"<code>.lg:gap-0</code> through <code>.lg:gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-5","type":"item","en":"<code>.xl:gap-0</code> through <code>.xl:gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-6","type":"item","en":"<code>.2xl:gap-0</code> through <code>.2xl:gap-12</code>"}]}]},{"id":"responsive--list-2","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"responsive--item-7","type":"item","en":"<code>.row-gap-0</code> through <code>.row-gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-8","type":"item","en":"<code>.sm:row-gap-0</code> through <code>.sm:row-gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-9","type":"item","en":"<code>.md:row-gap-0</code> through <code>.md:row-gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-10","type":"item","en":"<code>.lg:row-gap-0</code> through <code>.lg:row-gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-11","type":"item","en":"<code>.xl:row-gap-0</code> through <code>.xl:row-gap-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-12","type":"item","en":"<code>.2xl:row-gap-0</code> through <code>.2xl:row-gap-12</code>"}]}]},{"id":"responsive--list-3","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"responsive--item-13","type":"item","en":"<code>.column-gap-0</code> thro
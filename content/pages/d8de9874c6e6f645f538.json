{"route":"/docs/5.2/forms/range/","version":"5.2","renderedVersion":"5.2","title":{"id":"content","type":"heading","en":"Range","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use our custom range inputs for consistent cross-browser styling and built-in customization."},"blocks":[{"id":"overview","type":"heading","en":"Overview","level":2},{"id":"overview--paragraph-1","type":"paragraph","en":"Create custom <code>&lt;input type=&quot;range&quot;&gt;</code> controls with <code>.form-range</code>. The track (the background) and thumb (the value) are both styled to appear the same across browsers. As only Firefox supports “filling” their track from the left or right of the thumb as a means to visually indicate progress, we do not currently support it."},{"id":"overview--example-1","type":"demo","key":"a1523c9f39acb3c4ad5b","height":174,"anchors":["customRange1"]},{"id":"overview--code-1","type":"code","value":"<label for=\"customRange1\" class=\"form-label\">Example range</label>\n<input type=\"range\" class=\"form-range\" id=\"customRange1\">","language":"html"},{"id":"disabled","type":"heading","en":"Disabled","level":2},{"id":"disabled--paragraph-1","type":"paragraph","en":"Add the <code>disabled</code> boolean attribute on an input to give it a grayed out appearance, remove pointer events, and prevent focusing."},{"id":"disabled--example-1","type":"demo","key":"895c0f49a10fe7a1b723","height":174,"anchors":["disabledRange"]},{"id":"disabled--code-1","type":"code","value":"<label for=\"disabledRange\" class=\"form-label\">Disabled range</label>\n<input type=\"range\" class=\"form-range\" id=\"disabledRange\" disabled>","language":"html"},{"id":"min-and-max","type":"heading","en":"Min and max","level":2},{"id":"min-and-max--paragraph-1","type":"paragraph","en":"Range inputs have implicit values for <code>min</code> and <code>max</code>—<code>0</code> and <code>100</code>, respectively. You may specify new values for those using the <code>min</code> and <code>max</code> attributes."},{"id":"min-and-max--example-1","type":"demo","key":"5720a16f3ccb61b632c2","height":174,"anchors":["customRange2"]},{"id":"min-and-max--code-1","type":"code","value":"<label for=\"customRange2\" class=\"form-label\">Example range</label>\n<input type=\"range\" class=\"form-range\" min=\"0\" max=\"5\" id=\"customRange2\">","language":"html"},{"id":"steps","type":"heading","en":"Steps","level":2},{"id":"steps--paragraph-1","type":"paragraph","en":"By default, range inputs “snap” to integer values. To change this, you can specify a <code>step</code> value. In the example below, we double the number of steps by using <code>step=&quot;0.5&quot;</code>."},{"id":"steps--example-1","type":"demo","key":"8e8952b5037fb7b59675","height":174,"anchors":["customRange3"]},{"id":"steps--code-1","type":"code","value":"<label for=\"customRange3\" class=\"form-label\">Example range</label>\n<input type=\"range\" class=\"form-range\" min=\"0\" max=\"5\" step=\"0.5\" id=\"customRange3\">","language":"html"},{"id":"sass","type":"heading","en":"Sass","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--code-1","type":"code","value":"$form-range-track-width:          100%;\n$form-range-track-height:         .5rem;\n$form-range-track-cursor:         pointer;\n$form-range-track-bg:             $gray-300;\n$form-range-track-border-radius:  1rem;\n$form-range-track-box-shadow:     $box-shadow-inset;\n\n$form-range-thumb-width:                   1rem;\n$form-range-thumb-height:                  $form-range-thumb-width;\n$form-range-thumb-bg:                      $component-active-bg;\n$form-range-thumb-border:                  0;\n$form-range-thumb-border-radius:           1rem;\n$form-range-thumb-box-shadow:              0 .1rem .25rem rgba($black, .1);\n$form-range-thumb-focus-box-shadow:        0 0 0 1px $body-bg, $input-focus-box-shadow;\n$form-range-thumb-focus-box-shadow-width:  $input-focus-width; // For focus box shadow issue in Edge\n$form-range-thumb-active-bg:               tint-color($component-active-bg, 70%);\n$form-range-thumb-disabled-bg:             $gray-500;\n$form-range-thumb-transition:              background-color .15s ease-in-out, border-color .15s ease-in-out, box-shadow .15s ease-in-out;","language":"scss"}],"demos":[{"key":"a1523c9f39acb3c4ad5b","html":"\n<label for=\"customRange1\" class=\"form-label\">Example range</label>\n<input type=\"range\" class=\"form-range\" id=\"customRange1\">\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"895c0f49a10fe7a1b723","html":"\n<label for=\"disabledRange\" class=\"form-label\">Disabled range</label>\n<input type=\"range\" class=\"form-range\" id=\"disabledRange\" disabled=\"\">\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"5720a16f3ccb61b632c2","html":"\n<label for=\"customRange2\" class=\"form-label\">Example range</label>\n<input type=\"range\" class=\"form-range\" min=\"0\" max=\"5\" id=\"customRange2\">\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"8e8952b5037fb7b59675","html":"\n<label for=\"customRange3\" class=\"form-label\">Example range</label>\n<input type=\"range\" class=\"form-range\" min=\"0\" max=\"5\" step=\"0.5\" id=\"customRange3\">\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.2/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/5.2/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.2/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/5.2/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/5.2/getting-started/javascript/"},{"en":"Webpack","href":"https://getbootstrap.com/docs/5.2/getting-started/webpack/"},{"en":"Parcel","href":"https://getbootstrap.com/docs/5.2/getting-started/parcel/"},{"en":"Vite","href":"https://getbootstrap.com/docs/5.2/getting-sta
,{"type":"td","body":[{"id":"content--paragraph-183","type":"paragraph","en":"padding-inline-start: 2.5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-184","type":"paragraph","en":".ps-12"}]},{"type":"td","body":[{"id":"content--paragraph-185","type":"paragraph","en":"padding-inline-start: 3rem;"}]}]}]},{"id":"overview","type":"heading","en":"Overview","level":2},{"id":"overview--paragraph-1","type":"paragraph","en":"Use padding utilities to control the inner space within elements. Padding utilities are built from a default Sass map ranging from <code>0</code> to <code>3rem</code> (<code>.p-0</code> through <code>.p-12</code>). Use utilities like <code>.p-3</code> and <code>.p-5</code> to control the padding on all sides of an element:"},{"id":"overview--example-1","type":"demo","key":"babec386c1e486a9cd46","height":174},{"id":"overview--code-1","type":"code","value":"<div class=\"p-3\">.p-3</div>\n<div class=\"p-5\">.p-5</div>","language":""},{"id":"notation","type":"heading","en":"Notation","level":2},{"id":"notation--paragraph-1","type":"paragraph","en":"Padding utilities that apply to all breakpoints, from <code>xs</code> to <code>2xl</code>, have no breakpoint prefix in them. This is because those classes are applied from <code>min-width: 0</code> and up, and thus are not bound by a media query. The remaining breakpoints, however, do include a breakpoint prefix."},{"id":"notation--paragraph-2","type":"paragraph","en":"The classes are named using the format <code>{property}{sides}-{size}</code> for <code>xs</code> and <code>{breakpoint}:{property}{sides}-{size}</code> for <code>sm</code>, <code>md</code>, <code>lg</code>, <code>xl</code>, and <code>2xl</code>."},{"id":"notation--paragraph-3","type":"paragraph","en":"Where <em>property</em> is:"},{"id":"notation--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-1","type":"item","en":"<code>p</code> - for classes that set <code>padding</code>"}]}]},{"id":"notation--paragraph-4","type":"paragraph","en":"Where <em>sides</em> is one of:"},{"id":"notation--list-2","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-2","type":"item","en":"<code>t</code> - for classes that set <code>padding-block-start</code>"}]},{"tag":"li","body":[{"id":"notation--item-3","type":"item","en":"<code>b</code> - for classes that set <code>padding-block-end</code>"}]},{"tag":"li","body":[{"id":"notation--item-4","type":"item","en":"<code>s</code> - (start) for classes that set <code>padding-inline-start</code>"}]},{"tag":"li","body":[{"id":"notation--item-5","type":"item","en":"<code>e</code> - (end) for classes that set <code>padding-inline-end</code>"}]},{"tag":"li","body":[{"id":"notation--item-6","type":"item","en":"<code>x</code> - for classes that set <code>padding-inline</code>"}]},{"tag":"li","body":[{"id":"notation--item-7","type":"item","en":"<code>y</code> - for classes that set <code>padding-block</code>"}]},{"tag":"li","body":[{"id":"notation--item-8","type":"item","en":"blank - for classes that set a <code>padding</code> on all 4 sides of the element"}]}]},{"id":"notation--paragraph-5","type":"paragraph","en":"Where <em>size</em> is one of:"},{"id":"notation--list-3","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-9","type":"item","en":"<code>0</code> - for classes that eliminate the <code>padding</code> by setting it to <code>0</code>"}]},{"tag":"li","body":[{"id":"notation--item-10","type":"item","en":"<code>1</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * .25</code>"}]},{"tag":"li","body":[{"id":"notation--item-11","type":"item","en":"<code>2</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * .375</code>"}]},{"tag":"li","body":[{"id":"notation--item-12","type":"item","en":"<code>3</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * .5</code>"}]},{"tag":"li","body":[{"id":"notation--item-13","type":"item","en":"<code>4</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * .75</code>"}]},{"tag":"li","body":[{"id":"notation--item-14","type":"item","en":"<code>5</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 1</code>"}]},{"tag":"li","body":[{"id":"notation--item-15","type":"item","en":"<code>6</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 1.25</code>"}]},{"tag":"li","body":[{"id":"notation--item-16","type":"item","en":"<code>7</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 1.5</code>"}]},{"tag":"li","body":[{"id":"notation--item-17","type":"item","en":"<code>8</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 1.75</code>"}]},{"tag":"li","body":[{"id":"notation--item-18","type":"item","en":"<code>9</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 2</code>"}]},{"tag":"li","body":[{"id":"notation--item-19","type":"item","en":"<code>10</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 2.25</code>"}]},{"tag":"li","body":[{"id":"notation--item-20","type":"item","en":"<code>11</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 2.5</code>"}]},{"tag":"li","body":[{"id":"notation--item-21","type":"item","en":"<code>12</code> - (by default) for classes that set the <code>padding</code> to <code>$spacer * 3</code>"}]}]},{"id":"notation--paragraph-6","type":"paragraph","en":"(You can add more sizes by adding entries to the <code>$spacers</code> Sass map variable.)"},{"id":"examples","type":"heading","en":"Examples","level":2},{"id":"single-side","type":"heading","en":"Single side","level":3},{"id":"single-side--paragraph-1","type":"paragraph","en":"Use utilities like <code>.pt-4</code>, <code>.pe-4</code>, <code>.pb-4</code>, and <code>.ps-4</code> to control the padding on one side of an element:"},{"id":"single-side--example-1","type":"demo","key":"c62337d4e8d29b1790f1","height":228},{"id":"single-side--code-1","type":"code","value":"<div class=\"pt-4\">.pt-4</div>\n<div class=\"pe-4\">.pe-4</div>\n<div class=\"pb-4\">.pb-4</div>\n<div class=\"ps-4\">.ps-4</div>","language":""},{"id":"horizontal-padding","type":"heading","en":"Horizontal padding","level":3},{"id":"horizontal-padding--paragraph-1","type":"paragraph","en":"Use utilities like <code>.px-3</code> and <code>.px-5</code> to control the horizontal padding of an element:"},{"id":"horizontal-padding--example-1","type":"demo","key":"ca12bc1c9091e524946f","height":174},{"id":"horizontal-padding--code-1","type":"code","value":"<div class=\"px-3\">.px-3</div>\n<div class=\"px-5\">.px-5</div>","language":""},{"id":"vertical-padding","type":"heading","en":"Vertical padding","level":3},{"id":"vertical-padding--paragraph-1","type":"paragraph","en":"Use utilities like <code>.py-3</code> and <code>.py-5</code> to control the vertical padding of an element:"},{"id":"vertical-padding--example-1","type":"demo","key":"28e25d0e47667de583b4","height":174},{"id":"vertical-padding--code-1","type":"code","value":"<div class=\"py-3\">.py-3</div>\n<div class=\"py-5\">.py-5</div>","language":""},{"id":"responsive","type":"heading","en":"Responsive","level":2},{"id":"responsive--paragraph-1","type":"paragraph","en":"All padding utilities are responsive and include all breakpoints."},{"id":"responsive--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"responsive--item-1","type":"item","en":"<code>.p-0</code> through <code>.p-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-2","type":"item","en":"<code>.sm:p-0</code> through <code>.sm:p-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-3","type":"item","en":"<code>.md:p-0</code> through <code>.md:p-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-4","type":"item","en":"<code>.lg:p-0</code> through <code>.lg:p-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-5","type":"item","en":"<code>.xl:p-0</code> through <code>.xl:p-12</code>"}]},{"tag":"li","body":[{"id":"responsive--item-6","type":"item","en":"<code>.2xl:p-0</code> through <code>.2xl:p-12</code>"}]}]},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Padding utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"padding\": (\n  responsive: true,\n  property: padding,\n  class: p,\n  values: $spacers\n),\n\"padding-x\": (\n  responsive: true,\n  property: padding-inline,\n  class: px,\n  values: $spacers\n),\n\"padding-y\": (\n  responsive: true,\n  property: padding-block,\n  class: py,\n  values: $spacers\n),\n\"padding-top\": (\n  responsive: true,\n  property: padding-block-start,\n  class: pt,\n  values: $spacers\n),\n\"padding-end\": (\n  responsive: true,\n  property: padding-inline-end,\n  class: pe,\n  values: $spacers\n),\n\"padding-bottom\": (\n  responsive: true,\n  property: padding-block-end,\n  class: pb,\n  values: $spacers\n),\n\"padding-start\": (\n  responsive: true,\n  property: padding-inline-start,\n  class: ps,\n  values: $spacers\n),","language":""}],"demos":[{"key":"babec386c1e486a9cd46","html":"\n<div class=\"p-3 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .p-3\n  </div>\n</div>\n<div class=\"p-5 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .p-5\n  </div>\n</div>","attrs":{"class":"bd-example d-flex align-items-center justify-content-center gap-4 text-center"},"sprite":""},{"key":"c62337d4e8d29b1790f1","html":"\n<div class=\"pt-4 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .pt-4\n  </div>\n</div>\n<div class=\"pe-4 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .pe-4\n  </div>\n</div>\n<div class=\"pb-4 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .pb-4\n  </div>\n</div>\n<div class=\"ps-4 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .ps-4\n  </div>\n</div>","attrs":{"class":"bd-example d-flex align-items-center justify-content-center gap-4 text-center"},"sprite":""},{"key":"ca12bc1c9091e524946f","html":"\n<div class=\"px-3 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .px-3\n  </div>\n</div>\n<div class=\"px-5 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .px-5\n  </div>\n</div>","attrs":{"class":"bd-example d-flex flex-column align-items-center justify-content-center gap-4 text-center"},"sprite":""},{"key":"28e25d0e47667de583b4","html":"\n<div class=\"py-3 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .py-3\n  </div>\n</div>\n<div class=\"py-5 bg-primary bd-pattern-diagonal-inner fg-contrast-accent rounded-3\">\n  <div class=\"p-3 bg-primary rounded-3\">\n    .py-5\n  </div>\n</div>","attrs":{"class":"bd-example d-flex align-items-center justify-content-center gap-4 text-center"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/get
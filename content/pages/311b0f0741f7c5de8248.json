{"route":"/docs/3.4/","version":"3.4","renderedVersion":"3.4","title":{"id":"overview","type":"heading","level":1,"en":"Bootstrap"},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"B","anchors":["content"]},"blocks":[{"id":"page--paragraph-2","type":"paragraph","en":"Bootstrap is the most popular HTML, CSS, and JS framework for developing responsive, mobile first projects on the web."},{"id":"page--paragraph-3","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/3.4/getting-started/#download\">Download Bootstrap</a>"},{"id":"page--paragraph-4","type":"paragraph","en":"Currently v3.4.1"},{"id":"designed-for-everyone-everywhere","type":"heading","en":"Designed for everyone, everywhere","level":2},{"id":"designed-for-everyone-everywhere--paragraph-1","type":"paragraph","en":"Bootstrap makes front-end web development faster and easier. It&#39;s made for folks of all skill levels, devices of all shapes, and projects of all sizes."},{"id":"designed-for-everyone-everywhere--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.4/assets/img/sass-less.png\" alt=\"Sass and Less support\" loading=\"lazy\">"},{"id":"preprocessors","type":"heading","en":"Preprocessors","level":3},{"id":"preprocessors--paragraph-1","type":"paragraph","en":"Bootstrap ships with vanilla CSS, but its source code utilizes the two most popular CSS preprocessors, <a href=\"https://getbootstrap.com/docs/3.4/css/#less\">Less</a> and <a href=\"https://getbootstrap.com/docs/3.4/css/#sass\">Sass</a>. Quickly get started with precompiled CSS or build on the source."},{"id":"preprocessors--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.4/assets/img/devices.png\" alt=\"Responsive across devices\" loading=\"lazy\">"},{"id":"one-framework-every-device","type":"heading","en":"One framework, every device.","level":3},{"id":"one-framework-every-device--paragraph-1","type":"paragraph","en":"Bootstrap easily and efficiently scales your websites and applications with a single code base, from phones to tablets to desktops with CSS media queries."},{"id":"one-framework-every-device--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.4/assets/img/components.png\" alt=\"Components\" loading=\"lazy\">"},{"id":"full-of-features","type":"heading","en":"Full of features","level":3},{"id":"full-of-features--paragraph-1","type":"paragraph","en":"With Bootstrap, you get extensive and beautiful documentation for common HTML elements, dozens of custom HTML and CSS components, and awesome jQuery plugins."},{"id":"full-of-features--paragraph-2","type":"paragraph","en":"Bootstrap is open source. It&#39;s hosted, developed, and maintained on GitHub."},{"id":"full-of-features--paragraph-3","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap\">View the GitHub project</a>"},{"id":"official-bootstrap-themes","type":"heading","en":"Official Bootstrap Themes","level":2},{"id":"official-bootstrap-themes--paragraph-1","type":"paragraph","en":"Take Bootstrap to the next level with official premium themes. Each theme is its own toolkit featuring all of Bootstrap, brand new components and plugins, full docs, build tools, and more."},{"id":"official-bootstrap-themes--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.4/assets/img/bs-themes.png\" alt=\"Bootstrap Themes\" loading=\"lazy\">"},{"id":"built-with-bootstrap","type":"heading","en":"Built with Bootstrap","level":2},{"id":"built-with-bootstrap--paragraph-1","type":"paragraph","en":"Millions of amazing sites across the web are being built with Bootstrap. Get started on your own with our growing <a href=\"https://getbootstrap.com/docs/3.4/getting-started/#examples\">collection of examples</a> or by exploring some of our favorites."},{"id":"built-with-bootstrap--media-1","type":"media","html":"<a href=\"https://expo.getbootstrap.com/2014/10/29/lyft/\"><img src=\"https://getbootstrap.com/docs/3.4/assets/img/expo-lyft.jpg\" alt=\"Lyft\" loading=\"lazy\"></a>"},{"id":"built-with-bootstrap--media-2","type":"media","html":"<a href=\"https://expo.getbootstrap.com/2014/09/30/vogue/\"><img src=\"https://getbootstrap.com/docs/3.4/assets/img/expo-vogue.jpg\" alt=\"Vogue\" loading=\"lazy\"></a>"},{"id":"built-with-bootstrap--media-3","type":"media","html":"<a href=\"https://expo.getbootstrap.com/2014/02/12/newsweek/\"><img src=\"https://getbootstrap.com/docs/3.4/assets/img/expo-newsweek.jpg\" alt=\"Newsweek\" loading=\"lazy\"></a>"},{"id":"built-with-bootstrap--paragraph-2","type":"paragraph","en":"We showcase dozens of inspiring projects built with Bootstrap on the Bootstrap Expo."},{"id":"built-with-bootstrap--paragraph-3","type":"paragraph","en":"<a href=\"https://expo.getbootstrap.com/\">Explore the Expo</a>"}],"demos":[],"nav":[],"standalone":false,"publishedAssets":[{"url":"https://code.jquery.com/jquery-1.12.4.min.js","integrity":"sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://cdn.carbonads.com/carbon.js?zoneid=1673&serve=C6AILKT&placement=getbootstrapcom","https://code.jquery.com/jquery-1.12.4.min.js","https://getbootstrap.com/docs/3.4/dist/js/bootstrap.min.js","https://getbootstrap.com/docs/3.4/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/3.4/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/3.4/assets/css/docs.min.css"]}

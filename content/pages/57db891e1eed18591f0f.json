{"route":"/1.3.0/javascript.html","version":"1.3.0","renderedVersion":"1.3.0","title":{"id":"javascript-for-bootstrap","type":"heading","en":"Javascript for Bootstrap","level":1,"anchors":["overview"]},"lead":{"id":"javascript-for-bootstrap--paragraph-1","type":"paragraph","en":"Bring Bootstrap&#39;s components to life with new, custom plugins that work with <a href=\"https://jquery.com/\">jQuery</a> and <a href=\"https://github.com/ender-js/Ender\">Ender</a>."},"blocks":[{"id":"javascript-for-bootstrap--paragraph-2","type":"paragraph","en":"<a href=\"https://getbootstrap.com/1.3.0/index.html\">← Back to Bootstrap home</a>"},{"id":"modals-bootstrap-modaljs","type":"heading","en":"Modals <small>bootstrap-modal.js</small>","level":1,"anchors":["modal"]},{"id":"modals-bootstrap-modaljs--paragraph-1","type":"paragraph","en":"Our Modal plugin is a super slim take on the traditional modal js plugin, taking special care to include only the bare functionality that we require here at twitter."},{"id":"modals-bootstrap-modaljs--paragraph-2","type":"paragraph","en":"<a href=\"https://getbootstrap.com/1.3.0/assets/js/bootstrap-modal.js\">Download</a>"},{"id":"using-bootstrap-modal","type":"heading","en":"Using bootstrap-modal","level":3},{"id":"using-bootstrap-modal--code-1","type":"code","value":"$('#my-modal').modal(options)","language":""},{"id":"options","type":"heading","en":"Options","level":3},{"id":"options--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"options--paragraph-1","type":"paragraph","en":"Name"}]},{"type":"th","body":[{"id":"options--paragraph-2","type":"paragraph","en":"type"}]},{"type":"th","body":[{"id":"options--paragraph-3","type":"paragraph","en":"default"}]},{"type":"th","body":[{"id":"options--paragraph-4","type":"paragraph","en":"description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-5","type":"paragraph","en":"backdrop"}]},{"type":"td","body":[{"id":"options--paragraph-6","type":"paragraph","en":"boolean"}]},{"type":"td","body":[{"id":"options--paragraph-7","type":"paragraph","en":"false"}]},{"type":"td","body":[{"id":"options--paragraph-8","type":"paragraph","en":"Includes a modal-backdrop element"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-9","type":"paragraph","en":"keyboard"}]},{"type":"td","body":[{"id":"options--paragraph-10","type":"paragraph","en":"boolean"}]},{"type":"td","body":[{"id":"options--paragraph-11","type":"paragraph","en":"false"}]},{"type":"td","body":[{"id":"options--paragraph-12","type":"paragraph","en":"Closes the modal when escape key is pressed"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-13","type":"paragraph","en":"show"}]},{"type":"td","body":[{"id":"options--paragraph-14","type":"paragraph","en":"boolean"}]},{"type":"td","body":[{"id":"options--paragraph-15","type":"paragraph","en":"false"}]},{"type":"td","body":[{"id":"options--paragraph-16","type":"paragraph","en":"Opens modal on class initialization"}]}]}]},{"id":"markup","type":"heading","en":"Markup","level":3},{"id":"markup--paragraph-1","type":"paragraph","en":"You can activate modals on your page easily without having to write a single line of javascript. Just give an element a <code>data-controls-modal</code> attribute which corresponds to a modal element id, and when clicked, it will launch your modal. To add modal options, just include them as data attributes as well."},{"id":"markup--code-1","type":"code","value":"<a class=\"btn\" data-controls-modal=\"my-modal\" data-backdrop=\"true\" >Launch Modal</a>","language":""},{"id":"markup--paragraph-2","type":"paragraph","en":"Notice If you want your modal to animate in and out, just add a <code>.fade</code> class to your <code>.modal</code> element (refer to the demo to see this in action)."},{"id":"methods","type":"heading","en":"Methods","level":3},{"id":"modaloptions","type":"heading","en":".modal(options)","level":4},{"id":"modaloptions--paragraph-1","type":"paragraph","en":"Activates your content as a modal. Accepts an optional options <code>object</code>."},{"id":"modaloptions--code-1","type":"code","value":"$('#my-modal').modal({\n  closeOnEscape: true\n})","language":""},{"id":"modaltoggle","type":"heading","en":".modal(&#39;toggle&#39;)","level":4},{"id":"modaltoggle--paragraph-1","type":"paragraph","en":"Manually toggles a modal."},{"id":"modaltoggle--code-1","type":"code","value":"$('#my-modal').modal('toggle')","language":""},{"id":"modalshow","type":"heading","en":".modal(&#39;show&#39;)","level":4},{"id":"modalshow--paragraph-1","type":"paragraph","en":"Manually opens a modal."},{"id":"modalshow--code-1","type":"code","value":"$('#my-modal').modal('show')","language":""},{"id":"modalhide","type":"heading","en":".modal(&#39;hide&#39;)","level":4},{"id":"modalhide--paragraph-1","type":"paragraph","en":"Manually hides a modal."},{"id":"modalhide--code-1","type":"code","value":"$('#my-modal').modal('hide')","language":""},{"id":"modaltrue","type":"heading","en":".modal(true)","level":4},{"id":"modaltrue--paragraph-1","type":"paragraph","en":"Returns an elements modal class instance."},{"id":"modaltrue--code-1","type":"code","value":"$('#my-modal').modal(true)","language":""},{"id":"modaltrue--paragraph-2","type":"paragraph","en":"Notice Alternatively, this can be retrieved with <code>$().data(&#39;modal&#39;)</code>."},{"id":"events","type":"heading","en":"Events","level":3},{"id":"events--paragraph-1","type":"paragraph","en":"Bootstrap&#39;s modal class exposes a few events for hooking into modal functionality."},{"id":"events--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"events--paragraph-2","type":"paragraph","en":"Event"}]},{"type":"th","body":[{"id":"events--paragraph-3","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"events--paragraph-4","type":"paragraph","en":"show"}]},{"type":"td","body":[{"id":"events--paragraph-5","type":"paragraph","en":"This event fires immediately when the <code>show</code> instance method is called."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"events--paragraph-6","type":"paragraph","en":"shown"}]},{"type":"td","body":[{"id":"events--paragraph-7","type":"paragraph","en":"This event is fired when the modal has been made visible to the user (will wait for css transitions to complete)."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"events--paragraph-8","type":"paragraph","en":"hide"}]},{"type":"td","body":[{"id":"events--paragraph-9","type":"paragraph","en":"This event is fired immediately when the <code>hide</code> instance method has been called."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"events--paragraph-10","type":"paragraph","en":"hidden"}]},{"type":"td","body":[{"id":"events--paragraph-11","type":"paragraph","en":"This event is fired when the modal has finished being hidden from the user (will wait for css transitions to complete)."}]}]}]},{"id":"events--code-1","type":"code","value":"$('#my-modal').bind('hidden', function () {\n  // do something ...\n})","language":""},{"id":"demo","type":"heading","en":"Demo","level":3},{"id":"modal-heading","type":"heading","en":"Modal Heading","level":3,"anchors":["modal-from-dom"]},{"id":"modal-heading--paragraph-1","type":"paragraph","en":"One fine body…"},{"id":"modal-heading--paragraph-2","type":"paragraph","en":"<a href=\"#\">Primary</a>\n              <a href=\"#\">Secondary</a>"},{"id":"modal-heading--caption-1","type":"caption","en":"Launch Modal"},{"id":"dropdown-bootstrap-dropdownjs","type":"heading","en":"Dropdown <small>bootstrap-dropdown.js</small>","level":1,"anchors":["dropdown"]},{"id":"dropdown-bootstrap-dropdownjs--paragraph-1","type":"paragraph","en":"This plugin is for adding dropdown interaction to the bootstrap topbar or tabbed navigations."},{"id":"dropdown-bootstrap-dropdownjs--paragraph-2","type":"paragraph","en":"<a href=\"https://getbootstrap.com/1.3.0/assets/js/bootstrap-dropdown.js\">Download</a>"},{"id":"using-boostrap-dropdownjs","type":"heading","en":"Using boostrap-dropdown.js","level":3},{"id":"using-boostrap-dropdownjs--code-1","type":"code","value":"$('#topbar').dropdown()","language":""},{"id":"using-boostrap-dropdownjs--heading-1","type":"heading","en":"Markup","level":3},{"id":"using-boostrap-dropdownjs--heading-1--paragraph-1","type":"paragraph","en":"To quickly add dropdown functionality to any nav element, use the <code>data-dropdown</code> attribute. Any valid bootstrap dropdown will automatically be activated."},{"id":"using-boostrap-dropdownjs--heading-1--code-1","type":"code","value":"<ul class=\"tabs\">\n  <li class=\"active\"><a href=\"#\">Home</a></li>\n  <li class=\"dropdown\" data-dropdown=\"dropdown\" >\n    <a href=\"#\" class=\"dropdown-toggle\">Dropdown</a>\n    <ul class=\"dropdown-menu\">\n      <li><a href=\"#\">Secondary link</a></li>\n      <li><a href=\"#\">Something else here</a></li>\n      <li class=\"divider\"></li>\n      <li><a href=\"#\">Another link</a></li>\n    </ul>\n  </li>\n</ul>","language":""},{"id":"using-boostrap-dropdownjs--heading-1--paragraph-2","type":"paragraph","en":"Notice If your ui has several dropdowns, consider adding the <code>data-dropdown</code> attribute to a more significant container element like <code>.tabs</code> or <code>.topbar</code>."},{"id":"using-boostrap-dropdownjs--heading-1--heading-1","type":"heading","en":"Methods","level":3},{"id":"using-boostrap-dropdownjs--heading-1--heading-1--heading-1","type":"heading","en":"$().dropdown()","level":4},{"id":"using-boostrap-dropdownjs--heading-1--heading-1--heading-1--paragraph-1","type":"paragraph","en":"A programatic api for activating menus for a given topbar or tabbed navigation."},{"id":"using-boostrap-dropdownjs--heading-1--heading-1--heading-1--heading-1","type":"heading","en":"Demo","level":3},{"id":"project-name","type":"heading","en":"<a href=\"#\">Project Name</a>","level":3,"anchors":["topbar-example"]},{"id":"project-name--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"project-name--item-1","type":"item","en":"<a href=\"#\">Link</a>"}]},{"tag":"li","body":[{"id":"project-name--item-2","type":"item","en":"<a href=\"#\">Link</a>"}]}]},{"id":"project-name--list-4","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"project-name--item-3","type":"item","en":"<a href=\"#\">Dropdown 1</a>"},{"id":"project-name--list-2","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"project-name--item-4","type":"item","en":"<a href=\"#\">Secondary link</a>"}]},{"tag":"li","body":[{"id":"project-name--item-5","type":"item","en":"<a href=\"#\">Something else here</a>"}]},{"tag":"li","body":[{"id":"project-name--item-6","type":"item","en":"<a href=\"#\">Another link</a>"}]}]}]},{"tag":"li","body":[{"id":"project-name--item-7","type":"item","en":"<a href=\"#\">Dropdown 2</a>"},{"id":"project-name--list-3","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"project-name--item-8","type":"item","en":"<a href=\"#\">Secondary link</a>"}]},{"tag":"li","body":[{"id":"project-name--item-9","type":"item","en":"<a href=\"#\">Something else here</a>"}]},{"tag":"li","body":[{"id":"project-name--item-10","type":"item","en":"<a href=\"#\">Another link</a>"}]}]}]}]},{"id":"scrollspy-bootstrap-scrollspyjs","type":"heading","en":"ScrollSpy <small>bootstrap-scrollspy.js</small>","level":1,"anchors":["scrollspy"]},{"id":"scrollspy-bootstrap-scrollspyjs--paragraph-1","type":"paragraph","en":"This plugin is for adding the scrollspy (auto updating nav) interaction to the bootstrap topbar."},{"id":"scrollspy-bootstrap-scrollspyjs--paragraph-2","type":"paragraph","en":"<a href=\"https://getbootstrap.com/1.3.0/assets/js/bootstrap-scrollspy.js\">Download</a>"},{"id":"using-boostrap-scrollspyjs","type":"heading","en":"Using boostrap-scrollspy.js","level":2},{"id":"using-boostrap-scrollspyjs--code-1","type":"code","value":"$('#topbar').dropdown()","language":""},{"id":"using-boostrap-scrollspyjs--heading-1","type":"heading","en":"Markup","level":3},{"id":"using-boostrap-scrollspyjs--heading-1--paragraph-1","type":"paragraph","en":"To easily add scrollspy behavior to your nav, just add the <code>data-scrollspy</code> attribute to the <code>.topbar</code>."},{"id":"using-boostrap-scrollspyjs--heading-1--code-1","type":"code","value":"<div class=\"topbar\" data-scrollspy=\"scrollspy\" >...</div>","language":""},{"id":"using-boostrap-scrollspyjs--heading-1--heading-1","type":"heading","en":"Methods","level":3},{"id":"using-boostrap-scrollspyjs--heading-1--heading-1--heading-1","type":"heading","en":"$().scrollspy()","level":4},{"id":"using-boostrap-scrollspyjs--heading-1--heading-1--heading-1--paragraph-1","type":"paragraph","en":"Auto activates navigation buttons by users scroll position."},{"id":"using-boostrap-scrollspyjs--heading-1--heading-1--heading-1--code-1","type":"code","value":"$('body > .topbar').scrollSpy()","language":""},{"id":"using-boostrap-scrollspyjs--heading-1--heading-1--heading-1--paragraph-2","type":"paragraph","en":"Notice Topbar anchor tags must have resolvable id targets. For example, a <code>&lt;a href=&quot;#home&quot;&gt;home&lt;/a&gt;</code> must correspond to something in the dom like <code>&lt;div id=&quot;home&quot;&gt;&lt;/div&gt;</code>."},{"id":"scrollspyrefresh","type":"heading","en":".scrollspy(&#39;refresh&#39;)","level":4},{"id":"scrollspyrefresh--paragraph-1","type":"paragraph","en":"The scrollspy caches nav buttons and section coordinates for performance. If you need to update this cache (likely if you have dynamic content) just call this refresh method. If you used the data attribute to define your scrollspy, just call refresh on the body."},{"id":"scrollspyrefresh--code-1","type":"code","value":"$('body').scrollspy('refresh')","language":""},{"id":"scrollspyrefresh--heading-1","type":"heading","en":"Demo","level":3},{"id":"scrollspyrefresh--heading-1--paragraph-1","type":"paragraph","en":"Checkout the the topbar navigation on this page."},{"id":"tabs-bootstrap-tabsjs","type":"heading","en":"Tabs <small>bootstrap-tabs.js</small>","level":1,"anchors":["tabs"]},{"id":"tabs-bootstrap-tabsjs--paragraph-1","type":"paragraph","en":"This plugin adds quick, dynamic tab and pill functionality."},{"id":"tabs-bootstrap-tabsjs--paragraph-2","type":"paragraph","en":"<a href=\"https://getbootstrap.com/1.3.0/assets/js/bootstrap-tabs.js\">Download</a>"},{"id":"using-boostrap-tabsjs","type":"heading","en":"Using boostrap-tabs.js","level":3},{"id":"using-boostrap-tabsjs--code-1","type":"code","value":"$('.tabs').tabs()","language":""},{"id":"using-boostrap-tabsjs--heading-1","type":"heading","en":"Markup","level":3},{"id":"using-boostrap-tabsjs--heading-1--paragraph-1","type":"paragraph","en":"You can activate a tab or pill navigation without writing any javascript by simply giving them a <code>data-tabs</code> or <code>data-pills</code> attribute."},{"id":"using-boostrap-tabsjs--heading-1--code-1","type":"code","value":" <ul class=\"tabs\" data-tabs=\"tabs\" >...</ul>","language":""},{"id":"using-boostrap-tabsjs--heading-1--heading-1","type":"heading","en":"Methods","level":3},{"id":"tabs-or-pills","type":"heading","en":"$().tabs or $().pills","level":4},{"id":"tabs-or-pills--paragraph-1","type":"paragraph","en":"Activates tab and pill functionality for a given container. Tab links should reference id&#39;s in the document."},{"id":"tabs-or-pills--code-1","type":"code","value":"<ul class=\"tabs\">\n  <li class=\"active\"><a href=\"#home\">Home</a></li>\n  <li><a href=\"#profile\">Profile</a></li>\n  <li><a href=\"#messages\">Messages</a></li>\n  <li><a href=\"#settings\">Settings</a></li>\n</ul>\n\n<div class=\"pill-content\">\n  <div class=\"active\" id=\"home\">...</div>\n  <div id=\"profile\">...</div>\n  <div id=\"messages\">...</div>\n  <div id=\"settings\">...</div>\n</ul>\n\n<script>\n  $(function () {
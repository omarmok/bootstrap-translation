{"route":"/2.2.0/","version":"2.2.0","renderedVersion":"2.2.0","title":{"id":"bootstrap","type":"heading","en":"Bootstrap","level":1},"lead":{"id":"bootstrap--paragraph-1","type":"paragraph","en":"Sleek, intuitive, and powerful front-end framework for faster and easier web development."},"blocks":[{"id":"bootstrap--paragraph-2","type":"paragraph","en":"<a href=\"https://getbootstrap.com/2.2.0/assets/bootstrap.zip\">Download Bootstrap</a>"},{"id":"bootstrap--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"bootstrap--item-1","type":"item","en":"<a href=\"https://github.com/twitter/bootstrap\">GitHub project</a>"}]},{"tag":"li","body":[{"id":"bootstrap--item-2","type":"item","en":"<a href=\"https://getbootstrap.com/2.2.0/getting-started.html#examples\">Examples</a>"}]},{"tag":"li","body":[{"id":"bootstrap--item-3","type":"item","en":"<a href=\"https://getbootstrap.com/2.2.0/extend.html\">Extend</a>"}]},{"tag":"li","body":[{"id":"bootstrap--item-4","type":"item","en":"Version 2.2.0"}]}]},{"id":"introducing-bootstrap","type":"heading","en":"Introducing Bootstrap.","level":1},{"id":"introducing-bootstrap--paragraph-1","type":"paragraph","en":"Need reasons to love Bootstrap? Look no further."},{"id":"introducing-bootstrap--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.2.0/assets/img/bs-docs-twitter-github.png\" alt=\"\" loading=\"lazy\">"},{"id":"by-nerds-for-nerds","type":"heading","en":"By nerds, for nerds.","level":2},{"id":"by-nerds-for-nerds--paragraph-1","type":"paragraph","en":"Built at Twitter by <a href=\"https://twitter.com/mdo\">@mdo</a> and <a href=\"https://twitter.com/fat\">@fat</a>, Bootstrap utilizes <a href=\"http://lesscss.org/\">LESS CSS</a>, is compiled via <a href=\"https://nodejs.org/\">Node</a>, and is managed through <a href=\"https://github.com/\">GitHub</a> to help nerds do awesome stuff on the web."},{"id":"by-nerds-for-nerds--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.2.0/assets/img/bs-docs-responsive-illustrations.png\" alt=\"\" loading=\"lazy\">"},{"id":"made-for-everyone","type":"heading","en":"Made for everyone.","level":2},{"id":"made-for-everyone--paragraph-1","type":"paragraph","en":"Bootstrap was made to not only look and behave great in the latest desktop browsers (as well as IE7!), but in tablet and smartphone browsers via <a href=\"https://getbootstrap.com/2.2.0/scaffolding.html#responsive\">responsive CSS</a> as well."},{"id":"made-for-everyone--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.2.0/assets/img/bs-docs-bootstrap-features.png\" alt=\"\" loading=\"lazy\">"},{"id":"packed-with-features","type":"heading","en":"Packed with features.","level":2},{"id":"packed-with-features--paragraph-1","type":"paragraph","en":"A 12-column responsive <a href=\"https://getbootstrap.com/2.2.0/scaffolding.html#grid\">grid</a>, dozens of components, <a href=\"https://getbootstrap.com/2.2.0/javascript.html\">JavaScript plugins</a>, typography, form controls, and even a <a href=\"https://getbootstrap.com/2.2.0/customize.html\">web-based Customizer</a> to make Bootstrap your own."},{"id":"built-with-bootstrap","type":"heading","en":"Built with Bootstrap.","level":1},{"id":"built-with-bootstrap--paragraph-1","type":"paragraph","en":"For even more sites built with Bootstrap, <a href=\"https://builtwithbootstrap.com/\">visit the unofficial Tumblr</a> or <a href=\"https://getbootstrap.com/2.2.0/getting-started.html#examples\">browse the examples</a>."},{"id":"built-with-bootstrap--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"built-with-bootstrap--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.2.0/assets/img/example-sites/soundready.png\" alt=\"SoundReady.fm\" loading=\"lazy\">"}]},{"tag":"li","body":[{"id":"built-with-bootstrap--media-2","type":"media","html":"<a href=\"http://kippt.com/\"><img src=\"https://getbootstrap.com/2.2.0/assets/img/example-sites/kippt.png\" alt=\"Kippt\" loading=\"lazy\"></a>"}]},{"tag":"li","body":[{"id":"built-with-bootstrap--media-3","type":"media","html":"<a href=\"https://gathercontent.com/\"><img src=\"https://getbootstrap.com/2.2.0/assets/img/example-sites/gathercontent.png\" alt=\"Gather Content\" loading=\"lazy\"></a>"}]},{"tag":"li","body":[{"id":"built-with-bootstrap--media-4","type":"media","html":"<a href=\"https://jshint.com/\"><img src=\"https://getbootstrap.com/2.2.0/assets/img/example-sites/jshint.png\" alt=\"JS Hint\" loading=\"lazy\"></a>"}]}]}],"demos":[],"nav":[{"en":"Home","href":"https://getbootstrap.com/2.2.0/index.html"},{"en":"Get started","href":"https://getbootstrap.com/2.2.0/getting-started.html"},{"en":"Scaffolding","href":"https://getbootstrap.com/2.2.0/scaffolding.html"},{"en":"Base CSS","href":"https://getbootstrap.com/2.2.0/base-css.html"},{"en":"Components","href":"https://getbootstrap.com/2.2.0/components.html"},{"en":"JavaScript","href":"https://getbootstrap.com/2.2.0/javascript.html"},{"en":"Customize","href":"https://getbootstrap.com/2.2.0/customize.html"}],"standalone":false,"publishedAssets":[],"sourceScripts":["https://cdn.usefathom.com/script.js","https://cdn.carbonads.com/carbon.js?zoneid=1673&serve=C6AILKT&placement=getbootstrapcom","https://platform.twitter.com/widgets.js","https://getbootstrap.com/2.2.0/assets/js/jquery.js","https://getbootstrap.com/2.2.0/assets/js/google-code-prettify/prettify.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-transition.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-alert.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-modal.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-dropdown.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-scrollspy.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-tab.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-tooltip.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-popover.js","https://getbootstrap.com/2.2.0/assets/js/bootstrap-button.js","htt
{"route":"/docs/5.0/helpers/position/","version":"5.0","renderedVersion":"5.0","title":{"id":"content","type":"heading","en":"Position","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use these helpers for quickly configuring the position of an element."},"blocks":[{"id":"fixed-top","type":"heading","en":"Fixed top","level":2},{"id":"fixed-top--paragraph-1","type":"paragraph","en":"Position an element at the top of the viewport, from edge to edge. Be sure you understand the ramifications of fixed position in your project; you may need to add additional CSS."},{"id":"fixed-top--code-1","type":"code","value":"<div class=\"fixed-top\">...</div>","language":"html"},{"id":"fixed-bottom","type":"heading","en":"Fixed bottom","level":2},{"id":"fixed-bottom--paragraph-1","type":"paragraph","en":"Position an element at the bottom of the viewport, from edge to edge. Be sure you understand the ramifications of fixed position in your project; you may need to add additional CSS."},{"id":"fixed-bottom--code-1","type":"code","value":"<div class=\"fixed-bottom\">...</div>","language":"html"},{"id":"sticky-top","type":"heading","en":"Sticky top","level":2},{"id":"sticky-top--paragraph-1","type":"paragraph","en":"Position an element at the top of the viewport, from edge to edge, but only after you scroll past it. The <code>.sticky-top</code> utility uses CSS’s <code>position: sticky</code>, which isn’t fully supported in all browsers."},{"id":"sticky-top--code-1","type":"code","value":"<div class=\"sticky-top\">...</div>","language":"html"},{"id":"responsive-sticky-top","type":"heading","en":"Responsive sticky top","level":2},{"id":"responsive-sticky-top--paragraph-1","type":"paragraph","en":"Responsive variations also exist for <code>.sticky-top</code> utility."},{"id":"responsive-sticky-top--code-1","type":"code","value":"<div class=\"sticky-sm-top\">Stick to the top on viewports sized SM (small) or wider</div>\n<div class=\"sticky-md-top\">Stick to the top o
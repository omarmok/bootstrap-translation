undle.min.js","https://getbootstrap.com/docs/5.3/assets/Scripts.astro_astro_type_script_index_0_lang.D9qkKYrx.js","https://getbootstrap.com/docs/5.3/assets/DocsScripts.astro_astro_type_script_index_0_lang.DSSVDTqU.js"],"sourceStyles":["https://getbootstrap.com/docs/5.3/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/5.3/assets/_slug_.ZhhCqGDD.css"]}

{"route":"/docs/4.6/utilities/interactions/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"Interactions","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/utilities/interactions.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Utility classes that change how users interact with the contents of a website."},{"id":"text-selection","type":"heading","en":"Text selection","level":2},{"id":"text-selection--paragraph-1","type":"paragraph","en":"Change how the content is selected when the user interacts with it. Note that Internet Explorer and Legacy Edge have no support for the <code>all</code> value for <code>user-select</code>, and as such, <strong><code>.user-select-all</code> is not supported by either browser.</strong>"},{"id":"text-selection--example-1","type":"demo","key":"c9e45a01178cd054899a","height":201},{"id":"text-selection--code-1","type":"code","value":"<p class=\"user-select-all\">This paragraph will be entirely selected when clicked by the user.</p>\n<p class=\"user-select-auto\">This paragraph has the default select behavior.</p>\n<p class=\"user-select-none\">This paragraph will not be selectable when clicked by the user.</p>","language":"html"},{"id":"text-selection--paragraph-2","type":"paragraph","en":"Customize the available classes by changing the <code>$user-selects</code> Sass list in <code>_variables.scss</code>."}],"demos":[{"key":"c9e45a01178cd054899a","html":"\n<p class=\"user-select-all\">This paragraph will be entirely selected when clicked by the user.</p>\n<p class=\"user-select-auto\">This paragraph has the default select behavior.</p>\n<p class=\"user-select-none\">This paragraph will not be selectable when clicked by the user.</p>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.6/getting-sta
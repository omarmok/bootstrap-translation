{"route":"/docs/4.6/extend/icons/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"Icons","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/extend/icons.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Guidance and suggestions for using external icon libraries with Bootstrap."},{"id":"bootstrap-icons","type":"heading","en":"Bootstrap Icons","level":2},{"id":"bootstrap-icons--paragraph-1","type":"paragraph","en":"While you won’t find a built-in icon library in Bootstrap, our separate <a href=\"https://icons.getbootstrap.com/\">Bootstrap Icons</a> projects is a growing set of open source SVGs you can use. While they’re designed first and foremost to work with our components and documentation, you can use them in any project."},{"id":"bootstrap-icons--paragraph-2","type":"paragraph","en":"<a href=\"https://icons.getbootstrap.com/\">Get Bootstrap Icons</a>"},{"id":"bootstrap-icons--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/4.6/assets/img/bootstrap-icons.png\" alt=\"Bootstrap Icons\" loading=\"lazy\">"},{"id":"additional-icon-sets","type":"heading","en":"Additional icon sets","level":2},{"id":"additional-icon-sets--paragraph-1","type":"paragraph","en":"In addition to Bootstrap Icons, we have a handful of alternative icon libraries for you to choose from. While most icon sets include multiple file formats, we prefer SVG implementations for their improved accessibility and vector support."},{"id":"preferred","type":"heading","en":"Preferred","level":3},{"id":"preferred--paragraph-1","type":"paragraph","en":"We’ve tested and used these icon sets ourselves."},{"id":"preferred--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"preferred--item-1","type":"item","en":"<a href=\"https://fontawesome.com/\">Font Awesome</a>"}]},{"tag":"li","body":[{"id":"preferred--item-2","type":"item","en":"<a href=\"https://feathericons.com/\">Feather</a>"}]},{"tag":"li","body":[{"id":"preferred--item-3","type":"item","en":"<a href=\"https://octicons.github.com/\">Octicons</a>"}]}]},{"id":"more","type":"heading","en":"More","level":3},{"id":"more--paragraph-1","type":"paragraph","en":"While we haven’t tried these out, they do look promising and provide multiple formats—including SVG."},{"id":"more--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"more--item-1","type":"item","en":"<a href=\"https://github.com/danklammer/bytesize-icons\">Bytesize</a>"}]},{"tag":"li","body":[{"id":"more--item-2","type":"item","en":"<a href=\"https://material.io/resources/icons/\">Google Material icons</a>"}]},{"tag":"li","body":[{"id":"more--item-3","type":"item","en":"<a href=\"https://ionicons.com/\">Ionicons</a>"}]},{"tag":"li","body":[{"id":"more--item-4","type":"item","en":"<a href=\"http://demo.amitjakhu.com/dripicons/\">Dripicons</a>"}]},{"tag":"li","body":[{"id":"more--item-5","type":"item","en":"<a href=\"http://ikons.piotrkwiatkowski.co.uk/\">Ikons</a>"}]},{"tag":"li","body":[{"id":"more--item-6","type":"item","en":"<a href=\"https://icons8.com/\">Icons8</a>"}]},{"tag":"li","body":[{"id":"more--item-7","type":"item","en":"<a href=\"https://icofont.com/\">icofont</a>"}]},{"tag":"li","body":[{"id":"more--item-8","type":"item","en":"<a href=\"https://icons.coreui.io/\">CoreUI Icons</a>"}]}]}],"demos":[],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.6/getting-started/introduction/"},{"en":"Layout","href":"https://getbootstrap.com/docs/4.6/layout/overview/"},{"en":"Content","href":"https://getbootstrap.com/docs/4.6/content/reboot/"},{"en":"Components","href":"https://getbootstrap.com/docs/4.6/components/alerts/"},{"en":"Utilities","href":"https://getbootstrap.com/docs/4.6/utilities/borders/"},{"en":"Extend","href":"https://getbootstrap.com/docs/4.6/extend/approach/"},{"en":"Approach","href":"https://getbootstrap.com/docs/4.6/extend/approach/"},{"en":"Icons","href":"https://getbootstrap.com/docs/4.6/extend/icons/"},{"en":"Migration","href":"https://getbootstrap.com/docs/4.6/migration/"},{"en":"About","href":"https://getbootstrap.com/docs/4.6/about/overview/"},{"en":"End of Life","href":"https://getbootstrap.com/docs/4.6/end-of-life/"}],"standalone":false,"publishedAssets":[{"url":"/docs/4.6/dist/css/bootstrap.min.css","integrity":"sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N"},{"url":"https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","integrity":"sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"},{"url":"/docs/4.6/dist/js/bootstrap.bundle.min.js","integrity":"sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-analytics.com/analytics.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","https://getbootstrap.com/docs/4.6/dist/js/bootstrap.bundle.min.js","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.js","https://getbootstrap.com/docs/4.6/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/4.6/dist/css/bootstrap.min.css","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.css","https://getbootstrap.com/docs/4.6/assets/css/docs.css"]}

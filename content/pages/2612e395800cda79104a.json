{"route":"/docs/4.6/components/jumbotron/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"Jumbotron","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/components/jumbotron.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Lightweight, flexible component for showcasing hero unit style content."},{"id":"content--paragraph-2","type":"paragraph","en":"A lightweight, flexible component that can optionally extend the entire viewport to showcase key marketing messages on your site."},{"id":"content--example-1","type":"demo","key":"65a164e3f3339078274f","height":147},{"id":"content--code-1","type":"code","value":"<div class=\"jumbotron\">\n  <h1 class=\"display-4\">Hello, world!</h1>\n  <p class=\"lead\">This is a simple hero unit, a simple jumbotron-style component for calling extra attention to featured content or information.</p>\n  <hr class=\"my-4\">\n  <p>It uses utility classes for typography and spacing to space content out within the larger container.</p>\n  <a class=\"btn btn-primary btn-lg\" href=\"#\" role=\"button\">Learn more</a>\n</div>","language":"html"},{"id":"content--paragraph-3","type":"paragraph","en":"To make the jumbotron full width, and without rounded corners, add the <code>.jumbotron-fluid</code> modifier class and add a <code>.container</code> or <code>.container-fluid</code> within."},{"id":"content--example-2","type":"demo","key":"c3c52ec4c22fdd737d5a","height":147},{"id":"content--code-2","type":"code","value":"<div class=\"jumbotron jumbotron-fluid\">\n  <div class=\"container\">\n    <h1 class=\"display-4\">Fluid jumbotron</h1>\n    <p class=\"lead\">This is a modified jumbotron that occupies the entire horizontal space of its parent.</p>\n  </div>\n</div>","language":"html"}],"demos":[{"key":"65a164e3f3339078274f","html":"\n<div class=\"jumbotron\">\n  <h1 class=\"display-4\">Hello, world!</h1>\n  <p class=\"lead\">This is a simple hero unit, a simple jumbotron-style component for calling extra attention to featured content or information.</p>\n  \n  <p>It uses utility classes for typography and spacing to space content out within the larger container.</p>\n  <a class=\"btn btn-primary btn-lg\" href=\"#\" role=\"button\">Learn more</a>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"c3c52ec4c22fdd737d5a","html":"\n<div class=\"jumbotron jumbotron-fluid\">\n  <div class=\"container\">\n    <h1 class=\"display-4\">Fluid jumbotron</h1>\n    <p class=\"lead\">This is a modified jumbotron that occupies the entire horizontal space of its parent.</p>\n  </div>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.6/getting-started/introduction/"},{"en":"Layout","href":"https://getbootstrap.com/docs/4.6/layout/overview/"},{"en":"Content","href":"https://getbootstrap.com/docs/4.6/content/reboot/"},{"en":"Components","href":"https://getbootstrap.com/docs/4.6/components/alerts/"},{"en":"Alerts","href":"https://getbootstrap.com/docs/4.6/components/alerts/"},{"en":"Badge","href":"https://getbootstrap.com/docs/4.6/components/badge/"},{"en":"Breadcrumb","href":"https://getbootstrap.com/docs/4.6/components/breadcrumb/"},{"en":"Buttons","href":"https://getbootstrap.com/docs/4.6/components/buttons/"},{"en":"Button group","href":"https://getbootstrap.com/docs/4.6/components/button-group/"},{"en":"Card","href":"https://getbootstrap.com/docs/4.6/components/card/"},{"en":"Carousel","href":"https://getbootstrap.com/docs/4.6/components/carousel/"},{"en":"Collapse","href":"https://getbootstrap.com/docs/4.6/components/collapse/"},{"en":"Dropdowns","href":"https://getbootstrap.com/docs/4.6/components/dropdowns/"},{"en":"Forms","href":"https://getbootstrap.com/docs/4.6/components/forms/"},{"en":"Input group","href":"https://getbootstrap.com/docs/4.6/components/input-group/"},{"en":"Jumbotron","href":"https://getbootstrap.com/docs/4.6/components/jumbotron/"},{"en":"List group","href":"https://getbootstrap.com/docs/4.6/components/list-group/"},{"en":"Media object","href":"https://getbootstrap.com/docs/4.6/components/media-object/"},{"en":"Modal","href":"https://getbootstrap.com/docs/4.6/components/modal/"},{"en":"Navs","href":"https://getbootstrap.com/docs/4.6/components/navs/"},{"en":"Navbar","href":"https://getbootstrap.com/docs/4.6/components/navbar/"},{"en":"Pagination","href":"https://getbootstrap.com/docs/4.6/components/pagination/"},{"en":"Popovers","href":"https://getbootstrap.com/docs/4.6/components/popovers/"},{"en":"Progress","href":"https://getbootstrap.com/docs/4.6/components/progress/"},{"en":"Scrollspy","href":"https://getbootstrap.com/docs/4.6/components/scrollspy/"},{"en":"Spinners","href":"https://getbootstrap.com/docs/4.6/components/spinners/"},{"en":"Toasts","href":"https://getbootstrap.com/docs/4.6/components/toasts/"},{"en":"Tooltips","href":"https://getbootstrap.com/docs/4.6/components/tooltips/"},{"en":"Utilities","href":"https://getbootstrap.com/docs/4.6/utilities/borders/"},{"en":"Extend","href":"https://getbootstrap.com/docs/4.6/extend/approach/"},{"en":"Migration","href":"https://getbootstrap.com/docs/4.6/migration/"},{"en":"About","href":"https://getbootstrap.com/docs/4.6/about/overview/"},{"en":"End of Life","href":"https://getbootstrap.com/docs/4.6/end-of-life/"}],"standalone":false,"publishedAssets":[{"url":"/docs/4.6/dist/css/bootstrap.min.css","integrity":"sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N"},{"url":"https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","integrity":"sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"},{"url":"/docs/4.6/dist/js/bootstrap.bundle.min.js","integrity":"sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-
assets/js/ie10-viewport-bug-workaround.js\"></script>\n  \n\n","classes":"","dir":"ltr"},"publishedAssets":[{"url":"https://code.jquery.com/jquery-1.12.4.min.js","integrity":"sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ"}],"sourceScripts":["https://getbootstrap.com/docs/3.4/assets/js/ie-emulation-modes-warning.js","https://code.jquery.com/jquery-1.12.4.min.js","https://getbootstrap.com/docs/3.4/dist/js/bootstrap.min.js","https://getbootstrap.com/docs/3.4/assets/js/ie10-viewport-bug-workaround.js"],"sourceStyles":["https://getbootstrap.com/docs/3.4/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/3.4/assets/css/ie10-viewport-bug-workaround.css","https://getbootstrap.com/docs/3.4/examples/navbar/navbar.css"]}

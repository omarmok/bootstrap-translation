aph-54","type":"paragraph","en":".underline-thickness-5"}]},{"type":"td","body":[{"id":"content--paragraph-55","type":"paragraph","en":"text-decoration-thickness: 5px;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-56","type":"paragraph","en":".text-decoration-none"}]},{"type":"td","body":[{"id":"content--paragraph-57","type":"paragraph","en":"text-decoration: none;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-58","type":"paragraph","en":".text-decoration-underline"}]},{"type":"td","body":[{"id":"content--paragraph-59","type":"paragraph","en":"text-decoration: underline;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-60","type":"paragraph","en":".text-decoration-line-through"}]},{"type":"td","body":[{"id":"content--paragraph-61","type":"paragraph","en":"text-decoration: line-through;"}]}]}]},{"id":"text-decoration","type":"heading","en":"Text decoration","level":2},{"id":"text-decoration--paragraph-1","type":"paragraph","en":"Decorate text in components with text decoration classes."},{"id":"text-decoration--example-1","type":"demo","key":"a42211e9e807ce598bd2","height":201},{"id":"text-decoration--code-1","type":"code","value":"<p class=\"text-decoration-underline\">This text has a line underneath it.</p>\n<p class=\"text-decoration-line-through\">This text has a line going through it.</p>\n<a href=\"#\" class=\"text-decoration-none\">This link has its text decoration removed</a>","language":""},{"id":"underline","type":"heading","en":"Underline","level":2},{"id":"offset","type":"heading","en":"Offset","level":3},{"id":"offset--paragraph-1","type":"paragraph","en":"Change the underline’s distance from your text. Offset is set in <code>em</code> units to automatically scale with the element’s current <code>font-size</code>."},{"id":"offset--example-1","type":"demo","key":"67650ee2d76a3e0e54f8","height":228},{"id":"offset--code-1","type":"code","value":"<p><a href=\"#\">Default link</a></p>\n<p><a class=\"underline-offset-1\" href=\"#\">Offset 1 link</a></p>\n<p><a class=\"underline-offset-2\" href=\"#\">Offset 2 link</a></p>\n<p><a class=\"underline-offset-3\" href=\"#\">Offset 3 link</a></p>","language":""},{"id":"color","type":"heading","en":"Color","level":3},{"id":"color--paragraph-1","type":"paragraph","en":"Change the underline’s color independent of the text color."},{"id":"color--example-1","type":"demo","key":"c5039585182330c80eb2","height":300},{"id":"color--code-1","type":"code","value":"<p><a href=\"#\" class=\"underline-primary\">Primary underline</a></p>\n<p><a href=\"#\" class=\"underline-accent\">Accent underline</a></p>\n<p><a href=\"#\" class=\"underline-success\">Success underline</a></p>\n<p><a href=\"#\" class=\"underline-danger\">Danger underline</a></p>\n<p><a href=\"#\" class=\"underline-warning\">Warning underline</a></p>\n<p><a href=\"#\" class=\"underline-info\">Info underline</a></p>\n<p><a href=\"#\" class=\"underline-inverse\">Inverse underline</a></p>\n<p><a href=\"#\" class=\"underline-secondary\">Secondary underline</a></p>","language":""},{"id":"opacity","type":"heading","en":"Opacity","level":3},{"id":"opacity--paragraph-1","type":"paragraph","en":"Change the underline’s opacity. Fades the current text color by default, or pair with <code>.underline-{color}</code> to first set a color that the opacity is then mixed against."},{"id":"opacity--example-1","type":"demo","key":"34a481e3c22db6fdde79","height":300},{"id":"opacity--code-1","type":"code","value":"<p><a class=\"underline-10\" href=\"#\">Underline opacity 10</a></p>\n<p><a class=\"underline-20\" href=\"#\">Underline opacity 20</a></p>\n<p><a class=\"underline-30\" href=\"#\">Underline opacity 30</a></p>\n<p><a class=\"underline-40\" href=\"#\">Underline opacity 40</a></p>\n<p><a class=\"underline-50\" href=\"#\">Underline opacity 50</a></p>\n<p><a class=\"underline-60\" href=\"#\">Underline opacity 60</a></p>\n<p><a class=\"underline-70\" href=\"#\">Underline opacity 70</a></p>\n<p><a class=\"underline-80\" href=\"#\">Underline opacity 80</a></p>\n<p><a class=\"underline-90\" href=\"#\">Underline opacity 90</a></p>\n<p><a class=\"underline-100\" href=\"#\">Underline opacity 100</a></p>","language":""},{"id":"opacity--paragraph-2","type":"paragraph","en":"Pair an opacity class with a color class to fade that specific color instead of the default text color:"},{"id":"opacity--example-2","type":"demo","key":"25f28e4ee849b84bf045","height":147},{"id":"opacity--code-2","type":"code","value":"<a class=\"theme-success underline-success underline-30 hover:underline-80\" href=\"#\">Faded success underline</a>","language":""},{"id":"thickness","type":"heading","en":"Thickness","level":3},{"id":"thickness--paragraph-1","type":"paragraph","en":"Change the thickness of the underline."},{"id":"thickness--example-1","type":"demo","key":"b8a10c766c0f5ae90be9","height":300},{"id":"thickness--code-1","type":"code","value":"<p><a href=\"#\">Default link</a></p>\n<p><a class=\"underline-thickness-1\" href=\"#\">Thickness 1 link</a></p>\n<p><a class=\"underline-thickness-2\" href=\"#\">Thickness 2 link</a></p>\n<p><a class=\"underline-thickness-3\" href=\"#\">Thickness 3 link</a></p>\n<p><a class=\"underline-thickness-4\" href=\"#\">Thickness 4 link</a></p>\n<p><a class=\"underline-thickness-5\" href=\"#\">Thickness 5 link</a></p>","language":""},{"id":"hover-variants","type":"heading","en":"Hover variants","level":3},{"id":"hover-variants--paragraph-1","type":"paragraph","en":"The <code>.underline-offset</code>, <code>.underline-{N}</code>, and <code>.underline-thickness</code> utilities include <code>:hover</code> variants by default. Mix and match to create unique link styles."},{"id":"hover-variants--example-1","type":"demo","key":"a6a33821952702ebfac8","height":147},{"id":"hover-variants--code-1","type":"code","value":"<a class=\"underline-offset-2 hover:underline-offset-3 underline-10 hover:underline-50 hover:underline-thickness-2\" href=\"#\">\n  Underline with offset and opacity changes on hover\n</a>","language":""},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Text decoration utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"underline-offset\": (\n  property: text-underline-offset,\n  class: underline-offset,\n  state: hover,\n  values: (\n    1: .125em,\n    2: .25em,\n    3: .375em,\n  )\n),\n\"underline-color\": (\n  property: (\n    \"--underline-color\": null,\n    \"text-decoration-color\": var(--underline-color)\n  ),\n  class: underline,\n  values: theme-color-values(\"fg\"),\n),\n\"underline-opacity\": (\n  property: text-decoration-color,\n  class: underline,\n  state: hover,\n  values: theme-opacity-values(--underline-color, currentcolor)\n),\n\"underline-thickness\": (\n  property: text-decoration-thickness,\n  class: underline-thickness,\n  state: hover,\n  values: (\n    1: 1px,\n    2: 2px,\n    3: 3px,\n    4: 4px,\n    5: 5px,\n  )\n),","language":""}],"demos":[{"key":"a42211e9e807ce598bd2","html":"<p class=\"text-decoration-underline\">This text has a line underneath it.</p>\n<p class=\"text-decoration-line-through\">This text has a line going through it.</p>\n<a href=\"#\" class=\"text-decoration-none\">This link has its text decoration removed</a>","attrs":{"class":"bd-example"},"sprite":""},{"key":"67650ee2d76a3e0e54f8","html":"<p><a href=\"#\">Default link</a></p>\n<p><a class=\"underline-offset-1\" href=\"#\">Offset 1 link</a></p>\n<p><a class=\"underline-offset-2\" href=\"#\">Offset 2 link</a></p>\n<p><a class=\"underline-offset-3\" href=\"#\">Offset 3 link</a></p>","attrs":{"class":"bd-example"},"sprite":
{"route":"/docs/4.6/getting-started/contents/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"Contents","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/getting-started/contents.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Discover what’s included in Bootstrap, including our precompiled and source code flavors. Remember, Bootstrap’s JavaScript plugins require jQuery."},{"id":"precompiled-bootstrap","type":"heading","en":"Precompiled Bootstrap","level":2},{"id":"precompiled-bootstrap--paragraph-1","type":"paragraph","en":"Once downloaded, unzip the compressed folder and you’ll see something like this:"},{"id":"precompiled-bootstrap--code-1","type":"code","value":"bootstrap/\n├── css/\n│   ├── bootstrap-grid.css\n│   ├── bootstrap-grid.css.map\n│   ├── bootstrap-grid.min.css\n│   ├── bootstrap-grid.min.css.map\n│   ├── bootstrap-reboot.css\n│   ├── bootstrap-reboot.css.map\n│   ├── bootstrap-reboot.min.css\n│   ├── bootstrap-reboot.min.css.map\n│   ├── bootstrap.css\n│   ├── bootstrap.css.map\n│   ├── bootstrap.min.css\n│   └── bootstrap.min.css.map\n└── js/\n    ├── bootstrap.bundle.js\n    ├── bootstrap.bundle.js.map\n    ├── bootstrap.bundle.min.js\n    ├── bootstrap.bundle.min.js.map\n    ├── bootstrap.js\n    ├── bootstrap.js.map\n    ├── bootstrap.min.js\n    └── bootstrap.min.js.map","language":"text"},{"id":"precompiled-bootstrap--paragraph-2","type":"paragraph","en":"This is the most basic form of Bootstrap: precompiled files for quick drop-in usage in nearly any web project. We provide compiled CSS and JS (<code>bootstrap.*</code>), as well as compiled and minified CSS and JS (<code>bootstrap.min.*</code>). <a href=\"https://developers.google.com/web/tools/chrome-devtools/javascript/source-maps\">Source maps</a> (<code>bootstrap.*.map</code>) are available for use with certain browsers’ developer tools. Bundled JS files (<code>bootstrap.bundle.js</code> and minified <code>bootstrap.bundle.min.js</code>) include <a href=\"https://github.com/floating-ui/popper-docs/blob/main/docs/v1/index.md\">Popper</a>, but not <a href=\"https://jquery.com/\">jQuery</a>."},{"id":"css-files","type":"heading","en":"CSS files","level":2},{"id":"css-files--paragraph-1","type":"paragraph","en":"Bootstrap includes a handful of options for including some or all of our compiled CSS."},{"id":"css-files--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-2","type":"paragraph","en":"CSS files"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-3","type":"paragraph","en":"Layout"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-4","type":"paragraph","en":"Content"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-5","type":"paragraph","en":"Components"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-6","type":"paragraph","en":"Utilities"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"css-files--paragraph-7","type":"paragraph","en":"<code>bootstrap.css</code>"},{"id":"css-files--paragraph-8","type":"paragraph","en":"<code>bootstrap.min.css</code>"}]},{"type":"td","body":[{"id":"css-files--paragraph-9","type":"paragraph","en":"Included"}]},{"type":"td","body":[{"id":"css-files--paragraph-10","type":"paragraph","en":"Included"}]},{"type":"td","body":[{"id":"css-files--paragraph-11","type":"paragraph","en":"Included"}]},{"type":"td","body":[{"id":"css-files--paragraph-12","type":"paragraph","en":"Included"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"css-files--paragraph-13","type":"paragraph","en":"<code>bootstrap-grid.css</code>"},{"id":"css-files--paragraph-14","type":"paragraph","en":"<code>bootstrap-grid.min.css</code>"}]},{"type":"td","body":[{"id":"css-files--paragraph-15","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/4.6/layout/grid/\">Only grid system</a>"}]},{"type":"td","body":[{"id":"css-files--paragraph-16","type":"paragraph","en":"Not included"}]},{"type":"td","body":[{"id":"css-files--paragraph-17","type":"paragraph","en":"Not included"}]},{"type":"td","body":[{"id":"css-files--paragraph-18","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/4.6/utilities/flex/\">Only flex utilities</a>"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"css-files--paragraph-19","type":"paragraph","en":"<code>bootstrap-reboot.css</code>"},{"id":"css-files--paragraph-20","type":"paragraph","en":"<code>bootstrap-reboot.min.css</code>"}]},{"type":"td","body":[{"id":"css-files--paragraph-21","type":"paragraph","en":"Not included"}]},{"type":"td","body":[{"id":"css-files--paragraph-22","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/4.6/content/reboot/\">Only Reboot</a>"}]},{"type":"td","body":[{"id":"css-files--paragraph-23","type":"paragraph","en":"Not included"}]},{"type":"td","body":[{"id":"css-files--paragraph-24","type":"paragraph","en":"Not included"}]}]}]},{"id":"js-files","type":"heading","en":"JS files","level":2},{"id":"js-files--paragraph-1","type":"paragraph","en":"Similarly, we have options for including some or all of our compiled JavaScript."},{"id":"js-files--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"js-files--paragraph-2","type":"paragraph","en":"JS files"}]},{"type":"th","scope":"col","body":[{"id":"js-files--paragraph-3","type":"paragraph","en":"Popper"}]},{"type":"th","scope":"col","body":[{"id":"js-files--paragraph-4","type":"paragraph","en":"jQuery"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"js-files--paragraph-5","type":"paragraph","en":"<code>bootstrap.bundle.js</code>"},{"id":"js-files--paragraph-6","type":"paragraph","en":"<code>bootstrap.bundle.min.js</code>"}]},{"type":"td","body":[{"id":"js-files--paragraph-7","type":"paragraph","en":"Included"}]},{"type":"td","body":[{"id":"js-files--paragraph-8","type":"paragraph","en":"Not included"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"js-files--paragraph-9","type":"paragraph","en":"<code>bootstrap.js</code>"},{"id":"js-files--paragraph-10","type":"paragraph","en":"<code>bootstrap.min.js</code>"}]},{"type":"td","body":[{"id":"js-files--paragraph-11","type":"paragraph","en":"Not included"}]},{"type":"td","body":[{"id":"js-files--paragraph-12","type":"paragraph","en":"Not included"}]}]}]},{"id":"bootstrap-source-code","type":"heading","en":"Bootstrap source code","level":2},{"id":"bootstrap-source-code--paragraph-1","type":"paragraph","en":"The Bootstrap source code download includes the precompiled CSS and JavaScript assets, along with source Sass, JavaScript, and documentation. More specifically, it includes the following and more:"},{"id":"bootstrap-source-code--code-1","type":"code","value":"bootstrap/\n├── dist/\n│   ├── css/\n│   └── js/\n├── site/\n│   └── content/\n|       └── docs/\n|           └── 4.6/\n|               └── examples/\n├── js/\n└── scss/","language":"text"},{"id":"bootstrap-source-code--paragraph-2","type":"paragraph","en":"The <code>scss/</code> and <code>js/</code> are the source code for our CSS and JavaScript. The <code>dist/</code> folder includes everything listed in the precompiled download section above. The <code>site/docs/</code> folder includes the source code for our documentation, and <code>examples/</code> of Bootstrap usage. Beyond that, any other included file provides support for packages, license information, and development."}],"demos":[],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.6/getting-started/introduction/"},{"en":"Introduction","href":"https://getbootstrap.com/docs/4.6/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/4.6/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/4.6/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/4.6/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/4.6/getting-started/javascript/"},{"en":"Theming","href":"https://getbootstrap.com/docs/4.6/getting-started/theming/"},{"en":"Build tools","href":"https://getbootstrap.com/docs/4.6/getting-started/build-tools/"},{"en":"Webpack","href":"https://getbootstrap.com/docs/4.6/getting-started/webpack/"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/4.6/getting-started/accessibility/"},{"en":"Layout","href":"https://getbootstrap.com/docs/4.6/layout/overview/"},{"en":"Content","href":"https://getbootstrap.com/docs/4.6/content/reboot/"},{"en":"Components","href":"https://getbootstrap.com/docs/4.6/components/alerts/"},{"en":"Utilities","href":"https://getbootstrap.com/docs/4.6/utilities/borders/"},{"en":"Extend","href":"https://getbootstrap.com/docs/4.6/extend/approach/"},{"en":"Migration","href":"https://getbootstrap.com/docs/4.6/migration/"},{"en":"About","href":"https://getbootstrap.com/docs/4.6/about/overview/"},{"en":"End of Life","href":"https://getbootstrap.com/docs/4.6/end-of-life/"}],"standalone":false,"publishedAssets":[{"url":"/docs/4.6/dist/css/bootstrap.min.css","integrity":"sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N"},{"url":"https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","integrity":"sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"},{"url":"/docs/4.6/dist/js/bootstrap.bundle.min.js","integrity":"sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-analytics.com/analytics.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","https://getbootstrap.com/docs/4.6/dist/js/bootstrap.bundle.min.js","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.js","https://getbootstrap.com/docs/4.6/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/4.6/dist/css/bootstrap.min.css","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.css","https://getbootstrap.com/docs/4.6/assets/css/docs.css"]}

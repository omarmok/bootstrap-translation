{"route":"/docs/6.0/forms/input-group/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Input group","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Easily extend form controls by adding text, buttons, or button groups on either side of textual inputs, custom selects, and custom file inputs."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"Input groups attach add-on elements to a textual input field. Add-ons can be text, buttons, or button groups. Add labels, help text, and validation styles with <a href=\"https://getbootstrap.com/docs/6.0/forms/field\">form fields</a>."},{"id":"content--example-1","type":"demo","key":"5f493b3664ef7e1c8191","height":174,"anchors":["basic-addon1","basic-addon2"]},{"id":"content--code-1","type":"code","value":"<div class=\"input-group\">\n  <span class=\"input-group-text\" id=\"basic-addon1\">@</span>\n  <input type=\"text\" class=\"form-control\" placeholder=\"Username\" aria-label=\"Username\" aria-describedby=\"basic-addon1\">\n</div>\n\n<div class=\"input-group\">\n  <input type=\"text\" class=\"form-control\" placeholder=\"Recipient’s username\" aria-label=\"Recipient’s username\" aria-describedby=\"basic-addon2\">\n  <span class=\"input-group-text\" id=\"basic-addon2\">@example.com</span>\n</div>","language":""},{"id":"examples","type":"heading","en":"Examples","level":2},{"id":"examples--paragraph-1","type":"paragraph","en":"Place one add-on or button on either side of an input. You may also place one on both sides of an input. Remember to place <code>&lt;label&gt;</code>s outside the input group."},{"id":"with-form-field","type":"heading","en":"With form field","level":2},{"id":"with-form-field--paragraph-1","type":"paragraph","en":"Wrap an <code>.input-group</code> in a <code>.form-field</code> to pair it with a label and description text."},{"id":"with-form-field--example-1","type":"demo","key":"23431320a1c352e81b90","height":147,"anchors":["inputGroupField"]},{"id":"with-form-field--code-1","type":"code","value":"<div class=\"form-field\">\n  <label for=\"inputGroupField\" class=\"form-label\">Your vanity URL</label>\n  <div class=\"input-group\">\n    <span class=\"input-group-text\">https://example.com/</span>\n    <input type=\"text\" class=\"form-control\" id=\"inputGroupField\" placeholder=\"username\">\n  </div>\n  <small class=\"form-text\">Choose a unique URL for your profile.</small>\n</div>","language":""},{"id":"buttons","type":"heading","en":"Buttons","level":3},{"id":"buttons--paragraph-1","type":"paragraph","en":"Use <a href=\"https://getbootstrap.com/docs/6.0/components/buttons\">buttons</a> instead of addons for supporting interactive options."},{"id":"buttons--example-1","type":"demo","key":"238d5de8f24c55563835","height":147,"anchors":["button-addon"]},{"id":"buttons--code-1","type":"code","value":"<div class=\"input-group\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" id=\"button-addon\">Button</button>\n  <input type=\"text\" class=\"form-control\" placeholder=\"\" aria-label=\"Example text with button addon\" aria-describedby=\"button-addon\">\n</div>","language":""},{"id":"textarea","type":"heading","en":"Textarea","level":3},{"id":"textarea--paragraph-1","type":"paragraph","en":"Input groups adapt to the height of textarea elements."},{"id":"textarea--example-1","type":"demo","key":"07a314547a360ce56caa","height":147},{"id":"textarea--code-1","type":"code","value":"<div class=\"input-group\">\n  <span class=\"input-group-text\">With textarea</span>\n  <textarea class=\"form-control\" aria-label=\"With textarea\"></textarea>\n</div>","language":""},{"id":"select","type":"heading","en":"Select","level":3},{"id":"select--example-1","type":"demo","key":"6d01eeddc961ab121834","height":228,"anchors":["inputGroupSelect01","inputGroupSelect02","inputGroupSelect03","inputGroupSelect04"]},{"id":"select--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <label class=\"input-group-text\" for=\"inputGroupSelect01\">Options</label>\n  <select class=\"form-control\" id=\"inputGroupSelect01\">\n    <option selected>Choose...</option>\n    <option value=\"1\">One</option>\n    <option value=\"2\">Two</option>\n    <option value=\"3\">Three</option>\n  </select>\n</div>\n\n<div class=\"input-group mb-3\">\n  <select class=\"form-control\" id=\"inputGroupSelect02\">\n    <option selected>Choose...</option>\n    <option value=\"1\">One</option>\n    <option value=\"2\">Two</option>\n    <option value=\"3\">Three</option>\n  </select>\n  <label class=\"input-group-text\" for=\"inputGroupSelect02\">Options</label>\n</div>\n\n<div class=\"input-group mb-3\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\">Button</button>\n  <select class=\"form-control\" id=\"inputGroupSelect03\" aria-label=\"Example select with button addon\">\n    <option selected>Choose...</option>\n    <option value=\"1\">One</option>\n    <option value=\"2\">Two</option>\n    <option value=\"3\">Three</option>\n  </select>\n</div>\n\n<div class=\"input-group\">\n  <select class=\"form-control\" id=\"inputGroupSelect04\" aria-label=\"Example select with button addon\">\n    <option selected>Choose...</option>\n    <option value=\"1\">One</option>\n    <option value=\"2\">Two</option>\n    <option value=\"3\">Three</option>\n  </select>\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\">Button</button>\n</div>","language":""},{"id":"file-input","type":"heading","en":"File input","level":3},{"id":"file-input--example-1","type":"demo","key":"0419570a9beba8d74803","height":228,"anchors":["inputGroupFile01","inputGroupFile02","inputGroupFileAddon03","inputGroupFile03","inputGroupFile04","inputGroupFileAddon04"]},{"id":"file-input--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <label class=\"input-group-text\" for=\"inputGroupFile01\">Upload</label>\n  <input type=\"file\" class=\"form-control\" id=\"inputGroupFile01\">\n</div>\n\n<div class=\"input-group mb-3\">\n  <input type=\"file\" class=\"form-control\" id=\"inputGroupFile02\">\n  <label class=\"input-group-text\" for=\"inputGroupFile02\">Upload</label>\n</div>\n\n<div class=\"input-group mb-3\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" id=\"inputGroupFileAddon03\">Button</button>\n  <input type=\"file\" class=\"form-control\" id=\"inputGroupFile03\" aria-describedby=\"inputGroupFileAddon03\" aria-label=\"Upload\">\n</div>\n\n<div class=\"input-group\">\n  <input type=\"file\" class=\"form-control\" id=\"inputGroupFile04\" aria-describedby=\"inputGroupFileAddon04\" aria-label=\"Upload\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" id=\"inputGroupFileAddon04\">Button</button>\n</div>","language":""},{"id":"checkboxes-and-radios","type":"heading","en":"Checkboxes and radios","level":3},{"id":"checkboxes-and-radios--paragraph-1","type":"paragraph","en":"Place any checkbox or radio within an input group’s addon instead of text."},{"id":"checkboxes-and-radios--example-1","type":"demo","key":"9ff3ff99ad0ace947c7e","height":174},{"id":"checkboxes-and-radios--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <div class=\"input-group-text\">\n    <input type=\"checkbox\" class=\"check\" aria-label=\"Checkbox for following text input\">\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with checkbox\">\n</div>\n\n<div class=\"input-group\">\n  <div class=\"input-group-text\">\n    <input type=\"radio\" class=\"radio\" aria-label=\"Radio button for following text input\">\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with radio button\">\n</div>","language":""},{"id":"multiple-inputs","type":"heading","en":"Multiple inputs","level":3},{"id":"multiple-inputs--paragraph-1","type":"paragraph","en":"While multiple <code>&lt;input&gt;</code>s are supported visually, validation styles are only available for input groups with a single <code>&lt;input&gt;</code>."},{"id":"multiple-inputs--example-1","type":"demo","key":"dfb648695ff5e034a17f","height":201},{"id":"multiple-inputs--code-1","type":"code","value":"<div class=\"input-group\">\n  <input type=\"text\" aria-label=\"First name\" class=\"form-control\">\n  <input type=\"text\" aria-label=\"Middle name\" class=\"form-control\">\n  <input type=\"text\" aria-label=\"Last name\" class=\"form-control\">\n</div>\n\n<div class=\"input-group\">\n  <span class=\"input-group-text\">First and last name</span>\n  <input type=\"text\" aria-label=\"First name\" class=\"form-control\">\n  <input type=\"text\" aria-label=\"Last name\" class=\"form-control\">\n</div>\n\n<div class=\"input-group\">\n    <input type=\"text\" class=\"form-control\" placeholder=\"Username\" aria-label=\"Username\">\n  <span class=\"input-group-text\">@</span>\n  <input type=\"text\" class=\"form-control\" placeholder=\"Server\" aria-label=\"Server\">\n</div>","language":""},{"id":"multiple-addons","type":"heading","en":"Multiple addons","level":3},{"id":"multiple-addons--paragraph-1","type":"paragraph","en":"Multiple add-ons are supported and can be mixed with checkbox and radio input versions."},{"id":"multiple-addons--example-1","type":"demo","key":"abd3f475d8ababf523fd","height":201},{"id":"multiple-addons--code-1","type":"code","value":"<div class=\"input-group\">\n  <span class=\"input-group-text\">$</span>\n  <span class=\"input-group-text\">0.00</span>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Dollar amount (with dot and two decimal places)\">\n</div>\n\n<div class=\"input-group\">\n  <input type=\"text\" class=\"form-control\" aria-label=\"Dollar amount (with dot and two decimal places)\">\n  <span class=\"input-group-text\">$</span>\n  <span class=\"input-group-text\">0.00</span>\n</div>\n\n<div class=\"input-group\">\n  <span class=\"input-group-text\">$</span>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Amount (to the nearest dollar)\">\n  <span class=\"input-group-text\">.00</span>\n</div>","language":""},{"id":"button-addons","type":"heading","en":"Button addons","level":3},{"id":"button-addons--example-1","type":"demo","key":"9d7cdce0fa3cb010afdd","height":228,"anchors":["button-addon1","button-addon2"]},{"id":"button-addons--code-1","type":"code","value":"<div class=\"input-group\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" id=\"button-addon1\">Button</button>\n  <input type=\"text\" class=\"form-control\" placeholder=\"\" aria-label=\"Example text with button addon\" aria-describedby=\"button-addon1\">\n</div>\n\n<div class=\"input-group mb-3\">\n  <input type=\"text\" class=\"form-control\" placeholder=\"Recipient’s username\" aria-label=\"Recipient’s username\" aria-describedby=\"button-addon2\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" id=\"button-addon2\">Button</button>\n</div>\n\n<div class=\"input-group mb-3\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\">Button</button>\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\">Button</button>\n  <input type=\"text\" class=\"form-control\" placeholder=\"\" aria-label=\"Example text with two button addons\">\n</div>\n\n<div class=\"input-group\">\n  <input type=\"text\" class=\"form-control\" placeholder=\"Recipient’s username\" aria-label=\"Recipient’s username with two button addons\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\">Button</button>\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\">Button</button>\n</div>","language":""},{"id":"buttons-with-menus","type":"heading","en":"Buttons with menus","level":3},{"id":"buttons-with-menus--example-1","type":"demo","key":"3d7495d286ebb69a015e","height":201},{"id":"buttons-with-menus--code-1","type":"code","value":"<div class=\"input-group\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" data-bs-toggle=\"menu\" aria-expanded=\"false\">Menu</button>\n  <div class=\"menu\">\n    <a class=\"menu-item\" href=\"#\">Action</a>\n    <a class=\"menu-item\" href=\"#\">Another action</a>\n    <a class=\"menu-item\" href=\"#\">Something else here</a>\n    <hr class=\"menu-divider\">\n    <a class=\"menu-item\" href=\"#\">Separated link</a>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with menu button\">\n</div>\n\n<div class=\"input-group\">\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with menu button\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" data-bs-toggle=\"menu\" data-bs-placement=\"bottom-end\" aria-expanded=\"false\">Menu</button>\n  <div class=\"menu\">\n    <a class=\"menu-item\" href=\"#\">Action</a>\n    <a class=\"menu-item\" href=\"#\">Another action</a>\n    <a class=\"menu-item\" href=\"#\">Something else here</a>\n    <hr class=\"menu-divider\">\n    <a class=\"menu-item\" href=\"#\">Separated link</a>\n  </div>\n</div>\n\n<div class=\"input-group\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" data-bs-toggle=\"menu\" aria-expanded=\"false\">Menu</button>\n  <div class=\"menu\">\n    <a class=\"menu-item\" href=\"#\">Action before</a>\n    <a class=\"menu-item\" href=\"#\">Another action before</a>\n    <a class=\"menu-item\" href=\"#\">Something else here</a>\n    <hr class=\"menu-divider\">\n    <a class=\"menu-item\" href=\"#\">Separated link</a>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with 2 menu buttons\">\n  <button class=\"btn-outline theme-secondary input-group-btn\" type=\"button\" data-bs-toggle=\"menu\" data-bs-placement=\"bottom-end\" aria-expanded=\"false\">Menu</button>\n  <div class=\"menu\">\n    <a class=\"menu-item\" href=\"#\">Action</a>\n    <a class=\"menu-item\" href=\"#\">Another action</a>\n    <a class=\"menu-item\" href=\"#\">Something else here</a>\n    <hr class=\"menu-divider\">\n    <a class=\"menu-item\" href=\"#\">Separated link</a>\n  </div>\n</div>","language":""},{"id":"segmented-buttons","type":"heading","en":"Segmented buttons","level":3},{"id":"segmented-buttons--example-1","type":"demo","key":"31584ab1ba903650ceab","height":174},{"id":"segmented-buttons--code-1","type":"code","value":"<div class=\"input-group mb-3\">\n  <button type=\"button\" class=\"btn-outline theme-secondary input-group-btn\">Action</button>\n  <button type=\"button\" class=\"btn-outline theme-secondary input-group-btn menu-toggle-split\" data-bs-toggle=\"menu\" aria-expanded=\"false\">\n    <span class=\"visually-hidden\">Toggle Menu</span>\n    <svg class=\"bi\"><use href=\"#chevron-expand\"></use></svg>\n  </button>\n  <div class=\"menu\">\n    <a class=\"menu-item\" href=\"#\">Action</a>\n    <a class=\"menu-item\" href=\"#\">Another action</a>\n    <a class=\"menu-item\" href=\"#\">Something else here</a>\n    <hr class=\"menu-divider\">\n    <a class=\"menu-item\" href=\"#\">Separated link</a>\n  </div>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with segmented menu button\">\n</div>\n\n<div class=\"input-group\">\n  <input type=\"text\" class=\"form-control\" aria-label=\"Text input with segmented menu button\">\n  <button type=\"button\" class=\"btn-outline theme-secondary input-group-btn\">Action</button>\n  <button type=\"button\" class=\"btn-outline theme-secondary input-group-btn menu-toggle-split\" data-bs-toggle=\"menu\" data-bs-placement=\"bottom-end\" aria-expanded=\"false\">\n    <span class=\"visually-hidden\">Toggle Menu</span>\n    <svg class=\"bi\"><use href=\"#chevron-expand\"></use></svg>\n  </button>\n  <div class=\"menu\">\n    <a class=\"menu-item\" href=\"#\">Action</a>\n    <a class=\"menu-item\" href=\"#\">Another action</a>\n    <a class=\"menu-item\" href=\"#\">Something else here</a>\n    <hr class=\"menu-divider\">\n    <a class=\"menu-item\" href=\"#\">Separated link</a>\n  </div>\n</div>","language":""},{"id":"border-radius","type":"heading","en":"Border radius","level":2},{"id":"border-radius--paragraph-1","type":"paragraph","en":"Sometimes building these components gets complicated, and CSS selectors can only do so much. We’ve accounted for most of the common use cases, but in case you need to provide an extra element and skip the border-radius logic, add the <code>.input-group-ignore</code> class to the element."},{"id":"border-radius--paragraph-2","type":"paragraph","en":"Consider this extra hidden input example:"},{"id":"border-radius--example-1","type":"demo","key":"7cfc9ec183700ff5bf44","height":147,"anchors":["visible-addon"]},{"id":"border-radius--code-1","type":"code","value":"<div class=\"input-group\">\n  <span class=\"input-group-text\" id=\"visible-addon\">@</span>\n  <input type=\"text\" class=\"form-control\" placeholder=\"Username\" aria-label=\"Username\" aria-describedby=\"visible-addon\">\n  <input type=\"text\" class=\"form-control input-group-ignore d-none\" placeholder=\"Hidden input\" aria-label=\"Hidden input\" aria-describedby=\"visible-addon\">\n</div>","language":""},{"id":"sizing","type":"heading","en":"Sizing","level":2},{"id":"sizing--paragraph-1","type":"paragraph","en":"Add the relative form sizing classes to the <code>.input-group</code> itself and contents within will automatically resize—no need for repeating the form control size classes on each element."},{"id":"sizing--paragraph-2","type":"paragraph","en":"<strong>Sizing on the individual input group elements isn’t supported.</strong>"},{"id":"sizing--example-1","type":"demo","key":"fc2c89922a4f0945bf40","height":201,"anchors":["inputGroup-sizing-sm","inputGroup-sizing-default","inputGroup-sizing-lg"]},{"id":"sizing--code-1","type":"code","value":"<div class=\"input-group input-group-sm\">\n  <span class=\"input-group-text\" id=\"inputGroup-sizing-sm\">Small</span>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Sizing example input\" aria-describedby=\"inputGroup-sizing-sm\">\n</div>\n\n<div class=\"input-group\">\n  <span class=\"input-group-text\" id=\"inputGroup-sizing-default\">Default</span>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Sizing example input\" aria-describedby=\"inputGroup-sizing-default\">\n</div>\n\n<div class=\"input-group input-group-lg\">\n  <span class=\"input-group-text\" id=\"inputGroup-sizing-lg\">Large</span>\n  <input type=\"text\" class=\"form-control\" aria-label=\"Sizing example input\" aria-describedby=\"inputGroup-sizing-lg\">\n</div>","language":""},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--paragraph-1","type":"paragraph","en":"Input group addons use local CSS variables on <code>.input-group-text</code> for real-time customization. Values for the CSS variables are generated from Sass maps unique to each component and applied to the aforementioned class."},{"id":"variables--code-1","type":"code","value":"// stylelint-disable-next-line scss/dollar-variable-default\n$input-group-addon-tokens: defaults(\n  (\n    --input-group-addon-padding-y: var(--btn-input-padding-y),\n    --input-group-addon-padding-x: var(--btn-input-padding-x),\n    --input-group-addon-font-size: var(--btn-input-font-size),\n    --input-group-addon-line-height: var(--btn-input-line-height),\n    --input-group-addon-color: var(--fg-body),\n    --input-group-addon-bg: var(--bg-2),\n    --input-group-addon-border-color: var(--border-color),\n  ),\n  $input-group-addon-tokens\n);","language":""},{"id":"sass-list","type":"heading","en":"Sass list","level":3},{"id":"sass-list--paragraph-1","type":"paragraph","en":"We use a Sass list to define the sizes of the input group, so you can easily add or modify sizes by fetching the associated
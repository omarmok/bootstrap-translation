{"route":"/docs/4.6/content/code/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"Code","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/content/code.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Documentation and examples for displaying inline and multiline blocks of code with Bootstrap."},{"id":"inline-code","type":"heading","en":"Inline code","level":2},{"id":"inline-code--paragraph-1","type":"paragraph","en":"Wrap inline snippets of code with <code>&lt;code&gt;</code>. Be sure to escape HTML angle brackets."},{"id":"inline-code--example-1","type":"demo","key":"7c30aac17d3aae83d908","height":147},{"id":"inline-code--code-1","type":"code","value":"For example, <code>&lt;section&gt;</code> should be wrapped as inline.","language":"html"},{"id":"code-blocks","type":"heading","en":"Code blocks","level":2},{"id":"code-blocks--paragraph-1","type":"paragraph","en":"Use <code>&lt;pre&gt;</code>s for multiple lines of code. Once again, be sure to escape any angle brackets in the code for proper rendering. You may optionally add the <code>.pre-scrollable</code> class, which will set a max-height of 340px and provide a y-axis scrollbar."},{"id":"code-blocks--example-1","type":"demo","key":"d83a8e2f6b5649a0d50b","height":147},{"id":"code-blocks--code-1","type":"code","value":"<pre><code>&lt;p&gt;Sample text here...&lt;/p&gt;\n&lt;p&gt;And another line of sample text here...&lt;/p&gt;\n</code></pre>","language":"html"},{"id":"variables","type":"heading","en":"Variables","level":2},{"id":"variables--paragraph-1","type":"paragraph","en":"For indicating variables use the <code>&lt;var&gt;</code> tag."},{"id":"variables--example-1","type":"demo","key":"98a6e0712753d21a90da","height":228},{"id":"variables--code-1","type":"code","value":"<var>y</var> = <var>m</var><var>x</var> + <var>b</var>","language":"html"},{"id":"user-input","type":"heading","en":"User input","level":2},{"id":"user-input--paragraph-1","type":"paragraph","en":"Use the <code>&lt;kbd&gt;</code> to indicate input that is typically entered via keyboard."},{"id":"user-input--example-1","type":"demo","key":"7a97a62ca026fc5bffe5","height":201},{"id":"user-input--code-1","type":"code","value":"To switch directories, type <kbd>cd</kbd> followed by the name of the directory.<br>\nTo edit settings, press <kbd><kbd>ctrl</kbd> + <kbd>,</kbd></kbd>","language":"html"},{"id":"sample-output","type":"heading","en":"Sample output","level":2},{"id":"sample-output--paragraph-1","type":"paragraph","en":"For indicating sample output from a program use the <code>&lt;samp&gt;</code> tag."},{"id":"sample-output--example-1","type":"demo","key":"c489bcb06cb1a07f46f5","height":147},{"id":"sample-output--code-1","type":"code","value":"<samp>This text is meant to be treated as sample output from a computer program.</samp>","language":"html"}],"demos":[{"key":"7c30aac17d3aae83d908","html":"\nFor example, <code>&lt;section&gt;</code> should be wrapped as inline.\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"d83a8e2f6b5649a0d50b","html":"\n<pre><code>&lt;p&gt;Sample text here...&lt;/p&gt;\n&lt;p&gt;And another line of sample text here...&lt;/p&gt;\n</code></pre>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"98a6e0712753d21a90da","html":"\n<var>y</var> = <var>m</var><var>x</var> + <var>b</var>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"7a97a62ca026fc5bffe5","html":"\nTo switch directories, type <kbd>cd</kbd> followed by the name of the directory.<br>\nTo edit settings, press <kbd><kbd>ctrl</kbd> + <kbd>,</kbd></kbd>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"c489bcb06cb1a07f46f5","html":"\n<samp>This text is meant to be treated as sample output from a computer program.</samp>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Getting started","href":"https://getbootstrap.com
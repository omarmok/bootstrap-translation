{"route":"/docs/5.1/utilities/opacity/","version":"5.1","renderedVersion":"5.1","title":{"id":"content","type":"heading","en":"Opacity","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Control the opacity of elements."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"The <code>opacity</code> property sets the opacity level for an element. The opacity level describes the transparency level, where <code>1</code> is not transparent at all, <code>.5</code> is 50% visible, and <code>0</code> is completely transparent."},{"id":"content--paragraph-3","type":"paragraph","en":"Set the <code>opacity</code> of an element using <code>.opacity-{value}</code> utilities."},{"id":"content--example-1","type":"demo","key":"8c8f17617a23581df6e2","height":228},{"id":"content--code-1","type":"code","value":"<div class=\"opacity-100\">...</div>\n<div class=\"opacity-75\">...</div>\n<div class=\"opacity-50\">...</div>\n<div class=\"opacity-25\">...</div>","language":"html"},{"id":"utilities-api","type":"heading","en":"Utilities API","level":3},{"id":"utilities-api--paragraph-1","type":"paragraph","en":"Opacity utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/5.1/utilities/api/#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"utilities-api--code-1","type":"code","value":"    \"opacity\": (\n      property: opacity,\n      values: (\n        0: 0,\n        25: .25,\n        50: .5,\n        75: .75,\n        100: 1,\n      )\n    ),","language":"scss"}],"demos":[{"key":"8c8f17617a23581df6e2","html":"\n  <div class=\"opacity-100 p-3 m-2 bg-primary text-light fw-bold rounded\">100%</div>\n  <div class=\"opacity-75 p-3 m-2 bg-primary text-light fw-bold rounded\">75%</div>\n  <div class=\"opacity-50 p-3 m-2 bg-primary text-light fw-bold rounded\">50%</div>\n  <div class=\"opacity-25 p-3 m-2 bg-primary text-light fw-bold rounded\">25%</div>\n","attrs":{"class":"bd-examp
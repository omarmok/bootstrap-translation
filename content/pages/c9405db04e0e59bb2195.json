{"route":"/docs/4.6/about/license/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"License FAQs","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/about/license.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Commonly asked questions about Bootstrap’s open source license."},{"id":"content--paragraph-2","type":"paragraph","en":"Bootstrap is released under the MIT license and is copyright 2024 Twitter. Boiled down to smaller chunks, it can be described with the following conditions."},{"id":"it-requires-you-to","type":"heading","en":"It requires you to:","level":4},{"id":"it-requires-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-requires-you-to--item-1","type":"item","en":"Keep the license and copyright notice included in Bootstrap’s CSS and JavaScript files when you use them in your works"}]}]},{"id":"it-permits-you-to","type":"heading","en":"It permits you to:","level":4},{"id":"it-permits-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-permits-you-to--item-1","type":"item","en":"Freely download and use Bootstrap, in whole or in part, for personal, private, company internal, or commercial purposes"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-2","type":"item","en":"Use Bootstrap in packages or distributions that you create"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-3","type":"item","en":"Modify the source code"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-4","type":"item","en":"Grant a sublicense to modify and distribute Bootstrap to third parties not included in the license"}]}]},{"id":"it-forbids-you-to","type":"heading","en":"It forbids you to:","level":4},{"id":"it-forbids-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-forbids-you-to--item-1","type":"item","en":"Hold the authors and license owners liable for damages as Bootstrap is provided without warranty"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-2","type":"item","en":"Hold the creators or copyright holders of Bootstrap liable"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-3","type":"item","en":"Redistribute any piece of Bootstrap without proper attribution"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-4","type":"item","en":"Use any marks owned by Twitter in any way that might state or imply that Twitter endorses your distribution"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-5","type":"item","en":"Use any marks owned by Twitter in any way that might state or imply that you created the Twitter software in question"}]}]},{"id":"it-does-not-require-you-to","type":"heading","en":"It does not require you to:","level":4},{"id":"it-does-not-require-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-does-not-require-you-to--item-1","type":"item","en":"Include the source of Bootstrap itself, or of any modifications you may have made to it, in any redistribution you may assemble that includes it"}]},{"tag":"li","body":[{"id":"it-does-not-require-you-to--item-2","type":"item","en":"Submit changes that you make to Bootstrap back to the Bootstrap project (though such feedback is encouraged)"}]}]},{"id":"it-does-not-require-you-to--paragraph-1","type":"paragraph","en":"The full Bootstrap license is located <a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/LICENSE\">in the project repository</a> for more information."}],"demos":[],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.6/getting-started/introduction/"},{"en":"Layout","href":"https://getbootstrap.com/docs/4.6/layout/overview/"},{"en":"Content","href":"https://getbootstrap.com/docs/4.6/content/reboot/"},{"en":"Components","href":"https://getbootstrap.com/docs/4.6/components/alerts/"},{"en":"Utilities","href":"https://getbootstrap.
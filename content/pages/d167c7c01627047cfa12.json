{"route":"/docs/5.0/about/license/","version":"5.0","renderedVersion":"5.0","title":{"id":"content","type":"heading","en":"License FAQs","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Commonly asked questions about Bootstrap’s open source license."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"Bootstrap is released under the MIT license and is copyright 2021 Twitter. Boiled down to smaller chunks, it can be described with the following conditions."},{"id":"it-requires-you-to","type":"heading","en":"It requires you to:","level":2},{"id":"it-requires-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-requires-you-to--item-1","type":"item","en":"Keep the license and copyright notice included in Bootstrap’s CSS and JavaScript files when you use them in your works"}]}]},{"id":"it-permits-you-to","type":"heading","en":"It permits you to:","level":2},{"id":"it-permits-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-permits-you-to--item-1","type":"item","en":"Freely download and use Bootstrap, in whole or in part, for personal, private, company internal, or commercial purposes"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-2","type":"item","en":"Use Bootstrap in packages or distributions that you create"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-3","type":"item","en":"Modify the source code"}]},{"tag":"li","body":[{"id":"it-permits-you-to--item-4","type":"item","en":"Grant a sublicense to modify and distribute Bootstrap to third parties not included in the license"}]}]},{"id":"it-forbids-you-to","type":"heading","en":"It forbids you to:","level":2},{"id":"it-forbids-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-forbids-you-to--item-1","type":"item","en":"Hold the authors and license owners liable for damages as Bootstrap is provided without warranty"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-2","type":"item","en":"Hold the creators or copyright holders of Bootstrap liable"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-3","type":"item","en":"Redistribute any piece of Bootstrap without proper attribution"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-4","type":"item","en":"Use any marks owned by Twitter in any way that might state or imply that Twitter endorses your distribution"}]},{"tag":"li","body":[{"id":"it-forbids-you-to--item-5","type":"item","en":"Use any marks owned by Twitter in any way that might state or imply that you created the Twitter software in question"}]}]},{"id":"it-does-not-require-you-to","type":"heading","en":"It does not require you to:","level":2},{"id":"it-does-not-require-you-to--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"it-does-not-require-you-to--item-1","type":"item","en":"Include the source of Bootstrap itself, or of any modifications you may have made to it, in any redistribution you may assemble that includes it"}]},{"tag":"li","body":[{"id":"it-does-not-require-you-to--item-2","type":"item","en":"Submit changes that you make to Bootstrap back to the Bootstrap project (though such feedback is encouraged)"}]}]},{"id":"it-does-not-require-you-to--paragraph-1","type":"paragraph","en":"The full Bootstrap license is located <a href=\"https://github.com/twbs/bootstrap/blob/v5.0.2/LICENSE\">in the project repository</a> for more information."}],"demos":[],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.0/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/5.0/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.0/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/5.0/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/5.0/getting-started/javascript/"},{"en":"Build tools","href":"https://getbootstrap.com/docs/5.0/getting-started/build
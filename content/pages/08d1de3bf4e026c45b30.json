-muted\">© 2017–2021</p>\n  </form>\n</main>\n\n    \n  \n\n","classes":"text-center","dir":"ltr"},"publishedAssets":[{"url":"/docs/5.1/dist/css/bootstrap.min.css","integrity":"sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3"}],"sourceScripts":[],"sourceStyles":["https://getbootstrap.com/docs/5.1/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/5.1/examples/sign-in/signin.css"]}

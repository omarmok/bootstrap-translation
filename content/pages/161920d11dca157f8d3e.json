d","body":[{"id":"how-they-work--paragraph-47","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-48","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-49","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-50","type":"paragraph","en":"1140px"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-51","type":"paragraph","en":"1440px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"how-they-work--paragraph-52","type":"paragraph","en":"<code>.2xl:container</code>"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-53","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-54","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-55","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-56","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-57","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-58","type":"paragraph","en":"1440px"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"how-they-work--paragraph-59","type":"paragraph","en":"<code>.container-fluid</code>"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-60","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-61","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-62","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-63","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-64","type":"paragraph","en":"100%"}]},{"type":"td","body":[{"id":"how-they-work--paragraph-65","type":"paragraph","en":"100%"}]}]}]},{"id":"default-container","type":"heading","en":"Default container","level":2},{"id":"default-container--paragraph-1","type":"paragraph","en":"Our default <code>.container</code> class is a responsive, fixed-width container, meaning its <code>max-width</code> changes at each breakpoint."},{"id":"default-container--code-1","type":"code","value":"<div class=\"container\">\n  <!-- Content here -->\n</div>","language":""},{"id":"responsive-containers","type":"heading","en":"Responsive containers","level":2},{"id":"responsive-containers--paragraph-1","type":"paragraph","en":"Responsive containers allow you to specify a class that is 100% wide until the specified breakpoint is reached, after which we apply <code>max-width</code>s for each of the higher breakpoints. For example, <code>.sm:container</code> is 100% wide to start until the <code>sm</code> breakpoint is reached, where it will scale up with <code>md</code>, <code>lg</code>, <code>xl</code>, and <code>2xl</code>."},{"id":"responsive-containers--code-1","type":"code","value":"<div class=\"sm:container\">100% wide until small breakpoint</div>\n<div class=\"md:container\">100% wide until medium breakpoint</div>\n<div class=\"lg:container\">100% wide until large breakpoint</div>\n<div class=\"xl:container\">100% wide until extra large breakpoint</div>\n<div class=\"2xl:container\">100% wide until extra extra large breakpoint</div>","language":""},{"id":"fluid-containers","type":"heading","en":"Fluid containers","level":2},{"id":"fluid-containers--paragraph-1","type":"paragraph","en":"Use <code>.container-fluid</code> for a full width container, spanning the entire width of the viewport."},{"id":"fluid-containers--code-1","type":"code","value":"<div class=\"container-fluid\">\n  ...\n</div>","language":""},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-variables","type":"heading","en":"Sass variables","level":3},{"id":"sass-variables--paragraph-1","type":"paragraph","en":"As shown above, Bootstrap generates a series of predefined container classes to help you build the layouts you desire. You may customize these predefined container classes by modifying the Sass map (found in <code>_config.scss</code>) that powers them:"},{"id":"sass-variables--code-1","type":"code","value":"$container-max-widths: ();\n// stylelint-disable-next-line scss/dollar-variable-default\n$container-max-widths: defaults(\n  (\n    sm: 540px,\n    md: 720px,\n    lg: 960px,\n    xl: 1200px,\n    2xl: 1440px\n  ),\n  $container-max-widths\n);","language":""},{"id":"sass-variables--paragraph-2","type":"paragraph","en":"For more information and examples on how to modify our Sass maps and variables, please refer to <a href=\"https://getbootstrap.com/docs/6.0/layout/grid#css\">the Sass section of the Grid documentation</a>."},{"id":"sass-mixins","type":"heading","en":"Sass mixins","level":3},{"id":"sass-mixins--paragraph-1","type":"paragraph","en":"In addition to customizing the Sass, you can also create your own containers with our Sass mixin."},{"id":"sass-mixins--code-1","type":"code","value":"// Source mixin\n@mixin make-container($padding-x: $container-padding-x) {\n  width: 100%;\n  padding-inline: $padding-x;\n  margin-inline: auto;\n}\n\n// Usage\n.custom-container {\n  @include make-container();\n}","language":""}],"demos":[],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0/getting-started/css-variables"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/6.0/getting-started/javascript"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/6.0/getting-started/accessibility"},{"en":"Quickstart","href":"https://getbootstrap.com/docs/6.0/guides/quickstart"},{"en":"npm","href":"https://getbootstrap.com/docs/6.0/guides/npm"},{"en":"Webpack","href":"https://getbootstrap.com/docs/6.0/gu
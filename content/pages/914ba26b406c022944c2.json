{"route":"/docs/6.0/utilities/background/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Background","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Convey meaning through <code>background-color</code> and add decoration with gradients."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".bg-primary"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"--bs-bg: var(--bs-primary-bg);<br>background-color: var(--bs-bg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".bg-accent"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"--bs-bg: var(--bs-accent-bg);<br>background-color: var(--bs-bg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".bg-success"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"--bs-bg: var(--bs-success-bg);<br>background-color: var(--bs-bg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".bg-danger"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"--bs-bg: var(--bs-danger-bg);<br>background-color: var(--bs-bg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".bg-warning"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"--bs-bg: var(--bs-warning-bg);<br>background-color: var(--bs-bg);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en"
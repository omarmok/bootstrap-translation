{"route":"/docs/5.1/content/figures/","version":"5.1","renderedVersion":"5.1","title":{"id":"content","type":"heading","en":"Figures","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Documentation and examples for displaying related images and text with the figure component in Bootstrap."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"Anytime you need to display a piece of content—like an image with an optional caption, consider using a <code>&lt;figure&gt;</code>."},{"id":"content--paragraph-3","type":"paragraph","en":"Use the included <code>.figure</code>, <code>.figure-img</code> and <code>.figure-caption</code> classes to provide some baseline styles for the HTML5 <code>&lt;figure&gt;</code> and <code>&lt;figcaption&gt;</code> elements. Images in figures have no explicit size, so be sure to add the <code>.img-fluid</code> class to your <code>&lt;img&gt;</code> to make it responsive."},{"id":"content--example-1","type":"demo","key":"1f680e78a41fef41abee","height":147},{"id":"content--code-1","type":"code","value":"<figure class=\"figure\">\n  <img src=\"...\" class=\"figure-img img-fluid rounded\" alt=\"...\">\n  <figcaption class=\"figure-caption\">A caption for the above image.</figcaption>\n</figure>","language":"html"},{"id":"content--paragraph-4","type":"paragraph","en":"Aligning the figure’s caption is easy with our <a href=\"https://getbootstrap.com/docs/5.1/utilities/text/#text-alignment\">text utilities</a>."},{"id":"content--example-2","type":"demo","key":"94d43c660e02069d1fdd","height":147},{"id":"content--code-2","type":"code","value":"<figure class=\"figure\">\n  <img src=\"...\" class=\"figure-img img-fluid rounded\" alt=\"...\">\n  <figcaption class=\"figure-caption text-end\">A caption for the above image.</figcaption>\n</figure>","language":"html"},{"id":"sass","type":"heading","en":"Sass","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--code-1","type":"code","value":"$figure-caption-font-size:          $small-font-size;\n$figure-caption-color:              $gray-600;","language":"scss"}],"demos":[{"key":"1f680e78a41fef41abee","html":"\n<figure class=\"figure\">\n  <svg class=\"bd-placeholder-img figure-img img-fluid rounded\" width=\"400\" height=\"300\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Placeholder: 400x300\" preserveAspectRatio=\"xMidYMid slice\" focusable=\"false\"><title>Placeholder</title><rect width=\"100%\" height=\"100%\" fill=\"#868e96\"></rect><text x=\"50%\" y=\"50%\" fill=\"#dee2e6\" dy=\".3em\">400x300</text></svg>\n\n  <figcaption class=\"figure-caption\">A caption for the above image.</figcaption>\n</figure>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"94d43c660e02069d1fdd","html":"\n<figure class=\"figure\">\n  <svg class=\"bd-placeholder-img figure-img img-fluid rounded\" width=\"400\" height=\"300\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Placeholder: 400x300\" preserveAspectRatio=\"xMidYMid slice\" focusable=\"false\"><title>Placeholder</title><rect width=\"100%\" height=\"100%\" fill=\"#868e96\"></rect><text x=\"50%\" y=\"50%\" fill=\"#dee2e6\" dy=\".3em\">400x300</text></svg>\n\n  <figcaption class=\"figure-caption text-end\">A caption for the above image.</figcaption>\n</figure>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.1/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/5.1/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.1/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/5.1/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/5.1/getting-started/javascript/"},{"en":"Webpack","href":"https://getbootstrap.com/docs/5.1/getting-started/webpack/"},{"en":"Parcel","href":"https://getbootstrap.com/docs/5.1/getting-start
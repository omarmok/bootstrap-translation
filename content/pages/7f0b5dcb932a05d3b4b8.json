{"route":"/docs/6.0/utilities/display/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Display property","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Quickly and responsively toggle the display value of components and more with our display utilities."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".d-inline"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"display: inline;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".d-inline-block"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"display: inline-block;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".d-block"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"display: block;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".d-grid"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"display: grid;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".d-inline-grid"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"display: inline-grid;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".d-table"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"display: table;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":".d-table-row"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"display: table-row;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":".d-table-cell"}]},{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"display: table-cell;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":".d-flex"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"display: flex;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":".d-inline-flex"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"display: inline-flex;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-24","type":"paragraph","en":".d-contents"}]},{"type":"td","body":[{"id":"content--paragraph-25","type":"paragraph","en":"display: contents;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-26","type":"paragraph","en":".d-flow-root"}]},{"type":"td","body":[{"id":"content--paragraph-27","type":"paragraph","en":"display: flow-root;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-28","type":"paragraph","en":".d-none"}]},{"type":"td","body":[{"id":"content--paragraph-29","type":"paragraph","en":"display: none;"}]}]}]},{"id":"how-it-works","type":"heading","en":"How it works","level":2},{"id":"how-it-works--paragraph-1","type":"paragraph","en":"Change the value of the <a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/display\"><code>display</code> property</a> with our responsive display utility classes. We purposely support only a subset of all possible values for <code>display</code>. Classes can be combined for various effects as you need."},{"id":"notation","type":"heading","en":"Notation","level":2},{"id":"notation--paragraph-1","type":"paragraph","en":"Display utility classes that apply to all <a href=\"https://getbootstrap.com/docs/6.0/layout/breakpoints\">breakpoints</a>, from <code>xs</code> to <code>2xl</code>, have no breakpoint abbreviation in them. This is because those classes are applied from <code>min-width: 0;</code> and up, and thus are not bound by a media query. The remaining breakpoints, however, do include a breakpoint abbreviation."},{"id":"notation--paragraph-2","type":"paragraph","en":"As such, the classes are named using the format:"},{"id":"notation--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-1","type":"item","en":"<code>.d-{value}</code> for <code>xs</code>"}]},{"tag":"li","body":[{"id":"notation--item-2","type":"item","en":"<code>.{breakpoint}:d-{value}</code> for <code>sm</code>, <code>md</code>, <code>lg</code>, <code>xl</code>, and <code>2xl</code> (for example, <code>.md:d-none</code>)."}]}]},{"id":"notation--paragraph-3","type":"paragraph","en":"Where <em>value</em> is one of:"},{"id":"notation--list-2","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-3","type":"item","en":"<code>none</code>"}]},{"tag":"li","body":[{"id":"notation--item-4","type":"item","en":"<code>inline</code>"}]},{"tag":"li","body":[{"id":"notation--item-5","type":"item","en":"<code>inline-block</code>"}]},{"tag":"li","body":[{"id":"notation--item-6","type":"item","en":"<code>block</code>"}]},{"tag":"li","body":[{"id":"notation--item-7","type":"item","en":"<code>grid</code>"}]},{"tag":"li","body":[{"id":"notation--item-8","type":"item","en":"<code>inline-grid</code>"}]},{"tag":"li","body":[{"id":"notation--item-9","type":"item","en":"<code>table</code>"}]},{"tag":"li","body":[{"id":"notation--item-10","type":"item","en":"<code>table-cell</code>"}]},{"tag":"li","body":[{"id":"notation--item-11","type":"item","en":"<code>table-row</code>"}]},{"tag":"li","body":[{"id":"notation--item-12","type":"item","en":"<code>flex</code>"}]},{"tag":"li","body":[{"id":"notation--item-13","type":"item","en":"<code>inline-flex</code>"}]}]},{"id":"notation--paragraph-4","type":"paragraph","en":"The display values can be altered by changing the <code>display</code> values defined in <code>$utilities</code> and recompiling the SCSS."},{"id":"notation--paragraph-5","type":"paragraph","en":"The media queries affect screen widths with the given breakpoint <em>or larger</em>. For example, <code>.lg:d-none</code> sets <code>display: none;</code> on <code>lg</code>, <code>xl</code>, and <code>2xl</code> screens."},{"id":"clearfix","type":"heading","en":"Clearfix","level":2},{"id":"clearfix--paragraph-1","type":"paragraph","en":"There’s no more clearfix helper in Bootstrap 6 as it’s an outdated technique. Instead, use the <code>display: flow-root</code> utility, <code>.d-flow-root</code>. This forces a container element to create a new block formatting context without the clearfix."},{"id":"clearfix--example-1","type":"demo","key":"32d40b0aaa7b59214ec9","height":147},{"id":"clearfix--code-1","type":"code","value":"<div class=\"d-flow-root\">\n  <div class=\"float-end px-3 py-2 border rounded-3\">Floated element</div>\n</div>","language":""},{"id":"examples","type":"heading","en":"Examples","level":2},{"id":"examples--example-1","type":"demo","key":"d255340aff06bc5c3ced","height":174},{"id":"examples--code-1","type":"code","value":"<div class=\"d-inline p-2 theme-primary theme-contrast\">d-inline</div>\n<div class=\"d-inline p-2 theme-secondary theme-contrast\">d-inline</div>","language":""},{"id":"examples--example-2","type":"demo","key":"eae3d6b59a7ca67bfa34","height":174},{"id":"examples--code-2","type":"code","value":"<span class=\"d-block p-2 theme-primary theme-contrast\">d-block</span>\n<span class=\"d-block p-2 theme-secondary theme-contrast\">d-block</span>","language":""},{"id":"hiding-elements","type":"heading","en":"Hiding elements","level":2},{"id":"hiding-elements--paragraph-1","type":"paragraph","en":"For faster mobile-friendly development, use responsive display classes for showing and hiding elements by device. Avoid creating entirely different versions of the same site, instead hide elements responsively for each screen size."},{"id":"hiding-elements--paragraph-2","type":"paragraph","en":"To hide elements simply use the <code>.d-none</code> class or one of the <code>.{sm,md,lg,xl,2xl}:d-none</code> classes for any responsive screen variation."},{"id":"hiding-elements--paragraph-3","type":"paragraph","en":"To show an element only on a given interval of screen sizes you can combine one <code>.{breakpoint}:d-none</code> class with a <code>.{breakpoint}:d-block</code> class, for example <code>.d-none .md:d-block .xl:d-none</code> will hide the element for all screen sizes except on medium and large devices."},{"id":"hiding-elements--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"hiding-elements--paragraph-4","type":"paragraph","en":"Screen size"}]},{"type":"th","body":[{"id":"hiding-elements--paragraph-5","type":"paragraph","en":"Class"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-6","type":"paragraph","en":"Hidden on all"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-7","type":"paragraph","en":"<code>.d-none</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-8","type":"paragraph","en":"Hidden only on xs"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-9","type":"paragraph","en":"<code>.d-none .sm:d-block</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-10","type":"paragraph","en":"Hidden only on sm"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-11","type":"paragraph","en":"<code>.sm:d-none .md:d-block</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-12","type":"paragraph","en":"Hidden only on md"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-13","type":"paragraph","en":"<code>.md:d-none .lg:d-block</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-14","type":"paragraph","en":"Hidden only on lg"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-15","type":"paragraph","en":"<code>.lg:d-none .xl:d-block</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-16","type":"paragraph","en":"Hidden only on xl"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-17","type":"paragraph","en":"<code>.xl:d-none .2xl:d-block</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-18","type":"paragraph","en":"Hidden only on 2xl"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-19","type":"paragraph","en":"<code>.2xl:d-none</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-20","type":"paragraph","en":"Visible on all"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-21","type":"paragraph","en":"<code>.d-block</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-22","type":"paragraph","en":"Visible only on xs"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-23","type":"paragraph","en":"<code>.d-block .sm:d-none</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-24","type":"paragraph","en":"Visible only on sm"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-25","type":"paragraph","en":"<code>.d-none .sm:d-block .md:d-none</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-26","type":"paragraph","en":"Visible only on md"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-27","type":"paragraph","en":"<code>.d-none .md:d-block .lg:d-none</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-28","type":"paragraph","en":"Visible only on lg"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-29","type":"paragraph","en":"<code>.d-none .lg:d-block .xl:d-none</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-30","type":"paragraph","en":"Visible only on xl"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-31","type":"paragraph","en":"<code>.d-none .xl:d-block .2xl:d-none</code>"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"hiding-elements--paragraph-32","type":"paragraph","en":"Visible only on 2xl"}]},{"type":"td","body":[{"id":"hiding-elements--paragraph-33","type":"paragraph","en":"<code>.d-none .2xl:d-block</code>"}]}]}]},{"id":"hiding-elements--example-1","type":"demo","key":"845fffb7f8e420bdde63","height":174},{"id":"hiding-elements--code-1","type":"code","value":"<div class=\"lg:d-none\">hide on lg and wider screens</div>\n<div class=\"d-none lg:d-block\">hide on screens smaller than lg</div>","language":""},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Display utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"display\": (\n  responsive: true,\n  property: display,\n  class: d,\n  values: inline inline-block block grid inline-grid table table-row table-cell flex inline-flex contents flow-root none\n),","language":""}],"demos":[{"key":"32d40b0aaa7b59214ec9","html":"<div class=\"d-flow-root\">\n  <div class=\"float-end px-3 py-2 border rounded-3\">Floated element</div>\n</div>","attrs":{"class":"bd-example"},"sprite":""},{"key":"d255340aff06bc5c3ced","html":"<div class=\"d-inline p-2 theme-primary theme-contrast\">d-inline</div>\n<div class=\"d-inline p-2 theme-secondary theme-contrast\">d-inline</div>","attrs":{"class":"bd-example"},"spr
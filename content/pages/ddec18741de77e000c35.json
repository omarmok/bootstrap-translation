{"route":"/docs/4.6/utilities/position/","version":"4.6","renderedVersion":"4.6","title":{"id":"content","type":"heading","en":"Position","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.6.2/site/content/docs/4.6/utilities/position.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Use these shorthand utilities for quickly configuring the position of an element."},{"id":"common-values","type":"heading","en":"Common values","level":2},{"id":"common-values--paragraph-1","type":"paragraph","en":"Quick positioning classes are available, though they are not responsive."},{"id":"common-values--code-1","type":"code","value":"<div class=\"position-static\">...</div>\n<div class=\"position-relative\">...</div>\n<div class=\"position-absolute\">...</div>\n<div class=\"position-fixed\">...</div>\n<div class=\"position-sticky\">...</div>","language":"html"},{"id":"fixed-top","type":"heading","en":"Fixed top","level":2},{"id":"fixed-top--paragraph-1","type":"paragraph","en":"Position an element at the top of the viewport, from edge to edge. Be sure you understand the ramifications of fixed position in your project; you may need to add additional CSS."},{"id":"fixed-top--code-1","type":"code","value":"<div class=\"fixed-top\">...</div>","language":"html"},{"id":"fixed-bottom","type":"heading","en":"Fixed bottom","level":2},{"id":"fixed-bottom--paragraph-1","type":"paragraph","en":"Position an element at the bottom of the viewport, from edge to edge. Be sure you understand the ramifications of fixed position in your project; you may need to add additional CSS."},{"id":"fixed-bottom--code-1","type":"code","value":"<div class=\"fixed-bottom\">...</div>","language":"html"},{"id":"sticky-top","type":"heading","en":"Sticky top","level":2},{"id":"sticky-top--paragraph-1","type":"paragraph","en":"Position an element at the top of the viewport, from edge to edge, but only after you scroll past it. The <code>.sticky-top</code> utility uses CSS’s <code>position: sticky</code>, which isn’t fully supported in all browsers."},{"id":"sticky-top--paragraph-2","type":"paragraph","en":"<strong>IE11 and IE10 will render <code>position: sticky</code> as <code>position: relative</code>.</strong> As such, we wrap the styles in a <code>@supports</code> query, limiting the stickiness to only browsers that can render it properly."},{"id":"sticky-top--code-1","type":"code","value":"<div class=\"sticky-top\">...</div>","language":"html"}],"demos":[],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.6/getting-started/introduction/"},{"en":"Layout","href":"https://getbootstrap.com/docs/4.6/layout/overview/"},{"en":"Content","href":"https://getbootstrap.com/docs/4.6/content/reboot/"},{"en":"Components","href":"https://getbootstrap.com/docs/4.6/components/alerts/"},{"en":"Utilities","href":"https://getbootstrap.com/docs/4.6/utilities/borders/"},{"en":"Borders","href":"https://getbootstrap.com/docs/4.6/utilities/borders/"},{"en":"Clearfix","href":"https://getbootstrap.com/docs/4.6/utilities/clearfix/"},{"en":"Close icon","href":"https://getbootstrap.com/docs/4.6/utilities/close-icon/"},{"en":"Colors","href":"https://getbootstrap.com/docs/4.6/utilities/colors/"},{"en":"Display","href":"https://getbootstrap.com/docs/4.6/utilities/display/"},{"en":"Embed","href":"https://getbootstrap.com/docs/4.6/utilities/embed/"},{"en":"Flex","href":"https://getbootstrap.com/docs/4.6/utilities/flex/"},{"en":"Float","href":"https://getbootstrap.com/docs/4.6/utilities/float/"},{"en":"Image replacement","href":"https://getbootstrap.com/docs/4.6/utilities/image-replacement/"},{"en":"Interactions","href":"https://getbootstrap.com/docs/4.6/utilities/interactions/"},{"en":"Overflow","href":"https://getbootstrap.com/docs/4.6/utilities/overflow/"},{"en":"Position","href":"https://getbootstrap.com/docs/4.6/utilities/position/"},{"en":"Screen readers","href":"https://getbootstrap.com/docs/4.6/utilities/screen-readers/"},{"en":"Shadows","href":"https://getbootstrap.com/docs/4.6/utilities/shadows/"},{"en":"Sizing","href":"https://getbootstrap.com/docs/4.6/utilities/sizing/"},{"en":"Spacing","href":"https://getbootstrap.com/docs/4.6/utilities/spacing/"},{"en":"Stretched link","href":"https://getbootstrap.com/docs/4.6/utilities/stretched-link/"},{"en":"Text","href":"https://getbootstrap.com/docs/4.6/utilities/text/"},{"en":"Vertical align","href":"https://getbootstrap.com/docs/4.6/utilities/vertical-align/"},{"en":"Visibility","href":"https://getbootstrap.com/docs/4.6/utilities/visibility/"},{"en":"Extend","href":"https://getbootstrap.com/docs/4.6/extend/approach/"},{"en":"Migration","href":"https://getbootstrap.com/docs/4.6/migration/"},{"en":"About","href":"https://getbootstrap.com/docs/4.6/about/overview/"},{"en":"End of Life","href":"https://getbootstrap.com/docs/4.6/end-of-life/"}],"standalone":false,"publishedAssets":[{"url":"/docs/4.6/dist/css/bootstrap.min.css","integrity":"sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N"},{"url":"https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","integrity":"sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"},{"url":"/docs/4.6/dist/js/bootstrap.bundle.min.js","integrity":"sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-analytics.com/analytics.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","https://getbootstrap.com/docs/4.6/dist/js/bootstrap.bundle.min.js","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.js","https://getbootstrap.com/docs/4.6/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/4.6/dist/css/bootstrap.min.css","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/c
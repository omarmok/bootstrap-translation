84-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-analytics.com/analytics.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://getbootstrap.com/docs/5.1/dist/js/bootstrap.bundle.min.js","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.js","https://getbootstrap.com/docs/5.1/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/5.1/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/5.1/assets/css/docs.css"]}

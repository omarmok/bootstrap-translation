{"route":"/2.3.0/extend.html","version":"2.3.0","renderedVersion":"2.3.0","title":{"id":"extending-bootstrap","type":"heading","en":"Extending Bootstrap","level":1,"anchors":["overview"]},"lead":{"id":"extending-bootstrap--paragraph-1","type":"paragraph","en":"Extend Bootstrap to take advantage of included styles and components, as well as LESS variables and mixins."},"blocks":[{"id":"extending-bootstrap--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"extending-bootstrap--item-1","type":"item","en":"<a href=\"#built-with-less\"><i></i> Built with LESS</a>"}]},{"tag":"li","body":[{"id":"extending-bootstrap--item-2","type":"item","en":"<a href=\"#compiling\"><i></i> Compiling Bootstrap</a>"}]},{"tag":"li","body":[{"id":"extending-bootstrap--item-3","type":"item","en":"<a href=\"#static-assets\"><i></i> Use as static assets</a>"}]}]},{"id":"built-with-less","type":"heading","en":"Built with LESS","level":1,"anchors":[]},{"id":"built-with-less--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.3.0/assets/img/less-logo-large.png\" alt=\"LESS CSS\" loading=\"lazy\">"},{"id":"built-with-less--paragraph-1","type":"paragraph","en":"Bootstrap is made with LESS at its core, a dynamic stylesheet language created by our good friend, <a href=\"http://cloudhead.io/\">Alexis Sellier</a>. It makes developing systems-based CSS faster, easier, and more fun."},{"id":"why-less","type":"heading","en":"Why LESS?","level":3},{"id":"why-less--paragraph-1","type":"paragraph","en":"One of Bootstrap&#39;s creators wrote a quick <a href=\"http://www.wordsbyf.at/2012/03/08/why-less/\">blog post about this</a>, summarized here:"},{"id":"why-less--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"why-less--item-1","type":"item","en":"Bootstrap compiles faster ~6x faster with Less compared to Sass"}]},{"tag":"li","body":[{"id":"why-less--item-2","type":"item","en":"Less is written in JavaScript, making it easier to us to dive in and patch compared to Ruby with Sass."}]},{"tag":"li","body":[{"id":"why-less--item-3","type":"item","en":"Less is more; we want to feel like we&#39;re writing CSS and making Bootstrap approachable to all."}]}]},{"id":"whats-included","type":"heading","en":"What&#39;s included?","level":3},{"id":"whats-included--paragraph-1","type":"paragraph","en":"As an extension of CSS, LESS includes variables, mixins for reusable snippets of code, operations for simple math, nesting, and even color functions."},{"id":"learn-more","type":"heading","en":"Learn more","level":3},{"id":"learn-more--paragraph-1","type":"paragraph","en":"Visit the official website at <a href=\"http://lesscss.org/\">http://lesscss.org/</a> to learn more."},{"id":"compiling-bootstrap-with-less","type":"heading","en":"Compiling Bootstrap with Less","level":1,"anchors":["compiling"]},{"id":"compiling-bootstrap-with-less--paragraph-1","type":"paragraph","en":"Since our CSS is written with Less and utilizes variables and mixins, it needs to be compiled for final production implementation. Here&#39;s how."},{"id":"compiling-bootstrap-with-less--note-1","type":"note","tone":"info","body":[{"id":"compiling-bootstrap-with-less--note-text-1","type":"note-text","en":"<strong>Note:</strong> If you&#39;re submitting a pull request to GitHub with modified CSS, you <strong>must</strong> recompile the CSS via any of these methods."}]},{"id":"tools-for-compiling","type":"heading","en":"Tools for compiling","level":2},{"id":"command-line","type":"heading","en":"Command line","level":3},{"id":"command-line--paragraph-1","type":"paragraph","en":"Follow <a href=\"https://github.com/twitter/bootstrap#developers\">the instructions in the project readme</a> on GitHub for compiling via command line."},{"id":"javascript","type":"heading","en":"JavaScript","level":3},{"id":"javascript--paragraph-1","type":"paragraph","en":"<a href=\"http://lesscss.org/\">Download the latest Less.js</a> and include the path to it (and Bootstrap) in the <code>&lt;head&gt;</code>."},{"id":"javascript--code-1","type":"code","value":"<link rel=\"stylesheet/less\" href=\"/path/to/bootstrap.less\">\n<script src=\"/path/to/less.js\"></script>","language":""},{"id":"javascript--paragraph-2","type":"paragraph","en":"To recompile the .less files, just save them and reload your page. Less.js compiles them and stores them in local storage."},{"id":"unofficial-mac-app","type":"heading","en":"Unofficial Mac app","level":3},{"id":"unofficial-mac-app--paragraph-1","type":"paragraph","en":"<a href=\"http://incident57.com/less/\">The unofficial Mac app</a> watches directories of .less files and compiles the code to local files after every save of a watched .less file. If you like, you can toggle preferences in the app for automatic minifying and which directory the compiled files end up in."},{"id":"more-apps","type":"heading","en":"More apps","level":3},{"id":"crunch","type":"heading","en":"<a href=\"http://crunchapp.net/\">Crunch</a>","level":4},{"id":"crunch--paragraph-1","type":"paragraph","en":"Crunch is a great looking LESS editor and compiler built on Adobe Air."},{"id":"codekit","type":"heading","en":"<a href=\"http://incident57.com/codekit/\">CodeKit</a>","level":4},{"id":"codekit--paragraph-1","type":"paragraph","en":"Created by the same guy as the unofficial Mac app, CodeKit is a Mac app that compiles LESS, SASS, Stylus, and CoffeeScript."},{"id":"simpless","type":"heading","en":"<a href=\"https://wearekiss.com/simpless\">Simpless</a>","level":4},{"id":"simpless--paragraph-1","type":"paragraph","en":"Mac, Linux, and Windows app for drag and drop compiling of LESS files. Plus, the <a href=\"https://github.com/Paratron/SimpLESS\">source code is on GitHub</a>."},{"id":"use-as-static-assets","type":"heading","en":"Use as static assets","level":1,"anchors":["static-assets"]},{"id":"use-as-static-assets--paragraph-1","type":"paragraph","en":"<a href=\"https://getbootstrap.com/2.3.0/getting-started.html\">Quickly start</a> any web project by dropping in the compiled or minified CSS and JS. Layer on custom styles separately for easy upgrades and maintenance moving forward."},{"id":"setup-file-structure","type":"heading","en":"Setup file structure","level":3},{"id":"setup-file-structure--paragraph-1","type":"paragraph","en":"Download the latest compiled Bootstrap and place into your project. For example, you might have something like this:"},{"id":"setup-file-structure--code-1","type":"code","value":"   app/\n       layouts/\n       templates/\n   public/\n       css/\n           bootstrap.min.css\n       js/\n           bootstrap.min.js\n       img/\n           glyphicons-halflings.png\n           glyphicons-halflings-white.png","language":""},{"id":"utilize-starter-template","type":"heading","en":"Utilize starter template","level":3},{"id":"utilize-starter-template--paragraph-1","type":"paragraph","en":"Copy the following base HTML to get started."},{"id":"utilize-starter-template--code-1","type":"code","value":"<html>\n  <head>\n    <title>Bootstrap 101 Template</title>\n    <!-- Bootstrap -->\n    <link href=\"public/css/bootstrap.min.css\" rel=\"stylesheet\">\n  </head>\n  <body>\n    <h1>Hello, world!</h1>\n    <!-- Bootstrap -->\n    <script src=\"public/js/bootstrap.min.js\"></script>\n  </body>\n</html>","language":""},{"id":"layer-on-custom-code","type":"heading","en":"Layer on custom code","level":3},{"id":"layer-on-custom-code--paragraph-1","type":"paragraph","en":"Work in your custom CSS, JS, and more as necessary to make Bootstrap your own with your own separate CSS and JS files."},{"id":"layer-on-custom-code--code-1","type":"code","value":"<html>\n  <head>\n    <title>Bootstrap 101 Template</title>\n    <!-- Bootstrap -->\n    <link href=\"public/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <!-- Project -->\n    <link href=\"public/css/application.css\" rel=\"stylesheet\">\n  </head>\n  <body>\n    <h1>Hello, world!</h1>\n    <!-- Bootstrap -->\n    <script src=\"public/js/bootstrap.min.js\"></script>\n    <!-- Project -->\n    <script src=\"public/js/application.js\"></script>\n  </body>\n</html>","language":""}],"demos":[],"nav":[{"en":"Home","href":"https://getbootstrap.com/2.3.0/index.html"},{"en":"Get started","href":"https://getbootstrap.com/2.3.0/getting-started.html"},{"en":"Scaffolding","href":"https://getbootstrap.com/2.3.0/scaffolding.html"},{"en":"Base CSS","href":"https://getbootstrap.com/2.3.0/base-css.html"},{"en":"Components","href":"https://getbootstrap.com/2.3.0/components.html"},{"en":"JavaScript","href":"https://getbootstrap.com/2.3.0/javascript.html"},{"en":"Customize","href":"https://getbootstrap.com/2.3.0/customize.html"},{"en":"Built with LESS","href":"#built-with-less"},{"en":"Compiling Bootstrap","href":"#compiling"},{"en":"Use as static assets","href":"#static-assets"}],"standalone":false,"publishedAssets":[],"sourceScripts":["https://cdn.usefathom.com/script.js","https://cdn.carbonads.com/carbon.js?zoneid=1673&serve=C6AILKT&placement=getbootstrapcom","https://platform.twitter.com/widgets.js","https://getbootstrap.com/2.3.0/assets/js/jquery.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-transition.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-alert.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-modal.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-dropdown.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-scrollspy.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-tab.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-tooltip.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-popover.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-button.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-collapse.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-carousel.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-typeahead.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-affix.js","https://getbootstrap.com/2.3.0/assets/js/holder/holder.js","https://getbootstrap.com/2.3.0/assets/js/google-code-prettify/prettify.js","https://getbootstrap.com/2.3.0/assets/js/application.js"],"sourceStyles":["https://getbootstrap.com/2.3.0/assets/css/bootstrap.css","https://getbootstrap.com/2.3.0/assets/css/bootstrap-responsive.css","https://getbootstrap.com/2.3.0/assets/css/docs.css","https://getbootstrap.com/2.3.0/assets/js/google-code-prettify/prettify.css"]}

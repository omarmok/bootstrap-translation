{"route":"/docs/6.0/forms/checkbox/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Checkbox","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Highly customizable, native checkbox <code>&lt;input&gt;</code> elements for presenting toggleable options."},"blocks":[{"id":"basic-checkbox","type":"heading","en":"Basic checkbox","level":2},{"id":"basic-checkbox--paragraph-1","type":"paragraph","en":"All checkbox styling is applied with the <code>.check</code> class directly on the <code>&lt;input&gt;</code>. This does the following:"},{"id":"basic-checkbox--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"basic-checkbox--item-1","type":"item","en":"Overrides the default <code>&lt;input&gt;</code> appearance with themed colors."}]},{"tag":"li","body":[{"id":"basic-checkbox--item-2","type":"item","en":"Renders the <code>:checked</code> and indeterminate icons via a CSS <code>mask</code> on the input’s <code>::before</code> pseudo-element, so the mark inherits the contrast color and no inline SVG is needed. The appropriate icon is shown based on the input’s state."}]}]},{"id":"basic-checkbox--paragraph-2","type":"paragraph","en":"For folks looking to replace our provided icons, override the <code>--bs-check-icon-checked</code> and <code>--bs-check-icon-indeterminate</code> CSS variables (or the <code>--check-icon-*</code> Sass tokens) with your own <code>mask-image</code> URLs."},{"id":"basic-checkbox--paragraph-3","type":"paragraph","en":"Labels and layout are handled with additional HTML and CSS."},{"id":"basic-checkbox--example-1","type":"demo","key":"a5b01423d2a8569eaf78","height":147,"anchors":["check"]},{"id":"basic-checkbox--code-1","type":"code","value":"<input type=\"checkbox\" id=\"check\" class=\"check\" checked />","language":""},{"id":"indeterminate","type":"heading","en":"Indeterminate","level":2},{"id":"indeterminate--paragraph-1","type":"paragraph","en":"Checkboxes can utilize the indeterminate pseudo class when manually set via JavaScript. There is no available HTML attribute for specifying it."},{"id":"indeterminate--example-1","type":"demo","key":"e324dfca83b0532d3920","height":147,"anchors":["checkIndeterminate"]},{"id":"indeterminate--code-1","type":"code","value":"<input type=\"checkbox\" id=\"checkIndeterminate\" class=\"check\" />","language":""},{"id":"with-form-field","type":"heading","en":"With form field","level":2},{"id":"with-form-field--paragraph-1","type":"paragraph","en":"Wrap the <code>.check</code> in a <code>.form-field</code> layout wrapper and add your label. The grid layout places the checkbox and label side by side."},{"id":"with-form-field--example-1","type":"demo","key":"6bd7dc6f2237403f5da9","height":147,"anchors":["checkLabel"]},{"id":"with-form-field--code-1","type":"code","value":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkLabel\" class=\"check\" />\n  <label for=\"checkLabel\">Example new checkbox</label>\n</div>","language":""},{"id":"description","type":"heading","en":"Description","level":2},{"id":"description--paragraph-1","type":"paragraph","en":"Add a description or other content after the label. We recommend wrapping the label and description in a <code>.form-field-content</code> to ensure appropriate spacing and alignment."},{"id":"description--example-1","type":"demo","key":"d48429ef623e173cc02e","height":147,"anchors":["checkDescription"]},{"id":"description--code-1","type":"code","value":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkDescription\" class=\"check\" />\n  <div class=\"form-field-content\">\n    <label for=\"checkDescription\">Example new checkbox</label>\n    <small class=\"form-text\">Supporting description for the above label.</small>\n  </div>\n</div>","language":""},{"id":"theme-colors","type":"heading","en":"Theme colors","level":2},{"id":"theme-colors--paragraph-1","type":"paragraph","en":"Modify the appearance of checked checkboxes by adding the <code>.theme-{color}</code> class to the <code>.check</code> element. This will set the checked background and border color to the theme color."},{"id":"theme-colors--example-1","type":"demo","key":"6d4fae81541ffb08771e","height":300,"anchors":["checkprimary","checkaccent","checksuccess","checkdanger","checkwarning","checkinfo","checkinverse","checksecondary"]},{"id":"theme-colors--code-1","type":"code","value":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkprimary\" class=\"check theme-primary\" checked />\n  <label for=\"checkprimary\">Example primary checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkaccent\" class=\"check theme-accent\" checked />\n  <label for=\"checkaccent\">Example accent checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checksuccess\" class=\"check theme-success\" checked />\n  <label for=\"checksuccess\">Example success checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkdanger\" class=\"check theme-danger\" checked />\n  <label for=\"checkdanger\">Example danger checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkwarning\" class=\"check theme-warning\" checked />\n  <label for=\"checkwarning\">Example warning checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkinfo\" class=\"check theme-info\" checked />\n  <label for=\"checkinfo\">Example info checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkinverse\" class=\"check theme-inverse\" checked />\n  <label for=\"checkinverse\">Example inverse checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checksecondary\" class=\"check theme-secondary\" checked />\n  <label for=\"checksecondary\">Example secondary checkbox</label>\n</div>","language":""},{"id":"disabled","type":"heading","en":"Disabled","level":2},{"id":"disabled--paragraph-1","type":"paragraph","en":"Add the <code>disabled</code> attribute and the associated <code>&lt;label&gt;</code>s are automatically styled to match with a lighter color to help indicate the input’s state."},{"id":"disabled--example-1","type":"demo","key":"ada1cd59e6bc26c2c66b","height":174,"anchors":["checkDisabled","checkDisabledChecked"]},{"id":"disabled--code-1","type":"code","value":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkDisabled\" class=\"check\" disabled />\n  <label for=\"checkDisabled\">Example new checkbox</label>\n</div>\n\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkDisabledChecked\" class=\"check\" checked disabled />\n  <label for=\"checkDisabledChecked\">Example new checkbox</label>\n</div>","language":""},{"id":"sizes","type":"heading","en":"Sizes","level":2},{"id":"sizes--paragraph-1","type":"paragraph","en":"Add <code>.check-sm</code> or <code>.check-lg</code> to make your checkbox appear smaller or larger."},{"id":"sizes--example-1","type":"demo","key":"cf683d9700e143248203","height":201,"anchors":["checkSizeSm","checkSizeMd","checkSizeLg"]},{"id":"sizes--code-1","type":"code","value":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkSizeSm\" class=\"check check-sm\" checked />\n  <label for=\"checkSizeSm\">Small checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkSizeMd\" class=\"check\" checked />\n  <label for=\"checkSizeMd\">Default checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkSizeLg\" class=\"check check-lg\" checked />\n  <label for=\"checkSizeLg\">Large checkbox</label>\n</div>","language":""},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--paragraph-1","type":"paragraph","en":"CSS variables for the checkbox component are built on the Sass variables."},{"id":"variables--code-1","type":"code","value":"// stylelint-disable-next-line scss/dollar-variable-default\n$check-tokens: defaults(\n  (\n    --check-size: 1.25rem,\n    --check-margin-block: .125rem,\n    --check-bg: var(--bg-body),\n    --check-border-color: var(--border-color),\n    --check-border-radius: var(--radius-5),\n    --check-icon-checked: #{escape-svg(url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path fill='none' stroke='black' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m5.5 10 3 3 6-6'/></svg>\"))},\n    --check-icon-indeterminate: #{escape-svg(url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path fill='none' stroke='black' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M6 10h8'/></svg>\"))},\n    --check-checked-bg: var(--control-checked-bg),\n    --check-checked-border-color: var(--control-checked-border-color),\n    --check-indeterminate-bg: var(--control-checked-bg),\n    --check-indeterminate-border-color: var(--control-checked-border-color),\n    --check-active-bg: var(--control-active-bg),\n    --check-active-border-color: var(--control-active-border-color),\n    --check-disabled-bg: var(--control-disabled-bg),\n    --check-disabled-opacity: var(--control-disabled-opacity),\n  ),\n  $check-tokens\n);","language":""}],"demos":[{"key":"a5b01423d2a8569eaf78","html":"<input type=\"checkbox\" id=\"check\" class=\"check\" checked=\"\">","attrs":{"class":"bd-example"},"sprite":""},{"key":"e324dfca83b0532d3920","html":"<input type=\"checkbox\" id=\"checkIndeterminate\" class=\"check\">","attrs":{"class":"bd-example bd-example-indeterminate"},"sprite":""},{"key":"6bd7dc6f2237403f5da9","html":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkLabel\" class=\"check\">\n  <label for=\"checkLabel\">Example new checkbox</label>\n</div>","attrs":{"class":"bd-example"},"sprite":""},{"key":"d48429ef623e173cc02e","html":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkDescription\" class=\"check\">\n  <div class=\"form-field-content\">\n    <label for=\"checkDescription\">Example new checkbox</label>\n    <small class=\"form-text\">Supporting description for the above label.</small>\n  </div>\n</div>","attrs":{"class":"bd-example"},"sprite":""},{"key":"6d4fae81541ffb08771e","html":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkprimary\" class=\"check theme-primary\" checked=\"\">\n  <label for=\"checkprimary\">Example primary checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkaccent\" class=\"check theme-accent\" checked=\"\">\n  <label for=\"checkaccent\">Example accent checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checksuccess\" class=\"check theme-success\" checked=\"\">\n  <label for=\"checksuccess\">Example success checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkdanger\" class=\"check theme-danger\" checked=\"\">\n  <label for=\"checkdanger\">Example danger checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkwarning\" class=\"check theme-warning\" checked=\"\">\n  <label for=\"checkwarning\">Example warning checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkinfo\" class=\"check theme-info\" checked=\"\">\n  <label for=\"checkinfo\">Example info checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkinverse\" class=\"check theme-inverse\" checked=\"\">\n  <label for=\"checkinverse\">Example inverse checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checksecondary\" class=\"check theme-secondary\" checked=\"\">\n  <label for=\"checksecondary\">Example secondary checkbox</label>\n</div>","attrs":{"class":"bd-example d-flex flex-column gap-2"},"sprite":""},{"key":"ada1cd59e6bc26c2c66b","html":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkDisabled\" class=\"check\" disabled=\"\">\n  <label for=\"checkDisabled\">Example new checkbox</label>\n</div>\n\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkDisabledChecked\" class=\"check\" checked=\"\" disabled=\"\">\n  <label for=\"checkDisabledChecked\">Example new checkbox</label>\n</div>","attrs":{"class":"bd-example vstack gap-2"},"sprite":""},{"key":"cf683d9700e143248203","html":"<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkSizeSm\" class=\"check check-sm\" checked=\"\">\n  <label for=\"checkSizeSm\">Small checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkSizeMd\" class=\"check\" checked=\"\">\n  <label for=\"checkSizeMd\">Default checkbox</label>\n</div>\n<div class=\"form-field\">\n  <input type=\"checkbox\" id=\"checkSizeLg\" class=\"check check-lg\" checked=\"\">\n  <label for=\"checkSizeLg\">Large checkbox</label>\n</div>","attrs":{"class":"bd-example d-flex flex-column gap-3"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0/getting-started/css-variables"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/6.0/getting-started/javascript"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/6.0/getting-started/accessibility"},{"en":"Quickstart","href":"https://getbootstrap.com/docs/6.0/guides/quickstart"},{"en":"npm","href":"https://getbootstrap.com/docs/6.0/guides/npm"},{"en":"Webpack","href":"https://getbootstrap.com/docs/6.0/guides/webpack"},{"en":"Parcel","href":"https://getbootstrap.com/docs/6.0/guides/parcel"},{"en":"Vite","href":"
{"route":"/2.3.0/examples/sticky-footer-navbar.html","version":"2.3.0","renderedVersion":"2.3.0","title":{"id":"sticky-footer-with-fixed-navbar","type":"heading","en":"Sticky footer with fixed navbar","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"#\">Project name</a>","anchors":["wrap"]},"blocks":[{"id":"page--list-2","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"page--item-1","type":"item","en":"<a href=\"#\">Home</a>"}]},{"tag":"li","body":[{"id":"page--item-2","type":"item","en":"<a href=\"#about\">About</a>"}]},{"tag":"li","body":[{"id":"page--item-3","type":"item","en":"<a href=\"#contact\">Contact</a>"}]},{"tag":"li","body":[{"id":"page--item-4","type":"item","en":"<a href=\"#\">Dropdown <b></b></a>"},{"id":"page--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"page--item-5","type":"item","en":"<a href=\"#\">Action</a>"}]},{"tag":"li","body":[{"id":"page--item-6","type":"item","en":"<a href=\"#\">Another action</a>"}]},{"tag":"li","body":[{"id":"page--item-7","type":"item","en":"<a href=\"#\">Something else here</a>"}]},{"tag":"li","body":[{"id":"page--item-8","type":"item","en":"Nav header"}]},{"tag":"li","body":[{"id":"page--item-9","type":"item","en":"<a href=\"#\">Separated link</a>"}]},{"tag":"li","body":[{"id":"page--item-10","type":"item","en":"<a href=\"#\">One more separated link</a>"}]}]}]}]},{"id":"sticky-footer-with-fixed-navbar--paragraph-1","type":"paragraph","en":"Pin a fixed-height footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS. A fixed navbar has been added within <code>#wrap</code> with <code>padding-top: 60px;</code> on the <code>.container</code>."},{"id":"sticky-footer-with-fixed-navbar--paragraph-2","type":"paragraph","en":"Back to <a href=\"https://getbootstrap.com/2.3.0/examples/sticky-footer.html\">the sticky footer</a> minus the navbar."},{"id":"sticky-footer-with-fixed-navbar--paragraph-3","type":"paragraph","en":"Example courtesy <a href=\"https://martinbean.co.uk/\">Martin Bean</a> and <a href=\"https://ryanfait.com/\">Ryan Fait</a>.","anchors":["push","footer"]}],"demos":[],"nav":[{"en":"Home","href":"#"},{"en":"About","href":"#about"},{"en":"Contact","href":"#contact"},{"en":"Dropdown","href":"#"},{"en":"Action","href":"#"},{"en":"Another action","href":"#"},{"en":"Something else here","href":"#"},{"en":"Separated link","href":"#"},{"en":"One more separated link","href":"#"}],"standalone":true,"embed":{"headStyles":"<style type=\"text/css\">\n\n      /* Sticky footer styles\n      -------------------------------------------------- */\n\n      html,\n      body {\n        height: 100%;\n        /* The html and body elements cannot have any padding or margin. */\n      }\n\n      /* Wrapper for page content to push down footer */\n      #wrap {\n        min-height: 100%;\n        height: auto !important;\n        height: 100%;\n        /* Negative indent footer by it's height */\n        margin: 0 auto -60px;\n      }\n\n      /* Set the fixed height of the footer here */\n      #push,\n      #footer {\n        height: 60px;\n      }\n      #footer {\n        background-color: #f5f5f5;\n      }\n\n      /* Lastly, apply responsive CSS fixes as necessary */\n      @media (max-width: 767px) {\n        #footer {\n          margin-left: -20px;\n          margin-right: -20px;\n          padding-left: 20px;\n          padding-right: 20px;\n        }\n      }\n\n\n\n      /* Custom page CSS\n      -------------------------------------------------- */\n      /* Not required for template or sticky footer method. */\n\n      #wrap > .container {\n        padding-top: 60px;\n      }\n      .container .credit {\n        margin: 20px 0;\n      }\n\n      code {\n        font-size: 80%;\n      }\n\n    </style>","body":"\n\n\n    <!-- Part 1: Wrap all page content here -->\n    <div id=\"wrap\">\n\n      <!-- Fixed navbar -->\n      <div class=\"navbar navbar-fixed-top\">\n        <div class=\"navbar-inner\">\n          <div class=\"container\">\n            <button type=\"button\" class=\"btn btn-navbar\" data-toggle=\"collapse\" data-target=\".nav-collapse\">\n              <span class=\"icon-bar\"></span>\n              <span class=\"icon-bar\"></span>\n              <span class=\"icon-bar\"></span>\n            </button>\n            <a class=\"brand\" href=\"#\">Project name</a>\n            <div class=\"nav-collapse collapse\">\n              <ul class=\"nav\">\n                <li class=\"active\"><a href=\"#\">Home</a></li>\n                <li><a href=\"#about\">About</a></li>\n                <li><a href=\"#contact\">Contact</a></li>\n                <li class=\"dropdown\">\n                  <a href=\"#\" class=\"dropdown-toggle\" data-toggle=\"dropdown\">Dropdown <b class=\"caret\"></b></a>\n                  <ul class=\"dropdown-menu\">\n                    <li><a href=\"#\">Action</a></li>\n                    <li><a href=\"#\">Another action</a></li>\n                    <li><a href=\"#\">Something else here</a></li>\n                    <li class=\"divider\"></li>\n                    <li class=\"nav-header\">Nav header</li>\n                    <li><a href=\"#\">Separated link</a></li>\n                    <li><a href=\"#\">One more separated link</a></li>\n                  </ul>\n                </li>\n              </ul>\n            </div><!--/.nav-collapse -->\n          </div>\n        </div>\n      </div>\n\n      <!-- Begin page content -->\n      <div class=\"container\">\n        <div class=\"page-header\">\n          <h1>Sticky footer with fixed navbar</h1>\n        </div>\n        <p class=\"lead\">Pin a fixed-height footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS. A fixed navbar has been added within <code>#wrap</code> with <code>padding-top: 60px;</code> on the <code>.container</code>.</p>\n        <p>Back to <a href=\"./sticky-footer.html\">the sticky footer</a> minus the navbar.</p>\n      </div>\n\n      <div id=\"push\"></div>\n    </div>\n\n    <div id=\"footer\">\n      <div class=\"container\">\n        <p class=\"muted credit\">Example courtesy <a href=\"https://martinbean.co.uk/\">Martin Bean</a> and <a href=\"https://ryanfait.com/\">Ryan Fait</a>.</p>\n      </div>\n    </div>\n\n\n\n    <!-- Le javascript\n    ================================================== -->\n    <!-- Placed at the end of the document so the pages load faster -->\n    <script src=\"../assets/js/jquery.js\"></script>\n    <script src=\"../assets/js/bootstrap-transition.js\"></script>\n    <script src=\"../assets/js/bootstrap-alert.js\"></script>\n    <script src=\"../assets/js/bootstrap-modal.js\"></script>\n    <script src=\"../assets/js/bootstrap-dropdown.js\"></script>\n    <script src=\"../assets/js/bootstrap-scrollspy.js\"></script>\n    <script src=\"../assets/js/bootstrap-tab.js\"></script>\n    <script src=\"../assets/js/bootstrap-tooltip.js\"></script>\n    <script src=\"../assets/js/bootstrap-popover.js\"></script>\n    <script src=\"../assets/js/bootstrap-button.js\"></script>\n    <script src=\"../assets/js/bootstrap-collapse.js\"></script>\n    <script src=\"../assets/js/bootstrap-carousel.js\"></script>\n    <script src=\"../assets/js/bootstrap-typeahead.js\"></script>\n\n  \n\n","classes":"","dir":"ltr"},"publishedAssets":[],"sourceScripts":["https://getbootstrap.com/2.3.0/assets/js/jquery.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-transition.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-alert.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-modal.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-dropdown.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-scrollspy.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-tab.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-tooltip.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-popover.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-button.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-collapse.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-carousel.js","https://getbootstrap.com/2.3.0/assets/js/bootstrap-typeahead.js"],"sourceStyles":["https://getbootstrap.com/2.3.0/assets/css/bootstrap.css","https://getbootstrap.com/2.3.0/assets/css/bootstrap-responsive.css"]}

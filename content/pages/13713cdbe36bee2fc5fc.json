s here as the browser default is <code>row</code>. However, you may encounter situations where you needed to explicitly set this value (like responsive layouts)."},{"id":"direction--paragraph-2","type":"paragraph","en":"Use <code>.flex-row</code> to set a horizontal direction (the browser default), or <code>.flex-row-reverse</code> to start the horizontal direction from the opposite side."},{"id":"direction--example-1","type":"demo","key":"c3a6934dda1e8d6408dd","height":174},{"id":"direction--code-1","type":"code","value":"<div class=\"d-flex flex-row mb-3\">\n  <div class=\"p-2\">Flex item 1</div>\n  <div class=\"p-2\">Flex item 2</div>\n  <div class=\"p-2\">Flex item 3</div>\n</div>\n<div class=\"d-flex flex-row-reverse\">\n  <div class=\"p-2\">Flex item 1</div>\n  <div class=\"p-2\">Flex item 2</div>\n  <div class=\"p-2\">Flex item 3</div>\n</div>","language":""},{"id":"direction--paragraph-3","type":"paragraph","en":"Use <code>.flex-column</code> to set a vertical direction, or <code>.flex-column-reverse</code> to start the vertical direction from the opposite side."},{"id":"direction--example-2","type":"demo","key":"8345067613d17dc23796","height":174},{"id":"direction--code-2","type":"code","value":"<div class=\"d-flex flex-column mb-3\">\n  <div class=\"p-2\">Flex item 1</div>\n  <div class=\"p-2\">Flex item 2</div>\n  <div class=\"p-2\">Flex item 3</div>\n</div>\n<div class=\"d-flex flex-column-reverse\">\n  <div class=\"p-2\">Flex item 1</div>\n  <div class=\"p-2\">Flex item 2</div>\n  <div class=\"p-2\">Flex item 3</div>\n</div>","language":""},{"id":"direction--paragraph-4","type":"paragraph","en":"Responsive variations also exist for <code>flex-direction</code>."},{"id":"direction--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"direction--item-1","type":"item","en":"<code>.flex-row</code>"}]},{"tag":"li","body":[{"id":"direction--item-2","type":"item","en":"<code>.flex-row-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-3","type":"item","en":"<code>.flex-column</code>"}]},{"tag":"li","body":[{"id":"direction--item-4","type":"item","en":"<code>.flex-column-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-5","type":"item","en":"<code>.sm:flex-row</code>"}]},{"tag":"li","body":[{"id":"direction--item-6","type":"item","en":"<code>.sm:flex-row-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-7","type":"item","en":"<code>.sm:flex-column</code>"}]},{"tag":"li","body":[{"id":"direction--item-8","type":"item","en":"<code>.sm:flex-column-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-9","type":"item","en":"<code>.md:flex-row</code>"}]},{"tag":"li","body":[{"id":"direction--item-10","type":"item","en":"<code>.md:flex-row-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-11","type":"item","en":"<code>.md:flex-column</code>"}]},{"tag":"li","body":[{"id":"direction--item-12","type":"item","en":"<code>.md:flex-column-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-13","type":"item","en":"<code>.lg:flex-row</code>"}]},{"tag":"li","body":[{"id":"direction--item-14","type":"item","en":"<code>.lg:flex-row-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-15","type":"item","en":"<code>.lg:flex-column</code>"}]},{"tag":"li","body":[{"id":"direction--item-16","type":"item","en":"<code>.lg:flex-column-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-17","type":"item","en":"<code>.xl:flex-row</code>"}]},{"tag":"li","body":[{"id":"direction--item-18","type":"item","en":"<code>.xl:flex-row-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-19","type":"item","en":"<code>.xl:flex-column</code>"}]},{"tag":"li","body":[{"id":"direction--item-20","type":"item","en":"<code>.xl:flex-column-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-21","type":"item","en":"<code>.2xl:flex-row</code>"}]},{"tag":"li","body":[{"id":"direction--item-22","type":"item","en":"<code>.2xl:flex-row-reverse</code>"}]},{"tag":"li","body":[{"id":"direction--item-23","type":"item","en":"<code>.2xl:flex-column</code>"}]},{"tag":"li","body":[{"id":"direction--item-24","type":"item","en":"<code>.2xl:flex-column-reverse</code>"}]}]},{"id":"fill","type":"heading","en":"Fill","level":2},{"id":"fill--paragraph-1","type":"paragraph","en":"Use the <code>.flex-fill</code> class on a series of sibling elements to force them into widths equal to their content (or equal widths if their content does not surpass their border-boxes) while taking up all available horizontal space."},{"id":"fill--example-1","type":"demo","key":"951e709c3d38671887d1","height":147},{"id":"fill--code-1","type":"code","value":"<div class=\"d-flex\">\n  <div class=\"p-2 flex-fill\">Flex item with a lot of content</div>\n  <div class=\"p-2 flex-fill\">Flex item</div>\n  <div class=\"p-2 flex-fill\">Flex item</div>\n</div>","language":""},{"id":"fill--paragraph-2","type":"paragraph","en":"Responsive variations also exist for <code>flex-fill</code>."},{"id":"fill--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"fill--item-1","type":"item","en":"<code>.flex-fill</code>"}]},{"tag":"li","body":[{"id":"fill--item-2","type":"item","en":"<code>.sm:flex-fill</code>"}]},{"tag":"li","body":[{"id":"fill--item-3","type":"item","en":"<code>.md:flex-fill</code>"}]},{"tag":"li","body":[{"id":"fill--item-4","type":"item","en":"<code>.lg:flex-fill</code>"}]},{"tag":"li","body":[{"id":"fill--item-5","type":"item","en":"<code>.xl:flex-fill</code>"}]},{"tag":"li","body":[{"id":"fill--item-6","type":"item","en":"<code>.2xl:flex-fill</code>"}]}]},{"id":"grow-and-shrink","type":"heading","en":"Grow and shrink","level":2},{"id":"grow-and-shrink--paragraph-1","type":"paragraph","en":"Use <code>.flex-grow-*</code> utilities to toggle a flex item’s ability to grow to fill available space. In the example below, the <code>.flex-grow-1</code> elements uses all available space it can, while allowing the remaining two flex items their necessary space."},{"id":"grow-and-shrink--example-1","type":"demo","key":"3eadaa950c5b72c8f987","height":147},{"id":"grow-and-shrink--code-1","type":"code","value":"<div class=\"d-flex\">\n  <div class=\"p-2 flex-grow-1\">Flex item</div>\n  <div class=\"p-2\">Flex item</div>\n  <div class=\"p-2\">Third flex item</div>\n</div>","language":""},{"id":"grow-and-shrink--paragraph-2","type":"paragraph","en":"Use <code>.flex-shrink-*</code> utilities to toggle a flex item’s ability to shrink if necessary. In the example below, the second flex item with <code>.flex-shrink-1</code> is forced to wrap its contents to a new line, &quot;shrinking&quot; to allow more space for the previous flex item with <code>.w-100</code>."},{"id":"grow-and-shrink--example-2","type":"demo","key":"846b7955f7116bcd3006","height":147},{"id":"grow-and-shrink--code-2","type":"code","value":"<div class=\"d-flex\">\n  <div class=\"p-2 w-100\">Flex item</div>\n  <div class=\"p-2 flex-shrink-1\">Flex item</div>\n</div>","language":""},{"id":"grow-and-shrink--paragraph-3","type":"paragraph","en":"Responsive variations also exist for <code>flex-grow</code> and <code>flex-shrink</code>."},{"id":"grow-and-shrink--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"grow-and-shrink--item-1","type":"item","en":"<code>.flex-grow-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-2","type":"item","en":"<code>.flex-grow-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-3","type":"item","en":"<code>.flex-shrink-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-4","type":"item","en":"<code>.flex-shrink-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-5","type":"item","en":"<code>.sm:flex-grow-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-6","type":"item","en":"<code>.sm:flex-grow-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-7","type":"item","en":"<code>.sm:flex-shrink-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-8","type":"item","en":"<code>.sm:flex-shrink-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-9","type":"item","en":"<code>.md:flex-grow-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-10","type":"item","en":"<code>.md:flex-grow-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-11","type":"item","en":"<code>.md:flex-shrink-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-12","type":"item","en":"<code>.md:flex-shrink-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-13","type":"item","en":"<code>.lg:flex-grow-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-14","type":"item","en":"<code>.lg:flex-grow-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-15","type":"item","en":"<code>.lg:flex-shrink-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-16","type":"item","en":"<code>.lg:flex-shrink-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-17","type":"item","en":"<code>.xl:flex-grow-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-18","type":"item","en":"<code>.xl:flex-grow-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-19","type":"item","en":"<code>.xl:flex-shrink-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-20","type":"item","en":"<code>.xl:flex-shrink-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-21","type":"item","en":"<code>.2xl:flex-grow-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-22","type":"item","en":"<code>.2xl:flex-grow-1</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-23","type":"item","en":"<code>.2xl:flex-shrink-0</code>"}]},{"tag":"li","body":[{"id":"grow-and-shrink--item-24","type":"item","en":"<code>.2xl:flex-shrink-1</code>"}]}]},{"id":"wrap","type":"heading","en":"Wrap","level":2},{"id":"wrap--paragraph-1","type":"paragraph","en":"Change how flex items wrap in a flex container. Choose from no wrapping at all (the browser default) with <code>.flex-nowrap</code>, wrapping with <code>.flex-wrap</code>, or reverse wrapping with <code>.flex-wrap-reverse</code>."},{"id":"wrap--example-1","type":"demo","key":"b626f61a24ba3f974378","height":147},{"id":"wrap--code-1","type":"code","value":"<div class=\"d-flex flex-nowrap\">\n  ...\n</div>","language":""},{"id":"wrap--example-2","type":"demo","key":"6ab46d5cb316e79be3ea","height":147},{"id":"wrap--code-2","type":"code","value":"<div class=\"d-flex flex-wrap\">\n  ...\n</div>","language":""},{"id":"wrap--example-3","type":"demo","key":"69fe8823071b2520f71e","height":147},{"id":"wrap--code-3","type":"code","value":"<div class=\"d-flex flex-wrap-reverse\">\n  ...\n</div>","language":""},{"id":"wrap--paragraph-2","type":"paragraph","en":"Responsive variations also exist for <code>flex-wrap</code>."},{"id":"wrap--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"wrap--item-1","type":"item","en":"<code>.flex-nowrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-2","type":"item","en":"<code>.flex-wrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-3","type":"item","en":"<code>.flex-wrap-reverse</code>"}]},{"tag":"li","body":[{"id":"wrap--item-4","type":"item","en":"<code>.sm:flex-nowrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-5","type":"item","en":"<code>.sm:flex-wrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-6","type":"item","en":"<code>.sm:flex-wrap-reverse</code>"}]},{"tag":"li","body":[{"id":"wrap--item-7","type":"item","en":"<code>.md:flex-nowrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-8","type":"item","en":"<code>.md:flex-wrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-9","type":"item","en":"<code>.md:flex-wrap-reverse</code>"}]},{"tag":"li","body":[{"id":"wrap--item-10","type":"item","en":"<code>.lg:flex-nowrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-11","type":"item","en":"<code>.lg:flex-wrap</code>"}]},{"tag":"li","body":[{"id":"wrap--item-12","type":"item","en":"<code>.lg:flex-wrap-reverse</code>
{"route":"/docs/6.0/utilities/flex/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Flex","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Quickly manage the layout, alignment, and sizing of grid columns, navigation, components, and more with a full suite of responsive flexbox utilities. For more complex implementations, custom CSS may be necessary."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".flex-fill"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"flex: 1 1 auto;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".flex-row"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"flex-direction: row;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".flex-column"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"flex-direction: column;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".flex-row-reverse"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"flex-direction: row-reverse;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".flex-column-reverse"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"flex-direction: column-reverse;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".flex-grow-0"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"
{"route":"/docs/6.0/utilities/grid/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Grid","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Utilities for controlling CSS Grid layout behavior including column counts, column behavior, and auto-placement options."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".grid-cols-1"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"grid-template-columns: 1fr;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".grid-cols-2"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"grid-template-columns: repeat(2, 1fr);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".grid-cols-3"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"grid-template-columns: repeat(3, 1fr);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".grid-cols-4"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"grid-template-columns: repeat(4, 1fr);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".grid-cols-6"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"grid-template-columns: repeat(6, 1fr);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".grid-cols-subgrid"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"grid-template-columns: subgrid;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":".grid-cols-fill"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"grid-column: 1 / -1;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":".grid-auto-flow-row"}]},{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"grid-auto-flow: row;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":".grid-auto-flow-column"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"grid-auto-flow: column;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":".grid-auto-flow-dense"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"grid-auto-flow: dense;"}]}]}]},{"id":"overview","type":"heading","en":"Overview","level":2},{"id":"overview--paragraph-1","type":"paragraph","en":"Use grid utilities to control CSS Grid layout behavior. These utilities work with Bootstrap’s <a href=\"https://getbootstrap.com/docs/6.0/layout/css-grid\">CSS Grid layout system</a> to manage column counts and auto-placement algorithms."},{"id":"overview--note-1","type":"note","tone":"info","body":[{"id":"overview--note-text-1","type":"note-text","en":"<strong>CSS Grid is opt-in.</strong> To use these utilities, you need to enable the CSS Grid system by setting <code>$enable-cssgrid: true</code> in your Sass configuration. See our <a href=\"https://getbootstrap.com/docs/6.0/layout/css-grid\">CSS Grid documentation</a> for more details."}]},{"id":"column-counts","type":"heading","en":"Column counts","level":2},{"id":"column-counts--paragraph-1","type":"paragraph","en":"Use <code>grid-cols-{value}</code> utilities to set the number of columns in a CSS Grid container by modifying the <code>--bs-columns</code> CSS variable. Bootstrap’s CSS Grid system supports 3, 4, and 6 column layouts out of the box."},{"id":"column-counts--example-1","type":"demo","key":"0fb6a1064e0701495467","height":147},{"id":"column-counts--code-1","type":"code","value":"<div class=\"grid text-center grid-cols-3\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","language":""},{"id":"column-counts--example-2","type":"demo","key":"fc7d904cd7e56fed7bd0","height":147},{"id":"column-counts--code-2","type":"code","value":"<div class=\"grid text-center grid-cols-4\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","language":""},{"id":"column-counts--example-3","type":"demo","key":"2343a226156993f4d630","height":147},{"id":"column-counts--code-3","type":"code","value":"<div class=\"grid text-center grid-cols-6\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","language":""},{"id":"column-counts--paragraph-2","type":"paragraph","en":"These utilities set the <code>--bs-columns</code> CSS variable:"},{"id":"column-counts--code-4","type":"code","value":".grid-cols-3 {\n  --bs-columns: 3;\n}\n\n.grid-cols-4 {\n  --bs-columns: 4;\n}\n\n.grid-cols-6 {\n  --bs-columns: 6;\n}","language":""},{"id":"fill-columns","type":"heading","en":"Fill columns","level":2},{"id":"fill-columns--paragraph-1","type":"paragraph","en":"Use <code>grid-cols-fill</code> to make a grid item span the entire width of the grid container by setting <code>grid-column: 1 / -1</code>."},{"id":"fill-columns--example-1","type":"demo","key":"11366c4a8ff3b4ae82dc","height":147},{"id":"fill-columns--code-1","type":"code","value":"<div class=\"grid text-center\" style=\"--bs-columns: 4;\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div class=\"grid-cols-fill\">Full width column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","language":""},{"id":"fill-columns--code-2","type":"code","value":"<div class=\"grid\" style=\"--bs-columns: 4;\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div class=\"grid-cols-fill\">Full width column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","language":""},{"id":"subgrid","type":"heading","en":"Subgrid","level":2},{"id":"subgrid--paragraph-1","type":"paragraph","en":"Use <code>grid-cols-subgrid</code> to have a nested <code>.grid</code> adopt the column tracks of its parent grid, instead of generating its own evenly divided columns, by setting <code>grid-template-columns: subgrid</code>."},{"id":"subgrid--paragraph-2","type":"paragraph","en":"In the example below, the parent grid’s three columns are unevenly sized (<code>2fr 1fr 1fr</code>). The nested grid in the last row uses <code>grid-cols-subgrid</code> to line up with those same column tracks rather than splitting into three equal columns of its own."},{"id":"subgrid--example-1","type":"demo","key":"96128b3adfafcce5a6d7","height":147},{"id":"subgrid--code-1","type":"code","value":"<div class=\"grid text-center\" style=\"grid-template-columns: 2fr 1fr 1fr;\">\n  <div>Column (2fr)</div>\n  <div>Column (1fr)</div>\n  <div>Column (1fr)</div>\n  <div class=\"grid grid-cols-subgrid\" style=\"grid-column: 1 / -1;\">\n    <div>Subgrid column (2fr)</div>\n    <div>Subgrid column (1fr)</div>\n    <div>Subgrid column (1fr)</div>\n  </div>\n</div>","language":""},{"id":"subgrid--code-2","type":"code","value":".grid-cols-subgrid {\n  grid-template-columns: subgrid;\n}","language":""},{"id":"auto-flow","type":"heading","en":"Auto flow","level":2},{"id":"auto-flow--paragraph-1","type":"paragraph","en":"Control how auto-placed items are inserted into the grid with <code>grid-auto-flow</code> utilities."},{"id":"row-default","type":"heading","en":"Row (default)","level":3},{"id":"row-default--paragraph-1","type":"paragraph","en":"Use <code>grid-auto-flow-row</code> to place items by filling each row in turn, adding new rows as necessary."},{"id":"row-default--example-1","type":"demo","key":"0cc496fe2ecf1b091603","height":147},{"id":"row-default--code-1","type":"code","value":"<div class=\"grid text-center grid-auto-flow-row\" style=\"--bs-columns: 3;\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n  <div>Item 4</div>\n  <div>Item 5</div>\n</div>","language":""},{"id":"column","type":"heading","en":"Column","level":3},{"id":"column--paragraph-1","type":"paragraph","en":"Use <code>grid-auto-flow-column</code> to place items by filling each column in turn, adding new columns as necessary."},{"id":"column--example-1","type":"demo","key":"1a0a8c0902d189c21083","height":147},{"id":"column--code-1","type":"code","value":"<div class=\"grid text-center grid-auto-flow-column\" style=\"--bs-rows: 3; --bs-columns: 3;\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n  <div>Item 4</div>\n  <div>Item 5</div>\n</div>","language":""},{"id":"dense","type":"heading","en":"Dense","level":3},{"id":"dense--paragraph-1","type":"paragraph","en":"Use <code>grid-auto-flow-dense</code> to use the &quot;dense&quot; packing algorithm, which attempts to fill in holes earlier in the grid if smaller items come up later."},{"id":"dense--example-1","type":"demo","key":"8a187e86ee655ca75496","height":147},{"id":"dense--code-1","type":"code","value":"<div class=\"grid text-center grid-auto-flow-dense\" style=\"--bs-columns: 3;\">\n  <div class=\"g-col-2\">Item 1 (spans 2)</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n  <div>Item 4</div>\n  <div class=\"g-col-2\">Item 5 (spans 2)</div>\n</div>","language":""},{"id":"dense--code-2","type":"code","value":".grid-auto-flow-row {\n  grid-auto-flow: row;\n}\n\n.grid-auto-flow-column {\n  grid-auto-flow: column;\n}\n\n.grid-auto-flow-dense {\n  grid-auto-flow: dense;\n}","language":""},{"id":"responsive","type":"heading","en":"Responsive","level":2},{"id":"responsive--paragraph-1","type":"paragraph","en":"All grid utilities are responsive and include all breakpoints."},{"id":"column-counts-1","type":"heading","en":"Column counts","level":3},{"id":"column-counts-1--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"column-counts-1--item-1","type":"item","en":"<code>.grid-cols-3</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-2","type":"item","en":"<code>.grid-cols-4</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-3","type":"item","en":"<code>.grid-cols-6</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-4","type":"item","en":"<code>.grid-cols-fill</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-5","type":"item","en":"<code>.grid-cols-subgrid</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-6","type":"item","en":"<code>.sm:grid-cols-3</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-7","type":"item","en":"<code>.sm:grid-cols-4</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-8","type":"item","en":"<code>.sm:grid-cols-6</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-9","type":"item","en":"<code>.sm:grid-cols-fill</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-10","type":"item","en":"<code>.sm:grid-cols-subgrid</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-11","type":"item","en":"<code>.md:grid-cols-3</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-12","type":"item","en":"<code>.md:grid-cols-4</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-13","type":"item","en":"<code>.md:grid-cols-6</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-14","type":"item","en":"<code>.md:grid-cols-fill</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-15","type":"item","en":"<code>.md:grid-cols-subgrid</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-16","type":"item","en":"<code>.lg:grid-cols-3</code>"}]},{"tag":"li","body":[{"id":"column-counts-1--item-
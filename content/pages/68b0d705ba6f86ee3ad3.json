--code-1","type":"code","value":"\"grid-column-counts\": (\n  responsive: true,\n  property: grid-template-columns,\n  class: grid-cols,\n  values: (\n    \"1\": 1fr,\n    \"2\": repeat(2, 1fr),\n    \"3\": repeat(3, 1fr),\n    \"4\": repeat(4, 1fr),\n    \"6\": repeat(6, 1fr),\n    subgrid: subgrid,\n  )\n),\n\"grid-columns\": (\n  responsive: true,\n  property: grid-column,\n  class: grid-cols,\n  values: (\n    fill: #{\"1 / -1\"},\n  )\n),\n\"grid-auto-flow\": (\n  responsive: true,\n  property: grid-auto-flow,\n  class: grid-auto-flow,\n  values: row column dense\n),","language":""}],"demos":[{"key":"0fb6a1064e0701495467","html":"<div class=\"grid text-center grid-cols-3\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","attrs":{"class":"bd-example bd-example-cssgrid"},"sprite":""},{"key":"fc7d904cd7e56fed7bd0","html":"<div class=\"grid text-center grid-cols-4\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","attrs":{"class":"bd-example bd-example-cssgrid"},"sprite":""},{"key":"2343a226156993f4d630","html":"<div class=\"grid text-center grid-cols-6\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","attrs":{"class":"bd-example bd-example-cssgrid"},"sprite":""},{"key":"11366c4a8ff3b4ae82dc","html":"<div class=\"grid text-center\" style=\"--bs-columns: 4;\">\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div>Column</div>\n  <div class=\"grid-cols-fill\">Full width column</div>\n  <div>Column</div>\n  <div>Column</div>\n</div>","attrs":{"class":"bd-example bd-example-cssgrid"},"sprite":""},{"key":"96128b3adfafcce5a6d7","html":"<div class=\"grid text-center\" style=\"grid-template-columns: 2fr 1fr 1fr;\">\n  <div>Column (2fr)</div>\n  <div>Column (1fr)</div>\n  <div>Column (1fr)</div>\n  <div class=\"grid grid-cols-subgrid\" st
{"route":"/docs/3.4/examples/sticky-footer/","version":"3.4","renderedVersion":"3.4","title":{"id":"sticky-footer","type":"heading","en":"Sticky footer","level":1},"lead":{"id":"sticky-footer--paragraph-1","type":"paragraph","en":"Pin a fixed-height footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS."},"blocks":[{"id":"sticky-footer--paragraph-2","type":"paragraph","en":"Use <a href=\"https://getbootstrap.com/docs/3.4/examples/sticky-footer-navbar/\">the sticky footer with a fixed navbar</a> if need be, too."}],"demos":[],"nav":[],"standalone":true,"embed":{"headStyles":"","body":"\n\n    <!-- Begin page content -->\n    <div class=\"container\">\n      <div class=\"page-header\">\n        <h1>Sticky footer</h1>\n      </div>\n      <p class=\"lead\">Pin a fixed-height footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS.</p>\n      <p>Use <a href=\"../sticky-footer-navbar/\">the sticky footer with a fixed navbar</a> if need be, too.</p>\n    </div>\n\n    <footer class=\"footer\">\n      <div class=\"container\">\n        <p class=\"text-muted\">Place sticky footer content here.</p>\n      </div>\n    </footer>\n\n    <!-- IE10 viewport hack for Surface/desktop Windows 8 bug -->\n    <script src=\"../../assets/js/ie10-viewport-bug-workaround.js\"></script>\n  \n\n","classes":"","dir":"ltr"},"publishedAssets":[],"sourceScripts":["https://getbootstrap.com/docs/3.4/assets/js/ie-emulation-modes-warning.js","https://getbootstrap.com/docs/3.4/assets/js/ie10-viewport-bug-workaround.js"],"sourceStyles":["https://getbootstrap.com/docs/3.4/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/3.4/assets/css/ie10-viewport-bug-workaround.css","https://getbootstrap.com/docs/3.4/examples/sticky-footer/sticky-footer.css"]}

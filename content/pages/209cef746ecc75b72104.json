{"route":"/docs/4.2/examples/floating-labels/","version":"4.2","renderedVersion":"4.2","title":{"id":"floating-labels","type":"heading","en":"Floating labels","level":1},"blocks":[{"id":"page--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/4.2/assets/brand/bootstrap-solid.svg\" alt=\"\" loading=\"lazy\">"},{"id":"floating-labels--paragraph-1","type":"paragraph","en":"Build form controls with floating labels via the <code>:placeholder-shown</code> pseudo-element. <a href=\"https://caniuse.com/#feat=css-placeholder-shown\">Works in latest Chrome, Safari, and Firefox.</a>"},{"id":"floating-labels--paragraph-2","type":"paragraph","en":"Email address"},{"id":"floating-labels--paragraph-3","type":"paragraph","en":"Password"},{"id":"floating-labels--paragraph-4","type":"paragraph","en":"Remember me"},{"id":"floating-labels--caption-1","type":"caption","en":"Sign in"},{"id":"floating-labels--paragraph-5","type":"paragraph","en":"© 2017-2018"}],"demos":[],"nav":[],"standalone":true,"embed":{"headStyles":"<style>\n      .bd-placeholder-img {\n        font-size: 1.125rem;\n        text-anchor: middle;\n      }\n\n      @media (min-width: 768px) {\n        .bd-placeholder-img-lg {\n          font-size: 3.5rem;\n        }\n      }\n    </style>","body":"\n    <form class=\"form-signin\">\n  <div class=\"text-center mb-4\">\n    <img class=\"mb-4\" src=\"/docs/4.2/assets/brand/bootstrap-solid.svg\" alt=\"\" width=\"72\" height=\"72\">\n    <h1 class=\"h3 mb-3 font-weight-normal\">Floating labels</h1>\n    <p>Build form controls with floating labels via the <code>:placeholder-shown</code> pseudo-element. <a href=\"https://caniuse.com/#feat=css-placeholder-shown\">Works in latest Chrome, Safari, and Firefox.</a></p>\n  </div>\n\n  <div class=\"form-label-group\">\n    <input type=\"email\" id=\"inputEmail\" class=\"form-control\" placeholder=\"Email address\" required=\"\" autofocus=\"\">\n    <label for=\"inputEmail\">Email address</label>\n  </div>\n\n  <div class=\"form-label-group\">\n    <input type=\"password\" id=\"inputPassword\" class=\"form-control\" placeholder=\"Password\" required=\"\">\n    <label for=\"inputPassword\">Password</label>\n  </div>\n\n  <div class=\"checkbox mb-3\">\n    <label>\n      <input type=\"checkbox\" value=\"remember-me\"> Remember me\n    </label>\n  </div>\n  <button class=\"btn btn-lg btn-primary btn-block\" type=\"submit\">Sign in</button>\n  <p class=\"mt-5 mb-3 text-muted text-center\">© 2017-2018</p>\n</form>\n\n\n","classes":"","dir":"ltr"},"publishedAssets":[{"url":"/docs/4.2/dist/css/bootstrap.min.css","integrity":"sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"}],"sourceScripts":[],"sourceStyles":["https://getbootstrap.com/docs/4.2/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/4.2/examples/floating-labels/floating-labels.css"]}

{"route":"/docs/3.3/","version":"3.3","renderedVersion":"3.3","title":{"id":"overview","type":"heading","level":1,"en":"Bootstrap"},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"B","anchors":["content"]},"blocks":[{"id":"page--paragraph-2","type":"paragraph","en":"Bootstrap is the most popular HTML, CSS, and JS framework for developing responsive, mobile first projects on the web."},{"id":"page--paragraph-3","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/3.3/getting-started/#download\">Download Bootstrap</a>"},{"id":"page--paragraph-4","type":"paragraph","en":"Currently v3.3.7"},{"id":"designed-for-everyone-everywhere","type":"heading","en":"Designed for everyone, everywhere","level":2},{"id":"designed-for-everyone-everywhere--paragraph-1","type":"paragraph","en":"Bootstrap makes front-end web development faster and easier. It&#39;s made for folks of all skill levels, devices of all shapes, and projects of all sizes."},{"id":"designed-for-everyone-everywhere--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.3/assets/img/sass-less.png\" alt=\"Sass and Less support\" loading=\"lazy\">"},{"id":"preprocessors","type":"heading","en":"Preprocessors","level":3},{"id":"preprocessors--paragraph-1","type":"paragraph","en":"Bootstrap ships with vanilla CSS, but its source code utilizes the two most popular CSS preprocessors, <a href=\"https://getbootstrap.com/docs/3.3/css/#less\">Less</a> and <a href=\"https://getbootstrap.com/docs/3.3/css/#sass\">Sass</a>. Quickly get started with precompiled CSS or build on the source."},{"id":"preprocessors--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.3/assets/img/devices.png\" alt=\"Responsive across devices\" loading=\"lazy\">"},{"id":"one-framework-every-device","type":"heading","en":"One framework, every device.","level":3},{"id":"one-framework-every-device--paragraph-1","type":"paragraph","en":"Bootstrap easily and efficiently scales your websites and applications with a single code base, from phones to tablets to desktops with CSS media queries."},{"id":"one-framework-every-device--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.3/assets/img/components.png\" alt=\"Components\" loading=\"lazy\">"},{"id":"full-of-features","type":"heading","en":"Full of features","level":3},{"id":"full-of-features--paragraph-1","type":"paragraph","en":"With Bootstrap, you get extensive and beautiful documentation for common HTML elements, dozens of custom HTML and CSS components, and awesome jQuery plugins."},{"id":"full-of-features--paragraph-2","type":"paragraph","en":"Bootstrap is open source. It&#39;s hosted, developed, and maintained on GitHub."},{"id":"full-of-features--paragraph-3","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap\">View the GitHub project</a>"},{"id":"premium-bootstrap-themes","type":"heading","en":"Premium Bootstrap Themes","level":2},{"id":"premium-bootstrap-themes--paragraph-1","type":"paragraph","en":"Take Bootstrap 4 to the next level with premium themes from our official marketplace—all built on Bootstrap with new components and plugins, docs, and build tools."},{"id":"premium-bootstrap-themes--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/docs/3.3/assets/img/bs-themes.png\" alt=\"Bootstrap Themes\" loading=\"lazy\">"},{"id":"built-with-bootstrap","type":"heading","en":"Built with Bootstrap","level":2},{"id":"built-with-bootstrap--paragraph-1","type":"paragraph","en":"Millions of amazing sites across the web are being built with Bootstrap. Get started on your own with our growing <a href=\"https://getbootstrap.com/docs/getting-started/#examples\">collection of examples</a> or by exploring some of our favorites."},{"id":"built-with-bootstrap--media-1","type":"media","html":"<a href=\"https://expo.getbootstrap.com/2014/10/29/lyft/\"><img src=\"https://getbootstrap.com/docs/3.3/assets/img/expo-lyft.jpg\" alt=\"Lyft\" loading=\"lazy\"></a>"},{"id":"built-with-bootstrap--media-2","type":"media","html":"<a href=\"https://expo.getbootstrap.com/2014/09/30/vogue/\"><img src=\"https://getbootstrap.com/docs/3.3/assets/img/expo-vogue.jpg\" alt=\"Vogue\" loading=\"lazy\"></a>"},{"id":"built-with-bootstrap--media-3","type":"media","html":"<a href=\"https://expo.getbootstrap.com/2014/03/13/riot-design/\"><img src=\"https://getbootstrap.com/docs/3.3/assets/img/expo-riot.jpg\" alt=\"Riot Design\" loading=\"lazy\"></a>"},{"id":"built-with-bootstrap--media-4","type":"media","html":"<a href=\"https://expo.getbootstrap.com/2014/02/12/newsweek/\"><img src=\"https://getbootstrap.com/docs/3.3/assets/img/expo-newsweek.jpg\" alt=\"Newsweek\" loading=\"lazy\"></a>"},{"id":"built-with-bootstrap--paragraph-2","type":"paragraph","en":"We showcase dozens of inspiring projects built with Bootstrap on the Bootstrap Expo."},{"id":"built-with-bootstrap--paragraph-3","type":"paragraph","en":"<a href=\"https://expo.getbootstrap.com/\">Explore the Expo</a>"}],"demos":[],"nav":[],"standalone":false,"publishedAssets":[],"sourceScripts":["https://getbootstrap.com/docs/3.3/assets/js/ie-emulation-modes-warning.js","https://cdn.usefathom.com/script.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom","https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js","https://getbootstrap.com/docs/3.3/dist/js/bootstrap.min.js","https://getbootstrap.com/docs/3.3/assets/js/docs.min.js","https://getbootstrap.com/docs/3.3/assets/js/ie10-viewport-bug-workaround.js"],"sourceStyles":["https://getbootstrap.com/docs/3.3/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/3.3/assets/css/docs.min.css"]}

{"route":"/docs/5.1/examples/sticky-footer-navbar/","version":"5.1","renderedVersion":"5.1","title":{"id":"sticky-footer-with-fixed-navbar","type":"heading","en":"Sticky footer with fixed navbar","level":1},"lead":{"id":"sticky-footer-with-fixed-navbar--paragraph-1","type":"paragraph","en":"Pin a footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS. A fixed navbar has been added with <code>padding-top: 60px;</code> on the <code>main &gt; .container</code>."},"blocks":[{"id":"sticky-footer-with-fixed-navbar--paragraph-2","type":"paragraph","en":"Back to <a href=\"https://getbootstrap.com/docs/5.1/examples/sticky-footer/\">the default sticky footer</a> minus the navbar."}],"demos":[],"nav":[],"standalone":true,"embed":{"headStyles":"<style>\n      .bd-placeholder-img {\n        font-size: 1.125rem;\n        text-anchor: middle;\n        -webkit-user-select: none;\n        -moz-user-select: none;\n        user-select: none;\n      }\n\n      @media (min-width: 768px) {\n        .bd-placeholder-img-lg {\n          font-size: 3.5rem;\n        }\n      }\n    </style>","body":"\n    \n<header>\n  <!-- Fixed navbar -->\n  <nav class=\"navbar navbar-expand-md navbar-dark fixed-top bg-dark\">\n    <div class=\"container-fluid\">\n      <a class=\"navbar-brand\" href=\"#\">Fixed navbar</a>\n      <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarCollapse\" aria-controls=\"navbarCollapse\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n        <span class=\"navbar-toggler-icon\"></span>\n      </button>\n      <div class=\"collapse navbar-collapse\" id=\"navbarCollapse\">\n        <ul class=\"navbar-nav me-auto mb-2 mb-md-0\">\n          <li class=\"nav-item\">\n            <a class=\"nav-link active\" aria-current=\"page\" href=\"#\">Home</a>\n          </li>\n          <li class=\"nav-item\">\n            <a class=\"nav-link\" href=\"#\">Link</a>\n          </li>\n          <li class=\"nav-item\">\n            <a class=\"nav-link disabled\">Disabled</a>\n          </li>\n        </ul>\n        <form class=\"d-flex\">\n          <input class=\"form-control me-2\" type=\"search\" placeholder=\"Search\" aria-label=\"Search\">\n          <button class=\"btn btn-outline-success\" type=\"submit\">Search</button>\n        </form>\n      </div>\n    </div>\n  </nav>\n</header>\n\n<!-- Begin page content -->\n<main class=\"flex-shrink-0\">\n  <div class=\"container\">\n    <h1 class=\"mt-5\">Sticky footer with fixed navbar</h1>\n    <p class=\"lead\">Pin a footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS. A fixed navbar has been added with <code class=\"small\">padding-top: 60px;</code> on the <code class=\"small\">main &gt; .container</code>.</p>\n    <p>Back to <a href=\"/docs/5.1/examples/sticky-footer/\">the default sticky footer</a> minus the navbar.</p>\n  </div>\n</main>\n\n<footer class=\"footer mt-auto py-3 bg-light\">\n  <div class=\"container\">\n    <span class=\"text-muted\">Place sticky footer content here.</span>\n  </div>\n</footer>\n\n    <script src=\"/docs/5.1/dist/js/bootstrap.bundle.min.js\" integrity=\"sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p\" crossorigin=\"anonymous\"></script>\n\n      \n  \n\n","classes":"d-flex flex-column h-100","dir":"ltr"},"publishedAssets":[{"url":"/docs/5.1/dist/css/bootstrap.min.css","integrity":"sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3"},{"url":"/docs/5.1/dist/js/bootstrap.bundle.min.js","integrity":"sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"}],"sourceScripts":["https://getbootstrap.com/docs/5.1/dist/js/bootstrap.bundle.min.js"],"sourceStyles":["https://getbootstrap.com/docs/5.1/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/5.1/examples/sticky-footer-navbar/sticky-footer-navbar.css"]}

pe":"paragraph","en":".space-y-2"}]},{"type":"td","body":[{"id":"content--paragraph-35","type":"paragraph","en":"margin-block-end: 0.375rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-36","type":"paragraph","en":".space-y-3"}]},{"type":"td","body":[{"id":"content--paragraph-37","type":"paragraph","en":"margin-block-end: 0.5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-38","type":"paragraph","en":".space-y-4"}]},{"type":"td","body":[{"id":"content--paragraph-39","type":"paragraph","en":"margin-block-end: 0.75rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-40","type":"paragraph","en":".space-y-5"}]},{"type":"td","body":[{"id":"content--paragraph-41","type":"paragraph","en":"margin-block-end: 1rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-42","type":"paragraph","en":".space-y-6"}]},{"type":"td","body":[{"id":"content--paragraph-43","type":"paragraph","en":"margin-block-end: 1.25rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-44","type":"paragraph","en":".space-y-7"}]},{"type":"td","body":[{"id":"content--paragraph-45","type":"paragraph","en":"margin-block-end: 1.5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-46","type":"paragraph","en":".space-y-8"}]},{"type":"td","body":[{"id":"content--paragraph-47","type":"paragraph","en":"margin-block-end: 1.75rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-48","type":"paragraph","en":".space-y-9"}]},{"type":"td","body":[{"id":"content--paragraph-49","type":"paragraph","en":"margin-block-end: 2rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-50","type":"paragraph","en":".space-y-10"}]},{"type":"td","body":[{"id":"content--paragraph-51","type":"paragraph","en":"margin-block-end: 2.25rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-52","type":"paragraph","en":".space-y-11"}]},{"type":"td","body":[{"id":"content--paragraph-53","type":"paragraph","en":"margin-block-end: 2.5rem;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-54","type":"paragraph","en":".space-y-12"}]},{"type":"td","body":[{"id":"content--paragraph-55","type":"paragraph","en":"margin-block-end: 3rem;"}]}]}]},{"id":"example","type":"heading","en":"Example","level":2},{"id":"example--paragraph-1","type":"paragraph","en":"Unlike <a href=\"https://getbootstrap.com/docs/6.0/utilities/gap\">gap utilities</a> which require flexbox or grid, space utilities work on any parent element by applying margins to children."},{"id":"example--example-1","type":"demo","key":"530a52275e27c33aea7b","height":147},{"id":"example--code-1","type":"code","value":"<div class=\"d-flex space-x-3 p-3 bd-pattern-diagonal rounded-3\">\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 1</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 2</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 3</div>\n</div>","language":""},{"id":"example--paragraph-2","type":"paragraph","en":"The selectors generated for space utilities are wrapped in <code>:where()</code> for zero specificity, making them easy to override with additional utilities or custom CSS."},{"id":"notation","type":"heading","en":"Notation","level":2},{"id":"notation--paragraph-1","type":"paragraph","en":"Space utilities that apply to all breakpoints, from <code>xs</code> to <code>2xl</code>, have no breakpoint abbreviation in them. This is because those classes are applied from <code>min-width: 0</code> and up, and thus are not bound by a media query. The remaining breakpoints, however, do include a breakpoint abbreviation."},{"id":"notation--paragraph-2","type":"paragraph","en":"The classes are named using the format <code>{property}-{size}</code> for <code>xs</code> and <code>{breakpoint}:{property}-{size}</code> for <code>sm</code>, <code>md</code>, <code>lg</code>, <code>xl</code>, and <code>2xl</code>."},{"id":"notation--paragraph-3","type":"paragraph","en":"Where <em>property</em> is one of:"},{"id":"notation--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-1","type":"item","en":"<code>space-x</code> - for classes that set horizontal spacing via <code>margin-inline-end</code>"}]},{"tag":"li","body":[{"id":"notation--item-2","type":"item","en":"<code>space-y</code> - for classes that set vertical spacing via <code>margin-block-end</code>"}]}]},{"id":"notation--paragraph-4","type":"paragraph","en":"Where <em>size</em> is one of:"},{"id":"notation--list-2","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"notation--item-3","type":"item","en":"<code>0</code> - for classes that eliminate the spacing by setting it to <code>0</code>"}]},{"tag":"li","body":[{"id":"notation--item-4","type":"item","en":"<code>1</code> - (by default) for classes that set the spacing to <code>$spacer * .25</code>"}]},{"tag":"li","body":[{"id":"notation--item-5","type":"item","en":"<code>2</code> - (by default) for classes that set the spacing to <code>$spacer * .375</code>"}]},{"tag":"li","body":[{"id":"notation--item-6","type":"item","en":"<code>3</code> - (by default) for classes that set the spacing to <code>$spacer * .5</code>"}]},{"tag":"li","body":[{"id":"notation--item-7","type":"item","en":"<code>4</code> - (by default) for classes that set the spacing to <code>$spacer * .75</code>"}]},{"tag":"li","body":[{"id":"notation--item-8","type":"item","en":"<code>5</code> - (by default) for classes that set the spacing to <code>$spacer * 1</code>"}]},{"tag":"li","body":[{"id":"notation--item-9","type":"item","en":"<code>6</code> - (by default) for classes that set the spacing to <code>$spacer * 1.25</code>"}]},{"tag":"li","body":[{"id":"notation--item-10","type":"item","en":"<code>7</code> - (by default) for classes that set the spacing to <code>$spacer * 1.5</code>"}]},{"tag":"li","body":[{"id":"notation--item-11","type":"item","en":"<code>8</code> - (by default) for classes that set the spacing to <code>$spacer * 1.75</code>"}]},{"tag":"li","body":[{"id":"notation--item-12","type":"item","en":"<code>9</code> - (by default) for classes that set the spacing to <code>$spacer * 2</code>"}]},{"tag":"li","body":[{"id":"notation--item-13","type":"item","en":"<code>10</code> - (by default) for classes that set the spacing to <code>$spacer * 2.25</code>"}]},{"tag":"li","body":[{"id":"notation--item-14","type":"item","en":"<code>11</code> - (by default) for classes that set the spacing to <code>$spacer * 2.5</code>"}]},{"tag":"li","body":[{"id":"notation--item-15","type":"item","en":"<code>12</code> - (by default) for classes that set the spacing to <code>$spacer * 3</code>"}]}]},{"id":"notation--paragraph-5","type":"paragraph","en":"(You can add more sizes by adding entries to the <code>$spacers</code> Sass map variable.)"},{"id":"horizontal","type":"heading","en":"Horizontal","level":2},{"id":"horizontal--paragraph-1","type":"paragraph","en":"Use <code>space-x-*</code> utilities to control the horizontal space between children:"},{"id":"horizontal--example-1","type":"demo","key":"914e6c00382f14b07107","height":147},{"id":"horizontal--code-1","type":"code","value":"<div class=\"d-flex space-x-3\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n</div>","language":""},{"id":"vertical","type":"heading","en":"Vertical","level":2},{"id":"vertical--paragraph-1","type":"paragraph","en":"Use <code>space-y-*</code> utilities to control the vertical space between children:"},{"id":"vertical--example-1","type":"demo","key":"1c45e7197225f614a2b8","height":147},{"id":"vertical--code-1","type":"code","value":"<div class=\"space-y-3\">\n  <div>Item 1</div>\n  <div>Item 2</div>\n  <div>Item 3</div>\n</div>","language":""},{"id":"how-it-works","type":"heading","en":"How it works","level":2},{"id":"how-it-works--paragraph-1","type":"paragraph","en":"Space utilities apply <code>margin-inline-end</code> or <code>margin-block-end</code> to every direct child except the last one via the selector <code>:where(.space-x-3 &gt; :not(:last-child))</code>. The <code>:where()</code> wrapper keeps specificity at zero, so you can easily override individual children with standard margin utilities."},{"id":"how-it-works--code-1","type":"code","value":":where(.space-x-3 > :not(:last-child)) {\n  margin-inline-end: .5rem;\n}","language":""},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Space utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"space-x\": (\n  responsive: true,\n  property: margin-inline-end,\n  class: space-x,\n  child-selector: \"> :not(:last-child)\",\n  values: $spacers\n),\n\"space-y\": (\n  responsive: true,\n  property: margin-block-end,\n  class: space-y,\n  child-selector: \"> :not(:last-child)\",\n  values: $spacers\n),","language":""}],"demos":[{"key":"530a52275e27c33aea7b","html":"\n<div class=\"d-flex space-x-3 p-3 bd-pattern-diagonal rounded-3\">\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 1</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 2</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 3</div>\n</div>","attrs":{"class":"bd-example d-flex align-items-center justify-content-center gap-4 text-center"},"sprite":""},{"key":"914e6c00382f14b07107","html":"\n<div class=\"d-flex space-x-3 bd-pattern-diagonal rounded-3\">\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 1</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 2</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 3</div>\n</div>","attrs":{"class":"bd-example d-flex align-items-center justify-content-center text-center"},"sprite":""},{"key":"1c45e7197225f614a2b8","html":"\n<div class=\"space-y-3 bd-pattern-diagonal rounded-3 d-inline-block p-3\">\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 1</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 2</div>\n  <div class=\"p-3 bg-subtle-accent fg-accent rounded-3\">Item 3</div>\n</div>","attrs":{"class":"bd-example d-flex align-items-center justify-content-center text-center"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0/getting-started/css-variables"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/6.0/getting-started/javascript"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/6.0/getting-started/accessibility"},{"en":"Quickstart","href":"https://getbootstrap.com/docs/6.0/guides/quickstart"},{"en":"npm","href":"https://getbootstrap.com/docs/6.0/guides/npm"},{"en":"Webpack","href":"https://getbootstrap.com/docs/6.0/guides/webpack"},{"en":"Parcel","href":"https://getbootstrap.com/docs/6.0/guides/parcel"},{"en":"Vite","href":"https://getbootstrap.com/docs/6.0/guides/vite"},{"en":"Contribute","href":"https://getbootstrap.com/docs/6.0/guides/contribute"},{"en":"Migration","href":"https://getbootstrap.com/docs/6.0/guides/migration"},{"en":"Overview","href":"https://getbootstrap.com/docs/6.0/customize/overview"},{"en":"Sass","href":"https://getbootstrap.com/docs/6.0/customize/sass"},{"en":"Options","href":"https://getbootstrap.com/docs/6.0/customize/options
{"route":"/docs/5.1/helpers/stacks/","version":"5.1","renderedVersion":"5.1","title":{"id":"content","type":"heading","en":"Stacks","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Shorthand helpers that build on top of our flexbox utilities to make component layout faster and easier than ever."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"Stacks offer a shortcut for applying a number of flexbox properties to quickly and easily create layouts in Bootstrap. All credit for the concept and implementation goes to the open source <a href=\"https://almonk.github.io/pylon/\">Pylon project</a>."},{"id":"content--note-1","type":"note","tone":"warning","body":[{"id":"content--note-text-1","type":"note-text","en":"Heads up! Support for gap utilities with flexbox was recently added to Safari, so consider verifying your intended browser support. Grid layout should have no issues. <a href=\"https://caniuse.com/flexbox-gap\">Read more</a>."}]},{"id":"vertical","type":"heading","en":"Vertical","level":2},{"id":"vertical--paragraph-1","type":"paragraph","en":"Use <code>.vstack</code> to create vertical layouts. Stacked items are full-width by default. Use <code>.gap-*</code> utilities to add space between items."},{"id":"vertical--example-1","type":"demo","key":"bf101f24b1878d78bba3","height":147},{"id":"vertical--code-1","type":"code","value":"<div class=\"vstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border\">Second item</div>\n  <div class=\"bg-light border\">Third item</div>\n</div>","language":"html"},{"id":"horizontal","type":"heading","en":"Horizontal","level":2},{"id":"horizontal--paragraph-1","type":"paragraph","en":"Use <code>.hstack</code> for horizontal layouts. Stacked items are vertically centered by default and only take up their necessary width. Use <code>.gap-*</code> utilities to add space between items."},{"id":"horizontal--example-1","type":"demo","key":"f4f60fe146f309ffd698","height":147},{"id":"horizontal--code-1","type":"code","value":"<div class=\"hstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border\">Second item</div>\n  <div class=\"bg-light border\">Third item</div>\n</div>","language":"html"},{"id":"horizontal--paragraph-2","type":"paragraph","en":"Using horizontal margin utilities like <code>.ms-auto</code> as spacers:"},{"id":"horizontal--example-2","type":"demo","key":"de58a60428c63a610505","height":147},{"id":"horizontal--code-2","type":"code","value":"<div class=\"hstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border ms-auto\">Second item</div>\n  <div class=\"bg-light border\">Third item</div>\n</div>","language":"html"},{"id":"horizontal--paragraph-3","type":"paragraph","en":"And with <a href=\"https://getbootstrap.com/docs/5.1/helpers/vertical-rule/\">vertical rules</a>:"},{"id":"horizontal--example-3","type":"demo","key":"ffd6b455dc6e18466ce1","height":147},{"id":"horizontal--code-3","type":"code","value":"<div class=\"hstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border ms-auto\">Second item</div>\n  <div class=\"vr\"></div>\n  <div class=\"bg-light border\">Third item</div>\n</div>","language":"html"},{"id":"examples","type":"heading","en":"Examples","level":2},{"id":"examples--paragraph-1","type":"paragraph","en":"Use <code>.vstack</code> to stack buttons and other elements:"},{"id":"examples--example-1","type":"demo","key":"3c2265e4ea757e378729","height":147},{"id":"examples--code-1","type":"code","value":"<div class=\"vstack gap-2 col-md-5 mx-auto\">\n  <button type=\"button\" class=\"btn btn-secondary\">Save changes</button>\n  <button type=\"button\" class=\"btn btn-outline-secondary\">Cancel</button>\n</div>","language":"html"},{"id":"examples--paragraph-2","type":"paragraph","en":"Create an inline form with <code>.hstack</code>:"},{"id":"examples--example-2","type":"demo","key":"964b01768e2056196e5a","height":147},{"id":"examples--code-2","type":"code","value":"<div class=\"hstack gap-3\">\n  <input class=\"form-control me-auto\" type=\"text\" placeholder=\"Add your item here...\" aria-label=\"Add your item here...\">\n  <button type=\"button\" class=\"btn btn-secondary\">Submit</button>\n  <div class=\"vr\"></div>\n  <button type=\"button\" class=\"btn btn-outline-danger\">Reset</button>\n</div>","language":"html"},{"id":"sass","type":"heading","en":"Sass","level":2},{"id":"sass--code-1","type":"code","value":".hstack {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  align-self: stretch;\n}\n\n.vstack {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  align-self: stretch;\n}","language":"scss"}],"demos":[{"key":"bf101f24b1878d78bba3","html":"\n<div class=\"vstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border\">Second item</div>\n  <div class=\"bg-light border\">Third item</div>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"f4f60fe146f309ffd698","html":"\n<div class=\"hstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border\">Second item</div>\n  <div class=\"bg-light border\">Third item</div>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"de58a60428c63a610505","html":"\n<div class=\"hstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border ms-auto\">Second item</div>\n  <div class=\"bg-light border\">Third item</div>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"ffd6b455dc6e18466ce1","html":"\n<div class=\"hstack gap-3\">\n  <div class=\"bg-light border\">First item</div>\n  <div class=\"bg-light border ms-auto\">Second item</div>\n  <div class=\"vr\"></div>\n  <div class=\"bg-light border\">Third item</div>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"3c2265e4ea757e378729","html":"\n<div class=\"vstack gap-2 col-md-5 mx-auto\">\n  <button type=\"button\" class=\"btn btn-secondary\">Save changes</button>\n  <button type=\"button\" class=\"btn btn-outline-secondary\">Cancel</button>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"964b01768e2056196e5a","html":"\n<div class=\"hstack gap-3\">\n  <input class=\"form-control me-auto\" type=\"text\" placeholder=\"Add your item here...\" aria-label=\"Add your item here...\">\n  <button type=\"button\" class=\"btn btn-secondary\">Submit</button>\n  <div class=\"vr\"></div>\n  <button type=\"button\" class=\"btn btn-outline-danger\">Reset</button>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.1/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/5.1/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.1/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/5.1/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/5.1/getting-started/javascript/"},{"en":"Webpack","href":"https://getbootstrap.com/docs/5.1/getting-started/webpack/"},{"en":"Parcel","href":"https://getbootstrap.com/docs/5.1/getting-started/parcel/"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/5.1/getting-started/accessibility/"},{"en":"RFS","href":"https://getbootstrap.com/docs/5.1/getting-started/rfs/"},{"en":"RTL","href":"https://getbootstrap.com/docs/5.1/getting-started/rtl/"},{"en":"Contribute","href":"https://getbootstrap.com/docs/5.1/getting-started/contribute/"},{"en":"Overview","href":"https://getbootstrap.com/docs/5.1/customize/overview/"},{"en":"Sass","href":"https://getbootstrap.com/docs/5.1/customize/sass/"},{"en":"Options","href":"https://getbootstrap.com/docs/5.1/customize/options/"},{"en":"Color","href":"https://getbootstrap.com/docs/5.1/customize/color/"},{"en":"Components","href":"https://getbootst
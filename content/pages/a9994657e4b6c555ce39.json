{"route":"/docs/4.6/examples/sticky-footer-navbar/","version":"4.6","renderedVersion":"4.6","title":{"id":"sticky-footer-with-fixed-navbar","type":"heading","en":"Sticky footer with fixed navbar","level":1},"lead":{"id":"sticky-footer-with-fixed-navbar--paragraph-1","type":"paragraph","en":"Pin a footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS. A fixed navbar has been added with <code>padding-top: 60px;</code> on the <code>main &gt; .container</code>."},"blocks":[{"id":"sticky-footer-with-fixed-navbar--paragraph-2","type":"paragraph","en":"Back to <a href=\"https://getbootstrap.com/docs/4.6/examples/sticky-footer/\">the default sticky footer</a> minus the navbar."}],"demos":[],"nav":[],"standalone":true,"embed":{"headStyles":"<style>\n      .bd-placeholder-img {\n        font-size: 1.125rem;\n        text-anchor: middle;\n        -webkit-user-select: none;\n        -moz-user-select: none;\n        -ms-user-select: none;\n        user-select: none;\n      }\n\n      @media (min-width: 768px) {\n        .bd-placeholder-img-lg {\n          font-size: 3.5rem;\n        }\n      }\n    </style>","body":"\n    \n<header>\n  <!-- Fixed navbar -->\n  <nav class=\"navbar navbar-expand-md navbar-dark fixed-top bg-dark\">\n    <a class=\"navbar-brand\" href=\"#\">Fixed navbar</a>\n    <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarCollapse\" aria-controls=\"navbarCollapse\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n      <span class=\"navbar-toggler-icon\"></span>\n    </button>\n    <div class=\"collapse navbar-collapse\" id=\"navbarCollapse\">\n      <ul class=\"navbar-nav mr-auto\">\n        <li class=\"nav-item active\">\n          <a class=\"nav-link\" href=\"#\">Home <span class=\"sr-only\">(current)</span></a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link\" href=\"#\">Link</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link disabled\">Disabled</a>\n        </li>\n      </ul>\n      <form class=\"form-inline mt-2 mt-md-0\">\n        <input class=\"form-control mr-sm-2\" type=\"text\" placeholder=\"Search\" aria-label=\"Search\">\n        <button class=\"btn btn-outline-success my-2 my-sm-0\" type=\"submit\">Search</button>\n      </form>\n    </div>\n  </nav>\n</header>\n\n<!-- Begin page content -->\n<main role=\"main\" class=\"flex-shrink-0\">\n  <div class=\"container\">\n    <h1 class=\"mt-5\">Sticky footer with fixed navbar</h1>\n    <p class=\"lead\">Pin a footer to the bottom of the viewport in desktop browsers with this custom HTML and CSS. A fixed navbar has been added with <code>padding-top: 60px;</code> on the <code>main &gt; .container</code>.</p>\n    <p>Back to <a href=\"/docs/4.6/examples/sticky-footer/\">the default sticky footer</a> minus the navbar.</p>\n  </div>\n</main>\n\n<footer class=\"footer mt-auto py-3\">\n  <div class=\"container\">\n    <span class=\"text-muted\">Place sticky footer content here.</span>\n  </div>\n</footer>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js\" integrity=\"sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj\" crossorigin=\"anonymous\"></script>\n      <script>window.jQuery || document.write('<script src=\"/docs/4.6/assets/js/vendor/jquery.slim.min.js\"><\\/script>')</script><script src=\"/docs/4.6/dist/js/bootstrap.bundle.min.js\" integrity=\"sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct\" crossorigin=\"anonymous\"></script>\n\n      \n  \n\n","classes":"d-flex flex-column h-100","dir":"ltr"},"publishedAssets":[{"url":"/docs/4.6/dist/css/bootstrap.min.css","integrity":"sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N"},{"url":"https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","integrity":"sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"},{"url":"/docs/4.6/dist/js/bootstrap.bundle.min.js","integrity":"sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"}],"sourceScripts":["https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js","https://getbootstrap.com/docs/4.6/dist/js/bootstrap.bundle.min.js"],"sourceStyles":["https://getbootstrap.com/docs/4.6/dist/css/bootstrap.min.css","https://getbootstrap.com/docs/4.6/examples/sticky-footer-navbar/sticky-footer-navbar.css"]}

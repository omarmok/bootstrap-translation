{"route":"/docs/6.0/forms/password-strength/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Password strength","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Provide visual feedback on password strength with segmented meters or progress bars that update as users type."},"blocks":[{"id":"overview","type":"heading","en":"Overview","level":2},{"id":"overview--paragraph-1","type":"paragraph","en":"Strength meters help users create secure passwords by providing real-time feedback on password complexity. Bootstrap’s strength component offers:"},{"id":"overview--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"overview--item-1","type":"item","en":"<strong>Segmented meter</strong>: Four segments that fill based on strength level"}]},{"tag":"li","body":[{"id":"overview--item-2","type":"item","en":"<strong>Progress bar variant</strong>: A single bar that grows with strength"}]},{"tag":"li","body":[{"id":"overview--item-3","type":"item","en":"<strong>Text feedback</strong>: Optional text messages for each strength level"}]},{"tag":"li","body":[{"id":"overview--item-4","type":"item","en":"<strong>Customizable scoring</strong>: Configure minimum length and scoring criteria"}]},{"tag":"li","body":[{"id":"overview--item-5","type":"item","en":"<strong>Minimal JavaScript</strong>: Lightweight component following Bootstrap patterns"}]}]},{"id":"examples","type":"heading","en":"Examples","level":2},{"id":"segmented","type":"heading","en":"Segmented","level":3},{"id":"segmented--paragraph-1","type":"paragraph","en":"The default strength meter uses four segments that fill progressively as password strength increases. Add <code>data-bs-strength</code> to enable the JavaScript behavior."},{"id":"segmented--example-1","type":"demo","key":"b7ec66f71ecca9122984","height":147,"anchors":["password1"]},{"id":"segmented--code-1","type":"code","value":"<div>\n  <label for=\"password1\" class=\"form-label\">Password</label>\n  <input type=\"password\" class=\"form-control\" id=\"password1\" placeholder=\"Enter password\">\n  <div class=\"strength\" data-bs-strength>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>","language":""},{"id":"with-text-feedback","type":"heading","en":"With text feedback","level":3},{"id":"with-text-feedback--paragraph-1","type":"paragraph","en":"Add a <code>.strength-text</code> element to display strength messages."},{"id":"with-text-feedback--example-1","type":"demo","key":"a67c976c798466ee84ba","height":147,"anchors":["password2"]},{"id":"with-text-feedback--code-1","type":"code","value":"<div>\n  <label for=\"password2\" class=\"form-label\">Password</label>\n  <input type=\"password\" class=\"form-control\" id=\"password2\" placeholder=\"Enter password\">\n  <div class=\"strength\" data-bs-strength>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n  <span class=\"strength-text\"></span>\n</div>","language":""},{"id":"progress-bar","type":"heading","en":"Progress bar","level":3},{"id":"progress-bar--paragraph-1","type":"paragraph","en":"Use <code>.strength-bar</code> for a single progress bar that grows with password strength."},{"id":"progress-bar--example-1","type":"demo","key":"ca7d12530cb3ed6260e3","height":147,"anchors":["password3"]},{"id":"progress-bar--code-1","type":"code","value":"<div>\n  <label for=\"password3\" class=\"form-label\">Password</label>\n  <input type=\"password\" class=\"form-control\" id=\"password3\" placeholder=\"Enter password\">\n  <div class=\"strength-bar\" data-bs-strength></div>\n</div>","language":""},{"id":"static-segmented","type":"heading","en":"Static segmented","level":3},{"id":"static-segmented--paragraph-1","type":"paragraph","en":"You can use the component without JavaScript for static displays by setting the <code>data-bs-strength</code> attribute manually."},{"id":"static-segmented--example-1","type":"demo","key":"3b1c0dbe69446a27b102","height":228},{"id":"static-segmented--code-1","type":"code","value":"<div>\n  <div>Weak</div>\n  <div class=\"strength\" data-bs-strength=\"weak\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>\n<div>\n  <div>Fair</div>\n  <div class=\"strength\" data-bs-strength=\"fair\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>\n<div>\n  <div>Good</div>\n  <div class=\"strength\" data-bs-strength=\"good\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>\n<div>\n  <div>Strong</div>\n  <div class=\"strength\" data-bs-strength=\"strong\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n  </div>\n</div>","language":""},{"id":"static-progress-bar","type":"heading","en":"Static progress bar","level":3},{"id":"static-progress-bar--example-1","type":"demo","key":"bf405ffa9e90a65376f0","height":228},{"id":"static-progress-bar--code-1","type":"code","value":"<div>\n  <div>Weak</div>\n  <div class=\"strength-bar\" data-bs-strength=\"weak\"></div>\n</div>\n<div>\n  <div>Fair</div>\n  <div class=\"strength-bar\" data-bs-strength=\"fair\"></div>\n</div>\n<div>\n  <div>Good</div>\n  <div class=\"strength-bar\" data-bs-strength=\"good\"></div>\n</div>\n<div>\n  <div>Strong</div>\n  <div class=\"strength-bar\" data-bs-strength=\"strong\"></div>\n</div>","language":""},{"id":"strength-criteria","type":"heading","en":"Strength criteria","level":2},{"id":"strength-criteria--paragraph-1","type":"paragraph","en":"The default scoring algorithm evaluates passwords based on:"},{"id":"strength-criteria--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"strength-criteria--paragraph-2","type":"paragraph","en":"Criteria"}]},{"type":"th","body":[{"id":"strength-criteria--paragraph-3","type":"paragraph","en":"Points"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-4","type":"paragraph","en":"Meets minimum length (8 characters)"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-5","type":"paragraph","en":"+1"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-6","type":"paragraph","en":"4+ characters over minimum"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-7","type":"paragraph","en":"+1"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-8","type":"paragraph","en":"Contains lowercase letters"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-9","type":"paragraph","en":"+1"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-10","type":"paragraph","en":"Contains uppercase letters"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-11","type":"paragraph","en":"+1"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-12","type":"paragraph","en":"Contains numbers"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-13","type":"paragraph","en":"+1"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-14","type":"paragraph","en":"Contains special characters"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-15","type":"paragraph","en":"+1"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-16","type":"paragraph","en":"Multiple special characters"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-17","type":"paragraph","en":"+1"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-18","type":"paragraph","en":"16+ characters"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-19","type":"paragraph","en":"+1"}]}]}]},{"id":"strength-criteria--table-2","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"strength-criteria--paragraph-20","type":"paragraph","en":"Level"}]},{"type":"th","body":[{"id":"strength-criteria--paragraph-21","type":"paragraph","en":"Points"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-22","type":"paragraph","en":"Weak"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-23","type":"paragraph","en":"1-2"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-24","type":"paragraph","en":"Fair"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-25","type":"paragraph","en":"3-4"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-26","type":"paragraph","en":"Good"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-27","type":"paragraph","en":"5-6"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"strength-criteria--paragraph-28","type":"paragraph","en":"Strong"}]},{"type":"td","body":[{"id":"strength-criteria--paragraph-29","type":"paragraph","en":"7-8"}]}]}]},{"id":"usage","type":"heading","en":"Usage","level":2},{"id":"via-data-attributes","type":"heading","en":"Via data attributes","level":3},{"id":"via-data-attributes--paragraph-1","type":"paragraph","en":"Add <code>data-bs-strength</code> to automatically initialize. The component will look for a password input in the same parent container."},{"id":"via-data-attributes--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"via-data-attributes--paragraph-2","type":"paragraph","en":"Attribute"}]},{"type":"th","body":[{"id":"via-data-attributes--paragraph-3","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"via-data-attributes--paragraph-4","type":"paragraph","en":"<code>data-bs-strength</code>"}]},{"type":"td","body":[{"id":"via-data-attributes--paragraph-5","type":"paragraph","en":"Initializes the strength indicator on the element (usually <code>.strength</code>)."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"via-data-attributes--paragraph-6","type":"paragraph","en":"<code>data-bs-input</code>"}]},{"type":"td","body":[{"id":"via-data-attributes--paragraph-7","type":"paragraph","en":"CSS selector for the password field when it is not a sibling in the same container."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"via-data-attributes--paragraph-8","type":"paragraph","en":"<code>data-bs-min-length</code>"}]},{"type":"td","body":[{"id":"via-data-attributes--paragraph-9","type":"paragraph","en":"Minimum length used when computing the strength score."}]}]}]},{"id":"via-data-attributes--code-1","type":"code","value":"<div>\n  <input type=\"password\" class=\"form-control\">\n  <div class=\"strength\" data-bs-strength>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>","language":""},{"id":"via-javascript","type":"heading","en":"Via JavaScript","level":3},{"id":"via-javascript--code-1","type":"code","value":"const element = document.querySelector('.strength')\nconst strength = new bootstrap.Strength(element, {\n  input: '#my-password-input',\n  minLength: 10,\n  messages: {\n    weak: 'Too weak',\n    fair: 'Could be better',\n    good: 'Good password',\n    strong: 'Excellent!'\n  }\n})","language":""},{"id":"dependencies","type":"heading","en":"Dependencies","level":3},{"id":"dependencies--paragraph-1","type":"paragraph","en":"The password strength plugin requires the following JavaScript files if you’re building Bootstrap’s JS from source:"},{"id":"dependencies--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"dependencies--paragraph-2","type":"paragraph","en":"File"}]},{"type":"th","body":[{"id":"dependencies--paragraph-3","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-4","type":"paragraph","en":"<code>js/src/strength.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-5","type":"paragraph","en":"Main strength component"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-6","type":"paragraph","en":"<code>js/src/base-component.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-7","type":"paragraph","en":"Base component class"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-8","type":"paragraph","en":"<code>js/src/dom/data.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-9","type":"paragraph","en":"Element data store"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-10","type":"paragraph","en":"<code>js/src/dom/event-handler.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-11","type":"paragraph","en":"Event handling utilities"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-12","type":"paragraph","en":"<code>js/src/dom/manipulator.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-13","type":"paragraph","en":"Data attribute manipulation"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-14","type":"paragraph","en":"<code>js/src/dom/selector-engine.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-15","type":"paragraph","en":"DOM selector utilities"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-16","type":"paragraph","en":"<code>js/src/util/config.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-17","type":"paragraph","en":"Configuration base class"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"dependencies--paragraph-18","type":"paragraph","en":"<code>js/src/util/index.ts</code>"}]},{"type":"td","body":[{"id":"dependencies--paragraph-19","type":"paragraph","en":"Core utility functions"}]}]}]},{"id":"options","type":"heading","en":"Options","level":3},{"id":"options--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"options--paragraph-1","type":"paragraph","en":"Name"}]},{"type":"th","body":[{"id":"options--paragraph-2","type":"paragraph","en":"Type"}]},{"type":"th","body":[{"id":"options--paragraph-3","type":"paragraph","en":"Default"}]},{"type":"th","body":[{"id":"options--paragraph-4","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-5","type":"paragraph","en":"<code>input</code>"}]},{"type":"td","body":[{"id":"options--paragraph-6","type":"paragraph","en":"string | element"}]},{"type":"td","body":[{"id":"options--paragraph-7","type":"paragraph","en":"<code>null</code>"}]},{"type":"td","body":[{"id":"options--paragraph-8","type":"paragraph","en":"Selector or element for the password input. If not provided, looks for <code>input[type=&quot;password&quot;]</code> in the parent."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-9","type":"paragraph","en":"<code>minLength</code>"}]},{"type":"td","body":[{"id":"options--paragraph-10","type":"paragraph","en":"number"}]},{"type":"td","body":[{"id":"options--paragraph-11","type":"paragraph","en":"<code>8</code>"}]},{"type":"td","body":[{"id":"options--paragraph-12","type":"paragraph","en":"Minimum password length for first strength point."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-13","type":"paragraph","en":"<code>messages</code>"}]},{"type":"td","body":[{"id":"options--paragraph-14","type":"paragraph","en":"object"}]},{"type":"td","body":[{"id":"options--paragraph-15","type":"paragraph","en":"<code>{weak, fair, good, strong}</code>"}]},{"type":"td","body":[{"id":"options--paragraph-16","type":"paragraph","en":"Custom messages for each strength level."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-17","type":"paragraph","en":"<code>weights</code>"}]},{"type":"td","body":[{"id":"options--paragraph-18","type":"paragraph","en":"object"}]},{"type":"td","body":[{"id":"options--paragraph-19","type":"paragraph","en":"See below"}]},{"type":"td","body":[{"id":"options--paragraph-20","type":"paragraph","en":"Point values for each scoring criterion. Set to <code>0</code> to disable a criterion."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-21","type":"paragraph","en":"<code>thresholds</code>"}]},{"type":"td","body":[{"id":"options--paragraph-22","type":"paragraph","en":"array"}]},{"type":"td","body":[{"id":"options--paragraph-23","type":"paragraph","en":"<code>[2, 4, 6]</code>"}]},{"type":"td","body":[{"id":"options--paragraph-24","type":"paragraph","en":"Score boundaries for strength levels: <code>[weak, fair, good]</code>. Scores above the last value are &quot;strong&quot;."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"options--paragraph-25","type":"paragraph","en":"<code>scorer</code>"}]},{"type":"td","body":[{"id":"options--paragraph-26","type":"paragraph","en":"function"}]},{"type":"td","body":[{"id":"options--paragraph-27","type":"paragraph","en":"<code>null</code>"}]},{"type":"td","body":[{"id":"options--paragraph-28","type":"paragraph","en":"Custom scoring function <code>(password) =&gt; number</code>. Overrides built-in scoring when provided."}]}]}]},{"id":"default-weights","type":"heading","en":"Default weights","level":4},{"id":"default-weights--code-1","type":"code","value":"{\n  minLength: 1,        // Meets minimum length\n  extraLength: 1,      // 4+ characters over minimum\n  lowercase: 1,        // Contains lowercase letters\n  uppercase: 1,        // Contains uppercase letters\n  numbers: 1,          // Contains numbers\n  special: 1,          // Contains special characters\n  multipleSpecial: 1,  // Multiple special characters\n  longPassword: 1      // 16+ characters\n}","language":""},{"id":"custom-weights","type":"heading","en":"Custom weights","level":4},{"id":"custom-weights--code-1","type":"code","value":"// Disable uppercase requirement, make special chars worth more\nnew bootstrap.Strength(element, {\n  weights: {\n    uppercase: 0,   // Don't require uppercase\n    special: 2      // Special chars worth 2 points\n  },\n  thresholds: [3, 5, 7]  // Adjust thresholds for new max score\n})","language":""},{"id":"custom-scorer","type":"heading","en":"Custom scorer","level":4},{"id":"custom-scorer--code-1","type":"code","value":"// Fully custom scoring logic\nnew bootstrap.Strength(element, {\n  scorer: (password) => {\n    let score = 0\n    if (password.length >= 12) score += 4\n    if (/[!@#$%]/.test(password)) score += 4\n    return score\n  },\n  thresholds: [2, 4, 6]\n})","language":""},{"id":"methods","type":"heading","en":"Methods","level":3},{"id":"methods--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"methods--paragraph-1","type":"paragraph","en":"Method"}]},{"type":"th","body":[{"id":"methods--paragraph-2","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"methods--paragraph-3","type":"paragraph","en":"<code>getStrength()</code>"}]},{"type":"td","body":[{"id":"methods--paragraph-4","type":"paragraph","en":"Returns the current strength level (<code>&#39;weak&#39;</code>, <code>&#39;fair&#39;</code>, <code>&#39;good&#39;</code>, <code>&#39;strong&#39;</code>, or <code>null</code>)."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"methods--paragraph-5","type":"paragraph","en":"<code>evaluate()</code>"}]},{"type":"td","body":[{"id":"methods--paragraph-6","type":"paragraph","en":"Manually trigger a password evaluation."}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"methods--paragraph-7","type":"paragraph","en":"<code>dispose()</code>"}]},{"type":"td","body":[{"id":"methods--paragraph-8","type":"paragraph","en":"Destroys the component instance."}]}]}]},{"id":"methods--code-1","type":"code","value":"const element = document.querySelector('.strength')\nconst strength = bootstrap.Strength.getOrCreateInstance(element)\n\n// Get current strength\nconsole.log(strength.getStrength()) // 'fair'","language":""},{"id":"events","type":"heading","en":"Events","level":3},{"id":"events--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","body":[{"id":"events--paragraph-1","type":"paragraph","en":"Event"}]},{"type":"th","body":[{"id":"events--paragraph-2","type":"paragraph","en":"Description"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"events--paragraph-3","type":"paragraph","en":"<code>strengthChange.bs.strength</code>"}]},{"type":"td","body":[{"id":"events--paragraph-4","type":"paragraph","en":"Fired when the strength level changes. Includes <code>strength</code> and <code>score</code> properties."}]}]}]},{"id":"events--code-1","type":"code","value":"const element = document.querySelector('.strength')\n\nelement.addEventListener('strengthChange.bs.strength', event => {\n  console.log('Strength:', event.strength) // 'weak', 'fair', 'good', 'strong'\n  console.log('Score:', event.score) // 0-8\n})","language":""},{"id":"css-only-usage","type":"heading","en":"CSS-only usage","level":2},{"id":"css-only-usage--paragraph-1","type":"paragraph","en":"For simple cases or server-rendered content, you can use the component without JavaScript by manually setting the <code>data-bs-strength</code> attribute and <code>.active</code> classes."},{"id":"css-only-usage--code-1","type":"code","value":"<!-- Set via server-side logic -->\n<div class=\"strength\" data-bs-strength=\"good\">\n  <div class=\"strength-segment active\"></div>\n  <div class=\"strength-segment active\"></div>\n  <div class=\"strength-segment active\"></div>\n  <div class=\"strength-segment\"></div>\n</div>","language":""},{"id":"accessibility","type":"heading","en":"Accessibility","level":2},{"id":"accessibility--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"accessibility--item-1","type":"item","en":"The strength meter is decorative feedback and should be used alongside clear password requirements text"}]},{"tag":"li","body":[{"id":"accessibility--item-2","type":"item","en":"Consider using <code>aria-describedby</code> to associate the password input with requirement text"}]},{"tag":"li","body":[{"id":"accessibility--item-3","type":"item","en":"Screen reader users benefit from the text feedback option which announces strength changes"}]}]},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--paragraph-1","type":"paragraph","en":"Password strength use local CSS variables on <code>.strength</code> for real-time customization. Values for the CSS variables are generated from Sass maps unique to each component and applied to the aforementioned class."},{"id":"variables--code-1","type":"code","value":"// stylelint-disable-next-line scss/dollar-variable-default\n$strength-tokens: defaults(\n  (\n    --strength-height: .375rem,\n    --strength-gap: .25rem,\n    --strength-margin-top: .25rem,\n    --strength-border-radius: var(--radius-pill),\n    --strength-bg: var(--bg-2),\n    --strength-color: var(--bg-2),\n    --strength-weak-color: var(--danger-bg),\n    --strength-fair-color: var(--warning-bg),\n    --strength-good-color: var(--info-bg),\n    --strength-strong-color: var(--success-bg),\n  ),\n  $strength-tokens\n);","language":""},{"id":"sass-list","type":"heading","en":"Sass list","level":3},{"id":"sass-list--paragraph-1","type":"paragraph","en":"We use a Sass list to define the strength levels, allowing you to easily add or modify levels by overriding the default list. <strong>The order of the levels matters</strong>, as it will be used to determine the width of the strength meter."},{"id":"sass-list--code-1","type":"code","value":"$strength-levels: weak, fair, good, strong;","language":""}],"demos":[{"key":"b7ec66f71ecca9122984","html":"<div>\n  <label for=\"password1\" class=\"form-label\">Password</label>\n  <input type=\"password\" class=\"form-control\" id=\"password1\" placeholder=\"Enter password\">\n  <div class=\"strength\" data-bs-strength=\"\">\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>","attrs":{"class":"bd-example"},"sprite":""},{"key":"a67c976c798466ee84ba","html":"<div>\n  <label for=\"password2\" class=\"form-label\">Password</label>\n  <input type=\"password\" class=\"form-control\" id=\"password2\" placeholder=\"Enter password\">\n  <div class=\"strength\" data-bs-strength=\"\">\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n  <span class=\"strength-text\"></span>\n</div>","attrs":{"class":"bd-example"},"sprite":""},{"key":"ca7d12530cb3ed6260e3","html":"<div>\n  <label for=\"password3\" class=\"form-label\">Password</label>\n  <input type=\"password\" class=\"form-control\" id=\"password3\" placeholder=\"Enter password\">\n  <div class=\"strength-bar\" data-bs-strength=\"\"></div>\n</div>","attrs":{"class":"bd-example"},"sprite":""},{"key":"3b1c0dbe69446a27b102","html":"<div>\n  <div>Weak</div>\n  <div class=\"strength\" data-bs-strength=\"weak\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>\n<div>\n  <div>Fair</div>\n  <div class=\"strength\" data-bs-strength=\"fair\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>\n<div>\n  <div>Good</div>\n  <div class=\"strength\" data-bs-strength=\"good\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment\"></div>\n  </div>\n</div>\n<div>\n  <div>Strong</div>\n  <div class=\"strength\" data-bs-strength=\"strong\">\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n    <div class=\"strength-segment active\"></div>\n  </div>\n</div>","attrs":{"class":"bd-example vstack gap-3 fg-3"},"sprite":""},{"key":"bf405ffa9e90a65376f0","html":"<div>\n  <div>Weak</div>\n  <div class=\"strength-bar\" data-bs-strength=\"weak\"></div>\n</div>\n<div>\n  <div>Fair</div>\n  <div class=\"strength-bar\" data-bs-strength=\"fair\"></div>\n</div>\n<div>\n  <div>Good</div>\n  <div class=\"strength-bar\" data-bs-strength=\"good\"></div>\n</div>\n<div>\n  <div>Strong</div>\n  <div class=\"strength-bar\" data-bs-strength=\"strong\"></div>\n</div>","attrs":{"class":"bd-example vstack gap-3 fg-3"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0
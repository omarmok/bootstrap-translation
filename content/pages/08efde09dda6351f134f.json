{"route":"/docs/6.0/utilities/vertical-align/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Vertical alignment","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Easily change the vertical alignment of inline, inline-block, inline-table, and table cell elements."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".align-baseline"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"vertical-align: baseline;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".align-top"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"vertical-align: top;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".align-middle"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"vertical-align: middle;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".align-bottom"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"vertical-align: bottom;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".align-text-bottom"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"vertical-align: text-bottom;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".align-text-top"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"vertical-align: text-top;"}]}]}]},{"id":"content--paragraph-16","type":"paragraph","en":"Change the alignment of elements with the <a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/vertical-align\"><code>vertical-alignment</code></a> utilities. Please note that vertical-align only affects inline, inline-block, inline-table, and table cell elements."},{"id":"content--paragraph-17","type":"paragraph","en":"Choose from <code>.align-baseline</code>, <code>.align-top</code>, <code>.align-middle</code>, <code>.align-bottom</code>, <code>.align-text-bottom</code>, and <code>.align-text-top</code> as needed."},{"id":"content--paragraph-18","type":"paragraph","en":"To vertically center non-inline content (like <code>&lt;div&gt;</code>s and more), use our <a href=\"https://getbootstrap.com/docs/6.0/utilities/flex#align-items\">flex box utilities</a>."},{"id":"content--paragraph-19","type":"paragraph","en":"With inline elements:"},{"id":"content--example-1","type":"demo","key":"70399688773abb73af61","height":300},{"id":"content--code-1","type":"code","value":"<span class=\"align-baseline\">baseline</span>\n<span class=\"align-top\">top</span>\n<span class=\"align-middle\">middle</span>\n<span class=\"align-bottom\">bottom</span>\n<span class=\"align-text-top\">text-top</span>\n<span class=\"align-text-bottom\">text-bottom</span>","language":""},{"id":"content--paragraph-20","type":"paragraph","en":"With table cells:"},{"id":"content--example-2","type":"demo","key":"af4ac099c5aee7584e8a","height":147},{"id":"content--code-2","type":"code","value":"<table style=\"height: 100px;\">\n  <tbody>\n    <tr>\n      <td class=\"align-baseline\">baseline</td>\n      <td class=\"align-top\">top</td>\n      <td class=\"align-middle\">middle</td>\n      <td class=\"align-bottom\">bottom</td>\n      <td class=\"align-text-top\">text-top</td>\n      <td class=\"align-text-bottom\">text-bottom</td>\n    </tr>\n  </tbody>\n</table>","language":""},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Vertical align utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"align\": (\n  property: vertical-align,\n  class: align,\n  values: baseline top middle bottom text-bottom text-top\n),","language":""}],"demos":[{"key":"70399688773abb73af61","html":"<span class=\"align-baseline\">baseline</span>\n<span class=\"align-top\">top</span>\n<span class=\"align-middle\">middle</span>\n<span class=\"align-bottom\">bottom</span>\n<span class=\"align-text-top\">text-top</span>\n<span class=\"align-text-bottom\">text-bottom</span>","attrs":{"class":"bd-example"},"sprite":""},{"key":"af4ac099c5aee7584e8a","html":"<table style=\"height: 100px;\">\n  <tbody>\n    <tr>\n      <td class=\"align-baseline\">baseline</td>\n      <td class=\"align-top\">top</td>\n      <td class=\"align-middle\">middle</td>\n      <td class=\"align-bottom\">bottom</td>\n      <td class=\"align-text-top\">text-top</td>\n      <td class=\"align-text-bottom\">text-bottom</td>\n    </tr>\n  </tbody>\n</table>","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0/getting-started/css-variables"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/6.0/getting-started/javascript"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/6.0/getting-started/accessibility"},{"en":"Quickstart","href":"https:
.com/docs/4.2/utilities/display/"},{"en":"Embed","href":"https://getbootstrap.com/docs/4.2/utilities/embed/"},{"en":"Flex","href":"https://getbootstrap.com/docs/4.2/utilities/flex/"},{"en":"Float","href":"https://getbootstrap.com/docs/4.2/utilities/float/"},{"en":"Image replacement","href":"https://getbootstrap.com/docs/4.2/utilities/image-replacement/"},{"en":"Overflow","href":"https://getbootstrap.com/docs/4.2/utilities/overflow/"},{"en":"Position","href":"https://getbootstrap.com/docs/4.2/utilities/position/"},{"en":"Screenreaders","href":"https://getbootstrap.com/docs/4.2/utilities/screenreaders/"},{"en":"Shadows","href":"https://getbootstrap.com/docs/4.2/utilities/shadows/"},{"en":"Sizing","href":"https://getbootstrap.com/docs/4.2/utilities/sizing/"},{"en":"Spacing","href":"https://getbootstrap.com/docs/4.2/utilities/spacing/"},{"en":"Text","href":"https://getbootstrap.com/docs/4.2/utilities/text/"},{"en":"Vertical align","href":"https://getbootstrap.com/docs/4.2/utilities/vertical-align/"},{"en":"Visibility","href":"https://getbootstrap.com/docs/4.2/utilities/visibility/"},{"en":"Extend","href":"https://getbootstrap.com/docs/4.2/extend/approach/"},{"en":"Approach","href":"https://getbootstrap.com/docs/4.2/extend/approach/"},{"en":"Icons","href":"https://getbootstrap.com/docs/4.2/extend/icons/"},{"en":"Migration","href":"https://getbootstrap.com/docs/4.2/migration/"},{"en":"About","href":"https://getbootstrap.com/docs/4.2/about/overview/"},{"en":"Overview","href":"https://getbootstrap.com/docs/4.2/about/overview/"},{"en":"Team","href":"https://getbootstrap.com/docs/4.2/about/team/"},{"en":"Brand","href":"https://getbootstrap.com/docs/4.2/about/brand/"},{"en":"License","href":"https://getbootstrap.com/docs/4.2/about/license/"},{"en":"Translations","href":"https://getbootstrap.com/docs/4.2/about/translations/"}],"standalone":false,"publishedAssets":[{"url":"/docs/4.2/dist/css/bootstrap.min.css","integrity":"sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"},{"url":"https://code.jquery.com/jquery-3.3.1.slim.min.js","integrity":"sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"},{"url":"/docs/4.2/dist/js/bootstrap.bundle.min.js","integrity":"sha384-zDnhMsjVZfS3hiP7oCBRmfjkQC4fzxVxFhBx8Hkz2aZX8gEvA/jsP3eXRCvzTofP"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-analytics.com/analytics.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://code.jquery.com/jquery-3.3.1.slim.min.js","https://getbootstrap.com/docs/4.2/dist/js/bootstrap.bundle.min.js","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.js","https://getbootstrap.com/docs/4.2/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/4.2/dist/css/bootstrap.min.css","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.css","https://getbootstrap.com/docs/4.2/assets/css/docs.min.css"]}

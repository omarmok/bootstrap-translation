{"route":"/docs/5.3/helpers/vertical-rule/","version":"5.3","renderedVersion":"5.3","title":{"id":"content","type":"heading","en":"Vertical rule","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use the custom vertical rule helper to create vertical dividers like the <code>&lt;hr&gt;</code> element."},"blocks":[{"id":"how-it-works","type":"heading","en":"How it works","level":2},{"id":"how-it-works--paragraph-1","type":"paragraph","en":"Vertical rules are inspired by the <code>&lt;hr&gt;</code> element, allowing you to create vertical dividers in common layouts. They’re styled just like <code>&lt;hr&gt;</code> elements:"},{"id":"how-it-works--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"how-it-works--item-1","type":"item","en":"They’re <code>1px</code> wide"}]},{"tag":"li","body":[{"id":"how-it-works--item-2","type":"item","en":"They have <code>min-height</code> of <code>1em</code>"}]},{"tag":"li","body":[{"id":"how-it-works--item-3","type":"item","en":"Their color is set via <code>currentColor</code> and <code>opacity</code>"}]}]},{"id":"how-it-works--paragraph-2","type":"paragraph","en":"Customize them with additional styles as needed."},{"id":"example","type":"heading","en":"Example","level":2},{"id":"example--example-1","type":"demo","key":"1525f08f18944677a56e","height":147},{"id":"example--code-1","type":"code","value":"<div class=\"vr\"></div>","language":"html"},{"id":"example--paragraph-1","type":"paragraph","en":"Vertical rules scale their height in flex layouts:"},{"id":"example--example-2","type":"demo","key":"d8086817485c89e738d9","height":147},{"id":"example--code-2","type":"code","value":"<div class=\"d-flex\" style=\"height: 200px;\">\n  <div class=\"vr\"></div>\n</div>","language":"html"},{"id":"with-stacks","type":"heading","en":"With stacks","level":2},{"id":"with-stacks--paragraph-1","type":"paragraph","en":"They can also be used in <a href=\"https://getbootstrap.com/docs/5.3/helpers/stacks\">stacks</a>:"},{"id":"with-stacks--example-1","type":"demo","key":"6754c0e13281232cfe9f","height":147},{"id":"with-stacks--code-1","type":"code","value":"<div class=\"hstack gap-3\">\n  <div class=\"p-2\">First item</div>\n  <div class=\"p-2 ms-auto\">Second item</div>\n  <div class=\"vr\"></div>\n  <div class=\"p-2\">Third item</div>\n</div>","language":"html"},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-variables","type":"heading","en":"Sass variables","level":3},{"id":"sass-variables--paragraph-1","type":"paragraph","en":"Customize the vertical rule Sass variable to change its width."},{"id":"sass-variables--code-1","type":"code","value":"$vr-border-width:             var(--#{$prefix}border-width);","language":"scss"}],"demos":[{"key":"1525f08f18944677a56e","html":" <div class=\"vr\"></div> ","attrs":{"class":"bd-example m-0 border-0"},"sprite":""},{"key":"d8086817485c89e738d9","html":" <div class=\"d-flex\" style=\"height: 200px;\">\n  <div class=\"vr\"></div>\n</div> ","attrs":{"class":"bd-example m-0 border-0"},"sprite":""},{"key":"6754c0e13281232cfe9f","html":" <div class=\"hstack gap-3\">\n  <div class=\"p-2\">First item</div>\n  <div class=\"p-2 ms-auto\">Second item</div>\n  <div class=\"vr\"></div>\n  <div class=\"p-2\">Third item</div>\n</div> ","attrs":{"class":"bd-example m-0 border-0 bd-example-flex"},"sprite":""}],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.3/getting-started/introduction"},{"en":"Download","href":"https://getbootstrap.com/docs/5.3/getting-started/download"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.3/getting-started/contents"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/5.3/getting-started/browsers-devices"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/5.3/getting-started/javascript"},{"en":"Webpack","href":"https://getbootstrap.com/docs/5.3/getting-started/webpack"},{"en":"Parcel","href":"https://getbootstrap.com/docs/5.3/getting-started/parcel"},{"en
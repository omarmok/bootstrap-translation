{"route":"/docs/6.0/utilities/border/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Border","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use border utilities to quickly style the border and border-radius of an element. Great for images, buttons, or any other element."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".border"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"border: var(--bs-border-width) var(--bs-border-style) var(--bs-border-color);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".border-0"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"border: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".border-top"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"border-block-start: var(--bs-border-width) var(--bs-border-style) var(--bs-border-color);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".border-top-0"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"border-block-start: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".border-end"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"border-inline-end: var(--bs-border-width) var(--bs-border-style) var(--bs-border-color);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".border-end-0"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"border-inline-end: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":".border-bottom"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"border-block-end: var(--bs-border-width) var(--bs-border-style) var(--bs-border-color);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":".border-bottom-0"}]},{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"border-block-end: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":".border-start"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"border-inline-start: var(--bs-border-width) var(--bs-border-style) var(--bs-border-color);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":".border-start-0"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"border-inline-start: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-24","type":"paragraph","en":".border-keyline"}]},{"type":"td","body":[{"id":"content--paragraph-25","type":"paragraph","en":"border-width: var(--bs-border-width-keyline);"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-26","type":"paragraph","en":".border-1"}]},{"type":"td","body":[{"id":"content--paragraph-27","type":"paragraph","en":"border-width: 1px;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-28","type":"paragraph","en":".border-2"}]},{"type":"td","body":[{"id":"content--paragraph-29","type":"paragraph","en":"border-width: 2px;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-30","type":"paragraph","en":".border-3"}]},{"type":"td","body":[{"id":"content--paragraph-31","type":"paragraph","en":"border-width: 3px;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-32","type":"paragraph","en":".border-4"}]},{"type":"td","body":[{"id":"content--paragraph-33","type":"paragraph","en":"border-width: 4px;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-34","type":"paragraph","en":".border-5"}]},{"type":"td","body":[{"id":"content--paragraph-35","type":"paragraph","en":"border-width: 5px;"}]}]}]},{"id":"border","type":"heading","en":"Border","level":2},{"id":"border--paragraph-1","type":"paragraph","en":"Use border utilities to add or remove an element’s borders. Choose from all borders or one at a time."},{"id":"additive","type":"heading","en":"Additive","level":3},{"id":"additive--paragraph-1","type":"paragraph","en":"Add borders to custom elements:"},{"id":"additive--example-1","type":"demo","key":"7658e57ad77423cdb8b2","height":300},{"id":"additive--code-1","type":"code","value":"<span class=\"border\"></span>\n<span class=\"border-top\"></span>\n<span class=\"border-end\"></span>\n<span class=\"border-bottom\"></span>\n<span class=\"border-start\"></span>","language":""},{"id":"subtractive","type":"heading","en":"Subtractive","level":3},{"id":"subtractive--paragraph-1","type":"paragraph","en":"Or remove borders:"},{"id":"subtractive--example-1","type":"demo","key":"5c059753868c2aa63b35","height":300},{"id":"subtractive--code-1","type":"code","value":"<span class=\"border border-0\"></span>\n<span class=\"border border-top-0\"></span>\n<span class=\"border border-end-0\"></span>\n<span class=\"border border-bottom-0\"></span>\n<span class=\"border border-start-0\"></span>","language":""},{"id":"width","type":"heading","en":"Width","level":2},{"id":"width--paragraph-1","type":"paragraph","en":"Border width utilities are available in increments of 1px from 0 to 5px. These set <code>border-width</code> on all sides."},{"id":"width--example-1","type":"demo","key":"26ab7aa7d95dd83daa83","height":300},{"id":"width--code-1","type":"code","value":"<span class=\"border border-keyline\"></span>\n<span class=\"border border-1\"></span>\n<span class=\"border border-2\"></span>\n<span class=\"border border-3\"></span>\n<span class=\"border border-4\"></span>\n<span class=\"border border-5\"></span>","language":""},{"id":"per-side-widths","type":"heading","en":"Per-side widths","level":3},{"id":"per-side-widths--paragraph-1","type":"paragraph","en":"We do not ship per-side border width utilities. Combine a side utility with a width utility when one side needs a thicker border:"},{"id":"per-side-widths--example-1","type":"demo","key":"b259136880464f5e3f22","height":228},{"id":"per-side-widths--code-1","type":"code","value":"<span class=\"border-top border-2\"></span>\n<span class=\"border-end border-3\"></span>\n<span class=\"border-bottom border-4\"></span>\n<span class=\"border-start border-5\"></span>","language":""},{"id":"extend-utilities","type":"heading","en":"Extend utilities","level":3},{"id":"extend-utilities--paragraph-1","type":"paragraph","en":"Extend the border classes with our <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#add-utilities\">utilities API</a> when you need different widths on different sides, without combining classes as shown above. Here‘s an example using the width longhands instead of the border shorthand so values from <code>$border-widths</code> apply cleanly."},{"id":"extend-utilities--code-1","type":"code","value":"// _my-utilities.scss\n@use \"sass:map\";\n@use \"bootstrap/scss/config\" as *;\n@use \"bootstrap/scss/utilities\";\n\n$border-width-values: map.merge($border-widths, (keyline: var(--border-width-keyline)));\n\n$utilities: map.merge(\n  $utilities,\n  (\n    \"border-top-width\": (\n      property: border-block-start-width,\n      class: border-t,\n      values: $border-width-values\n    ),\n    \"border-end-width\": (\n      property: border-inline-end-width,\n      class: border-e,\n      values: $border-width-values\n    ),\n    \"border-bottom-width\": (\n      property: border-block-end-width,\n      class: border-b,\n      values: $border-width-values\n    ),\n    \"border-start-width\": (\n      property: border-inline-start-width,\n      class: border-s,\n      values: $border-width-values\n    )\n  )\n);","language":""},{"id":"extend-utilities--paragraph-2","type":"paragraph","en":"Load that partial before Bootstrap:"},{"id":"extend-utilities--code-2","type":"code","value":"// my-bootstrap.scss\n@use \"my-utilities\";\n@use \"bootstrap/scss/bootstrap\";","language":""},{"id":"extend-utilities--paragraph-3","type":"paragraph","en":"This adds classes like <code>.border-t-5</code>, <code>.border-e-5</code>, <code>.border-b-5</code>, and <code>.border-s-5</code>. Pair them with <code>.border</code> or a side utility such as <code>.border-bottom</code> so the border still has a style and color."},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"variables","type":"heading","en":"Variables","level":3},{"id":"variables--code-1","type":"code","value":"--border-width: #{$border-width},\n--border-width-keyline: .5px,\n--border-style: #{$border-style},\n--border-color: light-dark(var(--gray-200), var(--gray-700)),\n--border-color-translucent: color-mix(in oklch, var(--fg-body) 15%, transparent),","language":""},{"id":"sass-variables","type":"heading","en":"Sass variables","level":3},{"id":"sass-variables--code-1","type":"code","value":"$border-width:                1px;\n$border-widths: ();\n// stylelint-disable-next-line scss/dollar-variable-default\n$border-widths: defaults(\n  (\n    keyline: .5px,\n    1: 1px,\n    2: 2px,\n    3: 3px,\n    4: 4px,\n    5: 5px\n  ),\n  $border-widths\n);\n$border-style:                solid;\n$border-color:                color-mix(in oklch, var(--gray-100), var(--gray-200));","language":""},{"id":"sass-mixins","type":"heading","en":"Sass mixins","level":3},{"id":"sass-mixins--code-1","type":"code","value":"@mixin border-radius($radius: var(--radius-5), $fallback-border-radius: false) {\n  @if $enable-rounded {\n    border-radius: valid-radius($radius);\n  }\n  @else if $fallback-border-radius != false {\n    border-radius: $fallback-border-radius;\n  }\n}\n\n@mixin border-top-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-start-start-radius: valid-radius($radius);\n    border-start-end-radius: valid-radius($radius);\n  }\n}\n\n@mixin border-end-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-start-end-radius: valid-radius($radius);\n    border-end-end-radius: valid-radius($radius);\n  }\n}\n\n@mixin border-bottom-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-end-start-radius: valid-radius($radius);\n    border-end-end-radius: valid-radius($radius);\n  }\n}\n\n@mixin border-start-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-start-start-radius: valid-radius($radius);\n    border-end-start-radius: valid-radius($radius);\n  }\n}\n\n@mixin border-top-start-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-start-start-radius: valid-radius($radius);\n  }\n}\n\n@mixin border-top-end-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-start-end-radius: valid-radius($radius);\n  }\n}\n\n@mixin border-bottom-end-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-end-end-radius: valid-radius($radius);\n  }\n}\n\n@mixin border-bottom-start-radius($radius: var(--radius-5)) {\n  @if $enable-rounded {\n    border-end-start-radius: valid-radius($radius);\n  }\n}","language":""},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Border utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"border\": (\n  property: border,\n  values: (\n    null: var(--border-width) var(--border-style) var(--border-color),\n    0: 0,\n  )\n),\n\"border-top\": (\n  class: border-top,\n  property: border-block-start,\n  values: (\n    null: var(--border-width) var(--border-style) var(--border-color),\n    0: 0,\n  )\n),\n\"border-end\": (\n  property: border-inline-end,\n  class: border-end,\n  values: (\n    null: var(--border-width) var(--border-style) var(--border-color),\n    0: 0,\n  )\n),\n\"border-bottom\": (\n  property: border-block-end,\n  class: border-bottom,\n  values: (\n    null: var(--border-width) var(--border-style) var(--border-color),\n    0: 0,\n  )\n),\n\"border-start\": (\n  property: border-inline-start,\n  class: border-start,\n  values: (\n    null: var(--border-width) var(--border-style) var(--border-color),\n    0: 0,\n  )\n),\n\"border-y\": (\n  class: border-y,\n  property: border-block,\n  values: (\n    null: var(--border-width) var(--border-style) var(--border-color),\n    0: 0,\n  )\n),\n\"border-x\": (\n  class: border-x,\n  property: border-inline,\n  values: (\n    null: var(--border-width) var(--border-style) var(--border-color),\n    0: 0,\n  )\n),","language":""}],"demos":[{"key":"7658e57ad77423cdb8b2","html":"<span class=\"border\"></span>\n<span class=\"border-top\"></span>\n<span class=\"border-end\"></span>\n<span class=\"border-bottom\"></span>\n<span class=\"border-start\"></span>","attrs":{"class":"bd-example bd-example-border-utils"},"sprite":""},{"key":"5c059753868c2aa63b35","html":"<span class=\"border border-0\"></span>\n<span class=\"border border-top-0\"></span>\n<span class=\"border border-end-0\"></span>\n<span class=\"border border-bottom-0\"></span>\n<span class=\"border border-start-0\"></span>","attrs":{"class":"bd-example bd-example-border-utils"},"sprite":""},{"key":"26ab7aa7d95dd83daa83","html":"<span class=\"border border-keyline\"></span>\n<span class=\"border border-1\"></span>\n<span class=\"border border-2\"></span>\n<span class=\"border border-3\"></span>\n<span class=\"border border-4\"></span>\n<span class=\"border border-5\"></span>","attrs":{"class":"bd-example bd-example-border-utils"},"sprite":""},{"key":"b259136880464f5e3f22","html":"<span class=\"border-top border-2\"></span>\n<span class=\"border-end border-3\"></span>\n<span class=\"border-bottom border-4\"></span>\n<span class=\"border-start border-5\"></span>","attrs":{"class":"bd-example bd-example-border-utils"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0/getting-started/css-variables"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/6.0/getting-started/javascript"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/6.0/getting-started/accessibility"},{"en":"Quickstart","href":"https://getbootstrap.com/docs/6.0/guides/quickstart"},{"en":"npm","href":"https://getbootstrap.com/docs/6.0/guides/npm"},{"en":"Webpack","href":"https://getbootstrap.com/docs/6.0/guides/webpack"},{"en":"Parcel","href":"https://getbootstrap.com/docs/6.0/guides/parcel"},{"en":"Vite","href":"https://getbootstrap.com/docs/6.0/guides/vite"},{"en":"Contribute","href":"https://getbootstrap.com/docs/6.0/guides/contribute"},{"en":"Migration","href":"https://getbootstrap.com/docs/6.0/guides/migration"},{"en":"Overview","href":"https://getbootstrap.com/docs/6.0/customize/overview"},{"en":"Sass","href":"https://getbootstrap.com/docs/6.0/customize/sass"},{"en":"Options","href":"https://getbootstrap.com/docs/6.0/customize/options"},{"en":"Color","href":"https://getbootstrap.com/docs/6.0/customize/color"},{"en"
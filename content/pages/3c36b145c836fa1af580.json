{"route":"/docs/6.0/utilities/place-items/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Place items","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use place-items utilities to control the alignment of grid items within their grid areas on both the block and inline axes simultaneously."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".place-items-start"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"place-items: start;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".place-items-end"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"place-items: end;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".place-items-center"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"place-items: center;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".place-items-stretch"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"place-items: stretch;"}]}]}]},{"id":"overview","type":"heading","en":"Overview","level":2},{"id":"overview--paragraph-1","type":"paragraph","en":"Use <code>place-items</code> utilities on CSS Grid containers as a shorthand to set both <code>align-items</code> and <code>justify-items</code> at once. This property controls how grid items are positioned within their grid areas on both axes."},{"id":"basic-usage","type":"heading","en":"Basic usage","level":2},{"id":"basic-usage--parag
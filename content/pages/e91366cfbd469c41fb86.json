{"route":"/docs/4.1/components/jumbotron/","version":"4.1","renderedVersion":"4.1","title":{"id":"content","type":"heading","en":"Jumbotron","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Lightweight, flexible component for showcasing hero unit style content."},"blocks":[{"id":"content--paragraph-2","type":"paragraph","en":"A lightweight, flexible component that can optionally extend the entire viewport to showcase key marketing messages on your site."},{"id":"content--example-1","type":"demo","key":"642a7ab71502d7b81946","height":147},{"id":"content--code-1","type":"code","value":"<div class=\"jumbotron\">\n  <h1 class=\"display-4\">Hello, world!</h1>\n  <p class=\"lead\">This is a simple hero unit, a simple jumbotron-style component for calling extra attention to featured content or information.</p>\n  <hr class=\"my-4\">\n  <p>It uses utility classes for typography and spacing to space content out within the larger container.</p>\n  <a class=\"btn btn-primary btn-lg\" href=\"#\" role=\"button\">Learn more</a>\n</div>","language":"html"},{"id":"content--paragraph-3","type":"paragraph","en":"To make the jumbotron full width, and without rounded corners, add the <code>.jumbotron-fluid</code> modifier class and add a <code>.container</code> or <code>.container-fluid</code> within."},{"id":"content--example-2","type":"demo","key":"3206ecc476d3c3a61761","height":147},{"id":"content--code-2","type":"code","value":"<div class=\"jumbotron jumbotron-fluid\">\n  <div class=\"container\">\n    <h1 class=\"display-4\">Fluid jumbotron</h1>\n    <p class=\"lead\">This is a modified jumbotron that occupies the entire horizontal space of its parent.</p>\n  </div>\n</div>","language":"html"}],"demos":[{"key":"642a7ab71502d7b81946","html":"\n<div class=\"jumbotron\">\n  <h1 class=\"display-4\">Hello, world!</h1>\n  <p class=\"lead\">This is a simple hero unit, a simple jumbotron-style component for calling extra attention to featured content or information.</p>\n  \n  <p>It uses utility classes for typography and spacing to space content out within the larger container.</p>\n  <a class=\"btn btn-primary btn-lg\" href=\"#\" role=\"button\">Learn more</a>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""},{"key":"3206ecc476d3c3a61761","html":"\n<div class=\"jumbotron jumbotron-fluid\">\n  <div class=\"container\">\n    <h1 class=\"display-4\">Fluid jumbotron</h1>\n    <p class=\"lead\">This is a modified jumbotron that occupies the entire horizontal space of its parent.</p>\n  </div>\n</div>\n","attrs":{"class":"bd-example"},"sprite":""}],"nav":[{"en":"Getting started","href":"https://getbootstrap.com/docs/4.1/getting-started/introduction/"},{"en":"Introduction","href":"https://getbootstrap.com/docs/4.1/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/4.1/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/4.1/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/4.1/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/4.1/getting-started/javascript/"},{"en":"Theming","href":"https://getbootstrap.com/docs/4.1/getting-started/theming/"},{"en":"Build tools","href":"https://getbootstrap.com/docs/4.1/getting-started/build-tools/"},{"en":"Webpack","href":"https://getbootstrap.com/docs/4.1/getting-started/webpack/"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/4.1/getting-started/accessibility/"},{"en":"Layout","href":"https://getbootstrap.com/docs/4.1/layout/overview/"},{"en":"Overview","href":"https://getbootstrap.com/docs/4.1/layout/overview/"},{"en":"Grid","href":"https://getbootstrap.com/docs/4.1/layout/grid/"},{"en":"Media object","href":"https://getbootstrap.com/docs/4.1/layout/media-object/"},{"en":"Utilities for layout","href":"https://getbootstrap.com/docs/4.1/layout/utilities-for-layout/"},{"en":"Content","href":"https://getbootstrap.com/docs/4.1/cont
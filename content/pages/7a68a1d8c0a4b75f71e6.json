{"route":"/2.0.1/","version":"2.0.1","renderedVersion":"2.0.1","title":{"id":"bootstrap-from-twitter","type":"heading","en":"Bootstrap, from Twitter","level":1},"lead":{"id":"bootstrap-from-twitter--paragraph-1","type":"paragraph","en":"Simple and flexible HTML, CSS, and Javascript for popular user interface components and interactions."},"blocks":[{"id":"bootstrap-from-twitter--paragraph-2","type":"paragraph","en":"<a href=\"https://github.com/twitter/bootstrap/\">View project on GitHub</a>\n      <a href=\"https://github.com/twbs/bootstrap/raw/v2.0.1/docs/assets/bootstrap.zip\">Download Bootstrap</a>"},{"id":"bootstrap-from-twitter--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"bootstrap-from-twitter--item-1","type":"item","en":"<a href=\"https://getbootstrap.com/2.0.1/upgrading.html\">Upgrading from 1.4</a>"}]},{"tag":"li","body":[{"id":"bootstrap-from-twitter--item-2","type":"item","en":"<a href=\"https://github.com/twitter/bootstrap/issues?state=open\">Issues</a>"}]},{"tag":"li","body":[{"id":"bootstrap-from-twitter--item-3","type":"item","en":"<a href=\"https://github.com/twitter/bootstrap/wiki\">Roadmap &amp; changelog</a>"}]},{"tag":"li","body":[{"id":"bootstrap-from-twitter--example-1","type":"frame","src":"https://ghbtns.com/github-btn.html?user=twbs&repo=bootstrap&type=watch&count=true","height":380}]},{"tag":"li","body":[{"id":"bootstrap-from-twitter--example-2","type":"frame","src":"https://ghbtns.com/github-btn.html?user=twbs&repo=bootstrap&type=fork&count=true","height":380}]},{"tag":"li","body":[{"id":"bootstrap-from-twitter--item-4","type":"item","en":"<a href=\"https://twitter.com/getbootstrap\">Follow @getbootstrap</a>"}]},{"tag":"li","body":[{"id":"bootstrap-from-twitter--item-5","type":"item","en":"<a href=\"https://twitter.com/share\">Tweet</a>"}]}]},{"id":"designed-for-everyone-everywhere","type":"heading","en":"Designed for everyone, everywhere.","level":1},{"id":"designed-for-everyone-everywhere--paragraph-1","type":"paragraph","en":"Need reasons to love Bootstrap? Look no further."},{"id":"designed-for-everyone-everywhere--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_042_group.png\" alt=\"\" loading=\"lazy\">"},{"id":"built-for-and-by-nerds","type":"heading","en":"Built for and by nerds","level":2},{"id":"built-for-and-by-nerds--paragraph-1","type":"paragraph","en":"Like you, we love building awesome products on the web. We love it so much, we decided to help people just like us do it easier, better, and faster. Bootstrap is built for you."},{"id":"built-for-and-by-nerds--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_079_podium.png\" alt=\"\" loading=\"lazy\">"},{"id":"for-all-skill-levels","type":"heading","en":"For all skill levels","level":2},{"id":"for-all-skill-levels--paragraph-1","type":"paragraph","en":"Bootstrap is designed to help people of all skill levels—designer or developer, huge nerd or early beginner. Use it as a complete kit or use to start something more complex."},{"id":"for-all-skill-levels--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_163_iphone.png\" alt=\"\" loading=\"lazy\">"},{"id":"cross-everything","type":"heading","en":"Cross-everything","level":2},{"id":"cross-everything--paragraph-1","type":"paragraph","en":"Originally built with only modern browsers in mind, Bootstrap has evolved to include support for all major browsers (even IE7!) and, with Bootstrap 2, tablets and smartphones, too."},{"id":"cross-everything--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_155_show_thumbnails.png\" alt=\"\" loading=\"lazy\">"},{"id":"12-column-grid","type":"heading","en":"12-column grid","level":2},{"id":"12-column-grid--paragraph-1","type":"paragraph","en":"Grid systems aren&#39;t everything, but having a durable and flexible one at the core of your work can make development much simpler. Use our built-in grid classes or roll your own."},{"id":"12-column-grid--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_214_resize_small.png\" alt=\"\" loading=\"lazy\">"},{"id":"responsive-design","type":"heading","en":"Responsive design","level":2},{"id":"responsive-design--paragraph-1","type":"paragraph","en":"With Bootstrap 2, we&#39;ve gone fully responsive. Our components are scaled according to a range of resolutions and devices to provide a consistent experience, no matter what."},{"id":"responsive-design--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_266_book_open.png\" alt=\"\" loading=\"lazy\">"},{"id":"styleguide-docs","type":"heading","en":"Styleguide docs","level":2},{"id":"styleguide-docs--paragraph-1","type":"paragraph","en":"Unlike other front-end toolkits, Bootstrap was designed first and foremost as a styleguide to document not only our features, but best practices and living, coded examples."},{"id":"styleguide-docs--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_082_roundabout.png\" alt=\"\" loading=\"lazy\">"},{"id":"growing-library","type":"heading","en":"Growing library","level":2},{"id":"growing-library--paragraph-1","type":"paragraph","en":"Despite being only 10kb (gzipped), Bootstrap is one of the most complete front-end toolkits out there with dozens of fully functional components ready to be put to use."},{"id":"growing-library--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/glyphicons/glyphicons_009_magic.png\" alt=\"\" loading=\"lazy\">"},{"id":"custom-jquery-plugins","type":"heading","en":"Custom jQuery plugins","level":2},{"id":"custom-jquery-plugins--paragraph-1","type":"paragraph","en":"What good is an awesome design component without easy-to-use, proper, and extensible interactions? With Bootstrap, you get custom-built jQuery plugins to bring your projects to life."},{"id":"custom-jquery-plugins--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/less-small.png\" alt=\"\" loading=\"lazy\">"},{"id":"built-on-less","type":"heading","en":"Built on LESS","level":2},{"id":"built-on-less--paragraph-1","type":"paragraph","en":"Where vanilla CSS falters, LESS excels. Variables, nesting, operations, and mixins in LESS makes coding CSS faster and more efficient with minimal overhead."},{"id":"built-on-less--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/icon-html5.png\" alt=\"\" loading=\"lazy\">"},{"id":"html5","type":"heading","en":"HTML5","level":3},{"id":"html5--paragraph-1","type":"paragraph","en":"Built to support new HTML5 elements and syntax."},{"id":"html5--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/icon-css3.png\" alt=\"\" loading=\"lazy\">"},{"id":"css3","type":"heading","en":"CSS3","level":3},{"id":"css3--paragraph-1","type":"paragraph","en":"Progressively enhanced components for ultimate style."},{"id":"css3--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/icon-github.png\" alt=\"\" loading=\"lazy\">"},{"id":"open-source","type":"heading","en":"Open-source","level":3},{"id":"open-source--paragraph-1","type":"paragraph","en":"Built for and maintained by the community via <a href=\"https://github.com/\">GitHub</a>."},{"id":"open-source--media-1","type":"media","html":"<img src=\"https://getbootstrap.com/2.0.1/assets/img/icon-twitter.png\" alt=\"\" loading=\"lazy\">"},{"id":"made-at-twitter","type":"heading","en":"Made at Twitter","level":3},{"id":"made-at-twitter--paragraph-1","type":"paragraph","en":"Brought to you by an experienced <a href=\"https://twitter.com/fat\">engineer</a> and <a href=\"https://twitter.com/mdo\">designer</a>."},{"id":"built-with-bootstrap","type":"heading","en":"Built with Bootstrap.","level":1},{"id":"built-with-bootstrap--paragraph-1","type":"paragraph","en":"For even more sites built with Bootstrap, <a href=\"https://builtwithbootstrap.com/\">visit the unofficial Tumblr</a> or <a href=\"https://getbootstrap.com/2.0.1/examples.html\">browse the examples</a>."},{"id":"built-with-bootstrap--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"built-with-bootstrap--media-1","type":"media","html":"<a href=\"http://kippt.com/\"><img src=\"https://getbootstrap.com/2.0.1/assets/img/example-sites/kippt.png\" alt=\"Kippt\" loading=\"lazy\"></a>"}]},{"tag":"li","body":[{"id":"built-with-bootstrap--media-2","type":"media","html":"<a href=\"https://www.fleetio.com/\"><img src=\"https://getbootstrap.com/2.0.1/assets/img/example-sites/fleetio.png\" alt=\"Fleetio\" loading=\"lazy\"></a>"}]},{"tag":"li","body":[{"id":"built-with-bootstrap--media-3","type":"media","html":"<a href=\"https://jshint.com/\"><img src=\"https://getbootstrap.com/2.0.1/assets/img/example-sites/jshint.png\" alt=\"JS Hint\" loading=\"lazy\"></a>"}]}]}],"demos":[],"nav":[{"en":"Overview","href":"https://getbootstrap.com/2.0.1/index.html"},{"en":"Scaffolding","href":"https://getbootstrap.com/2.0.1/scaffolding.html"},{"en":"Base CSS","href":"https://getbootstrap.com/2.0.1/base-css.html"},{"en":"Components","href":"https://getbootstrap.com/2.0.1/components.html"},{"en":"Javascript plugins","href":"https://getbootstrap.com/2.0.1/javascript.html"},{"en":"Using LESS","href":"https://getbootstrap.com/2.0.1/less.html"},{"en":"Customize","href":"https://getbootstrap.com/2.0.1/download.html"},{"en":"Examples","href":"https://getbootstrap.com/2.0.1/examples.html"}],"standalone":false,"publishedAssets":[],"sourceScripts":["https://cdn.usefathom.com/script.js","https://platform.twitter.com/widgets.js","https://getbootstrap.com/2.0.1/assets/js/jquery.js","https://getbootstrap.com/2.0.1/assets/js/google-code-prettify/prettify.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-transition.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-alert.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-modal.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-dropdown.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-scrollspy.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-tab.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-tooltip.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-popover.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-button.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-collapse.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-carousel.js","https://getbootstrap.com/2.0.1/assets/js/bootstrap-typeahead.js","https://getbootstrap.com/2.0.1/assets/js/application.js"],"sourceStyles":["https://getbootstrap.com/2.0.1/assets/css/bootstrap.css","https://getbootstrap.com/2.0.1/assets/css/bootstrap-responsive.css","https://getbootstrap.com/2.0.1/assets/css/docs.css","https://getbootstrap.com/2.0.1/assets/js/google-code-prettify/prettify.css"]}

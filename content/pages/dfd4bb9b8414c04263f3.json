{"route":"/docs/4.5/utilities/vertical-align/","version":"4.5","renderedVersion":"4.5","title":{"id":"content","type":"heading","en":"Vertical alignment","level":1},"lead":{"id":"page--paragraph-1","type":"paragraph","en":"<a href=\"https://github.com/twbs/bootstrap/blob/v4.5.3/site/docs/4.5/utilities/vertical-align.md\">View on GitHub</a>"},"blocks":[{"id":"content--paragraph-1","type":"paragraph","en":"Easily change the vertical alignment of inline, inline-block, inline-table, and table cell elements."},{"id":"content--paragraph-2","type":"paragraph","en":"Change the alignment of elements with the <a href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/vertical-align\"><code>vertical-alignment</code></a> utilities. Please note that vertical-align only affects inline, inline-block, inline-table, and table cell elements."},{"id":"content--paragraph-3","type":"paragraph","en":"Choose from <code>.align-baseline</code>, <code>.align-top</code>, <code>.align-middle</code>, <code>.align-bottom</code>, <code>.align-text-bottom</code>, and <code>.align-text-top</code> as needed."},{"id":"content--paragraph-4","type":"paragraph","en":"With inline elements:"},{"id":"content--example-1","type":"demo","key":"a1383c47df2736f116e9","height":300},{"id":"content--code-1","type":"code","value":"<span class=\"align-baseline\">baseline</span>\n<span class=\"align-top\">top</span>\n<span class=\"align-middle\">middle</span>\n<span class=\"align-bottom\">bottom</span>\n<span class=\"align-text-top\">text-top</span>\n<span class=\"align-text-bottom\">text-bottom</span>","language":"html"},{"id":"content--paragraph-5","type":"paragraph","en":"With table cells:"},{"id":"content--example-2","type":"demo","key":"a2c23de74fd32a181db6","height":147},{"id":"content--code-2","type":"code","value":"<table style=\"height: 100px;\">\n  <tbody>\n    <tr>\n      <td class=\"align-baseline\">baseline</td>\n      <td class=\"align-top\">top</td>\n      <td class=\"align-middle\">middle</td>\n      
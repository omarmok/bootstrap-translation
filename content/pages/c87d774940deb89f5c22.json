{"route":"/docs/6.0/utilities/height/","version":"6.0","renderedVersion":"6.0","title":{"id":"content","type":"heading","en":"Height","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Use height utilities to control the height of elements with responsive height classes."},"blocks":[{"id":"content--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"content--paragraph-2","type":"paragraph","en":"Class"}]},{"type":"th","scope":"col","body":[{"id":"content--paragraph-3","type":"paragraph","en":"Styles"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-4","type":"paragraph","en":".h-25"}]},{"type":"td","body":[{"id":"content--paragraph-5","type":"paragraph","en":"height: 25%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-6","type":"paragraph","en":".h-50"}]},{"type":"td","body":[{"id":"content--paragraph-7","type":"paragraph","en":"height: 50%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-8","type":"paragraph","en":".h-75"}]},{"type":"td","body":[{"id":"content--paragraph-9","type":"paragraph","en":"height: 75%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-10","type":"paragraph","en":".h-100"}]},{"type":"td","body":[{"id":"content--paragraph-11","type":"paragraph","en":"height: 100%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-12","type":"paragraph","en":".h-auto"}]},{"type":"td","body":[{"id":"content--paragraph-13","type":"paragraph","en":"height: auto;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-14","type":"paragraph","en":".h-min"}]},{"type":"td","body":[{"id":"content--paragraph-15","type":"paragraph","en":"height: min-content;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-16","type":"paragraph","en":".h-max"}]},{"type":"td","body":[{"id":"content--paragraph-17","type":"paragraph","en":"height: max-content;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-18","type":"paragraph","en":".h-fit"}]},{"type":"td","body":[{"id":"content--paragraph-19","type":"paragraph","en":"height: fit-content;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-20","type":"paragraph","en":".max-h-100"}]},{"type":"td","body":[{"id":"content--paragraph-21","type":"paragraph","en":"max-height: 100%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-22","type":"paragraph","en":".min-h-0"}]},{"type":"td","body":[{"id":"content--paragraph-23","type":"paragraph","en":"min-height: 0;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-24","type":"paragraph","en":".min-h-100"}]},{"type":"td","body":[{"id":"content--paragraph-25","type":"paragraph","en":"min-height: 100%;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-26","type":"paragraph","en":".vh-100"}]},{"type":"td","body":[{"id":"content--paragraph-27","type":"paragraph","en":"height: 100vh;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-28","type":"paragraph","en":".min-vh-100"}]},{"type":"td","body":[{"id":"content--paragraph-29","type":"paragraph","en":"min-height: 100vh;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-30","type":"paragraph","en":".dvh-100"}]},{"type":"td","body":[{"id":"content--paragraph-31","type":"paragraph","en":"height: 100dvh;"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"content--paragraph-32","type":"paragraph","en":".min-dvh-100"}]},{"type":"td","body":[{"id":"content--paragraph-33","type":"paragraph","en":"min-height: 100dvh;"}]}]}]},{"id":"content--paragraph-34","type":"paragraph","en":"Use height utilities to set the height of elements. Height utilities are generated from the utility API and include support for percentage values, intrinsic sizing keywords, and viewport units."},{"id":"relative-height","type":"heading","en":"Relative height","level":2},{"id":"relative-height--paragraph-1","type":"paragraph","en":"Set height relative to the parent element using percentage-based utilities. Includes support for <code>25%</code>, <code>50%</code>, <code>75%</code>, <code>100%</code>, and <code>auto</code> by default."},{"id":"relative-height--example-1","type":"demo","key":"04392c79dc18eae3c495","height":147},{"id":"relative-height--code-1","type":"code","value":"<div style=\"height: 100px;\">\n  <div class=\"h-25 d-inline-block\" style=\"width: 120px;\">Height 25%</div>\n  <div class=\"h-50 d-inline-block\" style=\"width: 120px;\">Height 50%</div>\n  <div class=\"h-75 d-inline-block\" style=\"width: 120px;\">Height 75%</div>\n  <div class=\"h-100 d-inline-block\" style=\"width: 120px;\">Height 100%</div>\n  <div class=\"h-auto d-inline-block\" style=\"width: 120px;\">Height auto</div>\n</div>","language":""},{"id":"intrinsic-sizing","type":"heading","en":"Intrinsic sizing","level":2},{"id":"intrinsic-sizing--paragraph-1","type":"paragraph","en":"Use intrinsic sizing keywords to set height based on content."},{"id":"intrinsic-sizing--example-1","type":"demo","key":"9255fbed1c249c4620a5","height":147},{"id":"intrinsic-sizing--code-1","type":"code","value":"<div style=\"height: 200px;\">\n  <div class=\"h-min d-inline-block p-3\" style=\"width: 120px;\">Height min-content</div>\n  <div class=\"h-max d-inline-block p-3\" style=\"width: 120px;\">Height max-content</div>\n  <div class=\"h-fit d-inline-block p-3\" style=\"width: 120px;\">Height fit-content</div>\n</div>","language":""},{"id":"max-height","type":"heading","en":"Max height","level":2},{"id":"max-height--paragraph-1","type":"paragraph","en":"Set maximum height using <code>max-height</code> utilities."},{"id":"max-height--example-1","type":"demo","key":"70f5783e3520c2be2e9f","height":147},{"id":"max-height--code-1","type":"code","value":"<div style=\"height: 100px;\">\n  <div class=\"max-h-100\" style=\"width: 100px; height: 200px;\">Max-height 100%</div>\n</div>","language":""},{"id":"min-height","type":"heading","en":"Min height","level":2},{"id":"min-height--paragraph-1","type":"paragraph","en":"Set minimum height using <code>min-height</code> utilities."},{"id":"min-height--example-1","type":"demo","key":"a046abff0a57ca607a4a","height":174},{"id":"min-height--code-1","type":"code","value":"<div class=\"min-h-0 p-3\" style=\"width: 200px;\">\n  Min-height 0 (allows content to determine height)\n</div>\n<div class=\"min-h-100 p-3\" style=\"width: 200px;\">Min-height 100%</div>","language":""},{"id":"viewport-height","type":"heading","en":"Viewport height","level":2},{"id":"viewport-height--paragraph-1","type":"paragraph","en":"Set height relative to the viewport using viewport units."},{"id":"viewport-height--code-1","type":"code","value":"<div class=\"vh-100\">Height 100vh</div>\n<div class=\"min-vh-100\">Min-height 100vh</div>","language":""},{"id":"viewport-height--note-1","type":"note","tone":"info","body":[{"id":"viewport-height--note-text-1","type":"note-text","en":"<strong>Full viewport height sections!</strong> Using <code>vh-100</code> makes an element take up the entire viewport height, which is useful for hero sections and full-screen layouts. On mobile browsers, <code>vh-100</code> can be taller than the visible area. See <a href=\"#dynamic-viewport-height\">dynamic viewport height</a>."}]},{"id":"dynamic-viewport-height","type":"heading","en":"Dynamic viewport height","level":2},{"id":"dynamic-viewport-height--paragraph-1","type":"paragraph","en":"On mobile browsers, the URL bar and the toolbars hide and show while the user scrolls. The <code>vh</code> unit does not change when this happens. It always measures the viewport with the browser UI hidden. An element with <code>vh-100</code> is therefore taller than the visible area while the URL bar shows. The bottom of the element stays off screen."},{"id":"dynamic-viewport-height--paragraph-2","type":"paragraph","en":"The <code>dvh</code> unit measures the area that the user sees now. The browser updates the value when it hides or shows the browser UI. Use <code>dvh-100</code> and <code>min-dvh-100</code> to fill the visible area on every device."},{"id":"dynamic-viewport-height--code-1","type":"code","value":"<div class=\"dvh-100\">Height 100dvh</div>\n<div class=\"min-dvh-100\">Min-height 100dvh</div>","language":""},{"id":"dynamic-viewport-height--note-1","type":"note","tone":"info","body":[{"id":"dynamic-viewport-height--note-text-1","type":"note-text","en":"<strong>Which unit do I use?</strong> Use <code>dvh</code> for full-screen mobile layouts, such as hero sections and full-height panels. Use <code>vh</code> when you need a height that does not change. The browser recalculates <code>dvh</code> while the browser UI animates, so the content can move. The browser never recalculates <code>vh</code>, but the element can overflow the visible area."}]},{"id":"small-and-large-viewport-units","type":"heading","en":"Small and large viewport units","level":3},{"id":"small-and-large-viewport-units--paragraph-1","type":"paragraph","en":"CSS gives you two more viewport units:"},{"id":"small-and-large-viewport-units--list-1","type":"list","tag":"ul","items":[{"tag":"li","body":[{"id":"small-and-large-viewport-units--item-1","type":"item","en":"<code>svh</code> is the small viewport height. It measures the viewport with the browser UI shown."}]},{"tag":"li","body":[{"id":"small-and-large-viewport-units--item-2","type":"item","en":"<code>lvh</code> is the large viewport height. It measures the viewport with the browser UI hidden. Current browsers give <code>vh</code> the same value."}]}]},{"id":"small-and-large-viewport-units--paragraph-2","type":"paragraph","en":"We do not ship utilities for <code>svh</code> and <code>lvh</code>, because most layouts need <code>dvh</code>. Add them with the <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#add-utilities\">utilities API</a>:"},{"id":"small-and-large-viewport-units--code-1","type":"code","value":"// my-bootstrap.scss\n@use \"bootstrap/scss/bootstrap\" with (\n  $utilities: (\n    \"small-viewport-height\": (\n      property: height,\n      class: svh,\n      values: (100: 100svh)\n    ),\n    \"min-small-viewport-height\": (\n      property: min-height,\n      class: min-svh,\n      values: (100: 100svh)\n    ),\n    \"large-viewport-height\": (\n      property: height,\n      class: lvh,\n      values: (100: 100lvh)\n    ),\n    \"min-large-viewport-height\": (\n      property: min-height,\n      class: min-lvh,\n      values: (100: 100lvh)\n    )\n  )\n);","language":""},{"id":"small-and-large-viewport-units--paragraph-3","type":"paragraph","en":"This adds <code>.svh-100</code>, <code>.min-svh-100</code>, <code>.lvh-100</code>, and <code>.min-lvh-100</code>."},{"id":"small-and-large-viewport-units--note-1","type":"note","tone":"info","body":[{"id":"small-and-large-viewport-units--note-text-1","type":"note-text","en":"Every browser that Bootstrap 6 supports has <code>dvh</code>, <code>svh</code>, and <code>lvh</code>. Read <a href=\"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices\">Browsers &amp; devices</a> for the full support policy."}]},{"id":"small-and-large-viewport-units--paragraph-4","type":"paragraph","en":"We ship the same utilities for the width axis, <code>dvw-100</code> and <code>min-dvw-100</code>. Read <a href=\"https://getbootstrap.com/docs/6.0/utilities/width#dynamic-viewport-width\">dynamic viewport width</a> to see how the width units differ."},{"id":"css","type":"heading","en":"CSS","level":2},{"id":"sass-utilities-api","type":"heading","en":"Sass utilities API","level":3},{"id":"sass-utilities-api--paragraph-1","type":"paragraph","en":"Height utilities are declared in our utilities API in <code>scss/_utilities.scss</code>. <a href=\"https://getbootstrap.com/docs/6.0/utilities/api#using-the-api\">Learn how to use the utilities API.</a>"},{"id":"sass-utilities-api--code-1","type":"code","value":"\"height\": (\n  property: height,\n  class: h,\n  values: (\n    25: 25%,\n    50: 50%,\n    75: 75%,\n    100: 100%,\n    auto: auto,\n    min: min-content,\n    max: max-content,\n    fit: fit-content,\n  )\n),\n\"max-height\": (\n  property: max-height,\n  class: max-h,\n  values: (100: 100%)\n),\n\"min-height\": (\n  property: min-height,\n  class: min-h,\n  values: (\n    0: 0,\n    100: 100%,\n  ),\n),\n\"viewport-height\": (\n  property: height,\n  class: vh,\n  values: (100: 100vh)\n),\n\"min-viewport-height\": (\n  property: min-height,\n  class: min-vh,\n  values: (100: 100vh)\n),\n\"dynamic-viewport-height\": (\n  property: height,\n  class: dvh,\n  values: (100: 100dvh)\n),\n\"min-dynamic-viewport-height\": (\n  property: min-height,\n  class: min-dvh,\n  values: (100: 100dvh)\n),","language":""}],"demos":[{"key":"04392c79dc18eae3c495","html":"<div style=\"height: 100px;\">\n  <div class=\"h-25 d-inline-block\" style=\"width: 120px;\">Height 25%</div>\n  <div class=\"h-50 d-inline-block\" style=\"width: 120px;\">Height 50%</div>\n  <div class=\"h-75 d-inline-block\" style=\"width: 120px;\">Height 75%</div>\n  <div class=\"h-100 d-inline-block\" style=\"width: 120px;\">Height 100%</div>\n  <div class=\"h-auto d-inline-block\" style=\"width: 120px;\">Height auto</div>\n</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""},{"key":"9255fbed1c249c4620a5","html":"<div style=\"height: 200px;\">\n  <div class=\"h-min d-inline-block p-3\" style=\"width: 120px;\">Height min-content</div>\n  <div class=\"h-max d-inline-block p-3\" style=\"width: 120px;\">Height max-content</div>\n  <div class=\"h-fit d-inline-block p-3\" style=\"width: 120px;\">Height fit-content</div>\n</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""},{"key":"70f5783e3520c2be2e9f","html":"<div style=\"height: 100px;\">\n  <div class=\"max-h-100\" style=\"width: 100px; height: 200px;\">Max-height 100%</div>\n</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""},{"key":"a046abff0a57ca607a4a","html":"<div class=\"min-h-0 p-3\" style=\"width: 200px;\">\n  Min-height 0 (allows content to determine height)\n</div>\n<div class=\"min-h-100 p-3\" style=\"width: 200px;\">Min-height 100%</div>","attrs":{"class":"bd-example bd-example-flex"},"sprite":""}],"nav":[{"en":"Install","href":"https://getbootstrap.com/docs/6.0/getting-started/install"},{"en":"AI","href":"https://getbootstrap.com/docs/6.0/getting-started/ai"},{"en":"Approach","href":"https://getbootstrap.com/docs/6.0/getting-started/approach"},{"en":"CSS variables","href":"https://getbootstrap.com/docs/6.0/getting-started/css-variables"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/6.0/getting-started/javascript"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/6.0/getting-started/browsers-devices"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/6.0/getting-started/accessibility"},{"en":"Quickstart","href":"https://getbootstrap.com/docs/6.0/guides/quickstart"},{"en":"npm","href":"https://getbootstrap.com/docs/6.0/guides/npm"},{"en":"Webpack","href":"https://getbootstrap.com/docs/6.0/guides/webpack"},{"en":"Parcel","href":"https://getbootstrap.com/docs/6.0/guides/parcel"},{"en":"Vite","href":"https://getbootstrap.com/docs/6.0/guides/vite"},{"en":"Contribute","href":"https://getbootstrap.com/docs/6.0/guides/contribute"},{"en":"Migration","href":"https://getbootstrap.com/docs/6.0/guides/migration"},{"en":"Overview","href":"https://getbootstrap.com/docs/6.0/customize/overview"},{"en":"Sass","href":"https://getbootstrap.com/docs/6.0/customize/sass"},{"en":"Options","href":"https://getbootstrap.com/docs/6.0/customize/options"},{"en":"Color","href":"https://getbootstrap.com/docs/6.0/customize/color"},{"en":"Theme","href":"https://getbootstrap.com/docs/6.0/customize/theme"},{"en":"Color modes","href":"https://getbootstrap.com/docs/6.0/customize/color-modes"},{"en":"Com
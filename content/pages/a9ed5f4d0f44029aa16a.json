{"route":"/docs/5.1/getting-started/contents/","version":"5.1","renderedVersion":"5.1","title":{"id":"content","type":"heading","en":"Contents","level":1},"lead":{"id":"content--paragraph-1","type":"paragraph","en":"Discover what’s included in Bootstrap, including our precompiled and source code flavors."},"blocks":[{"id":"precompiled-bootstrap","type":"heading","en":"Precompiled Bootstrap","level":2},{"id":"precompiled-bootstrap--paragraph-1","type":"paragraph","en":"Once downloaded, unzip the compressed folder and you’ll see something like this:"},{"id":"precompiled-bootstrap--code-1","type":"code","value":"bootstrap/\n├── css/\n│   ├── bootstrap-grid.css\n│   ├── bootstrap-grid.css.map\n│   ├── bootstrap-grid.min.css\n│   ├── bootstrap-grid.min.css.map\n│   ├── bootstrap-grid.rtl.css\n│   ├── bootstrap-grid.rtl.css.map\n│   ├── bootstrap-grid.rtl.min.css\n│   ├── bootstrap-grid.rtl.min.css.map\n│   ├── bootstrap-reboot.css\n│   ├── bootstrap-reboot.css.map\n│   ├── bootstrap-reboot.min.css\n│   ├── bootstrap-reboot.min.css.map\n│   ├── bootstrap-reboot.rtl.css\n│   ├── bootstrap-reboot.rtl.css.map\n│   ├── bootstrap-reboot.rtl.min.css\n│   ├── bootstrap-reboot.rtl.min.css.map\n│   ├── bootstrap-utilities.css\n│   ├── bootstrap-utilities.css.map\n│   ├── bootstrap-utilities.min.css\n│   ├── bootstrap-utilities.min.css.map\n│   ├── bootstrap-utilities.rtl.css\n│   ├── bootstrap-utilities.rtl.css.map\n│   ├── bootstrap-utilities.rtl.min.css\n│   ├── bootstrap-utilities.rtl.min.css.map\n│   ├── bootstrap.css\n│   ├── bootstrap.css.map\n│   ├── bootstrap.min.css\n│   ├── bootstrap.min.css.map\n│   ├── bootstrap.rtl.css\n│   ├── bootstrap.rtl.css.map\n│   ├── bootstrap.rtl.min.css\n│   └── bootstrap.rtl.min.css.map\n└── js/\n    ├── bootstrap.bundle.js\n    ├── bootstrap.bundle.js.map\n    ├── bootstrap.bundle.min.js\n    ├── bootstrap.bundle.min.js.map\n    ├── bootstrap.esm.js\n    ├── bootstrap.esm.js.map\n    ├── bootstrap.esm.min.js\n    ├── bootstrap.esm.min.js.map\n    ├── bootstrap.js\n    ├── bootstrap.js.map\n    ├── bootstrap.min.js\n    └── bootstrap.min.js.map","language":"text"},{"id":"precompiled-bootstrap--paragraph-2","type":"paragraph","en":"This is the most basic form of Bootstrap: precompiled files for quick drop-in usage in nearly any web project. We provide compiled CSS and JS (<code>bootstrap.*</code>), as well as compiled and minified CSS and JS (<code>bootstrap.min.*</code>). <a href=\"https://developers.google.com/web/tools/chrome-devtools/javascript/source-maps\">Source maps</a> (<code>bootstrap.*.map</code>) are available for use with certain browsers&#39; developer tools. Bundled JS files (<code>bootstrap.bundle.js</code> and minified <code>bootstrap.bundle.min.js</code>) include <a href=\"https://github.com/floating-ui/popper-docs/blob/main/docs/v2/index.md\">Popper</a>."},{"id":"css-files","type":"heading","en":"CSS files","level":2},{"id":"css-files--paragraph-1","type":"paragraph","en":"Bootstrap includes a handful of options for including some or all of our compiled CSS."},{"id":"css-files--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-2","type":"paragraph","en":"CSS files"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-3","type":"paragraph","en":"Layout"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-4","type":"paragraph","en":"Content"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-5","type":"paragraph","en":"Components"}]},{"type":"th","scope":"col","body":[{"id":"css-files--paragraph-6","type":"paragraph","en":"Utilities"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"css-files--paragraph-7","type":"paragraph","en":"<code>bootstrap.css</code>"},{"id":"css-files--paragraph-8","type":"paragraph","en":"<code>bootstrap.rtl.css</code>"},{"id":"css-files--paragraph-9","type":"paragraph","en":"<code>bootstrap.min.css</code>"},{"id":"css-files--paragraph-10","type":"paragraph","en":"<code>bootstrap.rtl.min.css</code>"}]},{"type":"td","body":[{"id":"css-files--paragraph-11","type":"paragraph","en":"Included"}]},{"type":"td","body":[{"id":"css-files--paragraph-12","type":"paragraph","en":"Included"}]},{"type":"td","body":[{"id":"css-files--paragraph-13","type":"paragraph","en":"Included"}]},{"type":"td","body":[{"id":"css-files--paragraph-14","type":"paragraph","en":"Included"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"css-files--paragraph-15","type":"paragraph","en":"<code>bootstrap-grid.css</code>"},{"id":"css-files--paragraph-16","type":"paragraph","en":"<code>bootstrap-grid.rtl.css</code>"},{"id":"css-files--paragraph-17","type":"paragraph","en":"<code>bootstrap-grid.min.css</code>"},{"id":"css-files--paragraph-18","type":"paragraph","en":"<code>bootstrap-grid.rtl.min.css</code>"}]},{"type":"td","body":[{"id":"css-files--paragraph-19","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/5.1/layout/grid/\">Only grid system</a>"}]},{"type":"td","body":[]},{"type":"td","body":[]},{"type":"td","body":[{"id":"css-files--paragraph-20","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/5.1/utilities/flex/\">Only flex utilities</a>"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"css-files--paragraph-21","type":"paragraph","en":"<code>bootstrap-utilities.css</code>"},{"id":"css-files--paragraph-22","type":"paragraph","en":"<code>bootstrap-utilities.rtl.css</code>"},{"id":"css-files--paragraph-23","type":"paragraph","en":"<code>bootstrap-utilities.min.css</code>"},{"id":"css-files--paragraph-24","type":"paragraph","en":"<code>bootstrap-utilities.rtl.min.css</code>"}]},{"type":"td","body":[]},{"type":"td","body":[]},{"type":"td","body":[]},{"type":"td","body":[{"id":"css-files--paragraph-25","type":"paragraph","en":"Included"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"css-files--paragraph-26","type":"paragraph","en":"<code>bootstrap-reboot.css</code>"},{"id":"css-files--paragraph-27","type":"paragraph","en":"<code>bootstrap-reboot.rtl.css</code>"},{"id":"css-files--paragraph-28","type":"paragraph","en":"<code>bootstrap-reboot.min.css</code>"},{"id":"css-files--paragraph-29","type":"paragraph","en":"<code>bootstrap-reboot.rtl.min.css</code>"}]},{"type":"td","body":[]},{"type":"td","body":[{"id":"css-files--paragraph-30","type":"paragraph","en":"<a href=\"https://getbootstrap.com/docs/5.1/content/reboot/\">Only Reboot</a>"}]},{"type":"td","body":[]},{"type":"td","body":[]}]}]},{"id":"js-files","type":"heading","en":"JS files","level":2},{"id":"js-files--paragraph-1","type":"paragraph","en":"Similarly, we have options for including some or all of our compiled JavaScript."},{"id":"js-files--table-1","type":"table","caption":[],"rows":[{"head":true,"cells":[{"type":"th","scope":"col","body":[{"id":"js-files--paragraph-2","type":"paragraph","en":"JS files"}]},{"type":"th","scope":"col","body":[{"id":"js-files--paragraph-3","type":"paragraph","en":"Popper"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"js-files--paragraph-4","type":"paragraph","en":"<code>bootstrap.bundle.js</code>"},{"id":"js-files--paragraph-5","type":"paragraph","en":"<code>bootstrap.bundle.min.js</code>"}]},{"type":"td","body":[{"id":"js-files--paragraph-6","type":"paragraph","en":"Included"}]}]},{"head":false,"cells":[{"type":"th","scope":"row","body":[{"id":"js-files--paragraph-7","type":"paragraph","en":"<code>bootstrap.js</code>"},{"id":"js-files--paragraph-8","type":"paragraph","en":"<code>bootstrap.min.js</code>"}]},{"type":"td","body":[]}]}]},{"id":"bootstrap-source-code","type":"heading","en":"Bootstrap source code","level":2},{"id":"bootstrap-source-code--paragraph-1","type":"paragraph","en":"The Bootstrap source code download includes the precompiled CSS and JavaScript assets, along with source Sass, JavaScript, and documentation. More specifically, it includes the following and more:"},{"id":"bootstrap-source-code--code-1","type":"code","value":"bootstrap/\n├── dist/\n│   ├── css/\n│   └── js/\n├── site/\n│   └──content/\n│      └── docs/\n│          └── 5.1/\n│              └── examples/\n├── js/\n└── scss/","language":"text"},{"id":"bootstrap-source-code--paragraph-2","type":"paragraph","en":"The <code>scss/</code> and <code>js/</code> are the source code for our CSS and JavaScript. The <code>dist/</code> folder includes everything listed in the precompiled download section above. The <code>site/docs/</code> folder includes the source code for our documentation, and <code>examples/</code> of Bootstrap usage. Beyond that, any other included file provides support for packages, license information, and development."}],"demos":[],"nav":[{"en":"Introduction","href":"https://getbootstrap.com/docs/5.1/getting-started/introduction/"},{"en":"Download","href":"https://getbootstrap.com/docs/5.1/getting-started/download/"},{"en":"Contents","href":"https://getbootstrap.com/docs/5.1/getting-started/contents/"},{"en":"Browsers & devices","href":"https://getbootstrap.com/docs/5.1/getting-started/browsers-devices/"},{"en":"JavaScript","href":"https://getbootstrap.com/docs/5.1/getting-started/javascript/"},{"en":"Webpack","href":"https://getbootstrap.com/docs/5.1/getting-started/webpack/"},{"en":"Parcel","href":"https://getbootstrap.com/docs/5.1/getting-started/parcel/"},{"en":"Accessibility","href":"https://getbootstrap.com/docs/5.1/getting-started/accessibility/"},{"en":"RFS","href":"https://getbootstrap.com/docs/5.1/getting-started/rfs/"},{"en":"RTL","href":"https://getbootstrap.com/docs/5.1/getting-started/rtl/"},{"en":"Contribute","href":"https://getbootstrap.com/docs/5.1/getting-started/contribute/"},{"en":"Overview","href":"https://getbootstrap.com/docs/5.1/customize/overview/"},{"en":"Sass","href":"https://getbootstrap.com/docs/5.1/customize/sass/"},{"en":"Options","href":"https://getbootstrap.com/docs/5.1/customize/options/"},{"en":"Color"
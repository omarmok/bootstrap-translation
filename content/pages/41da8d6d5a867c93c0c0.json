ties/close-icon/"},{"en":"Colors","href":"https://getbootstrap.com/docs/4.1/utilities/colors/"},{"en":"Display","href":"https://getbootstrap.com/docs/4.1/utilities/display/"},{"en":"Embed","href":"https://getbootstrap.com/docs/4.1/utilities/embed/"},{"en":"Flex","href":"https://getbootstrap.com/docs/4.1/utilities/flex/"},{"en":"Float","href":"https://getbootstrap.com/docs/4.1/utilities/float/"},{"en":"Image replacement","href":"https://getbootstrap.com/docs/4.1/utilities/image-replacement/"},{"en":"Position","href":"https://getbootstrap.com/docs/4.1/utilities/position/"},{"en":"Screenreaders","href":"https://getbootstrap.com/docs/4.1/utilities/screenreaders/"},{"en":"Shadows","href":"https://getbootstrap.com/docs/4.1/utilities/shadows/"},{"en":"Sizing","href":"https://getbootstrap.com/docs/4.1/utilities/sizing/"},{"en":"Spacing","href":"https://getbootstrap.com/docs/4.1/utilities/spacing/"},{"en":"Text","href":"https://getbootstrap.com/docs/4.1/utilities/text/"},{"en":"Vertical align","href":"https://getbootstrap.com/docs/4.1/utilities/vertical-align/"},{"en":"Visibility","href":"https://getbootstrap.com/docs/4.1/utilities/visibility/"},{"en":"Extend","href":"https://getbootstrap.com/docs/4.1/extend/approach/"},{"en":"Approach","href":"https://getbootstrap.com/docs/4.1/extend/approach/"},{"en":"Icons","href":"https://getbootstrap.com/docs/4.1/extend/icons/"},{"en":"Migration","href":"https://getbootstrap.com/docs/4.1/migration/"},{"en":"About","href":"https://getbootstrap.com/docs/4.1/about/overview/"},{"en":"Overview","href":"https://getbootstrap.com/docs/4.1/about/overview/"},{"en":"Brand","href":"https://getbootstrap.com/docs/4.1/about/brand/"},{"en":"License","href":"https://getbootstrap.com/docs/4.1/about/license/"},{"en":"Translations","href":"https://getbootstrap.com/docs/4.1/about/translations/"}],"standalone":false,"publishedAssets":[{"url":"/docs/4.1/dist/css/bootstrap.min.css","integrity":"sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO"},{"url":"https://code.jquery.com/jquery-3.3.1.slim.min.js","integrity":"sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"},{"url":"/docs/4.1/assets/js/vendor/popper.min.js","integrity":"sha384-ZMP7rVo3mIykV+2+9J3UJ46jBk0WLaUAdn689aCwoqbBJiSnjAK/l8WvCWPIPm49"},{"url":"/docs/4.1/dist/js/bootstrap.min.js","integrity":"sha384-ChfqqxuZUCnJSK3+MXmPNIyE6ZbWh2IMqE241rYiqJxyMiZ6OW/JmZQ5stwEULTy"}],"sourceScripts":["https://cdn.usefathom.com/script.js","https://www.google-analytics.com/analytics.js","https://cdn.carbonads.com/carbon.js?serve=CKYIKKJL&placement=getbootstrapcom&format=responsive","https://code.jquery.com/jquery-3.3.1.slim.min.js","https://getbootstrap.com/docs/4.1/assets/js/vendor/popper.min.js","https://getbootstrap.com/docs/4.1/dist/js/bootstrap.min.js","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.js","https://getbootstrap.com/docs/4.1/assets/js/docs.min.js"],"sourceStyles":["https://getbootstrap.com/docs/4.1/dist/css/bootstrap.min.css","https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.css","https://getbootstrap.com/docs/4.1/assets/css/docs.min.css"]}

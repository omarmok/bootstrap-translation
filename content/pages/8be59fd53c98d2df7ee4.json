ckgrounds-and-gradients--paragraph-26","type":"paragraph","en":"<code>@color, @angle</code>"}]},{"type":"td","body":[{"id":"backgrounds-and-gradients--paragraph-27","type":"paragraph","en":"Create a cross-browser striped background gradient"}]}]},{"head":false,"cells":[{"type":"td","body":[{"id":"backgrounds-and-gradients--paragraph-28","type":"paragraph","en":"<code>.#gradientBar()</code>"}]},{"type":"td","body":[{"id":"backgrounds-and-gradients--paragraph-29","type":"paragraph","en":"<code>@primaryColor, @secondaryColor</code>"}]},{"type":"td","body":[{"id":"backgrounds-and-gradients--paragraph-30","type":"paragraph","en":"Used for buttons to assign a gradient and slightly darker border"}]}]}]},{"id":"compiling-bootstrap-with-less","type":"heading","en":"Compiling Bootstrap with LESS","level":1,"anchors":["compiling"]},{"id":"compiling-bootstrap-with-less--note-1","type":"note","tone":"info","body":[{"id":"compiling-bootstrap-with-less--note-text-1","type":"note-text","en":"<strong>Note:</strong> If you&#39;re submitting a pull request to GitHub with modified CSS, you <strong>must</strong> recompile the CSS via any of these methods."}]},{"id":"tools-for-compiling","type":"heading","en":"Tools for compiling","level":2},{"id":"node-with-makefile","type":"heading","en":"Node with makefile","level":3},{"id":"node-with-makefile--paragraph-1","type":"paragraph","en":"Install the LESS command line compiler with npm by running the following command:"},{"id":"node-with-makefile--code-1","type":"code","value":"$ npm install less","language":""},{"id":"node-with-makefile--paragraph-2","type":"paragraph","en":"Once installed just run <code>make</code> from the root of your bootstrap directory and you&#39;re all set."},{"id":"node-with-makefile--paragraph-3","type":"paragraph","en":"Additionally, if you have <a href=\"https://github.com/mynyml/watchr\">watchr</a> installed, you may run <code>make watch</code> to have bootstrap automatically rebuilt every time you edit a file in the bootstrap lib (this isn&#39;t required, just a convenience method)."},{"id":"command-line","type":"heading","en":"Command line","level":3},{"id":"command-line--paragraph-1","type":"paragraph","en":"Install the LESS command line tool via Node and run the following command:"},{"id":"command-line--code-1","type":"code","value":"$ lessc ./lib/bootstrap.less > bootstrap.css","language":""},{"id":"command-line--paragraph-2","type":"paragraph","en":"Be sure to include <code>--compress</code> in that command if you&#39;re trying to save some bytes!"},{"id":"javascript","type":"heading","en":"Javascript","level":3},{"id":"javascript--paragraph-1","type":"paragraph","en":"<a href=\"http://lesscss.org/\">Download the latest Less.js</a> and include the path to it (and Bootstrap) in the <code>&lt;head&gt;</code>."},{"id":"javascript--code-1","type":"code","value":"<link rel=\"stylesheet/less\" href=\"/path/to/bootstrap.less\">\n<script src=\"/path/to/less.js\"></script>","language":""},{"id":"javascript--paragraph-2","type":"paragraph","en":"To recompile the .less files, just save them and reload your page. Less.js compiles them and stores them in local storage."},{"id":"unofficial-mac-app","type":"heading","en":"Unofficial Mac app","level":3},{"id":"unofficial-mac-app--paragraph-1","type":"paragraph","en":"<a href=\"http://incident57.com/less/\">The unofficial Mac app</a> watches directories of .less files and compiles the code to local files after every save of a watched .less file."},{"id":"unofficial-mac-app--paragraph-2","type":"paragraph","en":"If you like, you can toggle preferences in the app for automatic minifying and which directory the compiled files end up in."},{"id":"more-mac-apps","type":"heading","en":"More Mac apps","level":3},{"id":"crunch","type":"heading","en":"<a href=\"http://crunchapp.net/\">Crunch</a>","level":4},{"id":"crunch--paragraph-1","type":"paragraph","en":"Crunch is a great looking LESS editor and compiler built on Adobe Air."},{"id":"codekit","type":"heading","en":"<a href=\"http://incident57.com/codekit/\">CodeKit</a>","level":4},{"id":"codekit--paragraph-1","type":"paragraph","en":"Created by the same guy as the unofficial Mac app, CodeKit is a Mac app that compiles LESS, SASS, Stylus, and CoffeeScript."},{"id":"simpless","type":"heading","en":"<a href=\"https://wearekiss.com/simpless\">Simpless</a>","level":4},{"id":"simpless--paragraph-1","type":"paragraph","en":"Mac, Linux, and PC app for drag and drop compiling of LESS files. Plus, the <a href=\"https://github.com/Paratron/SimpLESS\">source code is on GitHub</a>."}],"demos":[],"nav":[{"en":"Overview","href":"https://getbootstrap.com/2.0.0/index.html"},{"en":"Scaffolding","href":"https://getbootstrap.com/2.0.0/scaffolding.html"},{"en":"Base CSS","href":"https://getbootstrap.com/2.0.0/base-css.html"},{"en":"Components","href":"https://getbootstrap.com/2.0.0/components.html"},{"en":"Javascript plugins","href":"https://getbootstrap.com/2.0.0/javascript.html"},{"en":"Using LESS","href":"https://getbootstrap.com/2.0.0/less.html"},{"en":"Customize","href":"https://getbootstrap.com/2.0.0/download.html"},{"en":"Examples","href":"https://getbootstrap.com/2.0.0/examples.html"}],"standalone":false,"publishedAssets":[],"sourceScripts":["https://cdn.usefathom.com/script.js","https://platform.twitter.com/widgets.js","https://getbootstrap.com/2.0.0/assets/js/jquery.js","https://getbootstrap.com/2.0.0/assets/js/google-code-prettify/prettify.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-transition.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-alert.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-modal.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-dropdown.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-scrollspy.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-tab.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-tooltip.js","https://getbootstrap.com/2.0.0/assets/js/bootstrap-popover.js","https://getboo